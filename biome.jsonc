{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				// tsconfig sets noUncheckedIndexedAccess, so `!` is how an invariant the type cannot see is asserted at the point that knows it.
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				// Target sources and producer prompts travel as string literals, where `${name}` is the text a candidate must contain.
				"noTemplateCurlyInString": "off"
			}
		}
	},
	// 120 columns is both the width common style guides settle on and the ninth decile of the tree as it stood, so the formatter reshapes only the last decile.
	"formatter": { "enabled": true, "lineWidth": 120 },
	// Imports are grouped by architectural layer, which mirrors the one-way dependency direction; sorting them alphabetically would scatter that grouping.
	"assist": { "actions": { "source": { "organizeImports": "off" } } },
	"files": { "includes": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"] }
}
