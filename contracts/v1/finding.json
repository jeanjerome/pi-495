{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "rule_id",
    "category",
    "severity",
    "message",
    "path",
    "region",
    "symbol",
    "requirement_refs",
    "baseline_state",
    "fingerprint",
    "tool",
    "tool_version",
    "confidence",
    "raw_evidence_ref"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "enum": [
        "assertion",
        "structure",
        "quality",
        "security",
        "performance",
        "scope",
        "protocol",
        "review",
        "incident"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "major",
        "minor",
        "info"
      ]
    },
    "message": {
      "type": "string"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "region": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "start_line",
            "end_line",
            "start_col",
            "end_col"
          ],
          "properties": {
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            },
            "start_col": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "end_col": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "symbol": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "revision"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "baseline_state": {
      "type": "string",
      "enum": [
        "new",
        "preexisting",
        "removed",
        "unknown"
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest, hex, prefixed"
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tool_version": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "raw_evidence_ref": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "algorithm",
            "digest",
            "size_bytes",
            "media_type"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "sha256"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "SHA-256 digest, hex, prefixed"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "media_type": {
              "type": "string",
              "minLength": 1
            }
          },
          "$id": "urn:495:contract:object-ref:1",
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$id": "urn:495:contract:finding:1",
  "additionalProperties": false
}
