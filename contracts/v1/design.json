{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "change_id",
    "summary",
    "components",
    "interfaces",
    "alternatives",
    "risks",
    "tasks"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "summary",
          "responsibility",
          "requirement_ids",
          "depends_on",
          "paths",
          "checks"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "summary": {
            "type": "string"
          },
          "responsibility": {
            "type": "string",
            "description": "the component or module that owns what the task changes"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "the requirements this task serves"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "the task_id of each task that must be done first"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "the paths the task writes: files, or directories ending in /"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "the local checks run while doing the task"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$id": "urn:495:contract:design:1",
  "additionalProperties": false
}
