{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "budgets": {
          "type": "object",
          "properties": {
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "max_technical_retries": {
              "type": "integer",
              "minimum": 0
            },
            "max_continuations": {
              "type": "integer",
              "minimum": 0
            },
            "intervention_ms": {
              "type": "integer",
              "minimum": 1
            },
            "increment_ms": {
              "type": "integer",
              "minimum": 1
            },
            "tool_calls_per_intervention": {
              "type": "integer",
              "minimum": 1
            },
            "feedback_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "adoption": {
          "type": "object",
          "properties": {
            "mandate": {
              "type": "string",
              "enum": [
                "kernel",
                "human"
              ]
            },
            "requirements": {
              "type": "string",
              "enum": [
                "kernel",
                "human"
              ]
            },
            "protocol": {
              "type": "string",
              "enum": [
                "kernel"
              ]
            },
            "design": {
              "type": "string",
              "enum": [
                "kernel",
                "human"
              ]
            }
          },
          "additionalProperties": false
        },
        "g5_human_acceptance": {
          "type": "boolean"
        },
        "integration_enabled": {
          "type": "boolean"
        },
        "baseline": {
          "type": "object",
          "properties": {
            "compare_to_reference": {
              "type": "boolean"
            },
            "tolerance": {
              "type": "string",
              "enum": [
                "no_aggravation",
                "block_any"
              ]
            },
            "instability": {
              "type": "string",
              "enum": [
                "confirm_then_indeterminate",
                "none"
              ]
            },
            "max_confirmations": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "stagnation_identical_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "required_reviews": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_missions": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "acceptance_recipe": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "journey",
                "preconditions",
                "entry",
                "observations",
                "negative_control",
                "negative_not_applicable",
                "simulations",
                "not_exercised",
                "external_data",
                "command",
                "report_path",
                "timeout_ms"
              ],
              "properties": {
                "journey": {
                  "type": "string",
                  "minLength": 1
                },
                "preconditions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "entry": {
                  "type": "string",
                  "minLength": 1
                },
                "observations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "observation_id",
                      "requirement_id",
                      "expected"
                    ],
                    "properties": {
                      "observation_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "requirement_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "expected": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "negative_control": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "requirement_id",
                        "deprived_of",
                        "expected"
                      ],
                      "properties": {
                        "requirement_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "deprived_of": {
                          "type": "string",
                          "minLength": 1
                        },
                        "expected": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "negative_not_applicable": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "simulations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "not_exercised": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "external_data": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "report_path": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "network": {
                  "type": "string",
                  "enum": [
                    "denied",
                    "loopback",
                    "allowed"
                  ]
                },
                "protected_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "properties": {
        "allow_unconfined": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "human_origin": {
      "type": "object",
      "properties": {
        "rpc_actor_env": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "workspace_exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "fr",
        "en"
      ]
    }
  },
  "$id": "urn:495:contract:harness-config:1",
  "additionalProperties": false
}
