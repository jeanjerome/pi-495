{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "control_id",
    "control_version",
    "requirement_refs",
    "subject",
    "protocol_revision",
    "environment",
    "inputs_digest",
    "started_at",
    "ended_at",
    "verdict",
    "facts",
    "findings",
    "artifacts",
    "limits",
    "baseline",
    "producer"
  ],
  "properties": {
    "control_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "control_version": {
      "type": "string"
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "revision"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "program",
            "increment",
            "change",
            "attempt",
            "candidate",
            "artifact",
            "protocol",
            "control",
            "component",
            "fixture",
            "reference",
            "build",
            "environment",
            "integration"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest, hex, prefixed"
        }
      },
      "$id": "urn:495:contract:subject-ref:1",
      "additionalProperties": false
    },
    "protocol_revision": {
      "type": "object",
      "required": [
        "protocol_id",
        "revision",
        "content_digest"
      ],
      "properties": {
        "protocol_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest, hex, prefixed"
        }
      },
      "$id": "urn:495:contract:protocol-ref:1",
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "environment_id",
        "digest",
        "profile_id"
      ],
      "properties": {
        "environment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest, hex, prefixed"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "$id": "urn:495:contract:environment-ref:1",
      "additionalProperties": false
    },
    "inputs_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest, hex, prefixed"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INDETERMINATE",
        "NOT_RUN",
        "NOT_APPLICABLE"
      ]
    },
    "facts": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "category",
          "severity",
          "message",
          "path",
          "region",
          "symbol",
          "requirement_refs",
          "baseline_state",
          "fingerprint",
          "tool",
          "tool_version",
          "confidence",
          "raw_evidence_ref"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "category": {
            "type": "string",
            "enum": [
              "assertion",
              "structure",
              "quality",
              "security",
              "performance",
              "scope",
              "protocol",
              "review",
              "incident"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "region": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "start_line",
                  "end_line",
                  "start_col",
                  "end_col"
                ],
                "properties": {
                  "start_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "start_col": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "end_col": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "requirement_id",
                "revision"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "baseline_state": {
            "type": "string",
            "enum": [
              "new",
              "preexisting",
              "removed",
              "unknown"
            ]
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "SHA-256 digest, hex, prefixed"
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tool_version": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "raw_evidence_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "algorithm",
                  "digest",
                  "size_bytes",
                  "media_type"
                ],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "const": "sha256"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "description": "SHA-256 digest, hex, prefixed"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "media_type": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "$id": "urn:495:contract:object-ref:1",
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "$id": "urn:495:contract:finding:1",
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "ref"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "ref": {
            "type": "object",
            "required": [
              "algorithm",
              "digest",
              "size_bytes",
              "media_type"
            ],
            "properties": {
              "algorithm": {
                "type": "string",
                "const": "sha256"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "SHA-256 digest, hex, prefixed"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "media_type": {
                "type": "string",
                "minLength": 1
              }
            },
            "$id": "urn:495:contract:object-ref:1",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "truncated",
        "bytes_read",
        "bytes_total",
        "exclusions",
        "unstable",
        "notes"
      ],
      "properties": {
        "truncated": {
          "type": "boolean"
        },
        "bytes_read": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unstable": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "baseline": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "reference_id",
            "reference_digest",
            "reference_verdict",
            "reference_evidence_id",
            "reused",
            "tolerance",
            "raw_verdict",
            "new_findings",
            "preexisting_findings",
            "removed_findings",
            "blocking_findings",
            "unstable",
            "confirmations",
            "notes"
          ],
          "properties": {
            "reference_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "reference_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "SHA-256 digest, hex, prefixed"
            },
            "reference_verdict": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "INDETERMINATE",
                "NOT_RUN",
                "NOT_APPLICABLE"
              ]
            },
            "reference_evidence_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "reused": {
              "type": "boolean"
            },
            "tolerance": {
              "type": "string",
              "enum": [
                "no_aggravation",
                "block_any"
              ]
            },
            "raw_verdict": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "INDETERMINATE",
                "NOT_RUN",
                "NOT_APPLICABLE"
              ]
            },
            "new_findings": {
              "type": "integer",
              "minimum": 0
            },
            "preexisting_findings": {
              "type": "integer",
              "minimum": 0
            },
            "removed_findings": {
              "type": "integer",
              "minimum": 0
            },
            "blocking_findings": {
              "type": "integer",
              "minimum": 0
            },
            "unstable": {
              "type": "boolean"
            },
            "confirmations": {
              "type": "integer",
              "minimum": 0
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "$id": "urn:495:contract:baseline-comparison:1",
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "actor_id",
        "actor_type",
        "role",
        "origin",
        "authentication_level"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "actor_type": {
          "type": "string",
          "enum": [
            "human",
            "kernel",
            "agent",
            "executor",
            "integrator",
            "extension",
            "system"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "origin": {
          "type": "string",
          "enum": [
            "tui_session",
            "rpc_qualified",
            "sdk_qualified",
            "json",
            "print",
            "model_output",
            "tool_call",
            "kernel",
            "executor",
            "system"
          ]
        },
        "authentication_level": {
          "type": "string",
          "enum": [
            "none",
            "session",
            "host_qualified"
          ]
        }
      },
      "$id": "urn:495:contract:actor-ref:1",
      "additionalProperties": false
    }
  },
  "$id": "urn:495:contract:evidence-candidate:1",
  "additionalProperties": false
}
