{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "change_id",
    "requirements",
    "answers",
    "assumptions",
    "contract_families"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "statement",
          "category",
          "mandatory",
          "criterion",
          "source",
          "contract_family",
          "satisfied_by_reference"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "contract_family": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "satisfied_by_reference": {
            "type": "boolean",
            "description": "the reference already exhibits this behaviour, so a suite that stays green proves it; false means the requirement needs a control that fails on the reference"
          }
        },
        "additionalProperties": false
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "question",
          "answer",
          "observable",
          "requirement_ids"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "observable": {
            "type": "boolean",
            "description": "the answer fixes something a control can observe — a status, a message, a bound"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract_families": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "string",
          "enum": [
            "covered",
            "not_applicable",
            "to_instruct"
          ]
        }
      }
    }
  },
  "$id": "urn:495:contract:requirements:1",
  "additionalProperties": false
}
