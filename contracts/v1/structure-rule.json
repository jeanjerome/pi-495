{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "rule_id",
    "kind",
    "statement",
    "scope",
    "forbidden"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": [
        "forbidden_dependency",
        "no_cycle"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$id": "urn:495:contract:structure-rule:1",
  "additionalProperties": false
}
