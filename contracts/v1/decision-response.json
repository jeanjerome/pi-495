{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "decision_id",
    "option_id",
    "free_text",
    "reason",
    "subject_revision",
    "scope",
    "expires_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "option_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "free_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_revision": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$id": "urn:495:contract:decision-response:1",
  "additionalProperties": false
}
