{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "title",
    "increments",
    "milestones",
    "global_requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "increments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "increment_id",
          "title",
          "value",
          "closure_criterion",
          "depends_on",
          "requirement_ids"
        ],
        "properties": {
          "increment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "closure_criterion": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "functional",
              "preparatory",
              "remediation"
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "milestone_id",
          "title",
          "increment_ids",
          "global_requirement_ids",
          "final"
        ],
        "properties": {
          "milestone_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "increment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1
          },
          "global_requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "final": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "global_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "scope_decision": {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$id": "urn:495:contract:trajectory:1",
  "additionalProperties": false
}
