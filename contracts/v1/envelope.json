{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "message_id",
    "operation_id",
    "correlation_id",
    "causation_id",
    "occurred_at",
    "producer",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "required": [
        "component",
        "version",
        "instance_id"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "payload": {}
  },
  "$id": "urn:495:contract:envelope:1",
  "additionalProperties": false
}
