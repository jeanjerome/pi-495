{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "operation_id",
    "idempotency_key",
    "operation_type",
    "subject",
    "expected_revision",
    "mandate_ref",
    "deadline",
    "inputs",
    "inputs_digest"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "operation_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "program",
            "increment",
            "change",
            "attempt",
            "candidate",
            "artifact",
            "protocol",
            "control",
            "component",
            "fixture",
            "build",
            "environment",
            "integration"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest, hex, prefixed"
        }
      },
      "$id": "urn:495:contract:subject-ref:1",
      "additionalProperties": false
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "mandate_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "deadline": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "inputs_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest, hex, prefixed"
    }
  },
  "$id": "urn:495:contract:operation-request:1",
  "additionalProperties": false
}
