{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol_id",
    "change_id",
    "controls",
    "qualifications",
    "capability_diagnosis",
    "obligations",
    "required_reviews",
    "arbitration",
    "environment_digest"
  ],
  "properties": {
    "protocol_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "version",
          "title",
          "command",
          "cwd",
          "env_allowlist",
          "env",
          "timeout_ms",
          "parser",
          "report_path",
          "network",
          "writable_paths",
          "requirement_refs",
          "protected",
          "protected_paths"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "description": "relative to the workspace root"
          },
          "env_allowlist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "string"
              }
            }
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "parser": {
            "type": "string",
            "enum": [
              "exit-code",
              "node-test",
              "junit-xml"
            ]
          },
          "report_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "network": {
            "type": "string",
            "enum": [
              "denied",
              "allowed"
            ]
          },
          "writable_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "requirement_id",
                "revision"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "protected": {
            "type": "boolean",
            "description": "the control definition files may not be modified by a producer"
          },
          "protected_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "$id": "urn:495:contract:control-definition:1",
        "additionalProperties": false
      }
    },
    "qualifications": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "positive",
            "negative",
            "incident",
            "qualified",
            "environment_digest",
            "notes"
          ],
          "properties": {
            "positive": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "INDETERMINATE",
                "NOT_RUN",
                "NOT_APPLICABLE"
              ]
            },
            "negative": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "INDETERMINATE",
                "NOT_RUN",
                "NOT_APPLICABLE"
              ]
            },
            "incident": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "INDETERMINATE",
                "NOT_RUN",
                "NOT_APPLICABLE"
              ]
            },
            "qualified": {
              "type": "boolean"
            },
            "environment_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "SHA-256 digest, hex, prefixed"
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_ids": {
              "type": "object",
              "required": [
                "positive",
                "negative",
                "incident"
              ],
              "properties": {
                "positive": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "negative": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "incident": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "capability_diagnosis": {
      "type": "object",
      "required": [
        "stack",
        "level",
        "test_files",
        "discovered",
        "executed",
        "undiscriminated_requirements",
        "unobserved_requirements",
        "notes"
      ],
      "properties": {
        "stack": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "none",
            "file_present",
            "discoverable",
            "executed",
            "discriminating"
          ]
        },
        "test_files": {
          "type": "integer",
          "minimum": 0
        },
        "discovered": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "executed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "undiscriminated_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "unobserved_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "mandatory",
          "control_ids",
          "combination",
          "human_interaction",
          "not_applicable_reason"
        ],
        "properties": {
          "requirement": {
            "type": "object",
            "required": [
              "requirement_id",
              "revision"
            ],
            "properties": {
              "requirement_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "mandatory": {
            "type": "boolean"
          },
          "control_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "combination": {
            "type": "string",
            "enum": [
              "all_pass",
              "any_pass",
              "human_decision"
            ]
          },
          "human_interaction": {
            "anyOf": [
              {
                "type": "string",
                "const": "IH-10"
              },
              {
                "type": "null"
              }
            ]
          },
          "not_applicable_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "required_reviews": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "arbitration": {
      "type": "string",
      "enum": [
        "human_decision",
        "reject"
      ]
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest, hex, prefixed"
    }
  },
  "$id": "urn:495:contract:protocol:1",
  "additionalProperties": false
}
