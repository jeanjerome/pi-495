{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol_id",
    "change_id",
    "controls",
    "qualifications",
    "capability_diagnosis",
    "obligations",
    "required_reviews",
    "arbitration",
    "baseline",
    "environment_digest"
  ],
  "properties": {
    "protocol_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "control_id",
          "version",
          "title",
          "command",
          "cwd",
          "env_allowlist",
          "env",
          "timeout_ms",
          "parser",
          "report_path",
          "structure_rules",
          "provides",
          "requires",
          "scope_argument",
          "network",
          "writable_paths",
          "requirement_refs",
          "protected",
          "protected_paths"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "cwd": {
            "type": "string",
            "description": "relative to the workspace root"
          },
          "env_allowlist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "string"
              }
            }
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "parser": {
            "type": "string",
            "enum": [
              "exit-code",
              "node-test",
              "junit-xml",
              "jest-json",
              "lcov",
              "jacoco-xml",
              "java-imports",
              "pitest-xml",
              "stryker-json",
              "pmd-xml",
              "cpd-xml"
            ]
          },
          "report_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "structure_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule_id",
                "kind",
                "statement",
                "scope",
                "forbidden"
              ],
              "properties": {
                "rule_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "forbidden_dependency",
                    "no_cycle"
                  ]
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "forbidden": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "$id": "urn:495:contract:structure-rule:1",
              "additionalProperties": false
            }
          },
          "quality_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule_id",
                "nature",
                "control_id",
                "reference",
                "threshold",
                "properties",
                "tool",
                "source",
                "established_on"
              ],
              "properties": {
                "rule_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "nature": {
                  "type": "string",
                  "enum": [
                    "complexity",
                    "dead_code",
                    "duplication"
                  ]
                },
                "control_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "reference": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "threshold": {
                  "type": "string",
                  "minLength": 1
                },
                "properties": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {
                      "type": "string"
                    }
                  }
                },
                "tool": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "established_on": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "additionalProperties": false
            }
          },
          "provides": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope_argument": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "network": {
            "type": "string",
            "enum": [
              "denied",
              "loopback",
              "allowed"
            ]
          },
          "writable_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "requirement_id",
                "revision"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "protected": {
            "type": "boolean",
            "description": "the control definition files may not be modified by a producer"
          },
          "protected_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "$id": "urn:495:contract:control-definition:1",
        "additionalProperties": false
      }
    },
    "qualifications": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "positive",
            "negative",
            "incident",
            "qualified",
            "environment_digest",
            "notes"
          ],
          "properties": {
            "positive": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "INDETERMINATE",
                "NOT_RUN",
                "NOT_APPLICABLE"
              ]
            },
            "negative": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "INDETERMINATE",
                "NOT_RUN",
                "NOT_APPLICABLE"
              ]
            },
            "incident": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "INDETERMINATE",
                "NOT_RUN",
                "NOT_APPLICABLE"
              ]
            },
            "qualified": {
              "type": "boolean"
            },
            "environment_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "SHA-256 digest, hex, prefixed"
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_ids": {
              "type": "object",
              "required": [
                "positive",
                "negative",
                "incident"
              ],
              "properties": {
                "positive": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "negative": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "incident": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "capability_diagnosis": {
      "type": "object",
      "required": [
        "stack",
        "level",
        "test_files",
        "discovered",
        "executed",
        "undiscriminated_requirements",
        "unobserved_requirements",
        "notes"
      ],
      "properties": {
        "stack": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "none",
            "file_present",
            "discoverable",
            "executed",
            "discriminating"
          ]
        },
        "test_files": {
          "type": "integer",
          "minimum": 0
        },
        "discovered": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "executed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "undiscriminated_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "unobserved_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "test_type",
              "tool",
              "version",
              "established_on",
              "source",
              "change"
            ],
            "properties": {
              "test_type": {
                "type": "string",
                "minLength": 1
              },
              "tool": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "established_on": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "change": {
                "type": "string",
                "minLength": 1
              },
              "edit": {
                "type": "object",
                "required": [
                  "path",
                  "current",
                  "wanted"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "current": {
                    "type": "string"
                  },
                  "wanted": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "install": {
                "type": "object",
                "required": [
                  "package",
                  "version",
                  "manager"
                ],
                "properties": {
                  "package": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "manager": {
                    "type": "string",
                    "enum": [
                      "npm",
                      "maven"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement",
          "mandatory",
          "control_ids",
          "combination",
          "human_interaction",
          "not_applicable_reason"
        ],
        "properties": {
          "requirement": {
            "type": "object",
            "required": [
              "requirement_id",
              "revision"
            ],
            "properties": {
              "requirement_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "mandatory": {
            "type": "boolean"
          },
          "control_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "combination": {
            "type": "string",
            "enum": [
              "all_pass",
              "any_pass",
              "human_decision"
            ]
          },
          "human_interaction": {
            "anyOf": [
              {
                "type": "string",
                "const": "IH-10"
              },
              {
                "type": "null"
              }
            ]
          },
          "not_applicable_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "required_reviews": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "arbitration": {
      "type": "string",
      "enum": [
        "human_decision",
        "reject"
      ]
    },
    "baseline": {
      "type": "object",
      "required": [
        "compare_to_reference",
        "tolerance",
        "instability",
        "max_confirmations"
      ],
      "properties": {
        "compare_to_reference": {
          "type": "boolean"
        },
        "tolerance": {
          "type": "string",
          "enum": [
            "no_aggravation",
            "block_any"
          ]
        },
        "instability": {
          "type": "string",
          "enum": [
            "confirm_then_indeterminate",
            "none"
          ]
        },
        "max_confirmations": {
          "type": "integer",
          "minimum": 0
        }
      },
      "$id": "urn:495:contract:baseline-policy:1",
      "additionalProperties": false
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest, hex, prefixed"
    },
    "complements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "digest",
          "test_type",
          "tool"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "SHA-256 digest, hex, prefixed"
          },
          "test_type": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "installed_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "integrity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "integrity": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "quality_referential": {
      "type": "object",
      "required": [
        "adopted_on",
        "decision_id",
        "rules"
      ],
      "properties": {
        "adopted_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "nature",
              "control_id",
              "reference",
              "threshold",
              "properties",
              "tool",
              "source",
              "established_on"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "nature": {
                "type": "string",
                "enum": [
                  "complexity",
                  "dead_code",
                  "duplication"
                ]
              },
              "control_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "reference": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "threshold": {
                "type": "string",
                "minLength": 1
              },
              "properties": {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "type": "string"
                  }
                }
              },
              "tool": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "established_on": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "perimeter": {
          "type": "object",
          "required": [
            "measured",
            "generated_annotations",
            "unmeasured"
          ],
          "properties": {
            "measured": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "module",
                  "root"
                ],
                "properties": {
                  "module": {
                    "type": "string",
                    "minLength": 1
                  },
                  "root": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "generated_annotations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "unmeasured": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "subject",
                  "reason"
                ],
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "urn:495:contract:protocol:1",
  "additionalProperties": false
}
