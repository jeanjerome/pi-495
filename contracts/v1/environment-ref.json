{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "environment_id",
    "digest",
    "profile_id"
  ],
  "properties": {
    "environment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest, hex, prefixed"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "$id": "urn:495:contract:environment-ref:1",
  "additionalProperties": false
}
