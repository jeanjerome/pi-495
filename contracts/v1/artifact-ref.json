{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "artifact_id",
    "revision",
    "content_digest",
    "schema_version"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest, hex, prefixed"
    },
    "schema_version": {
      "type": "number",
      "const": 1
    }
  },
  "$id": "urn:495:contract:artifact-ref:1",
  "additionalProperties": false
}
