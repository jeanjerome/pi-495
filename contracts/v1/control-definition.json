{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "control_id",
    "version",
    "title",
    "command",
    "cwd",
    "env_allowlist",
    "env",
    "timeout_ms",
    "parser",
    "report_path",
    "structure_rules",
    "provides",
    "requires",
    "scope_argument",
    "network",
    "writable_paths",
    "requirement_refs",
    "protected",
    "protected_paths"
  ],
  "properties": {
    "control_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "cwd": {
      "type": "string",
      "description": "relative to the workspace root"
    },
    "env_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "env": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "string"
        }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "parser": {
      "type": "string",
      "minLength": 1
    },
    "report_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "structure_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "kind",
          "statement",
          "scope",
          "forbidden"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "forbidden_dependency",
              "no_cycle"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "$id": "urn:495:contract:structure-rule:1",
        "additionalProperties": false
      }
    },
    "quality_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "nature",
          "control_id",
          "reference",
          "threshold",
          "properties",
          "tool",
          "source",
          "established_on"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "nature": {
            "type": "string",
            "enum": [
              "complexity",
              "dead_code",
              "duplication"
            ]
          },
          "control_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "reference": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "threshold": {
            "type": "string",
            "minLength": 1
          },
          "properties": {
            "type": "object",
            "patternProperties": {
              "^.*$": {
                "type": "string"
              }
            }
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "established_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "additionalProperties": false
      }
    },
    "architecture_map": {
      "type": "object",
      "required": [
        "parts",
        "relations"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "perimeter",
              "style",
              "roles",
              "hints"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "perimeter": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "style": {
                "type": "string",
                "enum": [
                  "layered",
                  "onion",
                  "simple",
                  "other"
                ]
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "package",
                    "role",
                    "hints"
                  ],
                  "properties": {
                    "package": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1
                    },
                    "called_by": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "hints": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "path",
                          "line",
                          "says"
                        ],
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "line": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "says": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "hints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "line",
                    "says"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "says": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "minItems": 1
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "hints"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "hints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "line",
                    "says"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "says": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "reading": {
          "type": "object",
          "required": [
            "data",
            "cross_cutting",
            "deployment"
          ],
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "statement",
                  "hints"
                ],
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hints": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "path",
                        "line",
                        "says"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "line": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "says": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "cross_cutting": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "statement",
                  "hints"
                ],
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hints": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "path",
                        "line",
                        "says"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "line": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "says": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "deployment": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "statement",
                  "hints"
                ],
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hints": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "path",
                        "line",
                        "says"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "line": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "says": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "$id": "urn:495:contract:architecture-map:1",
      "additionalProperties": false
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope_argument": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "network": {
      "type": "string",
      "enum": [
        "denied",
        "loopback",
        "allowed"
      ]
    },
    "writable_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "revision"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "protected": {
      "type": "boolean",
      "description": "the control definition files may not be modified by a producer"
    },
    "protected_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$id": "urn:495:contract:control-definition:1",
  "additionalProperties": false
}
