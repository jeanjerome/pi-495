{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "actor_id",
    "actor_type",
    "role",
    "origin",
    "authentication_level"
  ],
  "properties": {
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "human",
        "kernel",
        "agent",
        "executor",
        "integrator",
        "extension",
        "system"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "origin": {
      "type": "string",
      "enum": [
        "tui_session",
        "rpc_qualified",
        "sdk_qualified",
        "json",
        "print",
        "model_output",
        "tool_call",
        "kernel",
        "executor",
        "system"
      ]
    },
    "authentication_level": {
      "type": "string",
      "enum": [
        "none",
        "session",
        "host_qualified"
      ]
    }
  },
  "$id": "urn:495:contract:actor-ref:1",
  "additionalProperties": false
}
