{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "candidate_id",
    "manifest_digest",
    "base_digest",
    "workspace_id"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest, hex, prefixed"
    },
    "base_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest, hex, prefixed"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "$id": "urn:495:contract:candidate-ref:1",
  "additionalProperties": false
}
