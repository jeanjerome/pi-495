{
  "name": "pi-495",
  "version": "0.2.0",
  "description": "Evidence-gated harness for coding agents, inside Pi. The checks are frozen before the change exists; it is accepted on evidence, never on the agent's word.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Jean-Jerome Levy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeanjerome/pi-495.git"
  },
  "homepage": "https://github.com/jeanjerome/pi-495#readme",
  "bugs": {
    "url": "https://github.com/jeanjerome/pi-495/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "coding-agents",
    "ai-agents",
    "agent-harness",
    "harness-engineering",
    "agentic-coding",
    "llm-agents",
    "spec-driven-development",
    "test-driven-development",
    "mutation-testing",
    "human-in-the-loop",
    "code-review",
    "sandboxing",
    "verification",
    "local-llm",
    "ollama",
    "developer-tools",
    "typescript",
    "software-engineering"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/jeanjerome/pi-495/main/.github/assets/banner.jpg",
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "files": [
    "dist",
    "contracts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "test:v0": "node --test 'test/v0/**/*.test.ts'",
    "test:v1": "node --test 'test/v1/**/*.test.ts'",
    "test:v2": "node --test --test-concurrency=1 'test/v2/**/*.test.ts'",
    "test:v3": "node --test --test-concurrency=1 'test/v3/**/*.test.ts'",
    "contracts": "node scripts/emit-contracts.ts",
    "check": "npm run typecheck && npm run test && npm run lint:code && npm run lint:layers && npm run lint:architecture && npm run lint:exports && npm run lint:traceability && npm run lint:declarations && npm run lint:distribution && npm run lint:story-format",
    "lint:code": "biome check",
    "lint:layers": "node scripts/check-layers.ts",
    "lint:traceability": "node scripts/check-traceability.ts",
    "lint:architecture": "node scripts/check-architecture.ts",
    "lint:exports": "node scripts/check-exports.ts",
    "lint:declarations": "node scripts/check-declarations.ts",
    "lint:story-format": "node scripts/check-story-format.ts",
    "lint:distribution": "node scripts/check-distribution.ts",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^24.13.6",
    "fast-check": "^4.10.2",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xynogen/pix-pretty": "^1.26.0",
    "jiti": "^2.7.0"
  }
}
