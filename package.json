{
  "name": "harness-495",
  "version": "0.1.0",
  "description": "495 — development harness for Pi: gated, evidence-backed software changes driven from the Pi TUI and its other public entry points",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package",
    "harness",
    "software-engineering",
    "verification"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "files": [
    "dist",
    "contracts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "test:v0": "node --test 'test/v0/**/*.test.ts'",
    "test:v1": "node --test 'test/v1/**/*.test.ts'",
    "test:v2": "node --test --test-concurrency=1 'test/v2/**/*.test.ts'",
    "test:v3": "node --test --test-concurrency=1 'test/v3/**/*.test.ts'",
    "contracts": "node scripts/emit-contracts.ts",
    "check": "npm run typecheck && npm run test && npm run lint:code && npm run lint:layers && npm run lint:architecture && npm run lint:exports && npm run lint:traceability && npm run lint:distribution && npm run lint:story-format && npm run lint:capsule",
    "lint:code": "biome check",
    "lint:layers": "node scripts/check-layers.ts",
    "lint:traceability": "node scripts/check-traceability.ts",
    "lint:architecture": "node scripts/check-architecture.ts",
    "lint:exports": "node scripts/check-exports.ts",
    "lint:story-format": "node scripts/check-story-format.ts",
    "lint:distribution": "node scripts/check-distribution.ts",
    "lint:capsule": "node scripts/check-capsule.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@earendil-works/pi-tui": "^0.86.1",
    "@types/node": "^24.13.5",
    "fast-check": "^4.10.2",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2"
  }
}
