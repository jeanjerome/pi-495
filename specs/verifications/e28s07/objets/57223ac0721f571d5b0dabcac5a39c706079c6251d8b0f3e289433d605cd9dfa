{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BCeTWmKrzofjdmacGzW694","type":"tool_result","content":"// e28s07 acceptance: reads a dossier back read-only, from SQLite and the object store, never through 495.\n// Per change in creation order: phase/status/outcome and stop, the reference it surveys, the measurement it opened\n// (key and operation), its evidence and whether each document is in the object store, its survey artifact as stored,\n// the IH-10 requests still pending, and every event naming OPERATION_ACTIVE. Then the operations register.\n// Usage: node e28s07-lire.mjs <dossier>\nimport { existsSync, readFileSync } from \"node:fs\";\nimport { DatabaseSync } from \"node:sqlite\";\nconst d = process.argv[2];\nconst db = new DatabaseSync(`${d}/state.sqlite`, { readOnly: true });\nconst raw = (g) => { const [a, h] = g.split(\":\"); const p = `${d}/objects/${a}/${h.slice(0, 2)}/${h.slice(2)}`; return existsSync(p) ? readFileSync(p) : null; };\nconst first = new Map(db.prepare(\"select aggregate_id, min(sequence) s from events where aggregate_kind='change' group by aggregate_id\").all().map((r) => [r.aggregate_id, r.s]));\nconst changes = db.prepare(\"select change_id, revision, phase, status, outcome, state from changes\").all().sort((a, b) => first.get(a.change_id) - first.get(b.change_id));\nfor (const r of changes) {\n\tconst s = JSON.parse(r.state);\n\tconsole.log(`== change ${r.change_id} deliverable=${s.deliverable ?? \"candidate\"} r${r.revision} ${r.phase}/${r.status}/${r.outcome} stop=${s.stop_reason ?? \"-\"} ${s.stop_detail ?? \"\"}`);\n\tconsole.log(`  reference digest=${s.reference?.digest} git=${s.reference?.git_head ?? s.reference?.head ?? \"\"}`);\n\tconst evs = db.prepare(\"select sequence, type, payload from events where aggregate_id=? order by sequence\").all(r.change_id);\n\tfor (const e of evs) {\n\t\tconst p = JSON.parse(e.payload);\n\t\tif (e.type === \"operation.opened\" || e.type === \"operation.closed\") console.log(`  #${e.sequence} ${e.type} ${p.operation_id} ${p.kind ?? \"\"} ${p.idempotency_key ?? \"\"}`);\n\t\tif (e.type === \"gate.decided\" && p.decision?.gate === \"G5\") console.log(`  #${e.sequence} G5 ${p.decision.verdict} next=${p.decision.next_action} ${(p.decision.reasons ?? []).join(\" | \")}`);\n\t\tif (e.type === \"decision.recorded\") console.log(`  #${e.sequence} decision.recorded ${p.decision_id} option=${p.response?.option_id ?? p.option_id}`);\n\t}\n\tconst active = evs.filter((e) => e.payload.includes(\"OPERATION_ACTIVE\"));\n\tconsole.log(`  events=${evs.length}, events naming OPERATION_ACTIVE=${active.length}${active.length ? ` first: ${active[0].payload.slice(0, 300)}` : \"\"}`);\n\tfor (const v of db.prepare(\"select evidence_id, control_id, verdict, subject_digest, content_digest, document from evidence where change_id=? order by recorded_at\").all(r.change_id)) {\n\t\tconst doc = JSON.parse(v.document);\n\t\tconsole.log(`  evidence ${v.evidence_id} ${v.control_id} ${v.verdict} subject=${doc.subject.kind}:${doc.subject.id} ${v.subject_digest} run=${doc.facts?.run ?? \"-\"} passing=${JSON.stringify(doc.facts?.passing_cases ?? [])} ${(doc.artifacts ?? []).map((a) => { const b = raw(a.ref.digest); return `${a.name} in CAS=${b ? `yes ${JSON.stringify(b.toString(\"utf8\").slice(0, 60))}` : \"no\"}`; }).join(\" \")}`);\n\t}\n\tfor (const a of db.prepare(\"select artifact_id, revision, content_digest from artifacts where change_id=? and kind='survey'\").all(r.change_id)) {\n\t\tconst b = raw(a.content_digest);\n\t\tconst sv = b ? JSON.parse(b.toString(\"utf8\")) : null;\n\t\tconsole.log(`  survey ${a.artifact_id} r${a.revision} ${a.content_digest} in CAS=${b ? \"yes\" : \"no\"} change_id=${sv?.change_id} reference=${sv?.reference_digest} keys=${sv ? Object.keys(sv).join(\",\") : \"-\"}`);\n\t}\n\tfor (const q of db.prepare(\"select * from decision_requests where change_id=?\").all(r.change_id)) {\n\t\tconst answered = db.prepare(\"select count(*) n 