 jar_sha256: string; java: string };\n    48\t\tbudget: FormalManifest[\"budget\"];\n    49\t\tsandbox: string;\n    50\t\toutcome: TlcOutcome;\n    51\t\t/** Whether the run is the PASS of the model: completed, every required property checked. */\n    52\t\tpass: boolean;\n    53\t\treasons: string[];\n    54\t\tresult: TlcResult | null;\n    55\t\traw: { name: string; digest: string }[];\n    56\t}\n    57\t\n    58\tconst EXIT_OF: Record<TlcOutcome, number> = { completed: 0, counterexample: 1, inconclusive: 2, error: 3 };\n    59\t\n    60\tfunction sha256Of(path: string): string {\n    61\t\treturn `sha256:${createHash(\"sha256\").update(readFileSync(path)).digest(\"hex\")}`;\n    62\t}\n    63\t\n    64\tfunction isRecordOfStrings(value: unknown): value is Record<string, string> {\n    65\t\treturn typeof value === \"object\" && value !== null && Object.values(value).every((v) => typeof v === \"string\");\n    66\t}\n    67\t\n    68\tfunction positive(value: unknown): boolean {\n    69\t\treturn typeof value === \"number\" && Number.isInteger(value) && value > 0;\n    70\t}\n    71\t\n    72\t/** The manifest, or the first field that does not hold, named with the form it should take. */\n    73\tfunction manifestOf(text: string): FormalManifest {\n    74\t\tconst m = JSON.parse(text) as Partial<FormalManifest>;\n    75\t\tconst fault =\n    76\t\t\t(typeof m.model !== \"string\" && \"model: the .tla file of the root module\") ||\n    77\t\t\t(typeof m.config !== \"string\" && \"config: the .cfg file TLC is given\") ||\n    78\t\t\t(!isRecordOfStrings(m.files) && 'files: { \"<path>\": \"sha256:<hex>\" } for every file of the model') ||\n    79\t\t\t(!(Array.isArray(m.required_properties) && m.required_properties.length > 0) &&\n    80\t\t\t\t\"required_properties: the invariants and properties the exploration must check, at least one\") ||\n    81\t\t\t(!(m.tool?.name === \"TLC\" && typeof m.tool.version === \"string\" && typeof m.tool.jar_sha256 === \"string\") &&\n    82\t\t\t\t'tool: { \"name\": \"TLC\", \"version\": \"<as TLC prints it>\", \"jar_sha256\": \"sha256:<hex>\" }') ||\n    83\t\t\t(!(\n    84\t\t\t\tpositive(m.budget?.timeout_ms) &&\n    85\t\t\t\tpositive(m.budget?.max_output_bytes) &&\n    86\t\t\t\tpositive(m.budget?.workers) &&\n    87\t\t\t\tpositive(m.budget?.heap_mb)\n    88\t\t\t) &&\n    89\t\t\t\t\"budget: positive integers timeout_ms, max_output_bytes, workers and heap_mb\");\n    90\t\tif (fault) throw new Error(`the manifest does not hold: ${fault}`);\n    91\t\treturn m as FormalManifest;\n    92\t}\n    93\t\n    94\t/** Why the model on disk is not the one the manifest approved, or null when it is. */\n    95\tfunction unapprovedFiles(manifest: FormalManifest, directory: string): string | null {\n    96\t\tfor (const file of [manifest.model, manifest.config])\n    97\t\t\tif (!(file in manifest.files)) return `${file} is not among the files the manifest pins`;\n    98\t\tfor (const [file, approved] of Object.entries(manifest.files)) {\n    99\t\t\tconst path = join(directory, file);\n   100\t\t\tif (!existsSync(path)) return `${file} is absent from ${directory}`;\n   101\t\t\tconst actual = sha256Of(path);\n   102\t\t\tif (actual !== approved) return `${file} is ${actual}, the manifest approves ${approved}`;\n   103\t\t}\n   104\t\treturn null;\n   105\t}\n   106\t\n   107\t/** Why the jar cannot be run as the approved TLC, said with what to provide, or null when it can. */\n   108\tfunction missingTool(manifest: FormalManifest, jar: string | undefined): string | null {\n   109\t\tconst approved = `TLC ${manifest.tool.version}, ${manifest.tool.jar_sha256}`;\n   110\t\tif (jar === undefined) return `no tla2tools.jar named: pass --jar <path> to the jar of ${approved}`;\n   111\t\tif (!existsSync(jar)) return `no tla2tools.jar at ${jar}: pass --jar <path> to the jar of ${approved}`;\n   112\t\tconst actual = sha256Of(jar);\n   113\t\tif (actual !== manifest.tool.jar_sha256) return `the jar at ${jar} is ${actual}, not the approved ${approved}`;\n   114\t\treturn null;\n   115\t}\n   116\t\n   117\t/** A completed exploration that left a required property unchecked proves less than the manifest asks. */\n   118\tfunction normalised(result: TlcResult, required: readonly string[]): { outcome: TlcOutcome; reasons: string[] } {\n   119\t\tif (result.outcome !== \"completed\") return { outcome: result.outcome, reasons: result.reasons };\n   120\t\tconst unchecked = required.filter((name) => !result.properties.some((p) => p.name === name && p.verified));\n   121\t\treturn unchecked.length === 0\n   122\t\t\t? { outcome: \"completed\", reasons: [] }\n   123\t\t\t: { outcome: \"error\", reasons: [`the configuration does not activate the required ${unchecked.join(\", \")}`] };\n   124\t}\n   125\t\n   126\tasync function explore(\n   127\t\tmanifestPath: string,\n   128\t\toptions: { jar: string | undefined; java: string; store: CasObjectStore },\n   129\t): Promise<FormalReport> {\n   130\t\tconst text = readFileSync(manifestPath, \"utf8\");\n   131\t\tconst manifest = manifestOf(text);\n   132\t\tconst directory = dirname(manifestPath);\n   133\t\tconst report = (\n   134\t\t\toutcome: TlcOutcome,\n   135\t\t\treasons: string[],\n   136\t\t\tresult: TlcResult | null = null,\n   137\t\t\traw: FormalReport[\"raw\"] = [],\n   138\t\t): FormalReport => ({\n   139\t\t\tmanifest: { path: manifestPath, sha256: `sha256:${createHash(\"sha256\").update(text).digest(\"hex\")}` },\n   140\t\t\tmodel: manifest.model,\n   141\t\t\tconfig: manifest.config,\n   142\t\t\tfiles: manifest.files,\n   143\t\t\trequired_properties: manifest.required_properties,\n   144\t\t\ttool: { ...manifest.tool, jar: options.jar ?? \"\", java: options.java },\n   145\t\t\tbudget: manifest.budget,\n   146\t\t\tsandbox: \"unconfined\",\n   147\t\t\toutcome,\n   148\t\t\tpass: outcome === \"completed\",\n   149\t\t\treasons,\n   150\t\t\tresult,\n   151\t\t\traw,\n   152\t\t});\n   153\t\tconst tool = missingTool(manifest, options.jar);\n   154\t\tif (tool !== null) return report(\"error\", [`capability missing: ${tool}`]);\n   155\t\tconst files = unapprovedFiles(manifest, directory);\n   156\t\tif (files !== null) return report(\"error\", [`the model is not the approved one: ${files}`]);\n   157\t\n   158\t\tconst work = mkdtempSync(join(tmpdir(), \"495-formal-\"));\n   159\t\ttry {\n   160\t\t\tfor (const file of Object.keys(manifest.files)) {\n   161\t\t\t\tmkdirSync(dirname(join(work, file)), { recursive: true });\n   162\t\t\t\tcopyFileSync(join(directory, file), join(work, file));\n   163\t\t\t}\n   164\t\t\tmkdirSync(join(work, \"tmp\"));\n   165\t\t\tconst { budget } = manifest;\n   166\t\t\tconst runner = new GenericControlRunner(new UnconfinedSandbox(), options.store, readersOf([]), {\n   167\t\t\t\tmax_output_bytes: budget.max_output_bytes,\n   168\t\t\t});\n   169\t\t\tconst identity = digestValue(manifest.files);\n   170\t\t\tconst { evidence } = await runner.runControl({\n   171\t\t\t\tcontrol: {\n   172\t\t\t\t\tcontrol_id: `tlc-${basename(manifest.model, \".tla\")}`,\n   173\t\t\t\t\tversion: manifest.tool.version,\n   174\t\t\t\t\ttitle: `TLC on ${manifest.model}`,\n   175\t\t\t\t\tcommand: [\n   176\t\t\t\t\t\toptions.java,\n   177\t\t\t\t\t\t`-Xmx${budget.heap_mb}m`,\n   178\t\t\t\t\t\t// TLC writes the standard modules it reads out of its jar there: they stay in the disposable copy.\n   179\t\t\t\t\t\t`-Djava.io.tmpdir=${join(work, \"tmp\")}`,\n   180\t\t\t\t\t\t\"-XX:+UseParallelGC\",\n   181\t\t\t\t\t\t\"-cp\",\n   182\t\t\t\t\t\tresolve(options.jar ?? \"\"),\n   183\t\t\t\t\t\t\"tlc2.TLC\",\n   184\t\t\t\t\t\t\"-tool\",\n   185\t\t\t\t\t\t\"-workers\",\n   186\t\t\t\t\t\tString(budget.workers),\n   187\t\t\t\t\t\t\"-metadir\",\n   188\t\t\t\t\t\t\"states\",\n   189\t\t\t\t\t\t\"-config\",\n   190\t\t\t\t\t\tmanifest.config,\n   191\t\t\t\t\t\tmanifest.model,\n   192\t\t\t\t\t],\n   193\t\t\t\t\tcwd: \".\",\n   194\t\t\t\t\tenv_allowlist: [\"PATH\", \"HOME\", \"JAVA_HOME\"],\n   195\t\t\t\t\tenv: {},\n   196\t\t\t\t\ttimeout_ms: budget.timeout_ms,\n   197\t\t\t\t\tparser: \"tlc\",\n   198\t\t\t\t\treport_path: null,\n   199\t\t\t\t\tstructure_rules: [],\n   200\t\t\t\t\tprovides: [],\n   201\t\t\t\t\trequires: [],\n   202\t\t\t\t\tscope_argument: null,\n   203\t\t\t\t\tnetwork: \"denied\",\n   204\t\t\t\t\twritable_paths: [work],\n   205\t\t\t\t\trequirement_refs: [],\n   206\t\t\t\t\tprotected: true,\n   207\t\t\t\t\tprotected_paths: [],\n   208\t\t\t\t},\n   209\t\t\t\tprotocol: { protocol_id: \"formal\", revision: 1, content_digest: digestValue(manifest) },\n   210\t\t\t\tcandidate: { candidate_id: \"model\", manifest_digest: identity, base_digest: identity, workspace_id: work },\n   211\t\t\t\t// The subject is the model, an artifact: what TLC establishes is never said of a program candidate.\n   212\t\t\t\tsubject: { kind: \"artifact\", id: basename(manifest.model, \".tla\"), revision: 1, digest: identity },\n   213\t\t\t\tworkspace_path: work,\n   214\t\t\t\tenvironment: { environment_id: \"formal\", digest: digestValue({ java: options.java }), profile_id: \"verify\" },\n   215\t\t\t\trequirement_refs: [],\n   216\t\t\t\tproducer: {\n   217\t\t\t\t\tactor_id: \"check-formal\",\n   218\t\t\t\t\tactor_type: \"executor\",\n   219\t\t\t\t\trole: \"executor\",\n   220\t\t\t\t\torigin: \"executor\",\n   221\t\t\t\t\tauthentication_level: \"host_qualified\",\n   222\t\t\t\t},\n   223\t\t\t});\n   224\t\t\tconst raw = evidence.artifacts.map((a) => ({ name: a.name, digest: a.ref.digest }));\n   225\t\t\tconst result = evidence.facts.tlc as TlcResult | undefined;\n   226\t\t\tif (result === undefined) return report(\"error\", evidence.limits.notes, null, raw);\n   227\t\t\tconst { outcome, reasons } = normalised(result, manifest.required_properties);\n   228\t\t\treturn report(outcome, reasons, result, raw);\n   229\t\t} finally {\n   230\t\t\trmSync(work, { recursive: true, force: true });\n   231\t\t}\n   232\t}\n   233\t\n   234\tfunction printed(report: FormalReport, stored: string): string {\n   235\t\tconst result = report.result;\n   236\t\tconst lines = [\n   237\t\t\t`${report.model} with ${report.config}: ${report.outcome}${report.pass ? \" — PASS for the model under its bounds\" : \" — not PASS\"}`,\n   238\t\t\t...report.reasons.map((reason) => `  ${reason}`),\n   239\t\t\t`tool: TLC ${result?.tool.version ?? report.tool.version}, jar ${report.tool.jar_sha256}, java ${report.tool.java}`,\n   240\t\t\t`files: ${Object.entries(report.files)\n   241\t\t\t\t.map(([file, digest]) => `${file} ${digest}`)\n   242\t\t\t\t.join(\", \")}`,\n   243\t\t\t`required: ${report.required_properties.join(\", \")}`,\n   244\t\t\t`budget: ${report.budget.timeout_ms} ms, ${report.budget.max_output_bytes} bytes of output, ${report.budget.workers} worker(s), ${report.budget.heap_mb} MB of heap; sandbox ${report.sandbox}`,\n   245\t\t\t...(result ? explored(result) : []),\n   246\t\t\t...report.raw.map((a) => `raw ${a.name}: ${a.digest}`),\n   247\t\t\t`report: ${stored}`,\n   248\t\t];\n   249\t\treturn lines.join(\"\\n\");\n   250\t}\n   251\t\n   252\t/** What TLC's own output establishes: properties, bounds, assumptions, modules, search and counterexample. */\n   253\tfunction explored(result: TlcResult): string[] {\n   254\t\tconst lines = [\n   255\t\t\t`properties: ${result.properties.map((p) => `${p.name} (${p.kind}) ${p.verified ? \"verified\" : \"not verified\"}`).join(\", \") || \"none\"}`,\n   256\t\t\t`bounds: ${\n   257\t\t\t\tObject.entries(result.bounds)\n   258\t\t\t\t\t.map(([name, value]) => `${name} = ${value}`)\n   259\t\t\t\t\t.join(\", \") || \"none\"\n   260\t\t\t}`,\n   261\t\t\t`assumptions: ${result.assumptions.join(\"; \") || \"none\"}`,\n   262\t\t\t`modules: ${result.modules.join(\", \")}`,\n   263\t\t\t`search: ${result.exhaustive ? \"exhaustive breadth-first\" : \"not exhaustive\"}; states: ${result.states ? `${result.states.generated} generated