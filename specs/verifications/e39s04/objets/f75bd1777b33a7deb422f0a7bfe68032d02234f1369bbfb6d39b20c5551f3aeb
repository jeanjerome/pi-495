{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0118B7tfcqAfXGaVyY8iTixj","type":"tool_result","content":"/**\n * The part of `specs/bugs/registry.yaml` the cycle reads and writes: the defects still open with\n * their severity, those a branch records with the severity the arbitration retains for them, and a\n * defect marked fixed once the story that repairs it has landed. The registry\n * has one `- bug_id:` line per entry and one line per scalar field, so it is read line by line, as\n * the plan is.\n */\nimport { existsSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { contenuA } from \"./git.ts\";\n\nexport type Gravite = \"low\" | \"medium\" | \"high\";\n\nexport interface Defaut {\n\tid: string;\n\tgravite: Gravite;\n\ttitre: string;\n}\n\nconst ENTREE = /^ {2}- bug_id: (BUG-\\S+)\\s*$/;\nconst CHAMP = /^ {4}(severity|status|title): (.+?)\\s*$/;\nconst ORDRE: Record<string, number> = { low: 0, medium: 1, high: 2 };\n\nfunction chemin(root: string): string {\n\treturn join(root, \"specs\", \"bugs\", \"registry.yaml\");\n}\n\ntype Entree = Defaut & { statut: string; texte: string };\n\n/** The lines of a registry text before its first entry, and the lines of each entry, up to the next one. */\nfunction decouper(texte: string): { preambule: string[]; blocs: string[][] } {\n\tconst preambule: string[] = [];\n\tconst blocs: string[][] = [];\n\tfor (const ligne of texte.split(\"\\n\")) {\n\t\tif (ENTREE.test(ligne)) blocs.push([ligne]);\n\t\telse (blocs.at(-1) ?? preambule).push(ligne);\n\t}\n\treturn { preambule, blocs };\n}\n\n/** Every entry of a registry text, in the order it lists them, with its text without the blank lines that end it. */\nfunction entrees(texte: string): Entree[] {\n\treturn decouper(texte).blocs.map((bloc) => {\n\t\tconst courant: Entree = { id: ENTREE.exec(bloc[0]!)![1]!, gravite: \"low\", titre: \"\", statut: \"\", texte: \"\" };\n\t\tfor (const ligne of bloc) {\n\t\t\tconst c = CHAMP.exec(ligne);\n\t\t\tif (!c) continue;\n\t\t\tif (c[1] === \"severity\") courant.gravite = c[2] as Gravite;\n\t\t\telse if (c[1] === \"status\") courant.statut = c[2]!;\n\t\t\telse courant.titre = c[2]!.replace(/^\"(.*)\"$/, \"$1\");\n\t\t}\n\t\tcourant.texte = bloc.join(\"\\n\").trimEnd();\n\t\treturn courant;\n\t});\n}\n\n/** The defects still open whose severity is at least `seuil`, most severe first, oldest first within a severity. */\nexport function defautsOuverts(root: string, seuil: Gravite): Defaut[] {\n\tif (!existsSync(chemin(root))) return [];\n\treturn entrees(readFileSync(chemin(root), \"utf8\"))\n\t\t.filter((d) => d.statut === \"open\" && (ORDRE[d.gravite] ?? 0) >= ORDRE[seuil]!)\n\t\t.map(({ statut: _statut, texte: _texte, ...d }) => d)\n\t\t.sort((a, b) => (ORDRE[b.gravite] ?? 0) - (ORDRE[a.gravite] ?? 0));\n}\n\n/**\n * Tells, for each entry of `texte`, whether the registry at `base` carried it as written. An entry is matched on its\n * whole text, each entry of the base once: an identifier the base already carries does not make a new entry old.\n */\nfunction connuesA(root: string, base: string, texte: string): boolean[] {\n\tconst aLaBase = entrees(contenuA(root, base, \"specs/bugs/registry.yaml\") ?? \"\").map((d) => d.texte);\n\treturn entrees(texte).map((d) => {\n\t\tconst i = aLaBase.indexOf(d.texte);\n\t\tif (i >= 0) aLaBase.splice(i, 1);\n\t\treturn i >= 0;\n\t});\n}\n\n/** The defects the registry carries at the head and did not carry, as written, at `base`: those the branch records. */\nexport function defautsInscrits(root: string, base: string): Defaut[] {\n\tif (!existsSync(chemin(root))) return [];\n\tconst texte = readFileSync(chemin(root), \"utf8\");\n\tconst connues = connuesA(root, base, texte);\n\treturn entrees(texte)\n\t\t.filter((_d, i) => !connues[i])\n\t\t.map(({ statut: _statut, texte: _texte, ...d }) => d);\n}\n\n/** One defect as a line of a list read by the owner or a session: its identifier, its severity, its title. */\nexport function ligneDeDefaut(d: Defaut): string {\n\treturn `- ${d.id} (${d.gravite}) : ${d.titre}`;\n}\n\n/**\n * Writes `gravite` as the one severity of every entry `id` the registry did not carry, as written, at `base`: the\n * entries the branch records under that identifier, and none the base already carried under it.\n */\nexport function fixerGravite(root: string, base: string, id: string, gravite: Gravite): void {\n\tconst fichier = chemin(root);\n\tconst texte = readFileSync(fichier, \"utf8\");\n\tconst connues = connuesA(root, base, texte);\n\tconst { preambule, blocs } = decouper(texte);\n\tconst visees = blocs.filter((bloc, i) => !connues[i] && ENTREE.exec(bloc[0]!)?.[1] === id);\n\tif (visees.length === 0) throw new Error(`specs/bugs/registry.yaml: ${id} not found among the entries of the branch`);\n\tfor (const bloc of visees) {\n\t\tconst premiere = bloc.findIndex((l) => l.startsWith(\"    severity: \"));\n\t\tconst sans = bloc.filter((l) => !l.startsWith(\"    severity: \"));\n\t\tconst fin = sans.findLastIndex((l) => l !== \"\") + 1;\n\t\tsans.splice(premiere >= 0 ? premiere : fin, 0, `    severity: ${gravite}`);\n\t\tbloc.splice(0, bloc.length, ...sans);\n\t}\n\twriteFileSync(fichier, [...preambule, ...blocs.flat()].join(\"\\n\"));\n}\n\n/** The registry entry a correction story cites: the first identifier of the kind the registry writes. */\nexport function defautDeLaStory(markdown: string): string | null {\n\treturn /BUG-\\d{4}-\\d{2}-\\d{2}T\\d{6}/.exec(markdown)?.[0] ?? null;\n}\n\n/** Where an entry goes once fixed: the registry keeps the open defects only. */\nfunction cheminArchive(root: string): string {\n\treturn join(root, \"specs\", \"bugs\", \"registry-fixed.yaml\");\n}\n\n/** Moves an open entry to the archive of fixed defects, marked fixed at the revision that fixed it. */\nexport function marquerCorrige(root: string, id: string, sha: string): void {\n\tconst fichier = chemin(root);\n\tconst lignes = readFileSync