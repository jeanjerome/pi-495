rom \"./verification-contract.ts\";\n    24\t\n    25\t/**\n    26\t * What an exploration ended on, read from the exit status of `scripts/check-formal.ts`; a run killed\n    27\t * before its end, its exit status null, is inconclusive.\n    28\t */\n    29\ttype IssueExploration = \"completed\" | \"counterexample\" | \"inconclusive\" | \"error\";\n    30\t\n    31\tconst ISSUE_DU_CODE: Record<number, IssueExploration> = { 0: \"completed\", 1: \"counterexample\", 2: \"inconclusive\" };\n    32\t\n    33\t/** How many lines of an exploration's output the account of a block carries; the rest is in the trace. */\n    34\tconst LIGNES_CITEES = 12;\n    35\t\n    36\t/** One exploration of the preparation: its manifest, its outcome, and its output kept in the object store. */\n    37\tinterface Resultat {\n    38\t\tmanifeste: string;\n    39\t\tissue: IssueExploration;\n    40\t\ttrace: ObjectRef | null;\n    41\t}\n    42\t\n    43\tinterface Examen {\n    44\t\tverte: boolean;\n    45\t\t/** Why the preparation does not hold, said for whoever revises it; empty when it holds. */\n    46\t\tmotif: string;\n    47\t\tresultats: Resultat[];\n    48\t}\n    49\t\n    50\t/** What the examination needs from the conductor: the story, a way to run a control, and to read its output. */\n    51\tinterface Outillage {\n    52\t\troot: string;\n    53\t\tstory: Story;\n    54\t\t/** The control that explores the model a manifest pins. */\n    55\t\texploration: (manifeste: string) => Controle;\n    56\t\tlancer: (c: Controle) => Promise<Preuve>;\n    57\t\tlire: (digest: string) => Promise<string | null>;\n    58\t}\n    59\t\n    60\t/** The preparation the red-green starts from: its account for the prompt, or the block it says. */\n    61\ttype Preparation = { verte: true; resume: string } | { verte: false; motif: string };\n    62\t\n    63\tfunction bloquee(texte: string, resultats: Resultat[] = []): Examen {\n    64\t\treturn {\n    65\t\t\tverte: false,\n    66\t\t\tmotif: `la préparation ne tient pas : la story revient à la préparation, aucune session de rouge-vert n'est lancée.\\n${texte}`,\n    67\t\t\tresultats,\n    68\t\t};\n    69\t}\n    70\t\n    71\t/** The state models the companion keeps, by manifest. */\n    72\tfunction manifestesRetenus(story: Story): string[] {\n    73\t\tconst manifestes = new Set<string>();\n    74\t\tfor (const p of story.verification?.promesses ?? [])\n    75\t\t\tfor (const m of p.moyens)\n    76\t\t\t\tif (m.retenu && m.moyen === \"modele-d-etats\") for (const f of m.manifestes) manifestes.add(f);\n    77\t\treturn [...manifestes];\n    78\t}\n    79\t\n    80\t/** The means the companion keeps that no run of the cycle can settle. */\n    81\tfunction indetermines(story: Story): string[] {\n    82\t\tconst trouves: string[] = [];\n    83\t\tfor (const p of story.verification?.promesses ?? [])\n    84\t\t\tfor (const m of p.moyens.filter((x) => x.retenu)) {\n    85\t\t\t\tif (m.moyen === \"modele-d-etats\" && m.manifestes.length === 0)\n    86\t\t\t\t\ttrouves.push(\n    87\t\t\t\t\t\t`« ${p.scenario} » : modèle d'états retenu sans manifeste ; attendu : le manifeste que TLC explore`,\n    88\t\t\t\t\t);\n    89\t\t\t\tif (m.moyen === \"preuve-lean\")\n    90\t\t\t\t\ttrouves.push(`« ${p.scenario} » : preuve Lean retenue, et le cycle n'a pas de contrôle Lean à lancer`);\n    91\t\t\t}\n    92\t\treturn trouves;\n    93\t}\n    94\t\n    95\tfunction issueDe(preuve: Preuve): IssueExploration {\n    96\t\tconst code = preuve.facts.exit_code;\n    97\t\tif (typeof code !== \"number\") return \"inconclusive\";\n    98\t\treturn ISSUE_DU_CODE[code] ?? \"error\";\n    99\t}\n   100\t\n   101\t/** One exploration that did not complete: its manifest, its outcome, the trace it left and its first lines. */\n   102\tasync function compteRendu(o: Outillage, r: Resultat): Promise<string> {\n   103\t\tif (!r.trace) return `- ${r.manifeste} : ${r.issue}, sans sortie`;\n   104\t\tconst sortie = (await o.lire(r.trace.digest)) ?? \"\";\n   105\t\tconst lignes = sortie.split(\"\\n\").filter((l) => l.trim() !== \"\");\n   106\t\t// The outcome line, then the counterexample's states when there are any: the header between them —\n   107\t\t// tool, files, budget — is in the trace.\n   108\t\tconst debut = lignes.findIndex((l) => l.startsWith(\"counterexample to \"));\n   109\t\tconst citees = debut > 0 ? [lignes[0] ?? \"\", ...lignes.slice(debut)] : lignes;\n   110\t\tconst extrait = citees.slice(0, LIGNES_CITEES).map((l) => `    ${l}`);\n   111\t\tconst omises = lignes.length - extrait.length;\n   112\t\tif (omises > 0) extrait.push(`    … ${omises} ligne(s) de plus dans la trace`);\n   113\t\treturn [`- ${r.manifeste} : ${r.issue}, trace ${r.trace.digest}`, ...extrait].join(\"\\n\");\n   114\t}\n   115\t\n   116\t/** Examines the preparation of a story that has a companion: its diagnostic, then each upstream means it keeps. */\n   117\tasync function examiner(o: Outillage): Promise<Examen> {\n   118\t\tconst diagnostic = o.story.verification;\n   119\t\tif (diagnostic && !diagnostic.prete) return bloquee(resumeDeVerification(diagnostic, o.root));\n   120\t\tconst indetermine = indetermines(o.story);\n   121\t\tif (indetermine.length > 0) return bloquee(`exploration indéterminée :\\n${indetermine.join(\"\\n\")}`);\n   122\t\tconst resultats: Resultat[] = [];\n   123\t\tfor (const manifeste of manifestesRetenus(o.story)) {\n   124\t\t\tconst preuve = await o.lancer(o.exploration(manifeste));\n   125\t\t\tconst trace = preuve.artifacts.find((a) => a.name === \"stdout\")?.ref ?? null;\n   126\t\t\tresultats.push({ manifeste, issue: issueDe(preuve), trace });\n   127\t\t}\n   128\t\tconst echecs = resultats.filter((r) => r.issue !== \"completed\");\n   129\t\tif (echecs.length === 0) return { verte: true, motif: \"\", resultats };\n   130\t\tconst comptes = await Promise.all(echecs.map((r) => compteRendu(o, r)));\n   131\t\treturn bloquee(`une propriété requise n'est pas établie par le modèle adopté :\\n${comptes.join(\"\\n\")}`, resultats);\n   132\t}\n   133\t\n   134\tfunction sha256(chemin: string): string | null {\n   135\t\treturn existsSync(chemin) ? `sha256:${createHash(\"sha256\").update(readFileSync(chemin)).digest(\"hex\")}` : null;\n   136\t}\n   137\t\n   138\t/** Every file of a model, the manifest, its model, its configuration and the files it pins, by path from the root. */\n   139\tfunction fichiersDuModele(root: string, manifeste: string): string[] {\n   140\t\tconst fichiers = new Set([manifeste]);\n   141\t\ttry {\n   142\t\t\tconst m = JSON.parse(readFileSync(join(root, manifeste), \"utf8\")) as Record<string, unknown>;\n   143\t\t\tconst epingles = m.files && typeof m.files === \"object\" ? Object.keys(m.files) : [];\n   144\t\t\tfor (const f of [m.model, m.config, ...epingles])\n   145\t\t\t\tif (typeof f === \"string\") fichiers.add(join(dirname(manifeste), f));\n   146\t\t} catch {\n   147\t\t\t// An unreadable manifest counts by its own digest; its exploration says what is wrong with it.\n   148\t\t}\n   149\t\treturn [...fichiers];\n   150\t}\n   151\t\n   152\t/**\n   153\t * What a preparation is the preparation of, part by part: the companion, the promises and the security of\n   154\t * the story, and every file of the models it explores, each with its digest, null for a file that is\n   155\t * absent. A change to any part is a revision of the rule, and gives the preparation a new identity.\n   156\t */\n   157\tfunction composantesDe(root: string, story: Story): Record<string, string | null> {\n   158\t\tconst composantes: Record<string, string | null> = {\n   159\t\t\tcompagnon: sha256(cheminDuCompagnon(story.chemin)),\n   160\t\t\tpromesses: digestValue(story.promesses),\n   161\t\t\tsecurite: digestValue(story.securite),\n   162\t\t};\n   163\t\tfor (const manifeste of manifestesRetenus(story))\n   164\t\t\tfor (const f of fichiersDuModele(root, manifeste)) composantes[f] = sha256(join(root, f));\n   165\t\treturn composantes;\n   166\t}\n   167\t\n   168\t/** The parts whose digest differs between two preparations, those of the new one first. */\n   169\tfunction changements(avant: Record<string, unknown>, apres: Record<string, string | null>): string[] {\n   170\t\tconst noms = new Set([...Object.keys(apres), ...Object.keys(avant)]);\n   171\t\treturn [...noms].filter((n) => avant[n] !== apres[n]);\n   172\t}\n   173\t\n   174\t/** The bounded account a red-green prompt receives: the fingerprint and the objects it cites, never their content. */\n   175\tfunction resume(e: Evenement, reprise: string | null): string {\n   176\t\tconst resultats = (e.resultats as Resultat[] | undefined) ?? [];\n   177\t\treturn [\n   178\t\t\t`préparation verte, empreinte ${String(e.empreinte)}`,\n   179\t\t\t...resultats.map((r) => `- ${r.manifeste} : ${r.issue}, sortie ${r.trace?.digest ?? \"aucune\"}`),\n   180\t\t\t...(reprise ? [reprise] : []),\n   181\t\t].join(\"\\n\");\n   182\t}\n   183\t\n   184\t/** Whether the story was sent back to the red-green since its preparation was last examined or cited. */\n   185\tfunction rouverteDepuis(journal: Journal): boolean {\n   186\t\tconst events = journal.lire();\n   187\t\tconst preparation = events.findLastIndex((e) => e.genre.startsWith(\"preparation\"));\n   188\t\treturn preparation >= 0 && events.findLastIndex((e) => e.genre === \"rouvert\") > preparation;\n   189\t}\n   190\t\n   191\tconst CORRECTION_DE_CODE =\n   192\t\t\"reprise : correction de code — la préparation tient telle qu'examinée ; corrige le code, sans retoucher les règles adoptées ni affaiblir un test\";\n   193\t\n   194\t/**\n   195\t * The preparation of the story at the threshold of the red-green. A story without a companion is on the\n   196\t * cycle it had and leaves no record. A preparation of the same identity, when one was recorded, is cited,\n   197\t * and a story reopened since is a code correction; a different identity withdraws the previous\n   198\t * preparation — a revision of the rule — and the new one is examined and recorded once.\n   199\t */\n   200\texport async function preparer(o: Outillage, journal: Journal): Promise<Preparation> {\n   201\t\tif (!o.story.verification) return { verte: true, resume: \"aucune : la story n'a pas de compagnon de vérification\" };\n   202\t\tconst composantes = composantesDe(o.root, o.story);\n   203\t\tconst empreinte = digestValue(composantes);\n   204\t\tconst precedente = journal.dernier(\"preparation\");\n   205\t\tlet e: Evenement;\n   206\t\tlet reprise: string | null = null;\n   207\t\tif (precedente?.empreinte === empreinte) {\n   208\t\t\tconst code = rouverteDepuis(journal);\n   209\t\t\tjournal.inscrire(\"rouge-vert\", \"preparation-retenue\", {\n   210\t\t\t\tempreinte,\n   211\t\t\t\t...(code ? { reprise: \"correction-de-code\" } : {}),\n   212\t\t\t});\n   213\t\t\tif (code) reprise = CORRECTION_DE_CODE;\n   214\t\t\te = precedente;\n   215\t\t} else {\n   216\t\t\tif (precedente) {\n   217\t\t\t\tconst changes = changements((precedente.composantes as Record<string, unknown> | undefined) ?? {}, composantes);\n   218\t\t\t\tjournal.inscrire(\"rouge-vert\", \"preparation-retiree\", {\n   219\t\t\t\t\tancienne: precedente.empreinte,\n   220\t\t\t\t\tempreinte,\n   221\t\t\t\t\treprise: \"revision-de-regle\",\n   222\t\t\t\t\tchangements: changes,\n   223\t\t\t\t});\n   224\t\t\t\treprise = `reprise : révision de règle — la préparation ${String(precedente.empreinte)} est retirée, celle-ci la remplace ; a changé : ${changes.join(\", \")}`;\n   225\t\t\t}\n   226\t\t\te = journal.inscrire(\"rouge-vert\", \"preparation\", { empreinte, composantes, ...(await examiner(o)) });\n   227\t\t}\n   228\t\treturn e.verte === true ? { verte: true, resume: resume(e, reprise) } : { verte: false, motif: String(e.motif) };\n   229\t}\nverification-contract.test.ts\nverification-gate.test.ts\nverification-journal.test.ts\nverification-profile.test.ts\nverification-revision.test.t