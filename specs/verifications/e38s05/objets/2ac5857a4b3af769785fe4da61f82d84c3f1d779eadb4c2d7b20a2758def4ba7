  168\t/** The parts whose digest differs between two preparations, those of the new one first. */\n   169\tfunction changements(avant: Record<string, unknown>, apres: Record<string, string | null>): string[] {\n   170\t\tconst noms = new Set([...Object.keys(apres), ...Object.keys(avant)]);\n   171\t\treturn [...noms].filter((n) => avant[n] !== apres[n]);\n   172\t}\n   173\t\n   174\t/** The bounded account a red-green prompt receives: the fingerprint and the objects it cites, never their content. */\n   175\tfunction resume(e: Evenement, reprise: string | null): string {\n   176\t\tconst resultats = (e.resultats as Resultat[] | undefined) ?? [];\n   177\t\treturn [\n   178\t\t\t`préparation verte, empreinte ${String(e.empreinte)}`,\n   179\t\t\t...resultats.map((r) => `- ${r.manifeste} : ${r.issue}, sortie ${r.trace?.digest ?? \"aucune\"}`),\n   180\t\t\t...(reprise ? [reprise] : []),\n   181\t\t].join(\"\\n\");\n   182\t}\n   183\t\n   184\t/** Whether the story was sent back to the red-green since its preparation was last examined or cited. */\n   185\tfunction rouverteDepuis(journal: Journal): boolean {\n   186\t\tconst events = journal.lire();\n   187\t\tconst preparation = events.findLastIndex((e) => e.genre.startsWith(\"preparation\"));\n   188\t\treturn preparation >= 0 && events.findLastIndex((e) => e.genre === \"rouvert\") > preparation;\n   189\t}\n   190\t\n   191\tconst CORRECTION_DE_CODE =\n   192\t\t\"reprise : correction de code — la préparation tient telle qu'examinée ; corrige le code, sans retoucher les règles adoptées ni affaiblir un test\";\n   193\t\n   194\t/**\n   195\t * The preparation of the story at the threshold of the red-green. A story without a companion is on the\n   196\t * cycle it had and leaves no record. A preparation of the same identity, when one was recorded, is cited,\n   197\t * and a story reopened since is a code correction; a different identity withdraws the previous\n   198\t * preparation — a revision of the rule — an