4\t\n    25\t/**\n    26\t * What an exploration ended on, read from the exit status of `scripts/check-formal.ts`; a run killed\n    27\t * before its end, its exit status null, is inconclusive.\n    28\t */\n    29\ttype IssueExploration = \"completed\" | \"counterexample\" | \"inconclusive\" | \"error\";\n    30\t\n    31\tconst ISSUE_DU_CODE: Record<number, IssueExploration> = { 0: \"completed\", 1: \"counterexample\", 2: \"inconclusive\" };\n    32\t\n    33\t/** How many lines of an exploration's output the account of a block carries; the rest is in the trace. */\n    34\tconst LIGNES_CITEES = 12;\n    35\t\n    36\t/** One exploration of the preparation: its manifest, its outcome, and its output kept in the object store. */\n    37\tinterface Resultat {\n    38\t\tmanifeste: string;\n    39\t\tissue: IssueExploration;\n    40\t\ttrace: ObjectRef | null;\n    41\t}\n    42\t\n    43\tinterface Examen {\n    44\t\tverte: boolean;\n    45\t\t/** Why the preparation does not hold, said for whoever revises it; empty when it holds. */\n    46\t\tmotif: string;\n    47\t\tresultats: Resultat[];\n    48\t}\n    49\t\n    50\t/** What the examination needs from the conductor: the story, a way to run a control, and to read its output. */\n    51\tinterface Outillage {\n    52\t\troot: string;\n    53\t\tstory: Story;\n    54\t\t/** The control that explores the model a manifest pins. */\n    55\t\texploration: (manifeste: string) => Controle;\n    56\t\tlancer: (c: Controle) => Promise<Preuve>;\n    57\t\tlire: (digest: string) => Promise<string | null>;\n    58\t}\n    59\t\n    60\t/** The preparation the red-green starts from: its account for the prompt, or the block it says. */\n    61\ttype Preparation = { verte: true; resume: string } | { verte: false; motif: string };\n    62\t\n    63\tfunction bloquee(texte: string, resultats: Resultat[] = []): Examen {\n    64\t\treturn {\n    65\t\t\tverte: false,\n    66\t\t\tmotif: `la préparation ne tient pas : la story revient à la préparation, aucune session de rouge-vert n'est lancée.\\n${texte}`,\n    67\t\t\tresultats,\n    68\t\t};\n    69\t}\n    70\t\n    71\t/** The state models the companion keeps, by manifest. */\n    72\tfunction manifestesRetenus(story: Story): string[] {\n    73\t\tconst manifestes = new Set<string>();\n    74\t\tfor (const p of story.verification?.promesses ?? [])\n    75\t\t\tfor (const m of p.moyens)\n    76\t\t\t\tif (m.retenu && m.moyen === \"modele-d-etats\") for (const f of m.manifestes) manifestes.add(f);\n    77\t\treturn [...manifestes];\n    78\t}\n    79\t\n    80\t/** The means the companion keeps that no run of the cycle can settle. */\n    81\tfunction indetermines(story: Story): string[] {\n    82\t\tconst trouves: string[] = [];\n    83\t\tfor (const p of story.verification?.promesses ?? [])\n    84\t\t\tfor (const m of p.moyens.filter((x) => x.retenu)) {\n    85\t\t\t\tif (m.moyen === \"modele-d-etats\" && m.manifestes.length === 0)\n    86\t\t\t\t\ttrouves.push(\n    87\t\t\t\t\t\t`« ${p.scenario} » : modèle d'états retenu sans manifeste ; attendu : le manifeste que TLC explore`,\n    88\t\t\t\t\t);\n    89\t\t\t\tif (m.moyen === \"preuve-lean\")\n    90\t\t\t\t\ttrouves.push(`« ${p.scenario} » : preuve Lean retenue, et le cycle n'a pas de contrôle Lean à lancer`);\n    91\t\t\t}\n    92\t\treturn trouves;\n    93\t}\n    94\t\n    95\tfunction issueDe(preuve: Preuve): IssueExploration {\n    96\t\tconst code = preuve.facts.exit_code;\n    97\t\tif (typeof code !== \"number\") return \"inconclusive\";\n    98\t\treturn ISSUE_DU_CODE[code] ?? \"error\";\n    99\t}\n   100\t\n   101\t/** One exploration that did not complete: its manifest, its outcome, the trace it left and its first lines. */\n   102\tasync function compteRendu(o: Outillage, r: Resultat): Promise<string> {\n   103\t\tif (!r.trace) return `- ${r.manifeste} : ${r.issue}, sans sortie`;\n   104\t\tconst sortie = (await o.lire(r.trace.digest)) ?? \"\";\n   105\t\tconst lignes = sortie.split(\"\\n\").filter((l) => l.trim() !== \"\");\n   106\t\t// The outcome line, then the counterexample's states when there are any: the header between them —\n   107\t\t// tool, files, budget — is in the trace.\n   108\t\tconst debut = lignes.findIndex((l) => l.startsWith(\"counterexample to \"));\n   109\t\tconst citees = debut > 0 ? [lignes[0] ?? \"\", ...lignes.slice(debut)] : lignes;\n   110\t\tconst extrait = citees.slice(0, LIGNES_CITEES).map((l) => `    ${l}`);\n   111\t\tconst omises = lignes.length - extrait.length;\n   112\t\tif (omises > 0) extrait.push(`    … ${omises} ligne(s) de plus dans la trace`);\n   113\t\treturn [`- ${r.manifeste} : ${r.issue}, trace ${r.trace.digest}`, ...extrait].join(\"\\n\");\n   114\t}\n   115\t\n   116\t/** Examines the preparation of a story that has a companion: its diagnostic, then each upstream means it keeps. */\n   117\tasync function examiner(o: Outillage): Promise<Examen> {\n   118\t\tconst diagnostic = o.story.verification;\n   119\t\tif (diagnostic && !diagnostic.prete) return bloquee(resumeDeVerification(diagnostic, o.root));\n   120\t\tconst indetermine = indetermines(o.story);\n   121\t\tif (indetermine.length > 0) return bloquee(`exploration indéterminée :\\n${indetermine.join(\"\\n\")}`);\n   122\t\tconst resultats: Resultat[] = [];\n   123\t\tfor (const manifeste of manifestesRetenus(o.story)) {\n   124\t\t\tconst preuve = await o.lancer(o.exploration(manifeste));\n   125\t\t\tconst trace = preuve.artifacts.find((a) => a.name === \"stdout\")?.ref ?? null;\n   126\t\t\tresultats.push({ manifeste, issue: issueDe(preuve), trace });\n   127\t\t}\n   128\t\tconst echecs = resultats.filter((r) => r.issue !== \"completed\");\n   129\t\tif (echecs.length === 0) return { verte: true, motif: \"\", resultats };\n   130\t\tconst comptes = await Promise.all(echecs.map((r) => compteRendu(o, r)));\n   131\t\treturn bloquee(`une propriété requise n'est pas établie par le modèle adopté :\\n${comptes.join(\"\\n\