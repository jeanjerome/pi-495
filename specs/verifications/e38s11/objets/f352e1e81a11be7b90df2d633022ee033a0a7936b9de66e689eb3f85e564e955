ory) is copied into a disposable directory and built there with Lake under the platform sandbox — the copy\n * alone writable, no temporary directory, the network denied — from the protected `lakefile.toml` alone, whatever\n * other configuration the project holds, and with Lake's artifact cache turned off, so every module is compiled from\n * its source. The protected modules are built first, where no proof runs, and what they compile to is set aside out of\n * the reach of the build of the proofs, which cannot replace it. The kernel then replays every module of the project\n * (`leanchecker`) and `scripts/lean/Inspect.lean`, which the proofs do not reach, reads each theorem's declaration\n * and the axioms it reaches as `#print axioms` collects them, both from the `.olean` of each module set aside: the\n * protected modules as first compiled, the others as the build left them. The protected files are compared before\n * and after the build. A declaration the import files under another name than its own is refused: the kernel replay\n * adds it under its own name, so the replay and the inspection would not read the same declaration. So is a name a\n * module of the project declares when an earlier imported module already does: the kernel replay skips a theorem its\n * imports hold under the same name and type, while the import keeps the later copy, which no kernel has checked.\n *\n * A theorem is proved only when it is a theorem, its type is exactly the approved statement, the statement comes\n * from a protected file and it reaches no axiom outside the allowed list: neither the exit status of the build nor\n * a message of Lean is taken for a proof.\n *\n * Exit status: 0 proved, 1 refused, 3 error.\n */\nimport { spawnSync } from \"node:child_process\";\nimport { createHash } from \"node:crypto\";\nimport { cpSync, existsSync, mkdtempSync, readFileSync, rmSync, statSync } from \"node:fs\";\nimport { homedir, tmpdir } from \"node:os\";\nimport { dirname, join, relative, resolve, sep } from \"node:path\";\nimport { parseArgs } from \"node:util\";\nimport { selectSandbox } from \"../src/adapters/sandbox/backends.ts\";\nimport { messageOf } from \"../src/domain/errors.ts\";\nimport type { ProcessObservation, SandboxProfile } from \"../src/ports/execution.ts\";\n\ninterface LeanManifest {\n\ttoolchain: { name: string; version: string; commit: string };\n\t/** Every protected file, by path relative to the project, with its sha256. */\n\tprotected: Record<string, string>;\n\tmodule: string;\n\ttheorems: { theorem: string; statement: string }[];\n\tallowed_axioms: string[];\n\tbudget: { timeout_ms: number; max_output_bytes: number };\n}\n\ninterface TheoremReport {\n\ttheorem: string;\n\tstatement: string;\n\tkind: string;\n\tstates_approved: boolean;\n\ttype: string | null;\n\tstatement_module: string | null;\n\taxioms: string[];\n\trefused: string[];\n}\n\ninterface LeanReport {\n\tmanifest: string;\n\tproject: string;\n\tverdict: \"proved\" | \"refused\" | \"error\";\n\treasons: string[];\n\ttoolchain: LeanManifest[\"toolchain\"] & { path: string };\n\tsandbox: string;\n\tallowed_axioms: string[];\n\tprotected: { file: string; approved: string; before: string | null; after: string | null }[];\n\ttheorems: TheoremReport[];\n\treplay: { tool: \"leanchecker\"; module: string; passed: boolean } | null;\n}\n\n/** An imported declaration the import files under a name other than its own, as the inspection prints it. */\ninterface Misfiled {\n\tmisfiled: string;\n\tname: string;\n\tmodule: string | null;\n}\n\n/** A name a module of the project declares when an earlier imported module already does, as the inspection prints it. */\ninterface DeclaredAgain {\n\tdeclared_again: string;\n\tfirst: string;\n\tagain: string;\n}\n\nconst EXIT_OF: Record<LeanReport[\"verdict\"], number> = { proved: 0, refused: 1, error: 3 };\nconst INSPECT = join(import.meta.dirname, \"lean\", \"Inspect.lean\");\n/** The only configuration Lake is told to read: a `lakefile.lean`, which Lake would prefer, is never read. */\nconst LAKE_CONFIGURATION = \"lakefile.toml\";\n\nfunction sha256Of(path: string): string | null {\n\tif (!existsSync(path)) return null;\n\treturn `sha256:${createHash(\"sha256\").update(readFileSync(path)).digest(\"hex\")}`;\n}\n\n/** The manifest, or the first field that does not hold, named with the form it should take. */\nfunction manifestOf(text: string): LeanManifest {\n\tconst m = JSON.parse(text) as Partial<LeanManifest>;\n\tconst fault =\n\t\t(!(\n\t\t\ttypeof m.toolchain?.name === \"string\" &&\n\t\t\ttypeof m.toolchain.version === \"string\" &&\n\t\t\ttypeof m.toolchain.commit === \"string\"\n\t\t) &&\n\t\t\t'toolchain: { \"name\": \"leanprover/lean4:v<x.y.z>\", \"version\": \"<x.y.z>\", \"commit\": \"<hash>\" }') ||\n\t\t(!(typeof m.protected === \"object\" && m.protected !== null && Object.hasOwn(m.protected, LAKE_CONFIGURATION)) &&\n\t\t\t`protected: { \"<path>\": \"sha256:<hex>\" } for the definitions, the statements and the project files, ${LAKE_CONFIGURATION} among them`) ||\n\t\t(typeof m.module !== \"string\" && \"module: the root module of the project\") ||\n\t\t(!(Array.isArray(m.theorems) && m.theorems.length > 0) &&\n\t\t\t'theorems: [{ \"theorem\": \"<name>\", \"statement\": \"<name>\" }], at least one') ||\n\t\t(!Array.isArray(m.allowed_axioms) && \"allowed_axioms: the axioms a proof may reach\") ||\n\t\t(!(Number.isInteger(m.budget?.timeout_ms) && Number.isInteger(m.budget?.max_output_bytes)) &&\n\t\t\t\"budget: integers timeout_ms and max_output_bytes\");\n\tif (fault) throw new Error(`the manifest does not hold: ${fault}`);\n\treturn m as LeanManifest;\n}\n\n/** Where elan installs a toolchain: `leanprover/lean4:v4.34.1` lives in `leanprover--lean4---v4.34.1`. */\nfunction elanToolchain(name: string): string {\n\tconst home = process.env.ELAN_HOME ?? join(homedir(), \".elan\");\n\treturn join(home, \"toolchains\", name.replace(\"/\", \"--\").replace(\":\", \"---\"));\n}\n\n/** Why the toolchain cannot be run as the approved one, said with what to provide, or null when it can. */\nfunction missingToolchain(toolchain: LeanManifest[\"toolchain\"], path: string): string | null {\n\tconst lean = join(path, \"bin\", \"lean\");\n\tconst install = `elan toolchain install ${toolchain.name}`;\n\tif (!existsSync(lean)) return `no Lean toolchain at ${path}: ${install}`;\n\tconst printed = spawnSync(lean, [\"--version\"], { encoding: \"utf8\" }).stdout ?? \"\";\n\tif (!printed.includes(`version ${toolchain.version},`) || !printed.includes(`commit ${toolchain.commit}`))\n\t\treturn `${lean} prints ${printed.trim()}, not version ${toolchain.version} at commit ${toolchain.commit}`;\n\treturn null;\n}\n\n/** `Verdicts/Statements.lean` is the module `Verdicts.Statements`. */\nfunction moduleOfFile(file: string): string {\n\treturn file\n\t\t.replace(/\\.lean$/, \"\")\n\t\t.split(\"/\")\n\t\t.join(\".\");\n}\n\n/**\n * Copies into `to` the `.olean` that `module` compiled to under `from` (`A/B.olean`) and, when `nested`, those of the\n * modules under it, keeping whatever `to` already holds. A link is copied as the file it points to. Nothing else is\n * taken: `leanchecker` replays the `.olean.server` and `.olean.private` parts it finds beside an `.olean`, which the\n * inspection of a module that is not a `module` never reads, so the kernel and the inspection read the same file.\n */\nfunction copyCompiled(from: string, to: string, module: string, nested: boolean): void {\n\tconst path = join(from, ...module.split(\".\"));\n\tconst options = { recursive: true, force: false, dereference: true };\n\tif (existsSync(`${path}.olean`)) cpSync(`${path}.olean`, join(to, `${relative(from, path)}.olean`), options);\n\tif (nested && existsSync(path))\n\t\tcpSync(path, join(to, relative(from, path)), {\n\t\t\t...options,\n\t\t\tfilter: (source) => source.endsWith(\".olean\") || statSync(source).isDirectory(),\n\t\t});\n}\n\nfunction text(bytes: Uint8Array): string {\n\treturn new TextDecoder().decode(bytes);\n}\n\nfunction failure(step: string, run: ProcessObservation): string {\n\tconst why = run.spawn_error ?? (run.timed_out ? \"timed out\" : `exit ${run.exit_code}`);\n\tconst tail = `${text(run.stdout)}${text(run.stderr)}`.trim().split(\"\\n\").slice(-20).join(\"\\n\");\n\treturn `${step} failed (${why}):\\n${tail}`;\n}\n\n/** What a theorem the inspection read is refused for; empty when it proves its approved statement. */\nfunction refusals(t: TheoremReport, manifest: LeanManifest): string[] {\n\tconst reasons: string[] = [];\n\tconst approvedModules = Object.keys(manifest.protected).map(moduleOfFile);\n\tif (t.kind !== \"theorem\") reasons.push(`${t.theorem} is ${t.kind}, not a theorem`);\n\tif (!t.states_approved) reasons.push(`${t.theorem} proves ${t.type}, not the approved statement ${t.statement}`);\n\tif (t.kind !== \"absent\" && !(t.statement_module && approvedModules.includes(t.statement_module)))\n\t\treasons.push(`${t.statement} comes from ${t.statement_module}, not from a protected file`);\n\tfor (const axiom of t.axioms)\n\t\tif (!manifest.allowed_axioms.includes(axiom))\n\t\t\treasons.push(`${t.theorem} reaches the axiom ${axiom}, which the manifest does not allow`);\n\treturn reasons;\n}\n\nfunction inspected(line: string, manifest: LeanManifest): TheoremReport {\n\tconst printedTheorem = JSON.parse(line) as Omit<TheoremReport, \"refused\" | \"type\" | \"statement_module\"> & {\n\t\ttype?: string;\n\t\tstatement_module?: string | null;\n\t};\n\tconst t: TheoremReport = {\n\t\ttheorem: printedTheorem.theorem,\n\t\tstatement: printedTheorem.statement,\n\t\tkind: printedTheorem.kind,\n\t\tstates_approved: printedTheorem.states_approved,\n\t\ttype: printedTheorem.type ?? null,\n\t\tstatement_module: printedTheorem.statement_module ?? null,\n\t\taxioms: printedTheorem.axioms,\n\t\trefused: [],\n\t};\n\treturn { ...t, refused: refusals(t, manifest) };\n}\n\nasync function verify(manifestPath: string, project: string, toolchainPath: string | undefined): Promise<LeanReport> {\n\tconst manifest = manifestOf(readFileSync(manifestPath, \"utf8\"));\n\tconst toolchain = { ...manifest.toolchain, path: toolchainPath ?? elanToolchain(manifest.toolchain.name) };\n\t// No temporary directory is granted: a proof run by the build writes into its copy and nowhere else.\n\tconst sandbox = selectSandbox({ allow_unconfined: false, temp_paths: [] });\n\tconst report: LeanReport = {\n\t\tmanifest: manifestPath,\n\t\tproject,\n\t\tverdict: \"error\",\n\t\treasons: [],\n\t\ttoolchain,\n\t\tsandbox: sandbox.backend.backend,\n\t\tallowed_axioms: manifest.allowed_axioms,\n\t\tprotected: Object.entries(manifest.protected).map(([file, approved]) => ({\n\t\t\tfile,\n\t\t\tapproved,\n\t\t\tbefore: sha256Of(join(project, file)),\n\t\t\tafter: null,\n\t\t})),\n\t\ttheorems: [],\n\t\treplay: null,\n\t};\n\tconst done = (verdict: LeanReport[\"verdict\"], reasons: string[]): LeanReport => ({ ...report, verdict, reasons });\n\n\tconst missing = missingToolchain(manifest.toolchain, toolchain.path);\n\tif (missing !== null) return done(\"error\", [`capability missing: ${missing}`]);\n\tif (!sandbox.qualification.qualified)\n\t\treturn done(\"error\", [`capability missing: no qualified sandbox (${sandbox.qualification.reasons.join(\"; \")})`]);\n\tconst altered = report.protected\n\t\t.filter((p) => p.before !== p.approved)\n\t\t.map((p) =>\n\t\t\tp.before === null ? `${p.file} is absent` : `${p.file} is ${p.before}, the manifest approves ${p.approved}`,\n\t\t);\n\tif (altered.length > 0)\n\t\treturn done(\n\t\t\t\"refused\",\n\t\t\taltered.map((a) => `a protected file is not the approved one: ${a}`),\n\t\t);\n\n\tconst work = mkdtempSync(join(tmpdir(), \"495-lean-\"));\n\tconst checked = mkdtempSync(join(tmpdir(), \"495-lean-checked-\"));\n\ttry {\n\t\t// What an earlier build left in the project is not copied: every module is built again from its source.\n\t\tcpSync(project, work, { recursive: true, filter: (source) => !`${source}${sep}`.includes(`${sep}.lake${sep}`) });\n\t\tconst bin = join(toolchain.path, \"bin\");\n\t\tconst library = join(work, \".lake\", \"build\", \"lib\", \"lean\");\n\t\tconst run = (command: string[], leanPath: string) => {\n\t\t\tconst profile: SandboxProfile = {\n\t\t\t\tprofile_id: \"verify\",\n\t\t\t\tread_paths: [],\n\t\t\t\twrite_paths: [work],\n\t\t\t\tnetwork: \"denied\",\n\t\t\t\tenv_allowlist: [],\n\t\t\t\t// Lake reads its artifact cache by default, under `$HOME/.cache/lake`: a cache shipped with the project would\n\t\t\t\t// restore, under the input hash of an approved module, what another source compiled to.\n\t\t\t\tenv: { PATH: `${bin}:/usr/bin:/bin`, HOME: work, LEAN_PATH: leanPath, LAKE_ARTIFACT_CACHE: \"false\" },\n\t\t\t};\n\t\t\treturn sandbox.backend.run(profile, {\n\t\t\t\tcommand,\n\t\t\t\tcwd: work,\n\t\t\t\ttimeout_ms: manifest.budget.timeout_ms,\n\t\t\t\tmax_output_bytes: manifest.budget.max_output_bytes,\n\t\t\t});\n\t\t};\n\t\tconst lake = (targets: string[]) =>\n\t\t\trun([join(bin, \"lake\"), \"-f\", join(work, LAKE_CONFIGURATION), \"build\", ...targets], library);\n\n\t\t// Built alone, the protected modules run nothing but approved code; what they compile to is what the kernel\n\t\t// replays the proofs against and the inspection reads, whatever the build of the proofs writes over it.\n\t\tconst protectedModules = Object.keys(manifest.protected)\n\t\t\t.filter((file) => file.endsWith(\".lean\"))\n\t\t\t.map(moduleOfFile);\n\t\tconst approved = await lake(protectedModules);\n\t\tif (approved.exit_code !== 0) return done(\"refused\", [failure(\"the build of the protected modules\", approved)]);\n\t\tfor (const module of protectedModules) copyCompiled(library, checked, module, false);\n\n\t\tconst build = await lake([manifest.module]);\n\t\treport.protected = report.protected.map((p) => ({ ...p, after: sha256Of(join(work, p.file)) }));\n\t\tif (build.exit_code !== 0) return done(\"refused\", [failure(\"the build of the proofs\", build)]);\n\t\tconst rewritten = report.protected.filter((p) => p.after !== p.approved).map((p) => `${p.file} is ${p.after}`);\n\t\tif (rewritten.length > 0)\n\t\t\treturn done(\n\t\t\t\t\"refused\",\n\t\t\t\trewritten.map((r) => `the build rewrote a protected file: ${r}`),\n\t\t\t);\n\n\t\t// Only the modules of the project are taken from the build, so none of them stands in for a module of Lean.\n\t\tcopyCompiled(library, checked, manifest.module, true);\n\t\tconst replay = await run([join(bin, \"leanchecker\"), manifest.module], checked);\n\t\treport.replay = { tool: \"leanchecker\", module: manifest.module, passed: replay.exit_code === 0 };\n\t\tif (replay.exit_code !== 0) return done(\"refused\", [failure(\"the kernel replay\", replay)]);\n\n\t\tconst inspection = await run(\n\t\t\t[\n\t\t\t\tjoin(bin, \"lean\"),\n\t\t\t\t\"--run\",\n\t\t\t\tINSPECT,\n\t\t\t\tmanifest.module,\n\t\t\t\t...manifest.theorems.map((t) => `${t.theorem}=${t.statement}`),\n\t\t\t],\n\t\t\tchecked,\n\t\t);\n\t\tif (inspection.exit_code !== 0) return done(\"error\", [failure(\"the inspection of the theorems\", inspection)]);\n\t\tconst lines = text(inspection.stdout).trim().split(\"\\n\");\n\t\tconst printedObjects = lines.map((line) => JSON.parse(line) as Partial<Misfiled & DeclaredAgain>);\n\t\tconst misfiled = printedObjects\n\t\t\t.filter((m): m is Misfiled => typeof m.misfiled === \"string\")\n\t\t\t.map(\n\t\t\t\t(m) =>\n\t\t\t\t\t`${m.module} files the declaration ${m.name} under the name ${m.misfiled}: the kernel replayed it under its own name, the inspection reads it under the other`,\n\t\t\t);\n\t\tconst declaredAgain = printedObjects\n\t\t\t.filter((d): d is DeclaredAgain => typeof d.declared_again === \"string\")\n\t\t\t.map(\n\t\t\t\t(d) =>\n\t\t\t\t\t`${d.declared_again} is declared by ${d.first} and again by ${d.again}: the kernel replayed the first, the inspection reads the other`,\n\t\t\t);\n\t\tconst theoremLines = lines.slice(misfiled.length + declaredAgain.length);\n\t\tif (theoremLines.length !== manifest.theorems.length)\n\t\t\treturn done(\"error\", [\n\t\t\t\t`the inspection read ${theoremLines.length} theorems, the manifest names ${manifest.theorems.length}`,\n\t\t\t]);\n\t\treport.theorems = theoremLines.map((line) => inspected(line, manifest));\n\t\tconst refused = [...misfiled, ...declaredAgain, ...report.theorems.flatMap((t) => t.refused)];\n\t\treturn refused.length > 0 ? done(\"refused\", refused) : done(\"proved\", []);\n\t} finally {\n\t\trmSync(work, { recursive: true, force: true });\n\t\trmSync(checked, { recursive: true, force: true });\n\t}\n}\n\nconst { values, positionals } = parseArgs({\n\tallowPositionals: true,\n\toptions: { project: { type: \"string\" }, toolchain: { type: \"string\" } },\n});\nconst manifestPath = positionals[0];\nif (manifestPath === undefined) {\n\tconsole.error(\"usage: node scripts/check-lean.ts <manifest.json> [--project <dir>] [--toolchain <dir>]\");\n\tprocess.exit(3);\n}\nlet report: LeanReport;\ntry {\n\treport = await verify(resolve(manifestPath), resolve(values.project ?? dirname(manifestPath)), values.toolchain);\n} catch (error) {\n\tconsole.error(`error: ${manifestPath}: ${messageOf(error)}`);\n\tprocess.exit(3);\n}\nconsole.log(JSON.stringify(report, null, 2));\nprocess.exit(EXIT_OF[report.verdict]);\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/v0-pure/lean-verdict-contract.test.ts":{"tests":[{"id":"0","name":"test/v0-pure/lean-verdict-contract.test.ts"}],"source":"import { strict as assert } from \"node:assert\";\nimport { existsSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { VERDICTS, type Verdict } from \"../../src/contracts/v1/common.ts\";\nimport { type CombinationMode, mandatoryOutcome, observeG5, requirementOutcome } from \"../helpers/g5-combination.ts\";\n\nconst REPOSITORY = join(import.meta.dirname, \"..\", \"..\");\nconst SPECIFICATION = join(REPOSITORY, \"specs\", \"formal\", \"verdicts\");\nconst TABLE = join(SPECIFICATION, \"correspondance.json\");\nconst G5 = join(REPOSITORY, \"src\", \"domain\", \"gates\", \"g5.ts\");\n/** The rules of the combination the Lean specification is approved to state, and nothing else. */\nconst APPROVED_RULES = [\"all_pass\", \"any_pass\", \"vide\", \"NOT_APPLICABLE\"];\n\ninterface CorrespondenceTable {\n\ttypescript: { file: string; function: string; observed_through: string };\n\tlean: { definitions: string; statements: string; combine: string };\n\trules: {\n\t\trule: string;\n\t\ttypescript: string;\n\t\tstatements: string[];\n\t\tcases: { mode: CombinationMode; verdicts: Verdict[]; combined: Verdict }[];\n\t}[];\n}\n\n/** The constructors of a Lean inductive type, in their declared order. */\nfunction constructors(lean: string, type: string): string[] {\n\tconst body = new RegExp(`^inductive ${type} where\\\\n((?:\\\\s+\\\\|\\\\s*\\\\w+\\\\n)+)`, \"m\").exec(lean)?.[1] ?? \"\";\n\treturn [...body.matchAll(/\\|\\s*(\\w+)/g)].map((m) => m[1] ?? \"\");\n}\n\n/** The names of the propositions a Lean file states as `def <Name> : Prop`. */\nfunction statements(lean: string): string[] {\n\treturn [...lean.matchAll(/^def (\\w+) : Prop :=/gm)].map((m) => m[1] ?? \"\");\n}\n\ndescribe(\"the Lean specification of the verdict combination of G5\", () => {\n\tit(\"its all/any, empty-list and NOT_APPLICABLE definitions match the approved correspondence table\", () => {\n\t\tassert.ok(existsSync(TABLE), `no Lean specification of the verdict combination of G5: ${TABLE} is missing`);\n\t\tconst table = JSON.parse(readFileSync(TABLE, \"utf8\")) as CorrespondenceTable;\n\t\tassert.deepEqual(\n\t\t\ttable.rules.map((r) => r.rule),\n\t\t\tAPPROVED_RULES,\n\t\t\t\"the table states exactly the approved rules\",\n\t\t);\n\n\t\tconst definitions = readFileSync(join(SPECIFICATION, table.lean.definitions), \"utf8\");\n\t\tassert.deepEqual(constructors(definitions, \"Verdict\"), [...VERDICTS], \"the Lean verdicts are those of the kernel\");\n\t\tassert.deepEqual(constructors(definitions, \"Mode\"), [\"all\", \"any\"]);\n\t\tassert.match(definitions, /^def combine \\(mode : Mode\\) \\(verdicts : List Verdict\\) : Verdict :=/m);\n\n\t\tconst stated = statements(readFileSync(join(SPECIFICATION, table.lean.statements), \"utf8\"));\n\t\tassert.deepEqual(\n\t\t\t[...stated].sort(),\n\t\t\ttable.rules.flatMap((r) => r.statements).sort(),\n\t\t\t\"every statement is approved by one rule of the table, and every approved statement is stated\",\n\t\t);\n\n\t\tassert.equal(table.typescript.file, \"src/domain/gates/g5.ts\");\n\t\tassert.match(readFileSync(G5, \"utf8\"), new RegExp(`^function ${table.typescript.function}\\\\(`, \"m\"));\n\t\tfor (const rule of table.rules) {\n\t\t\tassert.ok(rule.cases.length > 0, `rule ${rule.rule} has cases`);\n\t\t\tfor (const c of rule.cases) {\n\t\t\t\tconst observed = requirementOutcome(observeG5([{ mandatory: true, mode: c.mode, verdicts: c.verdicts }]), 0);\n\t\t\t\tassert.equal(\n\t\t\t\t\tobserved,\n\t\t\t\t\tmandatoryOutcome(c.combined),\n\t\t\t\t\t`${rule.rule}: ${c.mode} [${c.verdicts.join(\", \")}] combines to ${c.combined}, G5 says ${observed}`,\n\t\t\t\t);\n\t\t\t}\n\t\t}\n\t});\n});\n"},"test/v4-platform/lean-verdict-proof.test.ts":{"tests":[{"id":"1","name":"test/v4-platform/lean-verdict-proof.test.ts"}],"source":"import { strict as assert } from \"node:assert\";\nimport { copyFileSync, cpSync, existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { createServer } from \"node:net\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { outputDir, removedAfterEach } from \"../helpers/fixtures.ts\";\nimport { checkLean, type LeanReport, lakeBuild, leanMissing, projectCopy } from \"../helpers/lean-verdicts.ts\";\n\nconst cleanups = removedAfterEach();\n\n/** The proofs of a copy with the proof of one theorem replaced: its former block removed, the new one appended. */\nfunction replaceProof(copy: string, theorem: string, block: string): void {\n\tconst path = join(copy, \"Verdicts\", \"Proofs.lean\");\n\tconst kept = readFileSync(path, \"utf8\").replace(\n\t\tnew RegExp(`\\\\ntheorem ${theorem} [\\\\s\\\\S]*?(?=\\\\n(?:theorem |end Verdicts))`),\n\t\t\"\",\n\t);\n\twriteFileSync(path, kept.replace(/\\nend Verdicts\\s*$/, `\\n${block}\\n\\nend Verdicts\\n`));\n}\n\n/** The theorems of the manifest a copy carries, each with the short name of the statement it must prove. */\nfunction theoremsOf(copy: string): { theorem: string; statement: string }[] {\n\tconst manifest = JSON.parse(readFileSync(join(copy, \"manifest.json\"), \"utf8\")) as {\n\t\ttheorems: { theorem: string; statement: string }[];\n\t};\n\treturn manifest.theorems.map((t) => ({\n\t\ttheorem: t.theorem.replace(/^Verdicts\\./, \"\"),\n\t\tstatement: t.statement.replace(/^Verdicts\\./, \"\"),\n\t}));\n}\n\n/** Proofs of every approved theorem, each given by `proof`. */\nfunction proofsBy(copy: string, proof: string): string {\n\tconst theorems = theoremsOf(copy).map((t) => `theorem ${t.theorem} : ${t.statement} := ${proof}`);\n\treturn `import Verdicts.Statements\\n\\nnamespace Verdicts\\n\\n${theorems.join(\"\\n\\n\")}\\n\\nend Verdicts\\n`;\n}\n\n/** Proofs of every approved theorem left to `sorry`: they build, and prove nothing. */\nfunction sorriedProofs(copy: string): string {\n\treturn proofsBy(copy, \"by\\n  sorry\");\n}\n\n/** The approved statements, each made `True`: `trivial` proves them all. */\nfunction forgedStatements(copy: string): string {\n\tconst statements = theoremsOf(copy).map((t) => `def ${t.statement} : Prop := True`);\n\treturn `import Verdicts.Defs\\n\\nnamespace Verdicts\\n\\n${statements.join(\"\\n\")}\\n\\nend Verdicts\\n`;\n}\n\n/** Writes under `root` a project of the same modules where every statement is `True` and every proof `trivial`. */\nfunction writeForgedModules(root: string, copy: string): void {\n\tmkdirSync(join(root, \"Verdicts\"), { recursive: true });\n\twriteFileSync(\n\t\tjoin(root, \"Verdicts.lean\"),\n\t\t\"import Verdicts.Defs\\nimport Verdicts.Statements\\nimport Verdicts.Proofs\\n\",\n\t);\n\twriteFileSync(join(root, \"Verdicts\", \"Defs.lean\"), \"namespace Verdicts\\n\\nend Verdicts\\n\");\n\twriteFileSync(join(root, \"Verdicts\", \"Statements.lean\"), forgedStatements(copy));\n\twriteFileSync(join(root, \"Verdicts\", \"Proofs.lean\"), proofsBy(copy, \"trivial\"));\n}\n\n/** Builds a module of a project with Lake's artifact cache under `home`, and says which outputs it added there. */\nfunction cachedBuild(project: string, module: string, home: string): string[] {\n\tconst outputs = join(home, \".cache\", \"lake\", \"outputs\", \"verdicts\");\n\tconst before = existsSync(outputs) ? readdirSync(outputs) : [];\n\tconst built = lakeBuild(project, module, { HOME: home, LAKE_ARTIFACT_CACHE: \"true\" });\n\tassert.equal(built.status, 0, built.output);\n\treturn readdirSync(outputs).filter((entry) => !before.includes(entry));\n}\n\n/** Appends Lean commands to the proofs of a copy: they run while Lake builds them. */\nfunction appendToProofs(copy: string, commands: string): void {\n\tconst path = join(copy, \"Verdicts\", \"Proofs.lean\");\n\twriteFileSync(path, `${readFileSync(path, \"utf8\")}\\n${commands}\\n`);\n}\n\nfunction theoremOf(report: LeanReport | null, name: string) {\n\treturn report?.theorems.find((t) => t.theorem === `Verdicts.${name}`);\n}\n\ndescribe(\"the Lean check of the proofs of the verdict combination\", { skip: leanMissing }, () => {\n\tit(\"the approved proofs are verified: each theorem states its approved statement, with the allowed axioms only\", async () => {\n\t\tconst { status, output, report } = await checkLean();\n\t\tassert.equal(report?.verdict, \"proved\", `the approved project is proved: ${output}`);\n\t\tassert.equal(status, 0);\n\t\tassert.ok(report.theorems.length > 0);\n\t\tfor (const t of report.theorems) {\n\t\t\tassert.equal(t.kind, \"theorem\", t.theorem);\n\t\t\tassert.ok(t.states_approved, `${t.theorem} proves ${t.statement}`);\n\t\t\tassert.ok(!t.axioms.includes(\"sorryAx\"), `${t.theorem} uses no sorry`);\n\t\t\tassert.deepEqual(\n\t\t\t\tt.axioms.filter((a) => !report.allowed_axioms.includes(a)),\n\t\t\t\t[],\n\t\t\t\t`${t.theorem} uses only allowed axioms`,\n\t\t\t);\n\t\t}\n\t\tassert.equal(report.replay?.passed, true, \"the kernel replay finds no problem\");\n\t\tfor (const p of report.protected) assert.ok(p.before === p.approved && p.after === p.approved, p.file);\n\t});\n\n\tit(\"a dependency using sorry and a proof of another statement are refused\", async () => {\n\t\tconst sorried = projectCopy(\"lean-sorry-\", cleanups);\n\t\twriteFileSync(\n\t\t\tjoin(sorried, \"Verdicts\", \"Lemma.lean\"),\n\t\t\t\"import Verdicts.Statements\\n\\nnamespace Verdicts\\n\\ntheorem anyPassLemma : AnyPassKeepsPass := by\\n  sorry\\n\\nend Verdicts\\n\",\n\t\t);\n\t\tconst proofs = join(sorried, \"Verdicts\", \"Proofs.lean\");\n\t\twriteFileSync(proofs, `import Verdicts.Lemma\\n${readFileSync(proofs, \"utf8\")}`);\n\t\treplaceProof(sorried, \"anyPassKeepsPass\", \"theorem anyPassKeepsPass : AnyPassKeepsPass := anyPassLemma\");\n\t\tconst withSorry = await checkLean(sorried);\n\t\tassert.equal(withSorry.report?.verdict, \"refused\", `a proof that leans on sorry is refused: ${withSorry.output}`);\n\t\tassert.notEqual(withSorry.status, 0);\n\t\tassert.ok(theoremOf(withSorry.report, \"anyPassKeepsPass\")?.axioms.includes(\"sorryAx\"), withSorry.output);\n\t\tassert.match(theoremOf(withSorry.report, \"anyPassKeepsPass\")?.refused.join(\"\\n\") ?? \"\", /sorryAx/);\n\n\t\tconst other = projectCopy(\"lean-other-\", cleanups);\n\t\treplaceProof(\n\t\t\tother,\n\t\t\t\"anyPassKeepsPass\",\n\t\t\t\"theorem anyPassKeepsPass : ∀ verdicts : List Verdict, combine .any verdicts = combine .any verdicts :=\\n  fun _ => rfl\",\n\t\t);\n\t\tconst otherStatement = await checkLean(other);\n\t\tassert.equal(\n\t\t\totherStatement.report?.verdict,\n\t\t\t\"refused\",\n\t\t\t`a proof of another statement is refused: ${otherStatement.output}`,\n\t\t);\n\t\tassert.equal(theoremOf(otherStatement.report, \"anyPassKeepsPass\")?.states_approved, false);\n\t\tassert.match(\n\t\t\ttheoremOf(otherStatement.report, \"anyPassKeepsPass\")?.refused.join(\"\\n\") ?? \"\",\n\t\t\t/not the approved statement Verdicts\\.AnyPassKeepsPass/,\n\t\t);\n\t});\n\n\tit(\"an altered statement is refused before any proof is built\", async () => {\n\t\tconst altered = projectCopy(\"lean-altered-\", cleanups);\n\t\tconst statements = join(altered, \"Verdicts\", \"Statements.lean\");\n\t\twriteFileSync(\n\t\t\tstatements,\n\t\t\treadFileSync(statements, \"utf8\").replace(\n\t\t\t\t\"PASS ∈ verdicts → combine .any verdicts = PASS\",\n\t\t\t\t\"PASS ∈ verdicts → combine .any verdicts = combine .any verdicts\",\n\t\t\t),\n\t\t);\n\t\tconst { status, output, report } = await checkLean(altered);\n\t\tassert.equal(report?.verdict, \"refused\", `an altered statement is refused: ${output}`);\n\t\tassert.notEqual(status, 0);\n\t\tassert.match(\n\t\t\treport.reasons.join(\"\\n\"),\n\t\t\t/Verdicts\\/Statements\\.lean is sha256:\\w+, the manifest approves sha256:\\w+/,\n\t\t);\n\t\tassert.equal(report.replay, null, \"nothing is built nor replayed\");\n\t});\n\n\tit(\"a lakefile.lean that points the build to forged statements is not read\", async () => {\n\t\tconst copy = projectCopy(\"lean-lakefile-\", cleanups);\n\t\twriteForgedModules(join(copy, \"forged\"), copy);\n\t\twriteFileSync(\n\t\t\tjoin(copy, \"lakefile.lean\"),\n\t\t\t'import Lake\\nopen Lake DSL\\n\\npackage verdicts\\n\\n@[default_target]\\nlean_lib Verdicts where\\n  srcDir := \"forged\"\\n',\n\t\t);\n\t\twriteFileSync(join(copy, \"Verdicts\", \"Proofs.lean\"), sorriedProofs(copy));\n\t\tconst { status, output, report } = await checkLean(copy);\n\t\tassert.equal(report?.verdict, \"refused\", `the forged statements are not taken for the approved ones: ${output}`);\n\t\tassert.notEqual(status, 0);\n\t\tassert.ok(theoremOf(report, \"anyPassKeepsPass\")?.axioms.includes(\"sorryAx\"), \"the protected sources are built\");\n\t});\n\n\tit(\"a build that overwrites the compiled statements does not stand for their proof\", async () => {\n\t\tconst forged = projectCopy(\"lean-forged-\", cleanups);\n\t\twriteForgedModules(forged, forged);\n\t\tconst built = lakeBuild(forged, \"Verdicts\");\n\t\tassert.equal(built.status, 0, built.output);\n\t\tconst copy = projectCopy(\"lean-overwrite-\", cleanups);\n\t\tfor (const m of [\"Defs\", \"Statements\", \"Proofs\"])\n\t\t\tcpSync(\n\t\t\t\tjoin(forged, \".lake\", \"build\", \"lib\", \"lean\", \"Verdicts\", `${m}.olean`),\n\t\t\t\tjoin(copy, \"forged-build\", `${m}.olean`),\n\t\t\t);\n\t\twriteFileSync(join(copy, \"Verdicts\", \"Proofs.lean\"), sorriedProofs(copy));\n\t\twriteFileSync(\n\t\t\tjoin(copy, \"Verdicts\", \"Overwrite.lean\"),\n\t\t\t[\n\t\t\t\t\"import Verdicts.Proofs\",\n\t\t\t\t\"\",\n\t\t\t\t\"#eval show IO Unit from do\",\n\t\t\t\t'  for m in [\"Defs\", \"Statements\", \"Proofs\"] do',\n\t\t\t\t'    IO.FS.writeBinFile s!\".lake/build/lib/lean/Verdicts/{m}.olean\" (← IO.FS.readBinFile s!\"forged-build/{m}.olean\")',\n\t\t\t\t\"\",\n\t\t\t].join(\"\\n\"),\n\t\t);\n\t\twriteFileSync(\n\t\t\tjoin(copy, \"Verdicts.lean\"),\n\t\t\t`${readFileSync(join(copy, \"Verdicts.lean\"), \"utf8\")}import Verdicts.Overwrite\\n`,\n\t\t);\n\t\tconst { status, output, report } = await checkLean(copy);\n\t\tassert.equal(report?.verdict, \"refused\", `oleans written by the build are not the approved statements: ${output}`);\n\t\tassert.notEqual(status, 0);\n\t\tassert.equal(report.replay?.passed, false, \"the kernel replays the forged proofs against the approved statements\");\n\t});\n\n\tit(\"statements restored from a Lake artifact cache shipped with the project are not taken for the approved ones\", async () => {\n\t\tconst copy = projectCopy(\"lean-cache-\", cleanups);\n\t\tcachedBuild(copy, \"Verdicts.Defs\", copy);\n\t\tconst [approved] = cachedBuild(copy, \"Verdicts.Statements\", copy);\n\t\tconst forged = projectCopy(\"lean-cache-forged-\", cleanups);\n\t\twriteFileSync(join(forged, \"Verdicts\", \"Statements.lean\"), forgedStatements(forged));\n\t\tconst [forgery] = cachedBuild(forged, \"Verdicts.Statements\", copy);\n\t\tassert.ok(approved && forgery, \"the cache holds an output for the approved and for the forged statements\");\n\t\tconst outputs = join(copy, \".cache\", \"lake\", \"outputs\", \"verdicts\");\n\t\tcopyFileSync(join(outputs, forgery), join(outputs, approved));\n\t\twriteFileSync(join(copy, \"Verdicts\", \"Proofs.lean\"), proofsBy(copy, \"trivial\"));\n\t\tconst { status, output, report } = await checkLean(copy);\n\t\tassert.equal(report?.verdict, \"refused\", `the cached forged statements are not the approved ones: ${output}`);\n\t\tassert.notEqual(status, 0);\n\t});\n\n\tit(\"the parts of a module written beside its olean do not stand for its replay\", async () => {\n\t\t// Two modules without a constant, each compiled to its own region, stand for the server and private parts.\n\t\tconst forged = projectCopy(\"lean-parts-forged-\", cleanups);\n\t\twriteForgedModules(forged, forged);\n\t\tconst empties = [\"Server\", \"Private\"];\n\t\tfor (const empty of empties) writeFileSync(join(forged, \"Verdicts\", `${empty}.lean`), \"\");\n\t\twriteFileSync(\n\t\t\tjoin(forged, \"Verdicts.lean\"),\n\t\t\t`${readFileSync(join(forged, \"Verdicts.lean\"), \"utf8\")}${empties.map((e) => `import Verdicts.${e}\\n`).join(\"\")}`,\n\t\t);\n\t\tconst built = lakeBuild(forged, \"Verdicts\");\n\t\tassert.equal(built.status, 0, built.output);\n\t\tconst copy = projectCopy(\"lean-parts-\", cleanups);\n\t\tconst library = join(forged, \".lake\", \"build\", \"lib\", \"lean\", \"Verdicts\");\n\t\tmkdirSync(join(copy, \"forged-build\"));\n\t\tfor (const m of [\"Proofs\", ...empties])\n\t\t\tcopyFileSync(join(library, `${m}.olean`), join(copy, \"forged-build\", `${m}.olean`));\n\t\twriteFileSync(join(copy, \"Verdicts\", \"Proofs.lean\"), sorriedProofs(copy));\n\t\twriteFileSync(\n\t\t\tjoin(copy, \"Verdicts\", \"Overwrite.lean\"),\n\t\t\t[\n\t\t\t\t\"import Verdicts.Proofs\",\n\t\t\t\t\"\",\n\t\t\t\t\"#eval show IO Unit from do\",\n\t\t\t\t'  let into := \".lake/build/lib/lean/Verdicts/Proofs.olean\"',\n\t\t\t\t'  IO.FS.writeBinFile into (← IO.FS.readBinFile \"forged-build/Proofs.olean\")',\n\t\t\t\t'  for (part, empty) in [(\"server\", \"Server\"), (\"private\", \"Private\")] do',\n\t\t\t\t'    IO.FS.writeBinFile s!\"{into}.{part}\" (← IO.FS.readBinFile s!\"forged-build/{empty}.olean\")',\n\t\t\t\t\"\",\n\t\t\t].join(\"\\n\"),\n\t\t);\n\t\twriteFileSync(\n\t\t\tjoin(copy, \"Verdicts.lean\"),\n\t\t\t`${readFileSync(join(copy, \"Verdicts.lean\"), \"utf8\")}import Verdicts.Overwrite\\n`,\n\t\t);\n\t\tconst { status, output, report } = await checkLean(copy);\n\t\tassert.equal(report?.verdict, \"refused\", `a replay of empty parts does not stand for the forged proofs: ${output}`);\n\t\tassert.notEqual(status, 0);\n\t\tassert.equal(report.replay?.passed, false, \"the kernel replays the olean the inspection reads\");\n\t});\n\n\tit(\"a declaration filed under another name than its own does not stand for the approved statement\", async () => {\n\t\t// Proofs that import the definitions alone, each statement made `True` beside its `trivial` proof.\n\t\tconst forged = projectCopy(\"lean-misfiled-forged-\", cleanups);\n\t\tconst proofs = theoremsOf(forged).map((t) => `theorem ${t.theorem} : ${t.statement} := trivial`);\n\t\twriteFileSync(\n\t\t\tjoin(forged, \"Verdicts\", \"Proofs.lean\"),\n\t\t\tforgedStatements(forged).replace(/\\nend Verdicts\\n$/, `\\n${proofs.join(\"\\n\")}\\n\\nend Verdicts\\n`),\n\t\t);\n\t\tconst built = lakeBuild(forged, \"Verdicts.Proofs\");\n\t\tassert.equal(built.status, 0, built.output);\n\t\tconst copy = projectCopy(\"lean-misfiled-\", cleanups);\n\t\tmkdirSync(join(copy, \"forged-build\"));\n\t\tcopyFileSync(\n\t\t\tjoin(forged, \".lake\", \"build\", \"lib\", \"lean\", \"Verdicts\", \"Proofs.olean\"),\n\t\t\tjoin(copy, \"forged-build\", \"Proofs.olean\"),\n\t\t);\n\t\twriteFileSync(join(copy, \"Verdicts\", \"Proofs.lean\"), sorriedProofs(copy));\n\t\t// The build files each forged statement under a key the kernel replay reaches before every theorem: the replay\n\t\t// adds it under its own name, the import keeps it under that key, out of the way of the approved statement.\n\t\twriteFileSync(\n\t\t\tjoin(copy, \"Verdicts\", \"Overwrite.lean\"),\n\t\t\t[\n\t\t\t\t\"import Lean\",\n\t\t\t\t\"import Verdicts.Proofs\",\n\t\t\t\t\"\",\n\t\t\t\t\"open Lean\",\n\t\t\t\t\"\",\n\t\t\t\t\"#eval show IO Unit from do\",\n\t\t\t\t'  let (forgedProofs, _) ← readModuleData \"forged-build/Proofs.olean\"',\n\t\t\t\t\"  let theorems := forgedProofs.constants.filterMap fun c => if c matches .thmInfo _ then some c.name else none\",\n\t\t\t\t\"  let mut next := 0\",\n\t\t\t\t\"  let mut names := #[]\",\n\t\t\t\t\"  for c in forgedProofs.constants do\",\n\t\t\t\t\"    if c matches .thmInfo _ then\",\n\t\t\t\t\"      names := names.push c.name\",\n\t\t\t\t\"    else\",\n\t\t\t\t'      let mut key := Name.mkStr `Verdicts s!\"k{next}\"',\n\t\t\t\t\"      while !theorems.all (Name.quickCmp key · == .lt) do\",\n\t\t\t\t\"        next := next + 1\",\n\t\t\t\t'        key := Name.mkStr `Verdicts s!\"k{next}\"',\n\t\t\t\t\"      next := next + 1\",\n\t\t\t\t\"      names := names.push key\",\n\t\t\t\t'  saveModuleData \".lake/build/lib/lean/Verdicts/Proofs.olean\" `Verdicts.Proofs { forgedProofs with constNames := names }',\n\t\t\t\t\"\",\n\t\t\t].join(\"\\n\"),\n\t\t);\n\t\twriteFileSync(\n\t\t\tjoin(copy, \"Verdicts.lean\"),\n\t\t\t`${readFileSync(join(copy, \"Verdicts.lean\"), \"utf8\")}import Verdicts.Overwrite\\n`,\n\t\t);\n\t\tconst { status, output, report } = await checkLean(copy);\n\t\tassert.equal(report?.verdict, \"refused\", `a statement filed under another name is not proved: ${output}`);\n\t\tassert.notEqual(status, 0);\n\t\tassert.match(\n\t\t\treport.reasons.join(\"\\n\"),\n\t\t\t/Verdicts\\.Proofs files the declaration Verdicts\\.AllPassRejectsBlocking under the name Verdicts\\.k\\d+/,\n\t\t);\n\t});\n\n\tit(\"a theorem declared again by a later module does not stand for the proof the kernel replayed\", async () => {\n\t\tconst copy = projectCopy(\"lean-duplicate-\", cleanups);\n\t\twriteFileSync(join(copy, \"Verdicts\", \"Sorried.lean\"), sorriedProofs(copy));\n\t\twriteFileSync(join(copy, \"Verdicts\", \"Proofs.lean\"), \"import Verdicts.Sorried\\n\");\n\t\t// The build gives the compiled proofs the theorems of the sorried module again, each valued by an ill-typed\n\t\t// `True.intro`: the kernel replay skips a theorem its imports already hold, the import keeps the later copy.\n\t\twriteFileSync(\n\t\t\tjoin(copy, \"Verdicts\", \"Overwrite.lean\"),\n\t\t\t[\n\t\t\t\t\"import Lean\",\n\t\t\t\t\"import Verdicts.Proofs\",\n\t\t\t\t\"\",\n\t\t\t\t\"open Lean\",\n\t\t\t\t\"\",\n\t\t\t\t\"#eval show IO Unit from do\",\n\t\t\t\t'  let library := \".lake/build/lib/lean/Verdicts\"',\n\t\t\t\t'  let (sorried, _) ← readModuleData s!\"{library}/Sorried.olean\"',\n\t\t\t\t'  let (proofs, _) ← readModuleData s!\"{library}/Proofs.olean\"',\n\t\t\t\t\"  let theorems := sorried.constants.filterMap fun\",\n\t\t\t\t\"    | .thmInfo t => some (ConstantInfo.thmInfo { t with value := mkConst ``True.intro })\",\n\t\t\t\t\"    | _ => none\",\n\t\t\t\t'  saveModuleData s!\"{library}/Proofs.olean\" `Verdicts.Proofs',\n\t\t\t\t\"    { proofs with constNames := theorems.map (·.name), constants := theorems }\",\n\t\t\t\t\"\",\n\t\t\t].join(\"\\n\"),\n\t\t);\n\t\twriteFileSync(\n\t\t\tjoin(copy, \"Verdicts.lean\"),\n\t\t\t`${readFileSync(join(copy, \"Verdicts.lean\"), \"utf8\")}import Verdicts.Overwrite\\n`,\n\t\t);\n\t\tconst { status, output, report } = await checkLean(copy);\n\t\tassert.equal(report?.verdict, \"refused\", `a theorem declared twice is not proved: ${output}`);\n\t\tassert.notEqual(status, 0);\n\t\tassert.match(\n\t\t\treport.reasons.join(\"\\n\"),\n\t\t\t/Verdicts\\.allPassRejectsBlocking is declared by Verdicts\\.Sorried and again by Verdicts\\.Proofs/,\n\t\t);\n\t});\n\n\tit(\"the build of the proofs writes nowhere outside its copy and reaches no network\", async () => {\n\t\tconst copy = projectCopy(\"lean-confined-\", cleanups);\n\t\tconst name = `495-lean-escape-${process.pid}-${Date.now()}`;\n\t\tconst outside = [join(tmpdir(), name), join(\"/tmp\", name)];\n\t\tcleanups.push(...outside);\n\t\tlet connections = 0;\n\t\tconst server = createServer((socket) => {\n\t\t\tconnections += 1;\n\t\t\tsocket.destroy();\n\t\t});\n\t\tawait new Promise<void>((listening) => server.listen(0, \"127.0.0.1\", listening));\n\t\tconst { port } = server.address() as { port: number };\n\t\tappendToProofs(\n\t\t\tcopy,\n\t\t\t[\n\t\t\t\t\"#eval show IO Unit from do\",\n\t\t\t\t`  for path in [${outside.map((p) => JSON.stringify(p)).join(\", \")}] do`,\n\t\t\t\t'    try IO.FS.writeFile path \"written by a proof\" catch _ => pure ()',\n\t\t\t\t`  let connect := \"IO::Socket::INET->new(PeerAddr => q{127.0.0.1:${port}}, Timeout => 2)\"`,\n\t\t\t\t'  try discard <| IO.Process.output { cmd := \"/usr/bin/perl\", args := #[\"-MIO::Socket::INET\", \"-e\", connect] }',\n\t\t\t\t\"  catch _ => pure ()\",\n\t\t\t].join(\"\\n\"),\n\t\t);\n\t\tconst { output, report } = await checkLean(copy);\n\t\tawait new Promise((settled) => setTimeout(settled, 200));\n\t\tserver.close();\n\t\tassert.equal(report?.verdict, \"proved\", `the approved proofs still build under the confinement: ${output}`);\n\t\tfor (const path of outside) assert.ok(!existsSync(path), `the build wrote ${path}`);\n\t\tassert.equal(connections, 0, \"the build reached a listener of the host\");\n\t});\n\n\tit(\"a build that rewrites a protected file is refused\", async () => {\n\t\tconst copy = projectCopy(\"lean-rewrite-\", cleanups);\n\t\tappendToProofs(\n\t\t\tcopy,\n\t\t\t[\n\t\t\t\t\"#eval show IO Unit from do\",\n\t\t\t\t'  IO.FS.writeFile \"Verdicts/Statements.lean\" ((← IO.FS.readFile \"Verdicts/Statements.lean\") ++ \"\\\\n\")',\n\t\t\t].join(\"\\n\"),\n\t\t);\n\t\tconst { status, output, report } = await checkLean(copy);\n\t\tassert.equal(report?.verdict, \"refused\", `a protected file rewritten by the build is refused: ${output}`);\n\t\tassert.notEqual(status, 0);\n\t\tassert.match(\n\t\t\treport.reasons.join(\"\\n\"),\n\t\t\t/the build rewrote a protected file: Verdicts\\/Statements\\.lean is sha256:\\w+/,\n\t\t);\n\t\tconst statements = report.protected.find((p) => p.file === \"Verdicts/Statements.lean\");\n\t\tassert.ok(statements && statements.before === statements.approved && statements.after !== statements.approved);\n\t});\n\n\tit(\"a definition that proves the approved statement is not a theorem and is refused\", async () => {\n\t\tconst copy = projectCopy(\"lean-definition-\", cleanups);\n\t\tconst proofs = join(copy, \"Verdicts\", \"Proofs.lean\");\n\t\twriteFileSync(proofs, readFileSync(proofs, \"utf8\").replace(\"theorem anyPassKeepsPass :\", \"def anyPassKeepsPass :\"));\n\t\tconst { status, output, report } = await checkLean(copy);\n\t\tassert.equal(report?.verdict, \"refused\", `a definition is not taken for a theorem: ${output}`);\n\t\tassert.notEqual(status, 0);\n\t\tassert.deepEqual(theoremOf(report, \"anyPassKeepsPass\")?.refused, [\n\t\t\t\"Verdicts.anyPassKeepsPass is definition, not a theorem\",\n\t\t]);\n\t});\n\n\tit(\"a theorem whose statement comes from an unprotected module is refused\", async () => {\n\t\tconst copy = projectCopy(\"lean-unprotected-\", cleanups);\n\t\tconst proofs = join(copy, \"Verdicts\", \"Proofs.lean\");\n\t\twriteFileSync(\n\t\t\tproofs,\n\t\t\treadFileSync(proofs, \"utf8\").replace(\n\t\t\t\t/\\nend Verdicts\\s*$/,\n\t\t\t\t\"\\ndef Extra : Prop := True\\n\\ntheorem extra : Extra := trivial\\n\\nend Verdicts\\n\",\n\t\t\t),\n\t\t);\n\t\tconst manifest = JSON.parse(readFileSync(join(copy, \"manifest.json\"), \"utf8\")) as {\n\t\t\ttheorems: { theorem: string; statement: string }[];\n\t\t};\n\t\tmanifest.theorems.push({ theorem: \"Verdicts.extra\", statement: \"Verdicts.Extra\" });\n\t\twriteFileSync(join(copy, \"manifest-extra.json\"), JSON.stringify(manifest));\n\t\tconst { status, output, report } = await checkLean(copy, { manifest: join(copy, \"manifest-extra.json\") });\n\t\tassert.equal(report?.verdict, \"refused\", `a statement outside the protected files is refused: ${output}`);\n\t\tassert.notEqual(status, 0);\n\t\tassert.deepEqual(theoremOf(report, \"extra\")?.refused, [\n\t\t\t\"Verdicts.Extra comes from Verdicts.Proofs, not from a protected file\",\n\t\t]);\n\t});\n});\n\ndescribe(\"the toolchain of the Lean check\", () => {\n\tit(\"a toolchain that does not print the approved version and commit is refused before anything is built\", async () => {\n\t\tconst toolchain = outputDir(\"lean-toolchain-\", cleanups);\n\t\tmkdirSync(join(toolchain, \"bin\"));\n\t\twriteFileSync(\n\t\t\tjoin(toolchain, \"bin\", \"lean\"),\n\t\t\t\"#!/bin/sh\\necho 'Lean (version 4.0.0, arm64-apple-darwin, commit 0000000000000000000000000000000000000000, Release)'\\n\",\n\t\t\t{ mode: 0o755 },\n\t\t);\n\t\tconst { status, output, report } = await checkLean(undefined, { toolchain });\n\t\tassert.equal(report?.verdict, \"error\", `another toolchain is refused: ${output}`);\n\t\tassert.equal(status, 3);\n\t\tassert.match(\n\t\t\treport.reasons.join(\"\\n\"),\n\t\t\t/capability missing: .*prints Lean \\(version 4\\.0\\.0.*, not version 4\\.34\\.1 at commit 5045d005/,\n\t\t);\n\t\tassert.equal(report.replay, null, \"nothing is built nor replayed\");\n\t});\n});\n"},"test/v4-platform/lean-verdict-differential.test.ts":{"tests":[{"id":"2","name":"test/v4-platform/lean-verdict-differential.test.ts"}],"source":"import { strict as assert } from \"node:assert\";\nimport { cpSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { pathToFileURL } from \"node:url\";\nimport { isDeepStrictEqual } from \"node:util\";\nimport { VERDICTS, type Verdict } from \"../../src/contracts/v1/common.ts\";\nimport type { evaluateG5 } from \"../../src/domain/gates/g5.ts\";\nimport { outputDir, removedAfterEach } from \"../helpers/fixtures.ts\";\nimport { mandatoryOutcome, observeG5, requirementOutcome } from \"../helpers/g5-combination.ts\";\nimport { type CombinationCase, leanCombine, leanMissing } from \"../helpers/lean-verdicts.ts\";\n\nconst REPOSITORY = join(import.meta.dirname, \"..\", \"..\");\n/** Every list of verdicts up to this length is compared, under both rules. */\nconst EXHAUSTIVE_BOUND = 4;\n/** The seeds of the longer lists, kept so that a divergence they find is replayed as it was found. */\nconst SEEDS = [495, 20261010, 11];\nconst GENERATED_PER_SEED = 100;\nconst GENERATED_LENGTHS = { min: EXHAUSTIVE_BOUND + 1, max: 16 };\nconst MODES = [\"all\", \"any\"] as const;\n/** The line of `combine` in `g5.ts` that leaves an obligation with no verdict NOT_RUN. */\nconst EMPTY_LIST_LINE = 'if (v.length === 0) return verdicts.length === 0 ? \"NOT_RUN\" : \"NOT_APPLICABLE\";';\n\nconst cleanups = removedAfterEach();\n\n/** Every case of length 0 to `bound`, shortest first: the first divergence found is a minimal one. */\nfunction exhaustive(bound: number): CombinationCase[] {\n\tconst cases: CombinationCase[] = [];\n\tlet lists: Verdict[][] = [[]];\n\tfor (let length = 0; length <= bound; length++) {\n\t\tfor (const verdicts of lists) for (const mode of MODES) cases.push({ mode, verdicts });\n\t\tlists = lists.flatMap((l) => VERDICTS.map((v) => [...l, v]));\n\t}\n\treturn cases;\n}\n\n/** Longer lists drawn from a seeded generator (mulberry32), reproducible from the seed alone. */\nfunction generated(seed: number, count: number): CombinationCase[] {\n\tlet state = seed >>> 0;\n\tconst next = (): number => {\n\t\tstate = (state + 0x6d2b79f5) >>> 0;\n\t\tlet t = state;\n\t\tt = Math.imul(t ^ (t >>> 15), t | 1);\n\t\tt ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n\t\treturn ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n\t};\n\tconst pick = <T>(items: readonly T[]): T => items[Math.floor(next() * items.length)] as T;\n\treturn Array.from({ length: count }, () => {\n\t\tconst length = GENERATED_LENGTHS.min + Math.floor(next() * (GENERATED_LENGTHS.max - GENERATED_LENGTHS.min + 1));\n\t\treturn { mode: pick(MODES), verdicts: Array.from({ length }, () => pick(VERDICTS)) };\n\t});\n}\n\n/** The declared corpus: the approved table's cases, every list up to the bound, then the generated ones. */\nfunction corpus(): CombinationCase[] {\n\tconst table = JSON.parse(\n\t\treadFileSync(join(REPOSITORY, \"specs\", \"formal\", \"verdicts\", \"correspondance.json\"), \"utf8\"),\n\t) as { rules: { cases: CombinationCase[] }[] };\n\tconst tabled = table.rules.flatMap((r) => r.cases);\n\treturn [...exhaustive(EXHAUSTIVE_BOUND), ...SEEDS.flatMap((s) => generated(s, GENERATED_PER_SEED)), ...tabled];\n}\n\n/**\n * What G5 lets be seen of one combination: the outcome of a mandatory requirement; for an optional one, the verdict of\n * G5 when it is the only obligation, and the verdict it reports beside a mandatory requirement held INDETERMINATE —\n * G5 keeps its reasons only when it does not pass; and the outcome of a mandatory requirement beside an any_pass\n * obligation of PASS and FAIL, which must neither change it nor be changed by it.\n */\nfunction observed(c: CombinationCase, g5: typeof evaluateG5): unknown {\n\tconst alone = observeG5([{ mandatory: false, ...c }], g5);\n\tconst held = observeG5(\n\t\t[\n\t\t\t{ mandatory: false, ...c },\n\t\t\t{ mandatory: true, mode: \"all\", verdicts: [\"INDETERMINATE\"] },\n\t\t],\n\t\tg5,\n\t);\n\tconst prefix = \"optional requirement R1: \";\n\tconst reported = held.reasons.find((r) => r.startsWith(prefix))?.slice(prefix.length) ?? \"PASS\";\n\tconst beside = observeG5(\n\t\t[\n\t\t\t{ mandatory: true, mode: \"any\", verdicts: [\"PASS\", \"FAIL\"] },\n\t\t\t{ mandatory: true, ...c },\n\t\t],\n\t\tg5,\n\t);\n\treturn {\n\t\tmandatory: requirementOutcome(observeG5([{ mandatory: true, ...c }], g5), 0),\n\t\toptional: { alone: alone.verdict, outcome: requirementOutcome(held, 0), reported },\n\t\tbeside_any_pass: {\n\t\t\tany_pass: requirementOutcome(beside, 0),\n\t\t\tother: requirementOutcome(beside, 1),\n\t\t\tg5: beside.verdict,\n\t\t},\n\t};\n}\n\n/** What G5 must let be seen when the combination is the verdict the Lean reference gives. */\nfunction expected(combined: Verdict): unknown {\n\tconst outcome = mandatoryOutcome(combined);\n\treturn {\n\t\tmandatory: outcome,\n\t\toptional: { alone: \"PASS\", outcome: \"PASS\", reported: combined },\n\t\tbeside_any_pass: { any_pass: \"PASS\", other: outcome, g5: outcome },\n\t};\n}\n\n/** The first case, in the corpus's order, where G5 does not show what the reference says; null when none. */\nfunction firstDivergence(\n\tcases: readonly CombinationCase[],\n\treference: readonly Verdict[],\n\tg5: typeof evaluateG5,\n): { case: CombinationCase; lean: Verdict; expected: unknown; observed: unknown } | null {\n\tfor (const [i, c] of cases.entries()) {\n\t\tconst lean = reference[i] as Verdict;\n\t\tconst seen = observed(c, g5);\n\t\tif (!isDeepStrictEqual(seen, expected(lean))) return { case: c, lean, expected: expected(lean), observed: seen };\n\t}\n\treturn null;\n}\n\n/** `evaluateG5` from a disposable copy of `src/` whose `combine` accepts an obligation with no verdict. */\nasync function acceptingTheEmptyList(): Promise<typeof evaluateG5> {\n\tconst copy = outputDir(\"g5-mutant-\", cleanups);\n\tcpSync(join(REPOSITORY, \"src\"), copy, { recursive: true });\n\tconst g5 = join(copy, \"domain\", \"gates\", \"g5.ts\");\n\tconst source = readFileSync(g5, \"utf8\");\n\tassert.ok(source.includes(EMPTY_LIST_LINE), \"the line the mutant r