\t\tconsole.log(`   #${r.sequence} protocol.frozen control_ids=${JSON.stringify(p.control_ids)}`);\n\t\tfor (const c of p.controls ?? []) console.log(`      control ${c.control_id ?? c.id} cmd=${JSON.stringify(c.command)?.slice(0, 160)}`);\n\t}\n\tif (r.type === \"artifact.proposed\" && r.p.ref?.content_digest) {\n\t\tconst o = object(r.p.ref.content_digest);\n\t\tconst stack = o && JSON.stringify(o).match(/\"stack\":\"([^\"]+)\"/);\n\t\tif (stack) console.log(`   #${r.sequence} artifact ${r.p.kind} ${r.p.ref.artifact_id} carries stack=${stack[1]}`);\n\t}\n\tif (r.type === \"evidence.recorded\") console.log(`   #${r.sequence} evidence.recorded ${r.p.control_id ?? \"\"} ${JSON.stringify(r.p.evidence?.verdict ?? r.p.verdict ?? \"\")}`);\n== e12s01-c3-les-deux\nconfig.json\ndriver.log\nexports\nlocks\nlogs\nobjects\nstate.sqlite\nstate.sqlite-shm\nstate.sqlite-wal\nworkspaces\n== e12s01-n1-les-deux-main\nconfig.json\ndriver.log\nexports\nlocks\nlogs\nobjects\nstate.sqlite\nstate.sqlite-shm\nstate.sqlite-wal\nworkspaces\n== e12s01-c4-aucun\nconfig.json\ndriver.log\nexports\nlocks\nlogs\nobjects\nstate.sqlite\nstate.sqlite-shm\nstate.sqlite-wal\nworkspaces\nShell cwd was reset to /Users/jeanjerome/Projets/495-pi-package","is_error":false}]},"parent_tool_use_id":null,"session_id":"b6f8b8fc-431b-4924-bdb9-176ab1970ab0","uuid":"eb83c341-c322-45c7-9ca3-79636652722e","timestamp":"2026-09-30T00:53:48.482Z","tool_use_result":{"stdout":"// Reads one dossier back, read-only, from SQLite and the object store: the change's phase and gates,\n// the frozen protocol's controls, the evidence recorded per control, and every capability-missing\n// reason found in the change's events. Usage: node e12s01-lire.mjs <dossier>\nimport { existsSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { DatabaseSync } from \"node:sqlite\";\n\nconst [dir] = process.argv.slice(2);\nconst db = new DatabaseSync(join(dir, \"state.sqlite\"), { readOnly: true });\nconst object