ment":"{}","status":"Timeout","static":false,"coveredBy":["1","2"],"location":{"end":{"column":2,"line":63},"start":{"column":67,"line":61}}},{"id":"18","mutatorName":"ConditionalExpression","replacement":"false","status":"Timeout","static":false,"coveredBy":["1","2"],"location":{"end":{"column":114,"line":158},"start":{"column":28,"line":158}}},{"id":"21","mutatorName":"ArrowFunction","replacement":"() => undefined","status":"Timeout","static":false,"coveredBy":["1","2"],"location":{"end":{"column":89,"line":158},"start":{"column":48,"line":158}}},{"id":"1","mutatorName":"ArrowFunction","replacement":"() => undefined","status":"Timeout","static":false,"coveredBy":["1","2"],"location":{"end":{"column":72,"line":31},"start":{"column":41,"line":31}}},{"id":"5","mutatorName":"MethodExpression","replacement":"s.normalize(\"NFKD\").toLowerCase()","status":"Timeout","static":false,"coveredBy":["1","2"],"location":{"end":{"column":42,"line":66},"start":{"column":9,"line":66}}},{"id":"16","mutatorName":"ArrowFunction","replacement":"() => undefined","status":"Timeout","static":false,"coveredBy":["1","2"],"location":{"end":{"column":114,"line":158},"start":{"column":21,"line":158}}}],"source":"import type { CandidateManifest, ManifestEntry } from \"../../contracts/v1/candidate.ts\";\nimport type { CandidateFacts } from \"../change/commands.ts\";\nimport type { ChangeState, NextAction } from \"../change/state.ts\";\n\nexport interface G4Result {\n\tverdict: \"PASS\" | \"FAIL\";\n\treasons: string[];\n\tnext_action: NextAction;\n}\n\n/**\n * G4 — the candidate is complete, in scope, did not alter a protected control (SEC-03, RM-043) and\n * changed nothing of a submodule, whose files the project's repository cannot carry (§9.1).\n */\nexport function evaluateG4(state: ChangeState, facts: CandidateFacts): G4Result {\n\tconst reasons: string[] = [];\n\tif (!facts.complete)\n\t\treasons.push(`candidate observation incomplete: ${facts.limits_notes.join(\"; \") || \"unknown limit\"}`);\n\tfor (const p of facts.altered_protected_paths) reasons.push(`protected path altered by the producer: ${p}`);\n\tconst allowed = state.mandate?.allowed_paths ?? [];\n\tconst outOfScope = new Set(facts.out_of_scope_paths);\n\tif (allowed.length > 0)\n\t\tfor (const p of facts.changed_paths) if (!allowed.some((a) => matchesScope(p, a))) outOfScope.add(p);\n\tfor (const p of outOfScope) reasons.push(`path outside the mandate scope: ${p}`);\n\tfor (const { path, submodule } of facts.submodule_paths)\n\t\treasons.push(`path in submodule ${submodule}, which the project's repository cannot carry: ${path}`);\n\tconst allowedProtected = new Set(facts.allowed_protected_paths);\n\tif (state.protocol)\n\t\tfor (const p of facts.changed_paths)\n\t\t\tif (\n\t\t\t\tstate.protocol.protected_paths.some((pp) => matchesProtected(p, pp)) &&\n\t\t\t\t!facts.altered_protected_paths.includes(p) &&\n\t\t\t\t!allowedProtected.has(p)\n\t\t\t)\n\t\t\t\treasons.push(`protected path altered by the producer: ${p}`);\n\tif (reasons.length === 0) return { verdict: \"PASS\", reasons: [], next_action: \"verify\" };\n\treturn { verdict: \"FAIL\", reasons: [...new Set(reasons)], next_action: \"correct_or_reject\" };\n}\n\n/** Scope entries are directory prefixes (`src/`), exact files, or simple `*` globs on one segment. */\nexport function matchesScope(path: string, pattern: string): boolean {\n\tif (pattern === \"\" || pattern === \".\" || pattern === \"**\") return true;\n\tif (pattern.endsWith(\"/\")) return path === pattern.slice(0, -1) || path.startsWith(pattern);\n\tif (pattern.includes(\"*\")) {\n\t\tconst re = new RegExp(\n\t\t\t`^${pattern\n\t\t\t\t.split(\"**\")\n\t\t\t\t.map((p) => p.split(\"*\").map(escapeRe).join(\"[^/]*\"))\n\t\t\t\t.join(\".*\")}$`,\n\t\t);\n\t\treturn re.test(path);\n\t}\n\treturn path === pattern || path.startsWith(`${pattern}/`);\n}\n\n/**\n * Whether `path` names what the protected `pattern` names on a volume that ignores case and Unicode form, as macOS\n * does by default: a tool that opens `stryker.conf.json` there reads `Stryker.conf.json` or `ſtryker.conf.json`.\n * Folding both sides refuses more on a volume that tells them apart, never less.\n */\nfunction matchesProtected(path: string, pattern: string): boolean {\n\treturn matchesScope(foldName(path), foldName(pattern));\n}\n\nfunction foldName(s: string): string {\n\treturn s.normalize(\"NFKD\").toUpperCase().toLowerCase();\n}\n\nfunction escapeRe(s: string): string {\n\treturn s.replace(/[.+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n}\n\nexport interface ProtectedPaths {\n\t/** Every path this candidate changed, whatever it is. */\n\tchanged: string[];\n\t/** The changed paths but a prepared or complement file the candidate holds as the kernel wrote it. */\n\tproduced: string[];\n\t/** Changes to a protected path the frozen protocol allows. */\n\tallowed: string[];\n\t/** Changes to a protected path nothing allows: the producer altered an oracle. */\n\taltered: string[];\n}\n\n/**\n * Each path a candidate changed under a submodule of the reference, or the boundary itself, with that\n * submodule: its files belong to another repository, and a commit of the project cannot carry them.\n */\nexport function submodulePathsChanged(\n\tmanifest: CandidateManifest,\n\treference: readonly ManifestEntry[],\n): CandidateFacts[\"submodule_paths\"] {\n\tconst submodules = reference.filter((e) => e.kind === \"submodule\").map((e) => e.path);\n\treturn manifest.entries.flatMap((e) => {\n\t\tif (e.baseline_state === \"unchanged\") return [];\n\t\tconst submodule = submodules.find((s) => e.path === s || e.path.startsWith(`${s}/`));\n\t\treturn submodule === undefined ? [] : [{ path: e.path, submodule }];\n\t});\n}\n\n/**\n * Whether a path or a directory pattern lies below one of `directories`, where the technologies of the list install\n * their dependencies, at the project root or in a workspace package.\n */\nexport function inInstalledDependencies(path: string, directories: readonly string[]): boolean {\n\treturn path.split(\"/\").some((segment) => directories.includes(segment));\n}\n\n/**\n * Splits what a candidate changed against the paths the frozen protocol protects (SEC-03, RM-043).\n * Three changes to a protected path are allowed: a prepared file or a file of an adopted complement\n * put back exactly as the kernel wrote it, which the producer did not touch, and which is altered\n * under any other digest; a file the kernel did not write, added under a protected directory, which\n * took nothing away from an oracle that already stood, unless the\n * protected directory is itself an installed dependency, where a new file can shadow a package the\n * checks load; and whatever `alsoAllowed` recognizes, which is where a target's own layout\n * conventions are read rather than written into the kernel. A file of an adopted complement that the\n * candidate holds as the reference has it is altered too, and so is one the candidate no longer holds\n * at all: the manifest lists every file of the candidate, so a complement file it lacks was removed,\n * whether the reference had it or not.\n */\nexport function protectedPathsChanged(\n\tmanifest: CandidateManifest,\n\tprotectedPaths: readonly string[],\n\tpreparedFiles: readonly { path: string; digest: string }[],\n\tinstalledDependencies: readonly string[],\n\talsoAllowed: (path: string) => boolean = () => false,\n\tcomplements: readonly { path: string; digest: string }[] = [],\n): ProtectedPaths {\n\tconst entryOf = (path: string) => manifest.entries.find((e) => e.path === path);\n\tconst changed = manifest.entries.filter((e) => e.baseline_state !== \"unchanged\").map((e) => e.path);\n\tconst writtenAt = (path: string) => [...preparedFiles, ...complements].find((f) => f.path === path);\n\tconst asWritten = changed.filter((p) => {\n\t\tconst kept = writtenAt(p);\n\t\treturn kept !== undefined && kept.digest === (entryOf(p)?.content_digest ?? null);\n\t});\n\tconst allowed = changed.filter((p) => {\n\t\tconst entry = entryOf(p);\n\t\tif (writtenAt(p)) return asWritten.includes(p);\n\t\tif (\n\t\t\tentry?.baseline_state === \"added\" &&\n\t\t\tprotectedPaths.some(\n\t\t\t\t(pattern) =>\n\t\t\t\t\tpattern.endsWith(\"/\") &&\n\t\t\t\t\t!inInstalledDependencies(pattern, installedDependencies) &&\n\t\t\t\t\tmatchesProtected(p, pattern),\n\t\t\t)\n\t\t)\n\t\t\treturn true;\n\t\treturn alsoAllowed(p);\n\t});\n\tconst restored = complements\n\t\t.map((c) => c.path)\n\t\t.filter((p) => {\n\t\t\tconst entry = entryOf(p);\n\t\t\treturn entry === undefined || entry.baseline_state === \"unchanged\";\n\t\t});\n\tconst altered = [\n\t\t...changed.filter((p) => protectedPaths.some((pattern) => matchesProtected(p, pattern)) && !allowed.includes(p)),\n\t\t...restored,\n\t];\n\treturn { changed, produced: changed.filter((p) => !asWritten.includes(p)), allowed, altered };\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/v4-platform/node-mutation.test.ts":{"tests":[{"id":"0","name":"test/v4-platform/node-mutation.test.ts"}],"source":"/**\n * The mutation control of a Node target that installed Stryker 10.0.0 for real, qualified on its witnesses through\n * the generic runner and the platform sandbox: Stryker installed with npm at its exact version, without install\n * scripts, in a `node --test` target, the one step that opens the network running once outside the sandbox.\n */\nimport { strict as assert } from \"node:assert\";\nimport { execFileSync } from \"node:child_process\";\nimport { cpSync, existsSync, readdirSync, rmSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { after, before, describe, it } from \"node:test\";\nimport { GenericControlRunner } from \"../../src/adapters/execution/runner.ts\";\nimport { CasObjectStore } from \"../../src/adapters/object-store/cas.ts\";\nimport { selectSandbox } from \"../../src/adapters/sandbox/backends.ts\";\nimport { type DetailedQualification, qualifyControlDetailed } from \"../../src/application/qualification.ts\";\nimport type { DetectedTechnology } from \"../../src/application/stacks/stack.ts\";\nimport type { EvidenceCandidate } from \"../../src/contracts/v1/evidence.ts\";\nimport { invocationBase } from \"../helpers/execution-fixture.ts\";\nimport { NO_QUALIFIED_SANDBOX, outputDir, removedAfterEach, writeFiles } from \"../helpers/fixtures.ts\";\nimport { READERS_OF_495, STACKS_OF_495 } from \"../helpers/technologies.ts\";\n\nconst REFS = [{ requirement_id: \"VER-04\", revision: 1 }];\nconst BASE = invocationBase();\n\n/** A `node --test` target in TypeScript 7, whose `tsconfig.json` Stryker 10 would rewrite through an API TypeScript 7 no longer has. */\nconst TARGET: Record<string, string> = {\n\t\"package.json\": `${JSON.stringify({ name: \"mutated\", version: \"1.0.0\", type: \"module\", scripts: { test: \"node --test\" } }, null, 2)}\\n`,\n\t\"tsconfig.json\": `${JSON.stringify({ compilerOptions: { strict: true, noEmit: true, allowJs: true }, include: [\"src\"] }, null, 2)}\\n`,\n};\n\n/** Installs `packages` in `project` as an adoption installs them: each at its exact version, as a development dependency, without install scripts. */\nfunction installed(project: string, packages: readonly string[]): void {\n\texecFileSync(\n\t\t\"npm\",\n\t\t[\"install\", \"--save-dev\", \"--save-exact\", \"--ignore-scripts\", \"--no-audit\", \"--no-fund\", ...packages],\n\t\t{ cwd: project, stdio: \"ignore\", timeout: 10 * 60_000 },\n\t);\n}\n\n/** What a qualification printed, every run's standard output and error read back from the object store. */\nasync function outputsOf(objects: CasObjectStore, evidence: readonly EvidenceCandidate[]): Promise<string> {\n\tconst texts: string[] = [];\n\tfor (const run of evidence)\n\t\tfor (const artifact of run.artifacts.filter((a) => a.name === \"stdout\" || a.name === \"stderr\")) {\n\t\t\tconst bytes = await objects.get(artifact.ref);\n\t\t\ttexts.push(bytes === null ? \"\" : new TextDecoder().decode(bytes));\n\t\t}\n\treturn texts.join(\"\\n\");\n}\n\n/**\n * The mutation control `detection` declares on `reference`, qualified on its witnesses: the positive copy carries the\n * shared positive witness and `positiveExtra`, the negative one the mutation's own negative witness on top.\n */\nasync function qualifiedMutation(\n\troot: string,\n\treference: string,\n\tdetection: DetectedTechnology,\n\tpositiveExtra: Record<string, string> = {},\n): Promise<{ detailed: DetailedQualification; outputs: string; positive: string }> {\n\tconst mutation = detection.controls.find((c) => c.control_id === \"mutation\");\n\tassert.ok(mutation, `the target that installed Stryker gets the mutation control: ${detection.capability_missing}`);\n\tconst own = detection.own_negative_witness.mutation;\n\tassert.ok(own, \"the mutation control has a negative witness of its own\");\n\tconst positive = join(root, \"mutation-positive\");\n\tconst negative = join(root, \"mutation-negative\");\n\tfor (const workspace of [positive, negative]) {\n\t\tcpSync(reference, workspace, { recursive: true });\n\t\twriteFiles(workspace, detection.positive_witness);\n\t}\n\twriteFiles(positive, positiveExtra);\n\twriteFiles(negative, own);\n\tconst objects = new CasObjectStore(join(root, \"objects\"));\n\tconst sandbox = selectSandbox({ allow_unconfined: NO_QUALIFIED_SANDBOX });\n\tconst runner = new GenericControlRunner(sandbox.backend, objects, READERS_OF_495, {\n\t\tworkspace_of: (workspacePath) => STACKS_OF_495.workspaceOf(workspacePath),\n\t});\n\tconst detailed = await qualifyControlDetailed(\n\t\trunner,\n\t\tmutation,\n\t\t{\n\t\t\tpositive_path: positive,\n\t\t\tnegative_path: negative,\n\t\t\tpositive_files: { ...detection.positive_witness, ...positiveExtra },\n\t\t\tnegative_files: { ...detection.positive_witness, ...own },\n\t\t},\n\t\tBASE,\n\t);\n\tconst { evidence } = detailed;\n\treturn { detailed, outputs: await outputsOf(objects, [evidence.positive, evidence.negative]), positive };\n}\n\ndescribe(\"the mutation control of a Node target that installed Stryker 10.0.0\", () => {\n\tconst cleanups = removedAfterEach();\n\tconst shared: string[] = [];\n\tlet installedTarget = \"\";\n\tbefore(() => {\n\t\tconst root = outputDir(\"node-mutation-target-\");\n\t\tshared.push(root);\n\t\tinstalledTarget = join(root, \"target\");\n\t\twriteFiles(installedTarget, TARGET);\n\t\tinstalled(installedTarget, [\"@stryker-mutator/core@10.0.0\", \"typescript@7.0.2\"]);\n\t});\n\tafter(() => {\n\t\tfor (const dir of shared) rmSync(dir, { recursive: true, force: true });\n\t});\n\n\tit(\"sur une cible qui porte TypeScript 7.0.2 et un tsconfig.json, le contrôle de mutation est qualifié : témoin positif PASS, témoin négatif FAIL, et aucune sortie ne nomme parseConfigFileTextToJson\", async () => {\n\t\tconst root = outputDir(\"node-mutation-ts7-\", cleanups);\n\t\tconst reference = join(root, \"reference\");\n\t\tcpSync(installedTarget, reference, { recursive: true });\n\t\tconst detection = STACKS_OF_495.recognise(reference, REFS);\n\t\tconst { detailed, outputs } = await qualifiedMutation(root, reference, detection);\n\t\tconst q = detailed.qualification;\n\t\tassert.deepEqual([q.positive, q.negative], [\"PASS\", \"FAIL\"], JSON.stringify(q.notes));\n\t\tassert.equal(outputs.includes(\"parseConfigFileTextToJson\"), false, outputs.slice(-4000));\n\t});\n\n\tit(\"un test en échec dans la copie du témoin positif fait le témoin FAIL, et ne laisse aucun dossier sous .stryker-tmp dans cette copie\", async () => {\n\t\tconst root = outputDir(\"node-mutation-failing-\", cleanups);\n\t\tconst reference = join(root, \"reference\");\n\t\tcpSync(installedTarget, reference, { recursive: true });\n\t\tconst detection = STACKS_OF_495.recognise(reference, REFS);\n\t\tconst { detailed, positive } = await qualifiedMutation(root, reference, detection, {\n\t\t\t\"test/broken.test.js\":\n\t\t\t\t'import { strict as assert } from \"node:assert\";\\nimport { test } from \"node:test\";\\n\\ntest(\"a test that fails\", () => assert.fail(\"broken\"));\\n',\n\t\t});\n\t\tassert.equal(detailed.qualification.positive, \"FAIL\", JSON.stringify(detailed.qualification.notes));\n\t\tconst temporary = join(positive, \".stryker-tmp\");\n\t\tassert.deepEqual(existsSync(temporary) ? readdirSync(temporary) : [], [], \"no working copy of Stryker is left\");\n\t});\n\n\tit(\"sous une borne qui écarte test/nested/sandbox.test.js, en échec, le témoin positif de la mutation est PASS et la sortie de Stryker ne nomme pas test/nested/sandbox.test.js\", async () => {\n\t\tconst root = outputDir(\"node-mutation-bound-\", cleanups);\n\t\tconst reference = join(root, \"reference\");\n\t\tcpSync(installedTarget, reference, { recursive: true });\n\t\twriteFiles(reference, {\n\t\t\t\"test/nested/sandbox.test.js\":\n\t\t\t\t'import { strict as assert } from \"node:assert\";\\nimport { test } from \"node:test\";\\n\\ntest(\"a test that fails confined\", () => assert.fail(\"confined\"));\\n',\n\t\t});\n\t\tconst detection = STACKS_OF_495.recognise(reference, REFS, process.execPath, [], undefined, [\n\t\t\t\"test/*.test.js\",\n\t\t\t\"test/*.test.mjs\",\n\t\t]);\n\t\tconst { detailed, outputs } = await qualifiedMutation(root, reference, detection);\n\t\tassert.equal(detailed.qualification.positive, \"PASS\", JSON.stringify(detailed.qualification.notes));\n\t\tassert.equal(outputs.includes(\"test/nested/sandbox.test.js\"), false, outputs.slice(-4000));\n\t});\n});\n"},"test/v2-kernel/preparation.test.ts":{"tests":[{"id":"1","name":"test/v2-kernel/preparation.test.ts"}],"source":"import { strict as assert } from \"node:assert\";\nimport { rmSync, existsSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { makeHarness, specReport, type TestHarness, trackedProject } from \"../helpers/harness-fixture.ts\";\nimport {\n\tfixtureTs,\n\tfixtureTsWithoutTests,\n\tinitRepo,\n\ttempDir,\n\twriteFiles,\n\tfixtureMavenMultiModule,\n\tfixtureMavenHexagonal,\n\tSHOUT_IMPL,\n\tSHOUT_TEST,\n\tremovedAfterEach,\n} from \"../helpers/fixtures.ts\";\nimport { HUMAN, KERNEL } from \"../helpers/change-fixture.ts\";\nimport type { HumanOrigin } from \"../../src/contracts/v1/decision.ts\";\nimport type { Protocol } from \"../../src/contracts/v1/protocol.ts\";\nimport type { ControlExecutionPort, ControlInvocation } from \"../../src/ports/execution.ts\";\nimport { buildContext, preparationMandateObjective, preparationObjective } from \"../../src/application/context.ts\";\nimport {\n\tdiagnoseControlCapability,\n\tpreparedFilesFrom,\n\treferenceTestFiles,\n\tsamePreparationPaths,\n\ttype PreparationRecord,\n} from \"../../src/application/preparation.ts\";\nimport { GitWorkspace, DEFAULT_WORKSPACE_POLICY } from \"../../src/adapters/workspace/git-workspace.ts\";\nimport { STACKS_OF_495 } from \"../helpers/technologies.ts\";\n\nconst cleanups = removedAfterEach();\n\nconst spec = specReport({\n\tobjective: \"add shout(name) returning the greeting in upper case\",\n\trequirements: [\n\t\t{\n\t\t\trequirement_id: \"R1\",\n\t\t\tstatement: \"shout(name) returns greet(name) upper-cased\",\n\t\t\tmandatory: true,\n\t\t\tcriterion: \"unit test on shout passes\",\n\t\t\tcategory: \"functional\",\n\t\t\tsatisfied_by_reference: false,\n\t\t},\n\t\t{\n\t\t\trequirement_id: \"R2\",\n\t\t\tstatement: \"greet unchanged\",\n\t\t\tmandatory: true,\n\t\t\tcriterion: \"unit test on greet passes\",\n\t\t\tcategory: \"functional\",\n\t\t\tsatisfied_by_reference: true,\n\t\t},\n\t],\n\tdesign: { summary: \"add shout next to greet\", components: [\"greet\"], interfaces: [\"shout(name)\"], risks: [] },\n});\nconst report = (paths: string[]) => ({ summary: \"done\", changed_paths: paths, tests_claimed: false, notes: [] });\n\n/**\n * Stands in for the Stryker a target installed, as the package the mutation control imports: one mutant on the first\n * line of each range it is asked to mutate, which survives in the module no test asserts on and is killed elsewhere.\n */\nconst STRYKER_STAND_IN: Record<string, string> = {\n\t\"node_modules/@stryker-mutator/core/package.json\": JSON.stringify({\n\t\tname: \"@stryker-mutator/core\",\n\t\tversion: \"10.0.0\",\n\t\ttype: \"module\",\n\t\texports: \"./index.js\",\n\t}),\n\t\"node_modules/@stryker-mutator/core/index.js\": [\n\t\t'import { mkdirSync, writeFileSync } from \"node:fs\";',\n\t\t\"export class Stryker {\",\n\t\t\"  constructor(options) { this.options = options; }\",\n\t\t\"  async runMutationTest() {\",\n\t\t\"    const files = {};\",\n\t\t\"    for (const [id, range] of (this.options.mutate ?? []).entries()) {\",\n\t\t'      const [path, lines] = range.split(\":\");',\n\t\t'      const line = Number(lines.split(\"-\")[0]);',\n\t\t'      const status = path.includes(\"unasserted\") ? \"Survived\" : \"Killed\";',\n\t\t\"      const location = { start: { line, column: 1 }, end: { line, column: 2 } };\",\n\t\t'      (files[path] ??= { language: \"javascript\", source: \"\", mutants: [] }).mutants.push({ id: String(id), mutatorName: \"ArithmeticOperator\", replacement: \"x\", location, status });',\n\t\t\"    }\",\n\t\t'    mkdirSync(\"reports/mutation\", { recursive: true });',\n\t\t'    writeFileSync(\"reports/mutation/mutation.json\", JSON.stringify({ schemaVersion: \"2\", files }));',\n\t\t\"  }\",\n\t\t\"}\",\n\t].join(\"\\n\"),\n};\n\ndescribe(\"preparation of missing tests (SA-008, SA-009, SA-010, PRE-01..03, REC-28, REC-29)\", () => {\n\tit(\"opens preparing, adopts a discriminant prepared suite, protects it, then accepts the implementation\", async () => {\n\t\tconst p = trackedProject(fixtureTsWithoutTests);\n\t\tconst t = makeHarness({\n\t\t\tdefaultScript: { steps: [{ kind: \"complete\", output: spec }] },\n\t\t\tscripts: {\n\t\t\t\tprepare: {\n\t\t\t\t\tsteps: [\n\t\t\t\t\t\t{ kind: \"write\", path: \"test/shout.test.js\", content: SHOUT_TEST },\n\t\t\t\t\t\t{ kind: \"complete\", output: report([\"