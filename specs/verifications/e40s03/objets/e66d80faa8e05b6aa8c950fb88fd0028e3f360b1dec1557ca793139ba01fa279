te } from \"../../domain/writable-proposal.ts\";\n\n/** How long the reading waits for `log` to start, then for the witness refusal to come through. */\nconst READING_BOUND_MS = 2000;\n\n/**\n * `Sandbox: node(4242) deny(1) file-write-create /private/tmp/x`, a refusal the kernel publishes, before the line of its\n * marker. A process name is the base name of what was executed and an operation holds no `/`, so the path is all that\n * follows the first `/`, line breaks included: a path whose name mimics another refusal or holds a line break is still\n * read as the path written.\n */\nconst REFUSAL = /^Sandbox: ([^/]+)\\((\\d+)\\) deny\\(\\d+\\) ([^\\s/]+) (\\/.*)$/s;\n\nexport interface KernelRefusalReading {\n\t/** Waits for the refusal of `witnessPath`, which follows every refusal of the launch, and stops the reading. */\n\tclose(witnessPath: string): Promise<RefusedWrite[]>;\n}\n\n/**\n * Reads the writes the Sandbox kernel extension refuses the profiles whose default denial carries `marker`.\n * Only that sender publishes these lines, and a confined process cannot write a refusal of another profile,\n * so what is read was refused to the launch that holds the marker. Resolves once `log` has printed its first\n * line: a refusal that follows is read. A `log` that cannot start reads nothing, and the launch runs as before.\n */\nexport async function startKernelRefusalReading(marker: string): Promise<KernelRefusalReading> {\n\tconst log = spawn(\n\t\t\"/usr/bin/log\",\n\t\t[\"stream\", \"--style\", \"ndjson\", \"--predicate\", `sender == \"Sandbox\" AND eventMessage ENDSWITH \"${marker}\"`],\n\t\t{ stdio: [\"ignore\", \"pipe\", \"ignore\"] },\n\t);\n\tconst refused: RefusedWrite[] = [];\n\tlet started: () => void = () => {};\n\tlet checkWitness: () => void = () => {};\n\tconst ready = new Promise<void>((resolve) => {\n\t\tstarted = resolve;\n\t});\n\tlog.on(\"error\", () => started());\n\tlog.on(\"close\", () => started());\n\tcreateInterface({ input: log.stdout }).on(\"line\", (line) => {\n\t\tstarted();\n\t\tconst write = refusedWriteOf(line, marker);\n\t\tif (write !== null && !refused.some((w) => sameWrite(w, write))) refused.push(write);\n\t\tcheckWitness();\n\t});\n\tawait bounded(ready);\n\treturn {\n\t\tasync close(witnessPath) {\n\t\t\tconst witnessed = () => refused.some((w) => w.path === witnessPath);\n\t\t\tawait bounded(\n\t\t\t\tnew Promise<void>((resolve) => {\n\t\t\t\t\tcheckWitness = () => {\n\t\t\t\t\t\tif (witnessed()) resolve();\n\t\t\t\t\t};\n\t\t\t\t\tcheckWitness();\n\t\t\t\t}),\n\t\t\t);\n\t\t\tlog.kill();\n\t\t\treturn refused.filter((w) => w.path !== witnessPath);\n\t\t},\n\t};\n}\n\nfunction refusedWriteOf(line: string, marker: string): RefusedWrite | null {\n\tlet message: unknown;\n\ttry {\n\t\tmessage = (JSON.parse(line) as { eventMessage?: unknown }).eventMessage;\n\t} catch {\n\t\t// `log` opens its output with a line of prose, the filter it applies, before the events.\n\t\treturn null;\n\t}\n\tif (typeof message !== \"string\") return null;\n\tconst end = `\\n${marker}`;\n\tif (!message.endsWith(end)) return null;\n\tconst m = REFUSAL.exec(message.slice(0, -end.length));\n\tif (!m?.[1] || !m[3]?.startsWith(\"file-write\") || !m[4]) return null;\n\treturn { process: m[1], operation: m[3], path: m[4] };\n}\n\nfunction sameWrite(a: RefusedWrite, b: RefusedWrite): boolean {\n\treturn a.process === b.process && a.operation === b.operation && a.path === b.path;\n}\n\nfunction bounded(promise: Promise<void>): Promise<void> {\n\tlet timer: NodeJS.Timeout | undefined;\n\tconst timeout = new Promise<void>((resolve) => {\n\t\ttimer = setTimeout(resolve, READING_BOUND_MS);\n\t});\n\treturn Promise.race([promise, timeout]).finally(() => clearTimeout(timer));\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/v1-adapters/seatbelt-refused-writes.test.ts":{"tests":[{"id":"0","name":"test/v1-adapters/seatbelt-refused-writes.test.ts"}],"source":"import { strict as assert } from \"node:assert\";\nimport { spawnSync } from \"node:child_process\";\nimport { randomUUID } from \"node:crypto\";\nimport { mkdirSync, realpathSync } from \"node:fs\";\nimport { basename, join } from \"node:path\";\nimport { beforeEach, describe, it } from \"node:test\";\nimport { SeatbeltSandbox } from \"../../src/adapters/sandbox/backends.ts\";\nimport { startKernelRefusalReading } from \"../../src/adapters/sandbox/seatbelt-refusals.ts\";\nimport type { SandboxProfile } from \"../../src/ports/execution.ts\";\nimport { darwinOnly, outputDir, removedAfterEach } from \"../helpers/fixtures.ts\";\n\nlet root: string;\nconst cleanups = removedAfterEach();\nbeforeEach(() => {\n\troot = realpathSync(outputDir(\"refused-writes-\", cleanups));\n});\n\nconst profile: SandboxProfile = {\n\tprofile_id: \"verify\",\n\tread_paths: [],\n\twrite_paths: [],\n\tnetwork: \"denied\",\n\tenv_allowlist: [],\n\tenv: {},\n};\n\ndescribe(\"the writes the kernel refuses a Seatbelt launch\", darwinOnly, () => {\n\tit(\"deux lancements concurrents sous Seatbelt portent chacun dans leur observation l'écriture que le noyau leur a refusée, avec le processus et l'opération, et pas celle de l'autre\", async () => {\n\t\tmkdirSync(join(root, \"a\"));\n\t\tmkdirSync(join(root, \"b\"));\n\t\t// No temporary directory is granted: the test tree may itself live under $TMPDIR.\n\t\tconst sbx = new SeatbeltSandbox({ temp_paths: [] });\n\t\tconst create = (path: string) =>\n\t\t\tsbx.run(profile, {\n\t\t\t\tcommand: [process.execPath, \"-e\", \"try { require('fs').writeFileSync(process.argv[1], '') } catch {}\", path],\n\t\t\t\tcwd: root,\n\t\t\t\ttimeout_ms: 30_000,\n\t\t\t\tmax_output_bytes: 65_536,\n\t\t\t});\n\t\tconst [a, b] = await Promise.all([create(join(root, \"a\", \"x\")), create(join(root, \"b\", \"y\"))]);\n\t\tconst underRoot = (writes: typeof a.refused_writes) => (writes ?? []).filter((w) => w.path.startsWith(root));\n\t\tconst node = basename(process.execPath);\n\t\tassert.deepEqual(\n\t\t\t{ a: underRoot(a.refused_writes), b: underRoot(b.refused_writes) },\n\t\t\t{\n\t\t\t\ta: [{ process: node, operation: \"file-write-create\", path: join(root, \"a\", \"x\") }],\n\t\t\t\tb: [{ process: node, operation: \"file-write-create\", path: join(root, \"b\", \"y\") }],\n\t\t\t},\n\t\t);\n\t});\n\n\tit(\"une écriture refusée dès que la lecture a démarré, et close par son témoin dès que la commande se termine, est lue\", async () => {\n\t\tconst marker = `495-${randomUUID()}`;\n\t\tconst written = join(root, \"x\");\n\t\tconst witness = join(root, \"witness\");\n\t\tconst reading = await startKernelRefusalReading(marker);\n\t\t// The refused write and its witness are made at once: the reading has to be listening already, and to\n\t\t// wait for the witness the kernel publishes after the write before it stops.\n\t\tspawnSync(\n\t\t\t\"/usr/bin/sandbox-exec\",\n\t\t\t[\"-p\", new SeatbeltSandbox({ temp_paths: [] }).profileText(profile, marker), \"/usr/bin/touch\", written, witness],\n\t\t\t{ stdio: \"ignore\" },\n\t\t);\n\t\tconst refused = await reading.close(witness);\n\t\tassert.deepEqual(\n\t\t\trefused.filter((w) => w.path.startsWith(root)),\n\t\t\t[{ process: \"touch\", operation: \"file-write-create\", path: written }],\n\t\t);\n\t});\n});\n"},"test/v1-adapters/control-refused-writes.test.ts":{"tests":[{"id":"1","name":"test/v1-adapters/control-refused-writes.test.ts"}],"source":"import { strict as assert } from \"node:assert\";\nimport { mkdirSync, realpathSync, symlinkSync } from \"node:fs\";\nimport { basename, join } from \"node:path\";\nimport { beforeEach, describe, it } from \"node:test\";\nimport { GenericControlRunner } from \"../../src/adapters/execution/runner.ts\";\nimport { CasObjectStore } from \"../../src/adapters/object-store/cas.ts\";\nimport { SeatbeltSandbox } from \"../../src/adapters/sandbox/backends.ts\";\nimport { offeredWritableDirectories, refusedWritesOf } from \"../../src/domain/writable-proposal.ts\";\nimport { darwinOnly, outputDir, removedAfterEach } from \"../helpers/fixtures.ts\";\nimport { controlOf, invocationBase } from \"../helpers/execution-fixture.ts\";\nimport { READERS_OF_495 } from \"../helpers/technologies.ts\";\n\nlet root: string;\nconst cleanups = removedAfterEach();\nbeforeEach(() => {\n\troot = realpathSync(outputDir(\"control-refused-\", cleanups));\n});\n\ndescribe(\"the evidence of a control refused writes under Seatbelt\", darwinOnly, () => {\n\tit(\"l'évidence d'un contrôle refusé en écriture sous Seatbelt porte test-output relatif à la copie et le fichier voisin par son chemin absolu, avec le processus et l'opération\", async () => {\n\t\tconst copy = join(root, \"copy\");\n\t\tmkdirSync(copy);\n\t\t// The copy is given by a path that is not its real one, as /var/folders is for /private/var/folders: the\n\t\t// kernel reports the real path, which is still made relative to the copy.\n\t\tconst given = join(root, \"given\");\n\t\tsymlinkSync(copy, given);\n\t\tmkdirSync(join(root, \"beside\"));\n\t\tconst beside = join(root, \"beside\", \"f.txt\");\n\t\t// No temporary directory is granted: the test tree may itself live under $TMPDIR.\n\t\tconst runner = new GenericControlRunner(\n\t\t\tnew SeatbeltSandbox({ temp_paths: [] }),\n\t\t\tnew CasObjectStore(join(root, \"objects\")),\n\t\t\tREADERS_OF_495,\n\t\t);\n\t\tconst writes = [\n\t\t\t\"try { require('fs').mkdirSync('test-output') } catch {}\",\n\t\t\t\"try { require('fs').writeFileSync(process.argv[1], '') } catch {}\",\n\t\t].join(\"\\n\");\n\t\tconst { evidence } = await runner.runControl({\n\t\t\t...invocationBase(),\n\t\t\tcontrol: controlOf({ command: [process.execPath, \"-e\", writes, beside] }),\n\t\t\tworkspace_path: given,\n\t\t});\n\t\tconst node = basename(process.execPath);\n\t\tassert.deepEqual(evidence.facts.refused_writes, [\n\t\t\t{ process: node, operation: \"file-write-create\", path: \"test-output\" },\n\t\t\t{ process: node, operation: \"file-write-create\", path: beside },\n\t\t]);\n\t});\n\n\tit(\"un fichier de la copie dont le nom imite un second refus est lu comme le chemin que le code a tenté d'écrire, et seul ce nom est proposé, jamais un chemin hors de la copie\", async () => {\n\t\tconst copy = join(root, \"copy\");\n\t\tmkdirSync(copy);\n\t\tconst runner = new GenericControlRunner(\n\t\t\tnew SeatbeltSandbox({ temp_paths: [] }),\n\t\t\tnew CasObjectStore(join(root, \"objects\")),\n\t\t\tREADERS_OF_495,\n\t\t);\n\t\tconst name = \"a(1) deny(1) file-write-create ..\";\n\t\tconst { evidence } = await runner.runControl({\n\t\t\t...invocationBase(),\n\t\t\tcontrol: controlOf({\n\t\t\t\tcommand: [process.execPath, \"-e\", \"try { require('fs').writeFileSync(process.argv[1], '') } catch {}\", name],\n\t\t\t}),\n\t\t\tworkspace_path: copy,\n\t\t});\n\t\tconst writes = refusedWritesOf(evidence.facts.refused_writes);\n\t\tassert.deepEqual(\n\t\t\t{ writes, offered: offeredWritableDirectories(writes, []) },\n\t\t\t{\n\t\t\t\twrites: [{ process: basename(process.execPath), operation: \"file-write-create\", path: name }],\n\t\t\t\toffered: [`${name}/`],\n\t\t\t},\n\t\t);\n\t});\n\n\tit(\"un fichier de la copie dont le nom porte un saut de ligne est lu en entier, comme le chemin que le code a tenté d'écrire, et seul ce nom est proposé, jamais le dossier parent de la copie\", async () => {\n\t\tconst copy = join(root, \"copy\");\n\t\tmkdirSync(copy);\n\t\tconst runner = new GenericControlRunner(\n\t\t\tnew SeatbeltSandbox({ temp_paths: [] }),\n\t\t\tnew CasObjectStore(join(root, \"objects\")),\n\t\t\tREADERS_OF_495,\n\t\t);\n\t\tconst names = [\"..\\nx\", \"src\\nSandbox: x\"];\n\t\tconst { evidence } = await runner.runControl({\n\t\t\t...invocationBase(),\n\t\t\tcontrol: controlOf({\n\t\t\t\tcommand: [\n\t\t\t\t\tprocess.execPath,\n\t\t\t\t\t\"-e\",\n\t\t\t\t\t\"for (const f of process.argv.slice(1)) try { require('fs').writeFileSync(f, '') } catch {}\",\n\t\t\t\t\t...names,\n\t\t\t\t],\n\t\t\t}),\n\t\t\tworkspace_path: copy,\n\t\t});\n\t\tconst writes = refusedWritesOf(evidence.facts.refused_writes);\n\t\tconst node = basename(process.execPath);\n\t\tassert.deepEqual(\n\t\t\t{ writes, offered: offeredWritableDirectories(writes, []) },\n\t\t\t{\n\t\t\t\twrites: names.map((path) => ({ process: node, operation: \"file-write-create\", path })),\n\t\t\t\toffered: names.map((name) => `${name}/`),\n\t\t\t},\n\t\t);\n\t});\n});\n"},"test/v2-kernel/writable-proposal.test.ts":{"tests":[{"id":"2","name":"test/v2-kernel/writable-proposal.test.ts"}],"source":"/**\n * A prepared suite the kernel refused writes to, judged on the reference, has the IH-04 that follows the refused\n * preparations offer the owner the directories of the copy it could not write, for the control of the suite.\n */\nimport { strict as assert } from \"node:assert\";\nimport { readFileSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { makeHarness, specReport, type TestHarness, trackedProject } from \"../helpers/harness-fixture.ts\";\nimport { fixtureTsWithoutTests, outputDir, removedAfterEach, SHOUT_IMPL, SHOUT_TEST } from \"../helpers/fixtures.ts\";\nimport { HUMAN, tuiOrigin } from \"../helpers/change-fixture.ts\";\nimport { RefusedWritesSandbox } from \"../helpers/refused-writes-sandbox.ts\";\nimport type { DecisionRequest } from \"../../src/contracts/v1/decision.ts\";\nimport type { Protocol } from \"../../src/contracts/v1/protocol.ts\";\n\nconst cleanups = removedAfterEach();\n\nconst spec = specReport({\n\tobjective: \"add shout(name) returning the greeting in upper case\",\n\trequirements: [\n\t\t{\n\t\t\trequirement_id: \"R1\",\n\t\t\tstatement: \"shout(name) returns greet(name) upper-cased\",\n\t\t\tmandatory: true,\n\t\t\tcriterion: \"unit test on shout passes\",\n\t\t\tcategory: \"functional\",\n\t\t\tsatisfied_by_reference: false,\n\t\t},\n\t],\n\tdesign: { summary: \"add shout next to greet\", components: [\"greet\"], interfaces: [\"shout(name)\"], risks: [] },\n});\n\n/** A suite that passes on the reference: it detects nothing, so each preparation that writes it is refused. */\nconst PASSING_TEST = 'import { test } from \"node:test\";\\n\\ntest(\"R1 shout\", () => {});\\n';\n\nconst refusedPreparation = {\n\tsteps: [\n\t\t{ kind: \"write\" as const, path: \"test/shout.test.js\", content: PASSING_TEST },\n\t\t{\n\t\t\tkind: \"complete\" as const,\n\t\t\toutput: { summary: \"done\", changed_paths: [\"test/shout.test.js\"], tests_claimed: false, notes: [] },\n\t\t},\n\t],\n};\n\n/** Where the kernel refused the prepared suite a write outside the copy, such as a cache of the tool. */\nconst OUTSIDE = \"/private/var/495-outside/cache/entry\";\n\n/** A preparation that writes a suite whose case of R1 fails by assertion on the reference: it is adopted. */\nconst adoptedPreparation = {\n\tsteps: [\n\t\t{ kind: \"write\" as const, path: \"test/shout.test.js\", content: SHOUT_TEST },\n\t\t{\n\t\t\tkind: \"complete\" as const,\n\t\t\toutput: { summary: \"done\", changed_paths: [\"test/shout.test.js\"], tests_claimed: false, notes: [] },\n\t\t},\n\t],\n};\n\nconst implementation = {\n\tsteps: [\n\t\t{ kind: \"write\" as const, path: \"src/greet.js\", content: SHOUT_IMPL },\n\t\t{\n\t\t\tkind: \"complete\" as const,\n\t\t\toutput: { summary: \"done\", changed_paths: [\"src/greet.js\"], tests_claimed: false, notes: [] },\n\t\t},\n\t],\n};\n\nfunction harnessRefusing(inCopy: readonly string[], outside: readonly string[], root?: string): TestHarness {\n\treturn makeHarness({\n\t\tdefaultScript: { steps: [{ kind: \"complete\", output: spec }] },\n\t\tscripts: { prepare: refusedPreparation, implement: implementation },\n\t\tbackend: (real) => new RefusedWritesSandbox(real, inCopy, outside),\n\t\t...(root === undefined ? {} : { root, policy: CONTROLLER_POLICY }),\n\t});\n}\n\n/** The settings the controller's configuration carries, among them a directory it already gives the control. */\nconst CONTROLLER_POLICY = {\n\tpolicy_id: \"owner-policy\",\n\tsuite_paths: [\"test/**/*.test.js\"],\n\twritable_paths: { unit: [\"coverage/\"] },\n};\n\n/** A data directory whose `config.json` carries other settings than the directories it gives, and its text. */\nfunction controllerConfiguration(): { root: string; text: string } {\n\tconst root = outputDir(\"writable-grant-\", cleanups);\n\tconst text = `${JSON.stringify({ policy: CONTROLLER_POLICY, language: \"en\" }, null, 2)}\\n`;\n\twriteFileSync(join(root, \"config.json\"), text);\n\treturn { root, text };\n}\n\n/** The owner's answer to the IH-04 the change waits on. */\nfunction answer(t: TestHarness, changeId: string, asked: DecisionRequest, optionId: string): void {\n\tconst answered = t.harness.answerDecision(\n\t\tchangeId,\n\t\t{\n\t\t\tdecision_id: asked.decision_id,\n\t\t\toption_id: optionId,\n\t\t\tfree_text: null,\n\t\t\treason: null,\n\t\t\tsubject_revision: asked.subject.revision,\n\t\t\tscope: null,\n\t\t\texpires_at: null,\n\t\t},\n\t\ttuiOrigin(),\n\t);\n\tassert.equal(answered.error, null, answered.error?.message);\n}\n\n/** The controls of every protocol the change froze. */\nasync function frozenControls(t: TestHarness, changeId: string): Promise<Protocol[\"controls\"]> {\n\tconst protocols = await Promise.all(\n\t\tt.ledger\n\t\t\t.listArtifacts(changeId, \"protocol\")\n\t\t\t.map(async (a) => JSON.parse(new TextDecoder().decode((await t.objects.get(a.object))!)) as Protocol),\n\t);\n\treturn protocols.flatMap((p) => p.controls);\n}\n\n/** Starts a change and conducts it to the IH-04 asked once the preparations 495 spends by itself were refused. */\nasync function questionAsked(t: TestHarness): Promise<{ changeId: string; change: DecisionRequest }> {\n\tconst { change } = await t.harness.start({\n\t\tproject_path: trackedProject(fixtureTsWithoutTests),\n\t\trequest_text: \"add shout\",\n\t\tactor: HUMAN,\n\t});\n\tconst result = await t.harness.advance(change.change_id, { max_steps: 40 });\n\tassert.equal(result.stopped_because, \"decision_required\", result.steps.join(\" | \"));\n\tconst pending = t.harness.pendingDecisions(change.change_id);\n\tassert.deepEqual(\n\t\tpending.map((d) => d.interaction),\n\t\t[\"IH-04\"],\n\t);\n\treturn { changeId: change.change_id, change: pending[0]! };\n}\n\ndescribe(\"the directories of the copy a prepared suite could not write are offered to the owner\", () => {\n\tit(\"après des préparations dont la suite a été refusée en écriture sur test-output/run/a et hors de la copie, la question IH-04 offre grant_writable pour test-output/ au contrôle unit et rien pour le chemin hors de la copie ; sans écriture refusée, elle ne l'offre pas\", async () => {\n\t\tconst { change: asked } = await questionAsked(harnessRefusing([\"test-output/run/a\"], [OUTSIDE]));\n\t\tconst grants = asked.options.filter((o) => o.id === \"grant_writable\");\n\t\tassert.equal(grants.length, 1, `options offered: ${asked.options.map((o) => o.id).join(\", \")}`);\n\t\tassert.deepEqual(asked.grant_writable, { control_id: \"unit\", directories: [\"test-output/\"] });\n\t\tconst grant = grants[0]!;\n\t\tassert.ok(grant.label.includes(\"unit\") && grant.label.includes(\"test-output/\"), grant.label);\n\t\tassert.ok(grant.effect.includes(\"test-output/run/a\"), grant.effect);\n\t\tassert.ok(\n\t\t\tasked.options.every((o) => !`${o.label} ${o.effect}`.includes(\"495-outside\")),\n\t\t\t\"nothing is offered for the path outside the copy\",\n\t\t);\n\n\t\tconst { change: unrefused } = await questionAsked(harnessRefusing([], []));\n\t\tassert.ok(\n\t\t\tunrefused.options.every((o) => o.id !== \"grant_writable\"),\n\t\t\t`options offered: ${unrefused.options.map((o) => o.id).join(\", \")}`,\n\t\t);\n\t\tassert.equal(unrefused.grant_writable, undefined);\n\t});\n\n\tit(\"la réponse grant_writable écrit test-output/ sous policy.writable_paths.unit dans config.json en gardant suite_paths et le nom de la politique, accorde une préparation de plus, et le contrôle unit figé porte test-output/ ; la réponse préparer laisse config.json inchangé et aucun contrôle figé ne porte test-output/\", async () => {\n\t\tconst granting = controllerConfiguration();\n\t\tconst t = harnessRefusing([\"test-output/run/a\"], [OUTSIDE], granting.root);\n\t\tconst { changeId, change: asked } = await questionAsked(t);\n\t\tanswer(t, changeId, asked, \"grant_writable\");\n\t\tassert.deepEqual(JSON.parse(readFileSync(join(granting.root, \"config.json\"), \"utf8\")), {\n\t\t\tpolicy: { ...CONTROLLER_POLICY, writable_paths: { unit: [\"coverage/\", \"test-output/\"] } },\n\t\t\tlanguage: \"en\",\n\t\t});\n\t\tt.agent.scripts.set(\"prepare\", adoptedPreparation);\n\t\tconst granted = await t.harness.advance(changeId, { max_steps: 40 });\n\t\tconst state = t.ledger.loadChange(changeId)!.state;\n\t\tassert.equal(\n\t\t\tstate.interventions.filter((i) => i.role === \"prepare\").length,\n\t\t\t3,\n\t\t\t`one more preparation is granted: ${granted.steps.join(\" | \")}`,\n\t\t);\n\t\tassert.equal(state.gates.G2?.verdict, \"PASS\", granted.steps.join(\" | \"));\n\t\tconst unit = (await frozenControls(t, changeId)).filter((c) => c.control_id === \"unit\");\n\t\tassert.ok(\n\t\t\tunit.length > 0 &&\n\t\t\t\tunit.every((c) => c.writable_paths.includes(\"test-output/\") && c.writable_paths.includes(\"coverage/\")),\n\t\t\tJSON.stringify(unit),\n\t\t);\n\n\t\tconst declining = controllerConfiguration();\n\t\tconst u = harnessRefusing([\"test-output/run/a\"], [OUTSIDE], declining.root);\n\t\tconst other = await questionAsked(u);\n\t\tanswer(u, other.changeId, other.change, \"prepare\");\n\t\tu.agent.scripts.set(\"prepare\", adoptedPreparation);\n\t\tconst prepared = await u.harness.advance(other.changeId, { max_steps: 40 });\n\t\tassert.equal(readFileSync(join(declining.root, \"config.json\"), \"utf8\"), declining.text);\n\t\tassert.equal(u.ledger.loadChange(other.changeId)!.state.gates.G2?.verdict, \"PASS\", prepared.steps.join(\" | \"));\n\t\tconst frozen = await frozenControls(u, other.changeId);\n\t\tassert.ok(frozen.length > 0, \"a protocol is frozen\");\n\t\tassert.ok(\n\t\t\tfrozen.every((c) => !c.writable_paths.includes(\"test-output/\")),\n\t\t\tJSON.stringify(frozen.map((c) => [c.control_id, c.writable_paths])),\n\t\t);\n\t});\n});\n"}},"projectRoot":"/private/var/folders/j9/bnfyqnns4tzccm9jnvrxzx100000gn/T/cycle-arbre-fJa63h","config":{"mutate":["src/adapters/sandbox/seatbelt-refusals.ts:9-12","src/adapters/sandbox/seatbelt-refusals.ts:14-14","src/adapters/sandbox/seatbelt-refusals.ts:35-35","src/adapters/sandbox/seatbelt-refusals.ts:45-45","src/adapters/sandbox/seatbelt-refusals.ts:53-53","src/adapters/sandbox/seatbelt-refusals.ts:56-56","src/adapters/sandbox/seatbelt-refusals.ts:74-76","src/extension/config.ts:225-225"],"testRunner":"tap","tap":{"testFiles":["test/v1-adapters/seatbelt-refused-writes.test.ts","test/v1-adapters/control-refused-writes.test.ts","test/v2-kernel/writable-proposal.test.ts"],"nodeArgs":["--test-reporter=tap","-r","{{hookFile}}","{{testFile}}"],"forceBail":true},"coverageAnalysis":"perTest","reporters":["json"],"jsonReporter":{"fileName":"/var/folders/j9/bnfyqnns4tzccm9jnvrxzx100000gn/T/cycle-mutation-5Kd6yB/mutation.json"},"inPlace":true,"disableTypeChecks":false,"tempDirName":"/var/folders/j9/bnfyqnns4tzccm9jnvrxzx100000gn/T/cycle-mutation-5Kd6yB/stryker-tmp","configFile":"/var/folders/j9/bnfyqnns4tzccm9jnvrxzx100000gn/T/cycle-mutation-5Kd6yB/stryker.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner":{"command":"npm test"},"clearTextReporter":{"allowColor":true,"allowEmojis":false,"logTests":true,"maxTestsToLog":3,"reportTests":true,"reportMutants":true,"reportScoreTable":true,"skipFull":false},"dashboard":{"baseUrl":"https://dashboard.stryker-mutator.io/api/reports","reportType":"full"},"dryRunOnly":false,"eventReporter":{"baseDir":"reports/mutation/events"},"ignorePatterns":[],"ignoreStatic":false,"incremental":false,"incrementalFile":"reports/stryker-incremental.json","force":false,"fileLog