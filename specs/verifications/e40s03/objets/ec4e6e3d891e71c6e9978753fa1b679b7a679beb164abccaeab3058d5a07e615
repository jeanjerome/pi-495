te ip \"localhost:*\"))',\n\t\t\t);\n\t\treturn `${lines.join(\"\\n\")}\\n`;\n\t}\n\tasync run(profile: SandboxProfile, request: ExecutableRequest, signal?: AbortSignal): Promise<ProcessObservation> {\n\t\tconst env = buildEnv(profile.env_allowlist, profile.env);\n\t\tconst marker = `495-${randomUUID()}`;\n\t\tconst reading = await startKernelRefusalReading(marker);\n\t\tconst obs = await runProcess(\n\t\t\t{\n\t\t\t\tcommand: [\"/usr/bin/sandbox-exec\", \"-p\", this.profileText(profile, marker), ...request.command],\n\t\t\t\tcwd: request.cwd,\n\t\t\t\tenv,\n\t\t\t},\n\t\t\trequest,\n\t\t\tsignal,\n\t\t);\n\t\tconst refused_writes = await reading.close(await refuseWitness(marker));\n\t\t// sandbox-exec exits 71 (EX_OSERR) when the confined command cannot be executed.\n\t\treturn {\n\t\t\t...(startupIncident(obs, \"sandbox-exec:\", 71, \"sandbox-exec could not execute the command\") ?? obs),\n\t\t\trefused_writes,\n\t\t};\n\t}\n}\n\n/**\n * Has the kernel refuse, under `marker`, the creation of a path named after it, and returns that path. The\n * kernel publishes this refusal after those of the command that ran before it, so reading it closes the\n * reading of that command's refusals.\n */\nasync function refuseWitness(marker: string): Promise<string> {\n\tconst witness = join(realPathOf(tmpdir()), marker);\n\tconst profile = [\n\t\t\"(version 1)\",\n\t\tmarkedDenial(marker),\n\t\t\"(allow process-exec*)\",\n\t\t\"(allow file-read*)\",\n\t\t\"(allow sysctl-read)\",\n\t\t\"(allow mach-lookup)\",\n\t\t'(allow file-write* (literal \"/dev/dtracehelper\"))',\n\t].join(\"\\n\");\n\tawait runProcess(\n\t\t{ command: [\"/usr/bin/sandbox-exec\", \"-p\", profile, \"/bin/mkdir\", witness], cwd: \"/\", env: {} },\n\t\t{ command: [], cwd: \"/\", timeout_ms: 5000, max_output_bytes: 1024 },\n\t);\n\treturn witness;\n}\n\n/**\n * Linux bubblewrap backend. It qualifies where `bwrap` creates, without privilege, the namespaces it\n * asks for — a user and a mount namespace, and a network namespace of its own — and refuses elsewhere\n * with what `bwrap` said, so that a confined role is refused with `capability_missing` rather than run\n * unconfined (ADR-013, NFR-05).\n */\nexport class BubblewrapSandbox implements SandboxPort {\n\treadonly backend = \"bubblewrap\";\n\tprivate readonly options: BackendOptions;\n\tconstructor(options: Partial<BackendOptions> = {}) {\n\t\tthis.options = {\n\t\t\tdenied_read_paths: [...defaultDenied(), ...(options.denied_read_paths ?? [])],\n\t\t\ttemp_paths: options.temp_paths ?? [...new Set([tmpdir(), \"/tmp\"])],\n\t\t};\n\t}\n\tqualify(_profile: SandboxProfile): QualificationResult {\n\t\tconst result = (reasons: string[]): QualificationResult => ({\n\t\t\tbackend: this.backend,\n\t\t\tplatform: `${process.platform}-${process.arch}`,\n\t\t\tqualified: reasons.length === 0,\n\t\t\tcapabilities: { filesystem_confinement: true, network_confinement: true, process_group_termination: true },\n\t\t\treasons,\n\t\t});\n\t\tif (process.platform !== \"linux\") return result([\"bubblewrap requires Linux\"]);\n\t\t// The probe runs a null command under the confinement a role gets, so that a kernel or a container\n\t\t// that forbids unprivileged namespaces is found here and not at the first control.\n\t\tconst probe = spawnSync(\"bwrap\", [...this.confinement({ write_paths: [], network: \"denied\" }), \"--\", \"true\"], {\n\t\t\tencoding: \"utf8\",\n\t\t\ttimeout: 10_000,\n\t\t});\n\t\tif ((probe.error as NodeJS.ErrnoException | undefined)?.code === \"ENOENT\")\n\t\t\treturn result([\"bwrap not found in PATH\"]);\n\t\tif (probe.status === 0) return result([]);\n\t\t// A spawn error other than ENOENT, such as a bwrap that cannot be executed, leaves stderr undefined\n\t\t// whatever its type says.\n\t\tconst said = probe.stderr?.trim().split(\"\\n\")[0] || probe.error?.message || `exit ${probe.status ?? probe.signal}`;\n\t\treturn result([`bwrap cannot confine a command on this machine: ${said}`]);\n\t}\n\t/**\n\t * The mounts and namespaces of a confined command: the root read-only, the temporary and write paths\n\t * bound read-write, the denied paths masked.\n\t */\n\tprivate confinement(profile: Pick<SandboxProfile, \"write_paths\" | \"network\">): string[] {\n\t\tconst args = [\"--ro-bind\", \"/\", \"/\", \"--dev\", \"/dev\", \"--proc\", \"/proc\", \"--die-with-parent\", \"--new-session\"];\n\t\t// The temporary directories stay shared and writable, as under Seatbelt: what 495 writes there for a\n\t\t// command, a ruleset, is read by it.\n\t\tfor (const p of this.options.temp_paths) if (existsSync(p)) args.push(\"--bind\", p, p);\n\t\tfor (const p of profile.write_paths) args.push(\"--bind\", p, p);\n\t\t// Masked after the write paths are bound, so a grant never uncovers one. A directory is hidden by an\n\t\t// empty one; a file, which a tmpfs cannot be mounted on, by `/dev/null`, which a confined command\n\t\t// cannot open (`EACCES`).\n\t\tfor (const p of this.options.denied_read_paths) {\n\t\t\tif (!existsSync(p)) continue;\n\t\t\tif (statSync(p).isDirectory()) args.push(\"--tmpfs\", p);\n\t\t\telse args.push(\"--ro-bind\", \"/dev/null\", p);\n\t\t}\n\t\t// A network namespace of its own holds a loopback interface and no route anywhere else, so it is\n\t\t// what both `denied` and `loopback` ask for on this platform.\n\t\tif (profile.network !== \"allowed\") args.push(\"--unshare-net\");\n\t\treturn args;\n\t}\n\tasync run(profile: SandboxProfile, request: ExecutableRequest, signal?: AbortSignal): Promise<ProcessObservation> {\n\t\t// A bind needs a source, where Seatbelt grants a path before it exists: a write path the command is\n\t\t// to create is made here, empty, as the file the profile says it is or as a directory, and nothing\n\t\t// above it is granted.\n\t\tconst madeFiles: string[] = [];\n\t\tfor (const p of profile.write_paths) {\n\t\t\tif (existsSync(p)) continue;\n\t\t\tif (profile.write_files?.includes(p)) {\n\t\t\t\twriteFileSync(p, \"\");\n\t\t\t\tmadeFiles.push(p);\n\t\t\t} else mkdirSync(p, { recursive: true });\n\t\t}\n\t\tconst env = buildEnv(profile.env_allowlist, profile.env);\n\t\tlet obs: ProcessObservation;\n\t\ttry {\n\t\t\tobs = await runProcess(\n\t\t\t\t{\n\t\t\t\t\tcommand: [\"bwrap\", ...this.confinement(profile), \"--chdir\", request.cwd, \"--\", ...request.command],\n\t\t\t\t\tcwd: request.cwd,\n\t\t\t\t\tenv,\n\t\t\t\t},\n\t\t\t\trequest,\n\t\t\t\tsignal,\n\t\t\t);\n\t\t} finally {\n\t\t\t// A file made only to be bound and left empty is removed: where the command wrote no report, its\n\t\t\t// reader finds none, as under Seatbelt.\n\t\t\tfor (const p of madeFiles) if (statSync(p, { throwIfNoEntry: false })?.size === 0) rmSync(p);\n\t\t}\n\t\t// bwrap exits 1 after writing `bwrap: <reason>` when it cannot set up the namespaces it was\n\t\t// asked for — a container that forbids user namespaces, a kernel without them.\n\t\treturn startupIncident(obs, \"bwrap: \", 1, \"bwrap could not confine the command\") ?? obs;\n\t}\n}\n\n/**\n * No confinement. Only for V0–V2 tests and explicitly opted-in profiles; it never qualifies as a\n * security boundary and reports its capabilities as absent (ADR-013: fail closed elsewhere).\n */\nexport class UnconfinedSandbox implements SandboxPort {\n\treadonly backend = \"unconfined\";\n\tqualify(_profile: SandboxProfile): QualificationResult {\n\t\treturn {\n\t\t\tbackend: this.backend,\n\t\t\tplatform: `${process.platform}-${process.arch}`,\n\t\t\tqualified: false,\n\t\t\tcapabilities: { filesystem_confinement: false, network_confinement: false, process_group_termination: true },\n\t\t\treasons: [\"unconfined backend provides no isolation; SEC-02 and SEC-03 cannot be claimed\"],\n\t\t};\n\t}\n\trun(profile: SandboxProfile, request: ExecutableRequest, signal?: AbortSignal): Promise<ProcessObservation> {\n\t\treturn runProcess(\n\t\t\t{ command: request.command, cwd: request.cwd, env: buildEnv(profile.env_allowlist, profile.env) },\n\t\t\trequest,\n\t\t\tsignal,\n\t\t);\n\t}\n}\n\n/**\n * Selects the platform backend. When `allow_unconfined` is set the unconfined backend is returned\n * with an explicit non-qualified result; otherwise an unqualified platform yields a selection whose\n * `qualified` flag is false and the caller must refuse the operation (capability_missing).\n */\nexport function selectSandbox(\n\toptions: { allow_unconfined: boolean } & Partial<BackendOptions>,\n\tplatform: NodeJS.Platform = process.platform,\n): SandboxSelection {\n\tconst probe: SandboxProfile = {\n\t\tprofile_id: \"observe\",\n\t\tread_paths: [],\n\t\twrite_paths: [],\n\t\tnetwork: \"denied\",\n\t\tenv_allowlist: [],\n\t\tenv: {},\n\t};\n\tif (options.allow_unconfined) {\n\t\tconst b = new UnconfinedSandbox();\n\t\treturn { backend: b, qualification: b.qualify(probe) };\n\t}\n\tconst { allow_unconfined: _, ...backendOptions } = options;\n\tconst b: SandboxPort =\n\t\tplatform === \"darwin\" ? new SeatbeltSandbox(backendOptions) : new BubblewrapSandbox(backendOptions);\n\treturn { backend: b, qualification: b.qualify(probe) };\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/v1-adapters/seatbelt-refused-writes.test.ts":{"tests":[{"id":"0","name":"test/v1-adapters/seatbelt-refused-writes.test.ts"}],"source":"import { strict as assert } from \"node:assert\";\nimport { spawnSync } from \"node:child_process\";\nimport { randomUUID } from \"node:crypto\";\nimport { mkdirSync, realpathSync } from \"node:fs\";\nimport { basename, join } from \"node:path\";\nimport { beforeEach, describe, it } from \"node:test\";\nimport { SeatbeltSandbox } from \"../../src/adapters/sandbox/backends.ts\";\nimport { startKernelRefusalReading } from \"../../src/adapters/sandbox/seatbelt-refusals.ts\";\nimport type { SandboxProfile } from \"../../src/ports/execution.ts\";\nimport { darwinOnly, outputDir, removedAfterEach } from \"../helpers/fixtures.ts\";\n\nlet root: string;\nconst cleanups = removedAfterEach();\nbeforeEach(() => {\n\troot = realpathSync(outputDir(\"refused-writes-\", cleanups));\n});\n\nconst profile: SandboxProfile = {\n\tprofile_id: \"verify\",\n\tread_paths: [],\n\twrite_paths: [],\n\tnetwork: \"denied\",\n\tenv_allowlist: [],\n\tenv: {},\n};\n\ndescribe(\"the writes the kernel refuses a Seatbelt launch\", darwinOnly, () => {\n\tit(\"deux lancements concurrents sous Seatbelt portent chacun dans leur observation l'écriture que le noyau leur a refusée, avec le processus et l'opération, et pas celle de l'autre\", async () => {\n\t\tmkdirSync(join(root, \"a\"));\n\t\tmkdirSync(join(root, \"b\"));\n\t\t// No temporary directory is granted: the test tree may itself live under $TMPDIR.\n\t\tconst sbx = new SeatbeltSandbox({ temp_paths: [] });\n\t\tconst create = (path: string) =>\n\t\t\tsbx.run(profile, {\n\t\t\t\tcommand: [process.execPath, \"-e\", \"try { require('fs').writeFileSync(process.argv[1], '') } catch {}\", path],\n\t\t\t\tcwd: root,\n\t\t\t\ttimeout_ms: 30_000,\n\t\t\t\tmax_output_bytes: 65_536,\n\t\t\t});\n\t\tconst [a, b] = await Promise.all([create(join(root, \"a\", \"x\")), create(join(root, \"b\", \"y\"))]);\n\t\tconst underRoot = (writes: typeof a.refused_writes) => (writes ?? []).filter((w) => w.path.startsWith(root));\n\t\tconst node = basename(process.execPath);\n\t\tassert.deepEqual(\n\t\t\t{ a: underRoot(a.refused_writes), b: underRoot(b.refused_writes) },\n\t\t\t{\n\t\t\t\ta: [{ process: node, operation: \"file-write-create\", path: join(root, \"a\", \"x\") }],\n\t\t\t\tb: [{ process: node, operation: \"file-write-create\", path: join(root, \"b\", \"y\") }],\n\t\t\t},\n\t\t);\n\t});\n\n\tit(\"une écriture refusée dès que la lecture a démarré, et close par son témoin dès que la commande se termine, est lue\", async () => {\n\t\tconst marker = `495-${randomUUID()}`;\n\t\tconst written = join(root, \"x\");\n\t\tconst witness = join(root, \"witness\");\n\t\tconst reading = await startKernelRefusalReading(marker);\n\t\t// The refused write and its witness are made at once: the reading has to be listening already, and to\n\t\t// wait for the witness the kernel publishes after the write before it stops.\n\t\tspawnSync(\n\t\t\t\"/usr/bin/sandbox-exec\",\n\t\t\t[\"-p\", new SeatbeltSandbox({ temp_paths: [] }).profileText(profile, marker), \"/usr/bin/touch\", written, witness],\n\t\t\t{ stdio: \"ignore\" },\n\t\t);\n\t\tconst refused = await reading.close(witness);\n\t\tassert.deepEqual(\n\t\t\trefused.filter((w) => w.path.startsWith(root)),\n\t\t\t[{ process: \"touch\", operation: \"file-write-create\", path: written }],\n\t\t);\n\t});\n});\n"},"test/v1-adapters/control-refused-writes.test.ts":{"tests":[{"id":"1","name":"test/v1-adapters/control-refused-writes.test.ts"}],"source":"import { strict as assert } from \"node:assert\";\nimport { mkdirSync, realpathSync, symlinkSync } from \"node:fs\";\nimport { basename, join } from \"node:path\";\nimport { beforeEach, describe, it } from \"node:test\";\nimport { GenericControlRunner } from \"../../src/adapters/execution/runner.ts\";\nimport { CasObjectStore } from \"../../src/adapters/object-store/cas.ts\";\nimport { SeatbeltSandbox } from \"../../src/adapters/sandbox/backends.ts\";\nimport { offeredWritableDirectories, refusedWritesOf } from \"../../src/domain/writable-proposal.ts\";\nimport { darwinOnly, outputDir, removedAfterEach } from \"../helpers/fixtures.ts\";\nimport { controlOf, invocationBase } from \"../helpers/execution-fixture.ts\";\nimport { READERS_OF_495 } from \"../helpers/technologies.ts\";\n\nlet root: string;\nconst cleanups = removedAfterEach();\nbeforeEach(() => {\n\troot = realpathSync(outputDir(\"control-refused-\", cleanups));\n});\n\ndescribe(\"the evidence of a control refused writes under Seatbelt\", darwinOnly, () => {\n\tit(\"l'évidence d'un contrôle refusé en écriture sous Seatbelt porte test-output relatif à la copie et le fichier voisin par son chemin absolu, avec le processus et l'opération\", async () => {\n\t\tconst copy = join(root, \"copy\");\n\t\tmkdirSync(copy);\n\t\t// The copy is given by a path that is not its real one, as /var/folders is for /private/var/folders: the\n\t\t// kernel reports the real path, which is still made relative to the copy.\n\t\tconst given = join(root, \"given\");\n\t\tsymlinkSync(copy, given);\n\t\tmkdirSync(join(root, \"beside\"));\n\t\tconst beside = join(root, \"beside\", \"f.txt\");\n\t\t// No temporary directory is granted: the test tree may itself live under $TMPDIR.\n\t\tconst runner = new GenericControlRunner(\n\t\t\tnew SeatbeltSandbox({ temp_paths: [] }),\n\t\t\tnew CasObjectStore(join(root, \"objects\")),\n\t\t\tREADERS_OF_495,\n\t\t);\n\t\tconst writes = [\n\t\t\t\"try { require('fs').mkdirSync('test-output') } catch {}\",\n\t\t\t\"try { require('fs').writeFileSync(process.argv[1], '') } catch {}\",\n\t\t].join(\"\\n\");\n\t\tconst { evidence } = await runner.runControl({\n\t\t\t...invocationBase(),\n\t\t\tcontrol: controlOf({ command: [process.execPath, \"-e\", writes, beside] }),\n\t\t\tworkspace_path: given,\n\t\t});\n\t\tconst node = basename(process.execPath);\n\t\tassert.deepEqual(evidence.facts.refused_writes, [\n\t\t\t{ process: node, operation: \"file-write-create\", path: \"test-output\" },\n\t\t\t{ process: node, operation: \"file-write-create\", path: beside },\n\t\t]);\n\t});\n\n\tit(\"un fichier de la copie dont le nom imite un second refus est lu comme le chemin que le code a tenté d'écrire, et seul ce nom est proposé, jamais un chemin hors de la copie\", async () => {\n\t\tconst copy = join(root, \"copy\");\n\t\tmkdirSync(copy);\n\t\tconst runner = new GenericControlRunner(\n\t\t\tnew SeatbeltSandbox({ temp_paths: [] }),\n\t\t\tnew CasObjectStore(join(root, \"objects\")),\n\t\t\tREADERS_OF_495,\n\t\t);\n\t\tconst name = \"a(1) deny(1) file-write-create ..\";\n\t\tconst { evidence } = await runner.runControl({\n\t\t\t...invocationBase(),\n\t\t\tcontrol: controlOf({\n\t\t\t\tcommand: [process.execPath, \"-e\", \"try { require('fs').writeFileSync(process.argv[1], '') } catch {}\", name],\n\t\t\t}),\n\t\t\tworkspace_path: copy,\n\t\t});\n\t\tconst writes = refusedWritesOf(evidence.facts.refused_writes);\n\t\tassert.deepEqual(\n\t\t\t{ writes, offered: offeredWritableDirectories(writes, []) },\n\t\t\t{\n\t\t\t\twrites: [{ process: basename(process.execPath), operation: \"file-write-create\", path: name }],\n\t\t\t\toffered: [`${name}/`],\n\t\t\t},\n\t\t);\n\t});\n});\n"},"test/v2-kernel/writable-proposal.test.ts":{"tests":[{"id":"2","name":"test/v2-kernel/writable-proposal.test.ts"}],"source":"/**\n * A prepared suite the kernel refused writes to, judged on the reference, has the IH-04 that follows the refused\n * preparations offer the owner the directories of the copy it could not write, for the control of the suite.\n */\nimport { strict as assert } from \"node:assert\";\nimport { readFileSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { makeHarness, specReport, type TestHarness, trackedProject } from \"../helpers/harness-fixture.ts\";\nimport { fixtureTsWithoutTests, outputDir, removedAfterEach, SHOUT_IMPL, SHOUT_TEST } from \"../helpers/fixtures.ts\";\nimport { HUMAN, tuiOrigin } from \"../helpers/change-fixture.ts\";\nimport { RefusedWritesSandbox } from \"../helpers/refused-writes-sandbox.ts\";\nimport type { DecisionRequest } from \"../../src/contracts/v1/decision.ts\";\nimport type { Protocol } from \"../../src/contracts/v1/protocol.ts\";\n\nconst cleanups = removedAfterEach();\n\nconst spec = specReport({\n\tobjective: \"add shout(name) returning the greeting in upper case\",\n\trequirements: [\n\t\t{\n\t\t\trequirement_id: \"R1\",\n\t\t\tstatement: \"shout(name) returns greet(name) upper-cased\",\n\t\t\tmandatory: true,\n\t\t\tcriterion: \"unit test on shout passes\",\n\t\t\tcategory: \"functional\",\n\t\t\tsatisfied_by_reference: false,\n\t\t},\n\t],\n\tdesign: { summary: \"add shout next to greet\", components: [\"greet\"], interfaces: [\"shout(name)\"], risks: [] },\n});\n\n/** A suite that passes on the reference: it detects nothing, so each preparation that writes it is refused. */\nconst PASSING_TEST = 'import { test } from \"node:test\";\\n\\ntest(\"R1 shout\", () => {});\\n';\n\nconst refusedPreparation = {\n\tsteps: [\n\t\t{ kind: \"write\" as const, path: \"test/shout.test.js\", content: PASSING_TEST },\n\t\t{\n\t\t\tkind: \"complete\" as const,\n\t\t\toutput: { summary: \"done\", changed_paths: [\"test/shout.test.js\"], tests_claimed: false, notes: [] },\n\t\t},\n\t],\n};\n\n/** Where the kernel refused the prepared suite a write outside the copy, such as a cache of the tool. */\nconst OUTSIDE = \"/private/var/495-outside/cache/entry\";\n\n/** A preparation that writes a suite whose case of R1 fails by assertion on the reference: it is adopted. */\nconst adoptedPreparation = {\n\tsteps: [\n\t\t{ kind: \"write\" as const, path: \"test/shout.test.js\", content: SHOUT_TEST },\n\t\t{\n\t\t\tkind: \"complete\" as const,\n\t\t\toutput: { summary: \"done\", changed_paths: [\"test/shout.test.js\"], tests_claimed: false, notes: [] },\n\t\t},\n\t],\n};\n\nconst implementation = {\n\tsteps: [\n\t\t{ kind: \"write\" as const, path: \"src/greet.js\", content: SHOUT_IMPL },\n\t\t{\n\t\t\tkind: \"complete\" as const,\n\t\t\toutput: { summary: \"done\", changed_paths: [\"src/greet.js\"], tests_claimed: false, notes: [] },\n\t\t},\n\t],\n};\n\nfunction harnessRefusing(inCopy: readonly string[], outside: readonly string[], root?: string): TestHarness {\n\treturn makeHarness({\n\t\tdefaultScript: { steps: [{ kind: \"complete\", output: spec }] },\n\t\tscripts: { prepare: refusedPreparation, implement: implementation },\n\t\tbackend: (real) => new RefusedWritesSandbox(real, inCopy, outside),\n\t\t...(root === undefined ? {} : { root, policy: CONTROLLER_POLICY }),\n\t});\n}\n\n/** The settings the controller's configuration carries, among them a directory it already gives the control. */\nconst CONTROLLER_POLICY = {\n\tpolicy_id: \"owner-policy\",\n\tsuite_paths: [\"test/**/*.test.js\"],\n\twritable_paths: { unit: [\"coverage/\"] },\n};\n\n/** A data directory whose `config.json` carries other settings than the directories it gives, and its text. */\nfunction controllerConfiguration(): { root: string; text: string } {\n\tconst root = outputDir(\"writable-grant-\", cleanups);\n\tconst text = `${JSON.stringify({ policy: CONTROLLER_POLICY, language: \"en\" }, null, 2)}\\n`;\n\twriteFileSync(join(root, \"config.json\"), text);\n\treturn { root, text };\n}\n\n/** The owner's answer to the IH-04 the change waits on. */\nfunction answer(t: TestHarness, changeId: string, asked: DecisionRequest, optionId: string): void {\n\tconst answered = t.harness.answerDecision(\n\t\tchangeId,\n\t\t{\n\t\t\tdecision_id: asked.decision_id,\n\t\t\toption_id: optionId,\n\t\t\tfree_text: null,\n\t\t\treason: null,\n\t\t\tsubject_revision: asked.subject.revision,\n\t\t\tscope: null,\n\t\t\texpires_at: null,\n\t\t},\n\t\ttuiOrigin(),\n\t);\n\tassert.equal(answered.error, null, answered.error?.message);\n}\n\n/** The controls of every protocol the change froze. */\nasync function frozenControls(t: TestHarness, changeId: string): Promise<Protocol[\"controls\"]> {\n\tconst protocols = await Promise.all(\n\t\tt.ledger\n\t\t\t.listArtifacts(changeId, \"protocol\")\n\t\t\t.map(async (a) => JSON.parse(new TextDecoder().decode((await t.objects.get(a.object))!)) as Protocol),\n\t);\n\treturn protocols.flatMap((p) => p.controls);\n}\n\n/** Starts a change and conducts it to the IH-04 asked once the preparations 495 spends by itself were refused. */\nasync function questionAsked(t: TestHarness): Promise<{ changeId: string; change: DecisionRequest }> {\n\tconst { change } = await t.harness.start({\n\t\tproject_path: trackedProject(fixtureTsWithoutTests),\n\t\trequest_text: \"add shout\",\n\t\tactor: HUMAN,\n\t});\n\tconst result = await t.harness.advance(change.change_id, { max_steps: 