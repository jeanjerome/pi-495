"\" }));\n\tconst parentOf = new Map(rows.map((r) => [r.pid, r.ppid]));\n\tconst descends = (pid: number): boolean => {\n\t\tfor (let p = parentOf.get(pid); p !== undefined && p > 1; p = parentOf.get(p)) if (p === ancestor) return true;\n\t\treturn false;\n\t};\n\treturn rows\n\t\t.filter((r) => r.command.startsWith(\"/usr/bin/log stream\") && r.command.includes('sender == \"Sandbox\"'))\n\t\t.filter((r) => descends(r.pid))\n\t\t.map((r) => r.command);\n}\n\ndescribe(\"sandbox backends (SEC-01, SEC-02, ADR-013, C-SEC)\", () => {\n\tit(\n\t\t\"seatbelt qualifies on macOS and confines writes, sensitive reads, symlink escapes and network\",\n\t\tdarwinOnly,\n\t\tasync () => {\n\t\t\tconst sbx = new SeatbeltSandbox({ denied_read_paths: [join(root, \"secret\")], temp_paths: [] });\n\t\t\tconst q = sbx.qualify(profile());\n\t\t\tassert.equal(q.qualified, true, q.reasons.join(\";\"));\n\t\t\tconst script = [\n\t\t\t\t'const fs=require(\"fs\");const out=[];',\n\t\t\t\t'try{fs.writeFileSync(\"in-ws.txt\",\"1\");out.push(\"ws:ok\")}catch(e){out.push(\"ws:\"+e.code)}',\n\t\t\t\t`try{fs.writeFileSync(${JSON.stringify(join(root, \"outside.txt\"))},\"x\");out.push(\"outside:ok\")}catch(e){out.push(\"outside:\"+e.code)}`,\n\t\t\t\t`try{fs.readFileSync(${JSON.stringify(join(root, \"secret\", \"key\"))});out.push(\"secret:ok\")}catch(e){out.push(\"secret:\"+e.code)}`,\n\t\t\t\t`try{fs.symlinkSync(${JSON.stringify(join(root, \"secret\", \"key\"))},\"lnk\");fs.readFileSync(\"lnk\");out.push(\"symlink:ok\")}catch(e){out.push(\"symlink:\"+e.code)}`,\n\t\t\t\t'try{fs.writeFileSync(require(\"os\").homedir()+\"/.495-sbx-probe\",\"x\");out.push(\"home:ok\")}catch(e){out.push(\"home:\"+e.code)}',\n\t\t\t\t'require(\"http\").get(\"http://127.0.0.1:9\",()=>{out.push(\"net:ok\");done()}).on(\"error\",e=>{out.push(\"net:\"+e.code);done()});',\n\t\t\t\t'function done(){console.log(out.join(\",\"))}',\n\t\t\t].join(\"\");\n\t\t\tconst obs = await sbx.run(profile(), {\n\t\t\t\tcommand: [NODE, \"-e\", script],\n\t\t\t\tcwd: join(root, \"ws\"),\n\t\t\t\ttimeout_ms: 20000,\n\t\t\t\tmax_output_bytes: 65536,\n\t\t\t});\n\t\t\tconst text = new TextDecoder().decode(obs.stdout).trim();\n\t\t\tassert.equal(obs.exit_code, 0, new TextDecoder().decode(obs.stderr));\n\t\t\tassert.match(text, /ws:ok/);\n\t\t\tassert.match(text, /outside:EPERM/);\n\t\t\tassert.match(text, /secret:EPERM/);\n\t\t\tassert.match(text, /symlink:EPERM/);\n\t\t\tassert.match(text, /home:EPERM/);\n\t\t\tassert.match(text, /net:EPERM|net:ECONNREFUSED/);\n\t\t\tassert.equal(existsSync(join(root, \"outside.txt\")), false);\n\t\t\tassert.equal(existsSync(join(homedir(), \".495-sbx-probe\")), false);\n\t\t\tassert.equal(readFileSync(join(root, \"ws\", \"in-ws.txt\"), \"utf8\"), \"1\");\n\t\t},\n\t);\n\tit(\"a directory to create behind a link is granted under its resolved path: the profile carries the resolved path followed by /new and not link/new\", () => {\n\t\tmkdirSync(join(root, \"real\"));\n\t\tsymlinkSync(join(root, \"real\"), join(root, \"link\"));\n\t\tconst text = new SeatbeltSandbox().profileText(profile({ write_paths: [join(root, \"link\", \"new\")] }));\n\t\tassert.ok(text.includes(`(allow file-write* (subpath \"${join(realpathSync(root), \"real\", \"new\")}\"))`), text);\n\t\tassert.equal(text.includes(join(root, \"link\", \"new\")), false, text);\n\t});\n\tit(\"a path that exists is granted under its resolved form\", () => {\n\t\tmkdirSync(join(root, \"real\"));\n\t\tsymlinkSync(join(root, \"real\"), join(root, \"link\"));\n\t\tconst text = new SeatbeltSandbox().profileText(profile({ write_paths: [join(root, \"link\")] }));\n\t\tassert.ok(text.includes(`(allow file-write* (subpath \"${join(realpathSync(root), \"real\")}\"))`), text);\n\t\tassert.equal(text.includes(join(root, \"link\")), false, text);\n\t});\n\tit(\"mkdir on link/new exits 0 and creates real/new, a write in real/other stays EPERM\", darwinOnly, async () => {\n\t\tmkdirSync(join(root, \"real\"));\n\t\tsymlinkSync(join(root, \"real\"), join(root, \"link\"));\n\t\tconst sbx = new SeatbeltSandbox({ temp_paths: [] });\n\t\tconst p = profile({ write_paths: [join(root, \"link\", \"new\")] });\n\t\t// Probed while real/new is still absent: the grant is then built from the missing-path branch, the\n\t\t// one that must stay bounded to the declared directory.\n\t\tconst other = await sbx.run(p, {\n\t\t\tcommand: [\n\t\t\t\tNODE,\n\t\t\t\t\"-e\",\n\t\t\t\t`try{require(\"fs\").writeFileSync(${JSON.stringify(join(root, \"real\", \"other\"))},\"x\");console.log(\"ok\")}catch(e){console.log(e.code)}`,\n\t\t\t],\n\t\t\tcwd: join(root, \"ws\"),\n\t\t\ttimeout_ms: 20000,\n\t\t\tmax_output_bytes: 4096,\n\t\t});\n\t\tassert.equal(new TextDecoder().decode(other.stdout).trim(), \"EPERM\");\n\t\tassert.equal(existsSync(join(root, \"real\", \"other\")), false);\n\t\tconst made = await sbx.run(p, {\n\t\t\tcommand: [\"/bin/mkdir\", join(root, \"link\", \"new\")],\n\t\t\tcwd: join(root, \"ws\"),\n\t\t\ttimeout_ms: 20000,\n\t\t\tmax_output_bytes: 4096,\n\t\t});\n\t\tassert.equal(made.exit_code, 0, new TextDecoder().decode(made.stderr));\n\t\tassert.equal(existsSync(join(root, \"real\", \"new\")), true);\n\t});\n\tit(\"seatbelt lets a loopback profile reach itself and no other host (VER-04)\", darwinOnly, async () => {\n\t\t// A mutation engine forks worker processes and talks to them over a socket. The narrowest grant\n\t\t// that lets such a tool run is the loopback interface: the confinement SEC-02 claims is kept,\n\t\t// because no host but this one is reachable.\n\t\tconst sbx = new SeatbeltSandbox();\n\t\tconst script = [\n\t\t\t'const net=require(\"net\");const out=[];',\n\t\t\t'const srv=net.createServer((s)=>s.end(\"hi\")).listen(0,\"127.0.0.1\",()=>{',\n\t\t\t'const c=net.connect(srv.address().port,\"127.0.0.1\");',\n\t\t\t'c.on(\"data\",()=>{out.push(\"self:ok\");c.end();srv.close();elsewhere()});',\n\t\t\t'c.on(\"error\",(e)=>{out.push(\"self:\"+e.code);srv.close();elsewhere()});});',\n\t\t\t'srv.on(\"error\",(e)=>{out.push(\"bind:\"+e.code);elsewhere()});',\n\t\t\t'function elsewhere(){const r=net.connect(80,\"93.184.216.34\");',\n\t\t\t'r.on(\"error\",(e)=>{out.push(\"remote:\"+e.code);done()});r.on(\"connect\",()=>{out.push(\"remote:ok\");done()});}',\n\t\t\t'function done(){console.log(out.join(\",\"));process.exit(0)}',\n\t\t].join(\"\");\n\t\tconst obs = await sbx.run(profile({ network: \"loopback\" }), {\n\t\t\tcommand: [NODE, \"-e\", script],\n\t\t\tcwd: join(root, \"ws\"),\n\t\t\ttimeout_ms: 20000,\n\t\t\tmax_output_bytes: 4096,\n\t\t});\n\t\tassert.equal(\n\t\t\tnew TextDecoder().decode(obs.stdout).trim(),\n\t\t\t\"self:ok,remote:EPERM\",\n\t\t\tnew TextDecoder().decode(obs.stderr),\n\t\t);\n\t});\n\tit(\"seatbelt allows network only when the mandate says so\", darwinOnly, async () => {\n\t\tconst sbx = new SeatbeltSandbox();\n\t\tconst obs = await sbx.run(profile({ network: \"allowed\" }), {\n\t\t\tcommand: [NODE, \"-e\", 'require(\"net\").connect(9,\"127.0.0.1\").on(\"error\",e=>{console.log(e.code)})'],\n\t\t\tcwd: join(root, \"ws\"),\n\t\t\ttimeout_ms: 10000,\n\t\t\tmax_output_bytes: 4096,\n\t\t});\n\t\tassert.equal(new TextDecoder().decode(obs.stdout).trim(), \"ECONNREFUSED\");\n\t});\n\tit(\"un lancement sous Seatbelt ne démarre aucune lecture du journal du système\", darwinOnly, async () => {\n\t\tconst run = new SeatbeltSandbox().run(profile(), {\n\t\t\tcommand: [NODE, \"-e\", \"setTimeout(()=>{},1500)\"],\n\t\t\tcwd: join(root, \"ws\"),\n\t\t\ttimeout_ms: 10000,\n\t\t\tmax_output_bytes: 4096,\n\t\t});\n\t\tlet done = false;\n\t\tvoid run.finally(() => {\n\t\t\tdone = true;\n\t\t});\n\t\tconst readings = new Set<string>();\n\t\twhile (!done) {\n\t\t\tfor (const reading of systemLogReadingsOf(process.pid)) readings.add(reading);\n\t\t\tawait new Promise((resolve) => setTimeout(resolve, 100));\n\t\t}\n\t\tassert.equal((await run).exit_code, 0);\n\t\tassert.deepEqual([...readings], []);\n\t});\n\tit(\"unconfined never qualifies and declares missing confinement capabilities\", () => {\n\t\tconst q = new UnconfinedSandbox().qualify(profile());\n\t\tassert.equal(q.qualified, false);\n\t\tassert.equal(q.capabilities.filesystem_confinement, false);\n\t\tconst sel = selectSandbox({ allow_unconfined: true });\n\t\tassert.equal(sel.backend.backend, \"unconfined\");\n\t\tassert.equal(sel.qualification.qualified, false);\n\t});\n\tit(\"bubblewrap is refused off Linux with the reason « bubblewrap requires Linux »\", {\n\t\tskip: process.platform === \"linux\" && \"bubblewrap qualifies on Linux when bwrap can confine\",\n\t}, () => {\n\t\tconst q = new BubblewrapSandbox().qualify(profile());\n\t\tassert.equal(q.qualified, false);\n\t\tassert.ok(q.reasons.includes(\"bubblewrap requires Linux\"), q.reasons.join(\"; \"));\n\t\tconst sel = selectSandbox({ allow_unconfined: false }, \"linux\");\n\t\tassert.equal(sel.backend.backend, \"bubblewrap\");\n\t\tassert.equal(sel.qualification.qualified, false);\n\t});\n\tit(\"a confinement tool that could not start reports an incident, not a verdict on the target (RM-016)\", () => {\n\t\tconst base = {\n\t\t\tsignal: null,\n\t\t\ttimed_out: false,\n\t\t\tspawn_error: null,\n\t\t\tstdout: new Uint8Array(),\n\t\t\tstdout_truncated: false,\n\t\t\tstderr_truncated: false,\n\t\t\tstarted_at: \"t\",\n\t\t\tended_at: \"t\",\n\t\t\tduration_ms: 0,\n\t\t};\n\t\tconst text = (s: string) => new TextEncoder().encode(s);\n\t\t// bwrap refuses before the command runs: nothing about the target was measured.\n\t\tconst refused = startupIncident(\n\t\t\t{ ...base, exit_code: 1, stderr: text(\"bwrap: Creating new namespace failed: Operation not permitted\\n\") },\n\t\t\t\"bwrap: \",\n\t\t\t1,\n\t\t\t\"fallback\",\n\t\t);\n\t\tassert.equal(refused?.exit_code, null, \"no exit code is attributed to a command that never ran\");\n\t\tassert.equal(refused?.spawn_error, \"bwrap: Creating new namespace failed: Operation not permitted\");\n\t\tassert.equal(incidentOf(refused!), \"spawn error: bwrap: Creating new namespace failed: Operation not permitted\");\n\t\tassert.equal(parseExitCode(refused!).verdict, \"INDETERMINATE\");\n\t\t// A control of the target that genuinely failed keeps its verdict.\n\t\tassert.equal(\n\t\t\tstartupIncident({ ...base, exit_code: 1, stderr: text(\"1 test failed\\n\") }, \"bwrap: \", 1, \"fallback\"),\n\t\t\tnull,\n\t\t);\n\t\tassert.equal(\n\t\t\tstartupIncident({ ...base, exit_code: 0, stderr: text(\"bwrap: noise\\n\") }, \"bwrap: \", 1, \"fallback\"),\n\t\t\tnull,\n\t\t);\n\t});\n\tit(\"the process runner enforces timeout, kills the process group and bounds output (NFR-04, §12.3)\", async () => {\n\t\tconst sbx = new UnconfinedSandbox();\n\t\tconst t0 = Date.now();\n\t\tconst obs = await sbx.run(\n\t\t\tprofile(),\n\t\t\t{\n\t\t\t\tcommand: [\n\t\t\t\t\tNODE,\n\t\t\t\t\t\"-e\",\n\t\t\t\t\t'require(\"child_process\").spawn(process.execPath,[\"-e\",\"setInterval(()=>{},1000)\"]);setInterval(()=>{},1000)',\n\t\t\t\t],\n\t\t\t\tcwd: root,\n\t\t\t\ttimeout_ms: 500,\n\t\t\t\tmax_output_bytes: 1024,\n\t\t\t},\n\t\t\tundefined,\n\t\t);\n\t\tassert.equal(obs.timed_out, true);\n\t\tassert.ok(Date.now() - t0 < 5000);\n\t\tconst big = await sbx.run(profile(), {\n\t\t\tcommand: [NODE, \"-e\", 'process.stdout.write(\"x\".repeat(10000))'],\n\t\t\tcwd: root,\n\t\t\ttimeout_ms: 10000,\n\t\t\tmax_output_bytes: 1000,\n\t\t});\n\t\tassert.equal(big.stdout.byteLength, 1000);\n\t\tassert.equal(big.stdout_truncated, true);\n\t\tassert.equal(big.exit_code, 0);\n\t\tconst missing = await sbx.run(profile(), {\n\t\t\tcommand: [\"/nonexistent/binary-495\"],\n\t\t\tcwd: root,\n\t\t\ttimeout_ms: 1000,\n\t\t\tmax_output_bytes: 100,\n\t\t});\n\t\tassert.ok(missing.spawn_error);\n\t\tassert.equal(missing.exit_code, null);\n\t});\n\tit(\"environment is built from the allowlist only, no shell is involved\", async () => {\n\t\tprocess.env.HARNESS495_LEAK = \"leak\";\n\t\tconst sbx = new UnconfinedSandbox();\n\t\tconst obs = await sbx.run(profile(), {\n\t\t\tcommand: [\n\t\t\t\tNODE,\n\t\t\t\t\"-e\",\n\t\t\t\t\"console.log(JSON.stringify({leak:process.env.HARNESS495_LEAK||null,test:process.env.HARNESS495_TEST,argv:process.argv.slice(1)}))\",\n\t\t\t\t\"$HOME\",\n\t\t\t\t\"a b\",\n\t\t\t],\n\t\t\tcwd: root,\n\t\t\ttimeout_ms: 10000,\n\t\t\tmax_output_bytes: 4096,\n\t\t});\n\t\tconst parsed = JSON.parse(new TextDecoder().decode(obs.stdout));\n\t\tassert.equal(parsed.leak, null);\n\t\tassert.equal(parsed.test, \"1\");\n\t\tassert.deepEqual(parsed.argv, [\"$HOME\", \"a b\"]);\n\t\tdelete process.env.HARNESS495_LEAK;\n\t});\n});\n"},"test/v1-adapters/control-write-survey.test.ts":{"tests":[{"id":"1","name":"test/v1-adapters/control-write-survey.test.ts"}],"source":"import { strict as assert } from \"node:assert\";\nimport { mkdirSync, readdirSync, symlinkSync, writeFileSync } from \"node:fs\";\nimport { isAbsolute, join } from \"node:path\";\nimport { beforeEach, describe, it } from \"node:test\";\nimport { GenericControlRunner } from \"../../src/adapters/execution/runner.ts\";\nimport { CasObjectStore } from \"../../src/adapters/object-store/cas.ts\";\nimport { SeatbeltSandbox, selectSandbox } from \"../../src/adapters/sandbox/backends.ts\";\nimport type { ControlInvocation } from \"../../src/ports/execution.ts\";\nimport { darwinOnly, outputDir, removedAfterEach } from \"../helpers/fixtures.ts\";\nimport { controlOf, invocationBase } from \"../helpers/execution-fixture.ts\";\nimport { READERS_OF_495 } from \"../helpers/technologies.ts\";\n\nlet root: string;\nconst cleanups = removedAfterEach();\nbeforeEach(() => {\n\troot = outputDir(\"control-survey-\", cleanups);\n});\n\n/** The platform's confinement, Seatbelt or bubblewrap, with no temporary directory granted: the test tree may lie under it. */\nconst platform = selectSandbox({ allow_unconfined: false, temp_paths: [] });\nconst confined = { skip: !platform.qualification.qualified && platform.qualification.reasons.join(\"; \") };\n\n/** The paths the evidence of a surveyed control says it wrote. */\nfunction writtenOf(facts: Record<string, unknown>): unknown {\n\treturn facts.written;\n}\n\ndescribe(\"the survey of a control's writes\", () => {\n\tit(\n\t\t\"le relevé d'un contrôle sous le confinement de la plateforme rend test-output/run/a et src/a.txt relatifs à la copie, aucun chemin hors d'elle, et rien n'est écrit dans le dossier voisin, ni directement ni par le lien\",\n\t\tconfined,\n\t\tasync () => {\n\t\t\tconst copy = join(root, \"copy\");\n\t\t\tmkdirSync(join(copy, \"src\"), { recursive: true });\n\t\t\twriteFileSync(join(copy, \"src\", \"a.txt\"), \"before\");\n\t\t\tconst beside = join(root, \"beside\");\n\t\t\tmkdirSync(beside);\n\t\t\tsymlinkSync(beside, join(copy, \"out\"));\n\t\t\tconst writes = [\n\t\t\t\t\"const fs = require('fs');\",\n\t\t\t\t\"try { fs.mkdirSync('test-output/run', { recursive: true }); fs.writeFileSync('test-output/run/a', '1') } catch {}\",\n\t\t\t\t\"try { fs.writeFileSync('src/a.txt', 'after') } catch {}\",\n\t\t\t\t\"try { fs.writeFileSync(process.argv[1], 'x') } catch {}\",\n\t\t\t\t\"try { fs.writeFileSync('out/through-link.txt', 'x') } catch {}\",\n\t\t\t].join(\"\\n\");\n\t\t\tconst runner = new GenericControlRunner(\n\t\t\t\tplatform.backend,\n\t\t\t\tnew CasObjectStore(join(root, \"objects\")),\n\t\t\t\tREADERS_OF_495,\n\t\t\t);\n\t\t\tconst invocation: ControlInvocation = {\n\t\t\t\t...invocationBase(),\n\t\t\t\tcontrol: controlOf({ command: [process.execPath, \"-e\", writes, join(beside, \"direct.txt\")] }),\n\t\t\t\tworkspace_path: copy,\n\t\t\t};\n\t\t\tconst surveyed = { ...invocation, survey_writes: true };\n\t\t\tconst { evidence } = await runner.runControl(surveyed);\n\t\t\tconst written = writtenOf(evidence.facts);\n\t\t\tassert.ok(Array.isArray(written), `the evidence carries no written paths: ${JSON.stringify(evidence.facts)}`);\n\t\t\tassert.ok(written.includes(\"test-output/run/a\"), JSON.stringify(written));\n\t\t\tassert.ok(written.includes(\"src/a.txt\"), JSON.stringify(written));\n\t\t\tassert.ok(\n\t\t\t\twritten.every((p: unknown) => typeof p === \"string\" && !isAbsolute(p) && !p.startsWith(\"..\")),\n\t\t\t\tJSON.stringify(written),\n\t\t\t);\n\t\t\tassert.deepEqual(readdirSync(beside), []);\n\t\t},\n\t);\n\n\tit(\n\t\t\"sous Seatbelt, le relevé d'un contrôle qui crée tmp-run/x puis efface tmp-run rend tmp-run/x\",\n\t\tdarwinOnly,\n\t\tasync () => {\n\t\t\tconst copy = join(root, \"copy\");\n\t\t\tmkdirSync(copy);\n\t\t\tconst writes = [\n\t\t\t\t\"const fs = require('fs');\",\n\t\t\t\t\"fs.mkdirSync('tmp-run'); fs.writeFileSync('tmp-run/x', '1');\",\n\t\t\t\t\"try { fs.rmSync('tmp-run', { recursive: true, force: true }) } catch {}\",\n\t\t\t].join(\"\\n\");\n\t\t\tconst runner = new GenericControlRunner(\n\t\t\t\tnew SeatbeltSandbox({ temp_paths: [] }),\n\t\t\t\tnew CasObjectStore(join(root, \"objects\")),\n\t\t\t\tREADERS_OF_495,\n\t\t\t);\n\t\t\tconst invocation: ControlInvocation = {\n\t\t\t\t...invocationBase(),\n\t\t\t\tcontrol: controlOf({ command: [process.execPath, \"-e\", writes] }),\n\t\t\t\tworkspace_path: copy,\n\t\t\t};\n\t\t\tconst { evidence } = await runner.runControl({ ...invocation, survey_writes: true });\n\t\t\tconst written = writtenOf(evidence.facts);\n\t\t\tassert.ok(\n\t\t\t\tArray.isArray(written) && written.includes(\"tmp-run/x\"),\n\t\t\t\t`written: ${JSON.stringify(written)}; ${JSON.stringify(evidence.facts)}`,\n\t\t\t);\n\t\t},\n\t);\n\n\tit(\"le relevé d'un contrôle ne rend pas ce qu'il écrit sous un chemin qui lui est déjà donné\", confined, async () => {\n\t\tconst copy = join(root, \"copy\");\n\t\tmkdirSync(copy);\n\t\tconst writes = [\n\t\t\t\"const fs = require('fs');\",\n\t\t\t\"fs.mkdirSync('reports', { recursive: true }); fs.writeFileSync('reports/r.xml', '1');\",\n\t\t\t\"fs.mkdirSync('test-output'); fs.writeFileSync('test-output/a', '1');\",\n\t\t].join(\"\\n\");\n\t\tconst runner = new GenericControlRunner(\n\t\t\tplatform.backend,\n\t\t\tnew CasObjectStore(join(root, \"objects\")),\n\t\t\tREADERS_OF_495,\n\t\t);\n\t\tconst invocation: ControlInvocation = {\n\t\t\t...invocationBase(),\n\t\t\tcontrol: controlOf({ command: [process.execPath, \"-e\", writes], writable_paths: [\"reports/\"] }),\n\t\t\tworkspace_path: copy,\n\t\t};\n\t\tconst { evidence } = await runner.runControl({ ...invocation, survey_writes: true });\n\t\tassert.deepEqual(writtenOf(evidence.facts), [\"test-output\", \"test-output/a\"]);\n\t});\n});\n"},"test/v2-kernel/write-survey.test.ts":{"tests":[{"id":"2","name":"test/v2-kernel/write-survey.test.ts"}],"source":"/**\n * A refused preparation has its suite run once more, on a disposable copy of the reference and the prepared files where\n * it may write, and its record keeps what that suite wrote; a retained preparation does not run its suite again.\n */\nimport { strict as assert } from \"node:assert\";\nimport { describe, it } from \"node:test\";\nimport { makeHarness, specReport, trackedProject } from \"../helpers/harness-fixture.ts\";\nimport { fixtureTsWithoutTests } from \"../helpers/fixtures.ts\";\nimport { HUMAN, tuiOrigin } from \"../helpers/change-fixture.ts\";\n\n/** What the test reads of a preparation record: whether it was retained, and what its suite wrote when surveyed. */\ninterface SurveyedPreparation {\n\tqualified: boolean;\n\tsuite_written?: { control_id: string; paths: string[] };\n}\n\nconst spec = specReport({\n\tobjective: \"add shout(name) returning the greeting in upper case\",\n\trequirements: [\n\t\t{\n\t\t\trequirement_id: \"R1\",\n\t\t\tstatement: \"shout(name) returns greet(name) upper-cased\",\n\t\t\tmandatory: true,\n\t\t\tcriterion: \"unit test on shout passes\",\n\t\t\tcategory: \"functional\",\n\t\t\tsatisfied_by_reference: false,\n\t\t},\n\t],\n\tdesign: { summary: \"add shout next to greet\", components: [\"greet\"], interfaces: [\"shout(name)\"], risks: [] },\n});\n\n/** What the case of the suite writes in its copy before it judges anything. */\nconst WRITES_TEST_OUTPUT =\n\t'  try { mkdirSync(\"test-output/run\", { recursive: true }); writeFileSync(\"test-output/run/a\", \"1\"); } catch {}\\n';\n\n/** A suite whose case writes test-output/run/a and passes on the reference: it detects nothing, and is refused. */\nconst PASSING_TEST = `import { test } from \"node:test\";\\nimport { mkdirSync, writeFileSync } from \"node:fs\";\\n\\ntest(\"R1 shout\", () => {\\n${WRITES_TEST_OUTPUT}});\\n`;\n\n/** A suite whose case writes test-output/run/a and fails by assertion on the reference: it is retained. */\nconst FAILING_TEST = `import { test } from \"node:test\";\\nimport { strict as assert } from \"node:assert\";\\nimport { mkdirSync, writeFileSync } from \"node:fs\";\\nimport * as greeting from \"../src/greet.js\";\\n\\ntest(\"R1 shout upper-cases the greeting\", () => {\\n${WRITES_TEST_OUTPUT}  assert.equal(typeof greeting.shout, \"function\");\\n  assert.equal(greeting.shout(\"x\"), \"HELLO, X\");\\n});\\n`;\n\nfunction preparationWriting(content: string) {\n\treturn {\n\t\tsteps: [\n\t\t\t{ kind: \"write\" as const, path: \"test/shout.test.js\", content },\n\t\t\t{\n\t\t\t\tkind: \"complete\" as const,\n\t\t\t\toutput: { summary: \"done\", changed_paths: [\"test/shout.test.js\"], tests_claimed: false, notes: [] },\n\t\t\t},\n\t\t],\n\t};\n}\n\ndescribe(\"the survey of a refused preparation's suite\", () => {\n\tit(\"le relevé de la préparation refusée porte test-output/run/a pour le contrôle unit, et celui de la préparation retenue ne porte aucun chemin écrit\", async () => {\n\t\tconst t = makeHarness({\n\t\t\tdefaultScript: { steps: [{ kind: \"complete\", output: spec }] },\n\t\t\tscripts: { prepare: preparationWriting(PASSING_TEST) },\n\t\t});\n\t\tconst { change } = await t.harness.start({\n\t\t\tproject_path: trackedProject(fixtureTsWithoutTests),\n\t\t\trequest_text: \"add shout\",\n\t\t\tactor: HUMAN,\n\t\t});\n\t\tconst refused = await t.harness.advance(change.change_id, { max_steps: 40 });\n\t\tconst [asked] = t.harness.pendingDecisions(change.change_id);\n\t\tassert.equal(asked?.interaction, \"IH-04\", refused.steps.join(\" | \"));\n\t\tconst answered = t.harness.answerDecision(\n\t\t\tchange.change_id,\n\t\t\t{\n\t\t\t\tdecision_id: asked.decision_id,\n\t\t\t\toption_id: \"prepare\",\n\t\t\t\tfree_text: null,\n\t\t\t\treason: null,\n\t\t\t\tsubject_revision: asked.subject.revision,\n\t\t\t\tscope: null,\n\t\t\t\texpires_at: null,\n\t\t\t},\n\t\t\ttuiOrigin(),\n\t\t);\n\t\tassert.equal(answered.error, null, answered.error?.message);\n\t\tt.agent.scripts.set(\"prepare\", preparationWriting(FAILING_TEST));\n\t\tconst retained = await t.harness.advance(change.change_id, { max_steps: 40 });\n\n\t\tconst records = await Promise.all(\n\t\t\tt.ledger\n\t\t\t\t.listArtifacts(change.change_id, \"preparation\")\n\t\t\t\t.filter((a) => a.ref.artifact_id.startsWith(\"prep_\"))\n\t\t\t\t.map(\n\t\t\t\t\tasync (a) => JSON.parse(new TextDecoder().decode((await t.objects.get(a.object))!)) as SurveyedPreparation,\n\t\t\t\t),\n\t\t);\n\t\tconst refusedRecords = records.filter((r) => !r.qualified);\n\t\tconst retainedRecords = records.filter((r) => r.qualified);\n\t\tassert.ok(refusedRecords.length > 0 && retainedRecords.length === 1, retained.steps.join(\" | \"));\n\t\tfor (const record of refusedRecords) {\n\t\t\tassert.equal(record.suite_written?.control_id, \"unit\", JSON.stringify(record));\n\t\t\tassert.ok(record.suite_written.paths.includes(\"test-output/run/a\"), JSON.stringify(record.suite_written));\n\t\t}\n\t\tassert.equal(retainedRecords[0]!.suite_written, undefined, JSON.stringify(retainedRecords[0]));\n\t});\n});\n"},"test/v2-kernel/writable-proposal.test.ts":{"tests":[{"id":"3","name":"test/v2-kernel/writable-proposal.test.ts"}],"source":"/**\n * A refused preparation whose suite writes in a disposable copy has the IH-04 that follows the refused preparations\n * offer the owner the directories of the copy it wrote there, for the control of the suite.\n */\nimport { strict as assert } from \"node:assert\";\nimport { readFileSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { makeHarness, specReport, type TestHarness, trackedProject } from \"../helpers/harness-fixture.ts\";\nimport { fixtureTsWithoutTests, outputDir, removedAfterEach, SHOUT_IMPL, SHOUT_TEST } from \"../helpers/fixtures.ts\";\nimport { HUMAN, tuiOrigin } from \"../helpers/change-fixture.ts\";\nimport type { DecisionRequest } from \"../../src/contracts/v1/decision.ts\";\nimport type { Protocol } from \"../../src/contracts/v1/protocol.ts\";\n\nconst cleanups = removedAfterEach();\n\nconst spec = specReport({\n\tobjective: \"add shout(name) returning the greeting in upper case\",\n\trequirements: [\n\t\t{\n\t\t\trequirement_id: \"R1\",\n\t\t\tstatement: \"shout(name) returns greet(name) upper-cased\",\n\t\t\tmandatory: true,\n\t\t\tcriterion: \"unit test on shout passes\",\n\t\t\tcategory: \"functional\",\n\t\t\tsatisfied_by_reference: false,\n\t\t},\n\t],\n\tdesign: { summary: \"add shout next to greet\", components: [\"greet\"], interfaces: [\"shout(name)\"], risks: [] },\n});\n\n/**\n * A suite that passes on the reference, its case writing `written` in its copy and trying to write `outside`, a path\n * outside the copy: it detects nothing, so each preparation that writes it is refused.\n */\nfunction passingTest(written: readonly string[], outside: readonly string[]): string {\n\tconst writes = [...written.map((p) => ({ p, mkdir: true })), ...outside.map((p) => ({ p, mkdir: false }))]\n\t\t.map(\n\t\t\t({ p, mkdir }) =>\n\t\t\t\t`  try { ${mkdir ? `mkdirSync(dirname(${JSON.stringify(p)}), { recursive: true }); ` : \"\"}writeFileSync(${JSON.stringify(p)}, \"1\"); } catch {}\\n`,\n\t\t)\n\t\t.join(\"\");\n\treturn `import { test } from \"node:test\";\\nimport { mkdirSync, writeFileSync } from \"node:fs\";\\nimport { dirname } from \"node:path\";\\n\\ntest(\"R1 shout\", () => {\\n${writes}});\\n`;\n}\n\nfunction refusedPreparation(written: readonly string[], outside: readonly string[]) {\n\treturn {\n\t\tsteps: [\n\t\t\t{ kind: \"write\" as const, path: \"test/shout.test.js\", content: passingTest(written, outside) },\n\t\t\t{\n\t\t\t\tkind: \"complete\" as const,\n\t\t\t\toutput: { summary: \"done\", changed_paths: [\"test/shout.test.js\"], tests_claimed: false, notes: [] },\n\t\t\t},\n\t\t],\n\t};\n}\n\n/** A path outside the copy the suite tries to write, such as a cache of the tool, in a directory of the test's own. */\nfunction outsidePath(): string {\n\treturn join(outputDir(\"495-outside-\", cleanups), \"cache\", \"entry\");\n}\n\n/** A preparation that writes a suite whose case of R1 fails by assertion on the reference: it is adopted. */\nconst adoptedPreparation = {\n\tsteps: [\n\t\t{ kind: \"write\" as const, path: \"test/shout.test.js\", content: SHOUT_TEST },\n\t\t{\n\t\t\tkind: \"complete\" as const,\n\t\t\toutput: { summary: \"done\", changed_paths: [\"test/shout.test.js\"], tests_claimed: false, notes: [] },\n\t\t},\n\t],\n};\n\nconst implementation = {\n\tsteps: [\n\t\t{ kind: \"write\" as const, path: \"src/greet.js\", content: SHOUT_IMPL },\n\t\t{\n\t\t\tkind: \"complete\" as const,\n\t\t\toutput: { summary: \"done\", changed_paths: [\"src/greet.js\"], tests_claimed: false, notes: [] },\n\t\t},\n\t],\n};\n\nfunction harnessWriting(written: readonly string[], outside: readonly string[], root?: string): TestHarness {\n\treturn makeHarness({\n\t\tdefaultScript: { steps: [{ kind: \"complete\", output: spec }] },\n\t\tscripts: { prepare: refusedPreparation(written, outside), implement: implementation },\n\t\t...(root === undefined ? {} : { root, policy: CONTROLLER_POLICY }),\n\t});\n}\n\n/** The settings the controller's configuration carries, among them a directory it already gives the control. */\nconst CONTROLLER_POLICY = {\n\tpolicy_id: \"owner-policy\",\n\tsuite_paths: [\"test/**/*.test.js\"],\n\twritable_paths: { unit: [\"coverage/\"] },\n};\n\n/** A data directory whose `config.json` carries other settings than the directories it gives, and its text. */\nfunction controllerConfiguration(): { root: string; text: string } {\n\tconst root = outputDir(\"writable-grant-\", cleanups);\n\tconst text = `${JSON.stringify({ policy: CONTROLLER_POLICY, language: \"en\" }, null, 2)}\\n`;\n\twriteFileSync(join(root, \"config.json\"), text);\n\treturn { root, text };\n}\n\n/** The owner's answer to the IH-04 the change waits on. */\nfunction answer(t: TestHarness, changeId: string, asked: DecisionRequest, optionId: string): void {\n\tconst answered = t.harness.answerDecision(\n\t\tchangeId,\n\t\t{\n\t\t\tdecision_id: asked.decision_id,\n\t\t\toption_id: optionId,\n\t\t\tfree_text: null,\n\t\t\treason: null,\n\t\t\tsubject_revision: asked.subject.revision,\n\t\t\tscope: null,\n\t\t\texpires_at: null,\n\t\t},\n\t\ttuiOrigin(),\n\t);\n\tassert.equal(answered.error, null, answered.error?.message);\n}\n\n/** The controls of every protocol the change froze. */\nasync function frozenControls(t: TestHarness, changeId: string): Promise<Protocol[\"controls\"]> {\n\tconst protocols = await Promise.all(\n\t\tt.ledger\n\t\t\t.listArtifacts(changeId, \"protocol\")\n\t\t\t.map(async (a) => JSON.parse(new TextDecoder().decode((await t.objects.get(a.object))!)) as Protocol),\n\t);\n\treturn protocols.flatMap((p) => p.controls);\n}\n\n/** Starts a change and conducts it to the IH-04 asked once the preparations 495 spends by itself were refused. */\nasync function questionAsked(t: TestHarness): Promise<{ changeId: string; change: DecisionRequest }> {\n\tconst { change } = await t.harness.start({\n\t\tproject_path: trackedProject(fixtureTsWithoutTests),\n\t\trequest_text: \"add shout\",\n\t\tactor: HUMAN,\n\t});\n\tconst result = await t.harness.advance(change.change_id, { max_steps: 40 });\n\tassert.equal(result.stopped_because, \"decision_required\", result.steps.join(\" | \"));\n\tconst pending = t.harness.pendingDecisions(change.change_id);\n\tassert.deepEqual(\n\t\tpending.map((d) => d.interaction),\n\t\t[\"IH-04\"],\n\t);\n\treturn { changeId: change.change_id, change: pending[0]! };\n}\n\ndescribe(\"the directories of the copy a prepared suite could not write are offered to the owner\", () => {\n\tit(\"après des préparations refusées dont la suite crée test-output/run/a et tente d'écrire hors de la copie, la question IH-04 offre grant_writable pour test-output/ au contrôle unit avec les chemins relevés et rien pour le chemin hors de la copie ; quand la suite n'écrit rien, elle ne l'offre pas\", async () => {\n\t\tconst outside = outsidePath();\n\t\tconst { change: asked } = await questionAsked(harnessWriting([\"test-output/run/a\"], [outside]));\n\t\tconst grants = asked.options.filter((o) => o.id === \"grant_writable\");\n\t\tassert.equal(grants.length, 1, `options offered: ${asked.options.map((o) => o.id).join(\", \")}`);\n\t\tassert.deepEqual(asked.grant_writable, { control_id: \"unit\", directories: [\"test-output/\"] });\n\t\tconst grant = grants[0]!;\n\t\tassert.ok(grant.label.includes(\"unit\") && grant.label.includes(\"test-output/\"), grant.label);\n\t\tassert.ok(grant.effect.includes(\"test-output/run/a\"), grant.effect);\n\t\tassert.ok(\n\t\t\tasked.options.every((o) => !`${o.label} ${o.effect}`.includes(\"495-outside\")),\n\t\t\t\"nothing is offered for the path outside the copy\",\n\t\t);\n\n\t\tconst { change: silent } = await questionAsked(harnessWriting([], []));\n\t\tassert.ok(\n\t\t\tsilent.options.every((o) => o.id !== \"grant_writable\"),\n\t\t\t`options offered: ${silent.options.map((o) => o.id).join(\", \")}`,\n\t\t);\n\t\tassert.equal(silent.grant_writable, undefined);\n\t});\n\n\tit(\"la réponse grant_writable écrit test-output/ sous policy.writable_paths.unit dans config.json en gardant suite_paths et le nom de la politique, accorde une préparation de plus, et le contrôle unit figé porte test-output/ ; la réponse préparer laisse config.json inchangé et aucun contrôle figé ne porte test-output/\", async () => {\n\t\tconst granting = controllerConfiguration();\n\t\tconst t = harnessWriting([\"test-output/run/a\"], [outsidePath()], granting.root);\n\t\tconst { changeId, change: asked } = await questionAsked(t);\n\t\tanswer(t, changeId, asked, \"grant_writable\");\n\t\tassert.deepEqual(JSON.parse(readFileSync(join(granting.root, \"config.json\"), \"utf8\")), {\n\t\t\tpolicy: { ...CONTROLLER_POLICY, writable_paths: { unit: [\"coverage/\", \"test-output/\"] } },\n\t\t\tlanguage: \"en\",\n\t\t});\n\t\tt.agent.scripts.set(\"prepare\", adoptedPreparation);\n\t\tconst granted = await t.harness.advance(changeId, { max_steps: 40 });\n\t\tconst state = t.ledger.loadChange(changeId)!.state;\n\t\tassert.equal(\n\t\t\tstate.interventions.filter((i) => i.role === \"prepare\").length,\n\t\t\t3,\n\t\t\t`one more preparation is granted: ${granted.steps.join(\" | \")}`,\n\t\t);\n\t\tassert.equal(state.gates.G2?.verdict, \"PASS\", granted.steps.join(\" | \"));\n\t\tconst unit = (await frozenControls(t, changeId)).filter((c) => c.control_id === \"unit\");\n\t\tassert.ok(\n\t\t\tunit.length > 0 &&\n\t\t\t\tunit.every((c) => c.writable_paths.includes(\"test-output/\") && c.writable_paths.includes(\"coverage/\")),\n\t\t\tJSON.stringify(unit),\n\t\t);\n\n\t\tconst declining = controllerConfiguration();\n\t\tconst u = harnessWriting([\"test-output/run/a\"], [outsidePath()], declining.root);\n\t\tconst other = await questionAsked(u);\n\t\tanswer(u, other.changeId, other.change, \"prepare\");\n\t\tu.agent.scripts.set(\"prepare\", adoptedPreparation);\n\t\tconst prepared = await u.harness.advance(other.changeId, { max_steps: 40 });\n\t\tassert.equal(readFileSync(join(declining.root, \"config.json\"), \"utf8\"), declining.text);\n\t\tassert.equal(u.ledger.loadChange(other.changeId)!.state.gates.G2?.verdict, \"PASS\", prepared.steps.join(\" | \"));\n\t\tconst frozen = await frozenControls(u, other.changeId);\n\t\tassert.ok(frozen.length > 0, \"a protocol is frozen\");\n\t\tassert.ok(\n\t\t\tf