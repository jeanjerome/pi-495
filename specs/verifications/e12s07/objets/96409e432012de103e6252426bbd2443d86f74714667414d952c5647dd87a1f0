tracks is indexable whatever the rules say.\n37\t */\n38\tasync function indexablePaths(project: string, paths: readonly string[]): Promise<string[]> {\n39\t\tconst own = paths.filter((path) => !inInstalledDependencies(path));\n40\t\tif (own.length === 0) return [];\n41\t\tconst listed = await git(project, [\"ls-files\", \"-z\", \"--others\", \"--ignored\", \"--exclude-standard\", \"--\", ...own]);\n42\t\tconst ignored = new Set(listed.stdout.split(\"\\0\").filter(Boolean));\n43\t\treturn own.filter((path) => !ignored.has(path));\n44\t}\n45\t\n46\texport class GitIntegrator {\n47\t\tprivate readonly harness: Harness;\n48\t\tconstructor(harness: Harness) {\n49\t\t\tthis.harness = harness;\n50\t\t}\n51\t\n52\t\t/** Bound to the controller: one integration step per call. */\n53\t\tstep = async (unit: Unit, cor: string): Promise<Unit> => {\n54\t\t\tconst h = this.harness;\n55\t\t\tconst state = unit.state;\n56\t\t\tconst reference = (await h.artifacts.latest<ReferenceSnapshot>(state, \"reference\"))!.content;\n57\t\t\tconst manifest = await h.artifacts.read<CandidateManifest>({\n58\t\t\t\tartifact_id: state.candidate!.candidate_id,\n59\t\t\t\trevision: 1,\n60\t\t\t});\n61\t\t\tconst project = reference.project_path;\n62\t\t\tconst referenceEntries = includedEntries(reference.entries, reference.exclusions);\n63\t\t\tconst info = await inspectGit(project);\n64\t\t\tconst destination = info.branch ?? \"HEAD\";\n65\t\t\tconst before = info.head ?? \"0\".repeat(40);\n66\t\t\t// destination advanced?\n67\t\t\tif (state.integration && state.integration.destination_before !== before) {\n68\t\t\t\tconst current = await walkTree(project, {\n69\t\t\t\t\texclusions: reference.exclusions,\n70\t\t\t\t\tmax_file_bytes: 8 * 1024 * 1024,\n71\t\t\t\t\tmax_entries: 50_000,\n72\t\t\t\t});\n73\t\t\t\tconst changed =\n74\t\t\t\t\tdigestValue(current.entries.map((e) => [e.path, e.content_digest])) !==\n75\t\t\t\t\tdigestValue(referenceEntries.map((e) => [e.path, e.content_digest]));\n76\t\t\t\treturn h.commit(\n77\t\t\t\t\tunit,\n78\t\t\t\t\t{\n79\t\t\t\t\t\ttype: \"integration.destination_advanced\",\n80\t\t\t\t\t\tat: h.now(),\n81\t\t\t\t\t\tactor: KERNEL_ACTOR,\n82\t\t\t\t\t\tdestination_before: before,\n83\t\t\t\t\t\tcombined_changed: changed,\n84\t\t\t\t\t},\n85\t\t\t\t\tcor,\n86\t\t\t\t);\n87\t\t\t}\n88\t\t\tif (!state.operation) {\n89\t\t\t\tconst workingTree = await walkTree(project, {\n90\t\t\t\t\texclusions: reference.exclusions,\n91\t\t\t\t\tmax_file_bytes: 8 * 1024 * 1024,\n92\t\t\t\t\tmax_entries: 50_000,\n93\t\t\t\t});\n94\t\t\t\tif (diffEntries(referenceEntries, workingTree.entries).some((e) => e.baseline_state !== \"unchanged\")) {\n95\t\t\t\t\treturn h.commit(\n96\t\t\t\t\t\tunit,\n97\t\t\t\t\t\t{\n98\t\t\t\t\t\t\ttype: \"change.block\",\n99\t\t\t\t\t\t\tat: h.now(),\n100\t\t\t\t\t\t\tactor: KERNEL_ACTOR,\n101\t\t\t\t\t\t\treason: \"integration_conflict\",\n102\t\t\t\t\t\t\tdetail:\n103\t\t\t\t\t\t\t\t\"the project tree differs from the reference captured at intake; re-verify or resolve before integrating (RM-054)\",\n104\t\t\t\t\t\t},\n105\t\t\t\t\t\tcor,\n106\t\t\t\t\t);\n107\t\t\t\t}\n108\t\t\t\tconst plan = { destination, before, candidate: manifest.manifest_digest, paths: manifest.selected_paths };\n109\t\t\t\treturn h.commit(\n110\t\t\t\t\tunit,\n111\t\t\t\t\t{\n112\t\t\t\t\t\ttype: \"integration.prepare\",\n113\t\t\t\t\t\tat: h.now(),\n114\t\t\t\t\t\tactor: KERNEL_ACTOR,\n115\t\t\t\t\t\toperation_id: h.id(\"op\"),\n116\t\t\t\t\t\tidempotency_key: `integrate:${manifest.manifest_digest}:${before}`,\n117\t\t\t\t\t\tdestination,\n118\t\t\t\t\t\tdestination_before: before,\n119\t\t\t\t\t\tplan_digest: digestValue(plan),\n120\t\t\t\t\t},\n121\t\t\t\t\tcor,\n122\t\t\t\t);\n123\t\t\t}\n124\t\t\tconst opId = state.operation.operation_id;\n125\t\t\tif (state.operation.effect_state === \"prepared\") {\n126\t\t\t\tunit = h.commit(\n127\t\t\t\t\tunit,\n128\t\t\t\t\t{\n129\t\t\t\t\t\ttype: \"integration.effect\",\n130\t\t\t\t\t\tat: h.now(),\n