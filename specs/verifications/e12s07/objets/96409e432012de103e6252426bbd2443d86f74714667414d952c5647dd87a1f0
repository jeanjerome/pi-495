ailed: ${r.stderr}`);\n173\t\t\t\t\t}\n174\t\t\t\t\tconst after = (await inspectGit(project)).head ?? before;\n175\t\t\t\t\tconst applied = await walkTree(project, {\n176\t\t\t\t\t\texclusions: reference.exclusions,\n177\t\t\t\t\t\tmax_file_bytes: 8 * 1024 * 1024,\n178\t\t\t\t\t\tmax_entries: 50_000,\n179\t\t\t\t\t});\n180\t\t\t\t\tconst appliedEntries = diffEntries(referenceEntries, applied.entries);\n181\t\t\t\t\tconst appliedDigest = digestValue({\n182\t\t\t\t\t\tbase_ref: reference.tree_digest,\n183\t\t\t\t\t\tselected_paths: appliedEntries.filter((e) => e.baseline_state !== \"unchanged\").map((e) => e.path),\n184\t\t\t\t\t\texclusions: manifest.exclusions,\n185\t\t\t\t\t\tentries: appliedEntries.map((e) => [\n186\t\t\t\t\t\t\te.path,\n187\t\t\t\t\t\t\te.kind,\n188\t\t\t\t\t\t\te.content_digest,\n189\t\t\t\t\t\t\te.mode,\n190\t\t\t\t\t\t\te.symlink_target,\n191\t\t\t\t\t\t\te.baseline_state,\n192\t\t\t\t\t\t]),\n193\t\t\t\t\t\tmetadata_policy: \"content_and_mode\",\n194\t\t\t\t\t});\n195\t\t\t\t\tconst receipt: IntegrationReceipt = {\n196\t\t\t\t\t\tdestination,\n197\t\t\t\t\t\tbefore,\n198\t\t\t\t\t\tafter,\n199\t\t\t\t\t\tcandidate_digest: manifest.manifest_digest,\n200\t\t\t\t\t\tapplied_digest: appliedDigest,\n201\t\t\t\t\t\tcommit: after,\n202\t\t\t\t\t\tfiles: manifest.selected_paths,\n203\t\t\t\t\t\tat: h.now(),\n204\t\t\t\t\t};\n205\t\t\t\t\tawait h.artifacts.store(\"integration\", state.change_id, h.id(\"rcp\"), receipt, KERNEL_ACTOR.actor_id);\n206\t\t\t\t\tunit = h.commit(\n207\t\t\t\t\t\tunit,\n208\t\t\t\t\t\t{\n209\t\t\t\t\t\t\ttype: \"integration.effect\",\n210\t\t\t\t\t\t\tat: h.now(),\n211\t\t\t\t\t\t\tactor: KERNEL_ACTOR,\n212\t\t\t\t\t\t\toperation_id: opId,\n213\t\t\t\t\t\t\teffect_state: \"confirmed\",\n214\t\t\t\t\t\t\tdetail: null,\n215\t\t\t\t\t\t\tdecision_id: null,\n216\t\t\t\t\t\t},\n217\t\t\t\t\t\tcor,\n218\t\t\t\t\t);\n219\t\t\t\t\treturn h.commit(\n220\t\t\t\t\t\tunit,\n221\t\t\t\t\t\t{\n222\t\t\t\t\t\t\ttype: \"gate.evaluate\",\n223