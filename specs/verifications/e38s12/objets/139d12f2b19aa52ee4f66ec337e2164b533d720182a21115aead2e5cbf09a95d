tocol_ref,\n\t\t\t\tcandidate: input.candidate,\n\t\t\t\tsubject: {\n\t\t\t\t\tkind: \"candidate\" as const,\n\t\t\t\t\tid: input.candidate.candidate_id,\n\t\t\t\t\trevision: 1,\n\t\t\t\t\tdigest: input.candidate.manifest_digest,\n\t\t\t\t},\n\t\t\t\tworkspace_path: input.workspace_path,\n\t\t\t\tenvironment: this.deps.environment,\n\t\t\t\trequirement_refs: control.requirement_refs,\n\t\t\t\tproducer: EXECUTOR_ACTOR,\n\t\t\t\tintroduced_lines: introduced.lines,\n\t\t\t};\n\t\t\tconst planned = await this.citeOrPlanRun(input, control, invocation);\n\t\t\tif (\"cited\" in planned) {\n\t\t\t\tfacts.push(factOf(planned.cited, blockingOf(planned.cited)));\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tconst observed = (await this.deps.controls.runControl(planned.invocation)).evidence;\n\t\t\t// A path the diff could not read is a limit of every control that judged the introduced lines,\n\t\t\t// not a silent zero.\n\t\t\tconst limits =\n\t\t\t\tintroduced.notes.length > 0 && this.differential(control)\n\t\t\t\t\t? { ...observed.limits, notes: [...observed.limits.notes, ...introduced.notes] }\n\t\t\t\t\t: observed.limits;\n\t\t\tlet candidate: EvidenceCandidate = {\n\t\t\t\t...observed,\n\t\t\t\tfacts: { ...observed.facts, run: \"candidate\", ...planned.facts },\n\t\t\t\tlimits,\n\t\t\t};\n\t\t\tconst pass = passes.get(control.control_id);\n\t\t\tif (pass) {\n\t\t\t\tlet outcome = compareToReference(observed.verdict, observed.findings, pass, shape, baseline.tolerance);\n\t\t\t\t// The divergence to pay a confirmation for is the one the tolerance left standing: a control\n\t\t\t\t// whose every finding the reference already carried has nothing to confirm.\n\t\t\t\tif (\n\t\t\t\t\tbaseline.instability === \"confirm_then_indeterminate\" &&\n\t\t\t\t\tbaseline.max_confirmations > 0 &&\n\t\t\t\t\tdivergesFromReference(outcome.verdict, pass.verdict)\n\t\t\t\t) {\n\t\t\t\t\t// The two passes diverge and no preexisting finding explains it. The frozen rule pays\n\t\t\t\t\t// for one confirmation on the same candidate before the change is corrected for it.\n\t\t\t\t\tthis.deps.progress(\n\t\t\t\t\t\t`confirming control ${control.control_id}: it fails on the candidate and passes on the reference`,\n\t\t\t\t\t);\n\t\t\t\t\tconst confirmation = (await this.deps.controls.runControl(invocation)).evidence;\n\t\t\t\t\tconst confirmationId = this.deps.id(\"evc\");\n\t\t\t\t\tthis.storeEvidence(\n\t\t\t\t\t\tinput.change_id,\n\t\t\t\t\t\t{ ...confirmation, facts: { ...confirmation.facts, run: \"confirmation\" } },\n\t\t\t\t\t\tconfirmationId,\n\t\t\t\t\t);\n\t\t\t\t\toutcome = applyInstability(outcome, confirmation.verdict, confirmationId);\n\t\t\t\t}\n\t\t\t\tcandidate = {\n\t\t\t\t\t...candidate,\n\t\t\t\t\tverdict: outcome.verdict,\n\t\t\t\t\tfindings: outcome.findings,\n\t\t\t\t\tbaseline: outcome.comparison,\n\t\t\t\t\tlimits: {\n\t\t\t\t\t\t...candidate.limits,\n\t\t\t\t\t\tunstable: outcome.comparison.unstable,\n\t\t\t\t\t\tnotes: [...candidate.limits.notes, ...outcome.comparison.notes],\n\t\t\t\t\t},\n\t\t\t\t};\n\t\t\t}\n\t\t\tconst evidence = this.storeEvidence(input.change_id, candidate, this.deps.id(\"evd\"));\n\t\t\tfacts.push(factOf(evidence, blockingOf(evidence)));\n\t\t}\n\t\t// Evidence is about the snapshot the protocol froze: the kernel says whether the tree the\n\t\t// controls left behind is still that one (VER-03).\n\t\tconst writable = writablePrefixes(protocol.controls);\n\t\tconst after = await this.snapshotAfterControls(input, writable);\n\t\treturn { facts, candidate_moved: candidateMoved(manifest, after, writable) };\n\t}\n\n\t/**\n\t * The exploration of a formal model is about the model: the one an earlier candidate of this change made of the same\n\t * model is cited for this one and stored as its evidence. Otherwise, the invocation to run — for an exploration,\n\t * with what it reads, which identifies its result — and the facts saying why nothing was cited.\n\t */\n\tprivate async citeOrPlanRun(\n\t\tinput: RunInput,\n\t\tcontrol: ControlDefinition,\n\t\tinvocation: ControlInvocation,\n\t): Promise<{ cited: Evidence } | { invocation: ControlInvocation; facts: { rerun_because?: string } }> {\n\t\tconst pkg = control.formal_package;\n\t\tif (!pkg) return { invocation, facts: {} };\n\t\tconst started = this.deps.now();\n\t\tconst reads = { model: pkg.model, config: pkg.config, cwd: control.cwd, tools: [pkg.tool.java, pkg.tool.jar] };\n\t\tconst inputs = await formalInputsOf({ ...reads, env_allowlist: control.env_allowlist }, input.workspace_path);\n\t\tconst key = controlInputsDigest(control, input.candidate.manifest_digest, inputs);\n\t\tconst found = await establishedExploration(this.deps.ledger.listEvidence(input.change_id), control, inputs, key, {\n\t\t\tenvironment_digest: this.deps.environment.digest,\n\t\t\tprotocol: input.protocol_ref,\n\t\t\tobjects: this.deps.objects,\n\t\t});\n\t\tif (\"rerun_because\" in found)\n\t\t\treturn { invocation: { ...invocation, formal_inputs: inputs }, facts: { rerun_because: found.rerun_because } };\n\t\tthis.deps.progress(`control ${control.control_id} cites the exploration ${found.original.evidence_id}`);\n\t\tconst citation = citationOf(found.original, invocation, key, { started_at: started, ended_at: this.deps.now() });\n\t\treturn { cited: this.storeEvidence(input.change_id, citation, this.deps.id(\"evd\")) };\n\t}\n\n\t/**\n\t * The candidate tree once the controls have run, taken with their writable declarations excluded:\n\t * a build output is not part of what the two passes have to agree on.\n\t */\n\tprivate async snapshotAfterControls(input: RunInput, writable: readonly string[]): Promise<CandidateManifest> {\n\t\tconst handle = {\n\t\t\tworkspace_id: input.candidate.workspace_id,\n\t\t\tpath: input.workspace_path,\n\t\t\treference_id: input.reference.reference_id,\n\t\t\tcreated_at: this.deps.now(),\n\t\t};\n\t\treturn await this.deps.workspace.snapshotCandidate(handle, input.reference, {\n\t\t\t...this.deps.workspacePolicy,\n\t\t\texclusions: [...this.deps.workspacePolicy.exclusions, ...writable],\n\t\t});\n\t}\n\n\t/**\n\t * The reference pass of every control (VER-08): the same control, on the initial tree, in the same\n\t * environment — the comparability `environment_digest` expresses is the condition for the two\n\t * passes to be about the same thing. A pass already established for this control, this reference\n\t * and this environment is read back from the ledger: a reference does not change during a change,\n\t * so the attempts that follow a refusal cost nothing on the reference side.\n\t */\n\tprivate async referencePasses(\n\t\tchangeId: string,\n\t\tprotocol: Protocol,\n\t\tprotocolRef: ProtocolRef,\n\t\treference: ReferenceSnapshot,\n\t): Promise<Map<string, ReferencePass>> {\n\t\tconst passes = new Map<string, ReferencePass>();\n\t\tif (!protocol.baseline.compare_to_reference) return passes;\n\t\tconst established = this.deps.ledger.listEvidence(changeId);\n\t\tconst pending: ControlDefinition[] = [];\n\t\t// An acceptance run judges the candidate on its own observations; its negative control is the run on a\n\t\t// deprived copy it makes itself, so no failure the reference shares is ever tolerated.\n\t\tfor (const control of protocol.controls.filter((c) => !c.acceptance_recipe)) {\n\t\t\tconst reused = reusableReferencePass(\n\t\t\t\testablished,\n\t\t\t\tcontrol,\n\t\t\t\treference.tree_digest,\n\t\t\t\tthis.deps.environment.digest,\n\t\t\t\tprotocolRef,\n\t\t\t);\n\t\t\tif (reused)\n\t\t\t\tpasses.set(control.control_id, {\n\t\t\t\t\treference_id: reference.reference_id,\n\t\t\t\t\treference_digest: reference.tree_digest,\n\t\t\t\t\tverdict: reused.verdict,\n\t\t\t\t\tfindings: reused.findings,\n\t\t\t\t\tevidence_id: reused.evidence_id,\n\t\t\t\t\treused: true,\n\t\t\t\t});\n\t\t\telse pending.push(control);\n\t\t}\n\t\tfor (const stored of await this.runOnReference(changeId, pending, protocol, protocolRef, reference))\n\t\t\tpasses.set(stored.control_id, {\n\t\t\t\treference_id: reference.reference_id,\n\t\t\t\treference_digest: reference.tree_digest,\n\t\t\t\tverdict: stored.verdict,\n\t\t\t\tfindings: stored.findings,\n\t\t\t\tevidence_id: stored.evidence_id,\n\t\t\t\treused: false,\n\t\t\t});\n\t\treturn passes;\n\t}\n\n\t/**\n\t * The survey of the project: every frozen control runs on a copy of the reference, and what each\n\t * observed is recorded as evidence about the reference. Nothing runs in the project itself.\n\t */\n\tasync surveyReference(input: {\n\t\tchange_id: string;\n\t\tprotocol: Protocol;\n\t\tprotocol_ref: ProtocolRef;\n\t\treference: ReferenceSnapshot;\n\t}): Promise<{ passes: { fact: EvidenceFact; findings: Evidence[\"findings\"] }[]; generated_files: string[] }> {\n\t\tconst annotations = input.protocol.quality_referential?.perimeter?.generated_annotations ?? [];\n\t\tlet generated: string[] = [];\n\t\tconst passes = await this.runOnReference(\n\t\t\tinput.change_id,\n\t\t\tinput.protocol.controls,\n\t\t\tinput.protocol,\n\t\t\tinput.protocol_ref,\n\t\t\tinput.reference,\n\t\t\tasync (workspacePath, stored) => {\n\t\t\t\tif (annotations.length > 0) generated = await generatedFiles(workspacePath, stored, annotations);\n\t\t\t},\n\t\t);\n\t\treturn {\n\t\t\tpasses: passes.map((evidence) => ({\n\t\t\t\tfact: factOf(evidence, blockingCount(evidence.findings, \"block_any\")),\n\t\t\t\tfindings: evidence.findings,\n\t\t\t})),\n\t\t\tgenerated_files: generated,\n\t\t};\n\t}\n\n\t/**\n\t * Runs each control, in order, in one copy of the reference, and seals what each observed as a reference\n\t * pass; `inspect` then reads the copy the controls ran in, before it is deleted.\n\t */\n\tprivate async runOnReference(\n\t\tchangeId: string,\n\t\tcontrols: readonly ControlDefinition[],\n\t\tprotocol: Protocol,\n\t\tprotocolRef: ProtocolRef,\n\t\treference: ReferenceSnapshot,\n\t\tinspect?: (workspacePath: string, stored: readonly Evidence[]) => Promise<void>,\n\t): Promise<Evidence[]> {\n\t\tif (controls.length === 0) return [];\n\t\tconst stored: Evidence[] = [];\n\t\tconst handle = await openWorkspaceWithComplements(this.deps, reference, protocol.complements ?? []);\n\t\ttry {\n\t\t\tfor (const control of controls) {\n\t\t\t\tthis.deps.progress(`running control ${control.control_id} on the reference`);\n\t\t\t\t// The reference introduces nothing: that is the whole content of this pass for a differential\n\t\t\t\t// control, and it is why such a control carries no preexisting finding of its own (QLT-04).\n\t\t\t\tconst { evidence } = await this.deps.controls.runControl({\n\t\t\t\t\tcontrol,\n\t\t\t\t\tprotocol: protocolRef,\n\t\t\t\t\tcandidate: {\n\t\t\t\t\t\tcandidate_id: reference.reference_id,\n\t\t\t\t\t\tmanifest_digest: reference.tree_digest,\n\t\t\t\t\t\tbase_digest: reference.tree_digest,\n\t\t\t\t\t\tworkspace_id: handle.workspace_id,\n\t\t\t\t\t},\n\t\t\t\t\tsubject: { kind: \"reference\", id: reference.reference_id, revision: 1, digest: reference.tree_digest },\n\t\t\t\t\tworkspace_path: handle.path,\n\t\t\t\t\tenvironment: this.deps.environment,\n\t\t\t\t\trequirement_refs: control.requirement_refs,\n\t\t\t\t\tproducer: EXECUTOR_ACTOR,\n\t\t\t\t\tintroduced_lines: {},\n\t\t\t\t});\n\t\t\t\t// Observed on the initial tree: every finding of this pass is a defect the change inherited.\n\t\t\t\tstored.push(\n\t\t\t\t\tthis.storeEvidence(\n\t\t\t\t\t\tchangeId,\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\t...evidence,\n\t\t\t\t\t\t\tfacts: { ...evidence.facts, run: \"reference\" },\n\t\t\t\t\t\t\tfindings: evidence.findings.map((finding) => ({ ...finding, baseline_state: \"preexisting\" as const })),\n\t\t\t\t\t\t},\n\t\t\t\t\t\tthis.deps.id(\"evr\"),\n\t\t\t\t\t),\n\t\t\t\t);\n\t\t\t}\n\t\t\tawait inspect?.(handle.path, stored);\n\t\t} finally {\n\t\t\tawait this.deps.workspace.closeWorkspace(handle.workspace_id, \"delete\");\n\t\t}\n\t\treturn stored;\n\t}\n\n\t/**\n\t * The lines the frozen candidate introduces, recomputed from the store and not from a tree: the\n\t * candidate bytes of `files_` and the reference bytes of `base_files_` are both in the dossier, so\n\t * the calculation an auditor would redo is the one the controls were given (QLT-04).\n\t */\n\tprivate async introducedLines(\n\t\tmanifest: CandidateManifest,\n\t\tshape: CandidateShape,\n\t\tcomplements: readonly AdoptedComplement[],\n\t): Promise<IntroducedLinesResult> {\n\t\tconst candidateBytes = await this.deps.storedFiles(`files_${manifest.candidate_id}`);\n\t\tconst referenceBytes = await this.deps.storedFiles(`base_files_${manifest.candidate_id}`);\n\t\treturn introducedLinesOf(manifest, shape.renames, referenceBytes, candidateBytes, complements);\n\t}\n\n\t/** A qualification an earlier protocol of this change established for this exact sensor. */\n\tprivate async establishedQualification(\n\t\tprotocolRefs: readonly { artifact_id: string; revision: number }[],\n\t\tcontrol: ControlDefinition,\n\t): Promise<Qualification | null> {\n\t\tconst priors: Protocol[] = [];\n\t\tfor (const ref of protocolRefs) {\n\t\t\tconst prior = await this.deps.readArtifact<Protocol>(ref).catch(() => null);\n\t\t\tif (prior) priors.push(prior);\n\t\t}\n\t\treturn reusableQualification(priors, control, this.deps.environment.digest);\n\t}\n\n\t/**\n\t * Adds what one qualification run saw on the reference to the suite observation. Only a parser\n\t * that reports cases can contribute: an exit code alone tells nothing apart.\n\t */\n\tprivate countReferenceCases(\n\t\tinto: { reported: number; skipped: number; witnesses: number; any: boolean },\n\t\tcontrol: ControlDefinition,\n\t\twitnessTests: number,\n\t\tfacts: Record<string, unknown> | null,\n\t): void {\n\t\tif (control.parser === \"exit-code\" || !facts || typeof facts.tests !== \"number\") return;\n\t\tinto.reported += facts.tests;\n\t\tinto.skipped +=\n\t\t\t(typeof facts.skipped === \"number\" ? facts.skipped : 0) + (typeof facts.todo === \"number\" ? facts.todo : 0);\n\t\tinto.witnesses += witnessTests;\n\t\tinto.any = true;\n\t}\n\n\t/** Seals one observation into the ledger: chained, digested, and never rewritten (EVD-01). */\n\tprivate storeEvidence(changeId: string, candidate: EvidenceCandidate, evidenceId: string): Evidence {\n\t\tvalidate(EvidenceCandidate, candidate, \"evidence-candidate\");\n\t\tconst evidence: Evidence = {\n\t\t\tevidence_id: evidenceId,\n\t\t\trequirement_refs: candidate.requirement_refs,\n\t\t\tcontrol_id: candidate.control_id,\n\t\t\tcontrol_version: candidate.control_version,\n\t\t\tsubject: candidate.subject,\n\t\t\tprotocol_revision: candidate.protocol_revision,\n\t\t\tenvironment_digest: candidate.environment.digest,\n\t\t\tinputs_digest: candidate.inputs_digest,\n\t\t\tstarted_at: candidate.started_at,\n\t\t\tended_at: candidate.ended_at,\n\t\t\tverdict: candidate.verdict,\n\t\t\tfacts: candidate.facts,\n\t\t\tfindings: candidate.findings,\n\t\t\tartifacts: candidate.artifacts,\n\t\t\tlimits: candidate.limits,\n\t\t\tbaseline: candidate.baseline,\n\t\t\tproducer: candidate.producer,\n\t\t\tintegrity: { content_digest: \"\", chained_to: null },\n\t\t};\n\t\tevidence.integrity.content_digest = evidenceDigest(evidence);\n\t\tvalidate(Evidence, evidence, \"evidence\");\n\t\tthis.deps.ledger.putEvidence(evidence, changeId);\n\t\treturn evidence;\n\t}\n}\n\n/**\n * The files the findings of `passes` name that a generator declares it wrote, read in the copy the\n * controls ran in without writing anything there. A place outside the copy, or that cannot be read,\n * declares nothing.\n */\nasync function generatedFiles(\n\tworkspacePath: string,\n\tpasses: readonly Evidence[],\n\tannotations: readonly string[],\n): Promise<string[]> {\n\tconst root = resolve(workspacePath);\n\tconst places = new Set(passes.flatMap((evidence) => evidence.findings.flatMap(placesOf)));\n\tconst generated: string[] = [];\n\tfor (const place of places) {\n\t\tconst inside = relative(root, resolve(root, place));\n\t\tif (inside === \"\" || inside === \"..\" || inside.startsWith(`..${sep}`)) continue;\n\t\tconst source = await readFile(join(root, inside), \"utf8\").catch(() => \"\");\n\t\tif (declaresGenerated(source, annotations)) generated.push(place);\n\t}\n\treturn generated.sort();\n}\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/v0-pure/formal-result-identity.test.ts":{"tests":[{"id":"0","name":"test/v0-pure/formal-result-identity.test.ts"}],"source":"import { strict as assert } from \"node:assert\";\nimport { describe, it } from \"node:test\";\nimport { digestBytes } from \"../../src/contracts/digest.ts\";\nimport type { ControlDefinition, FormalPackage } from \"../../src/contracts/v1/protocol.ts\";\nimport { controlInputsDigest } from \"../../src/domain/baseline.ts\";\nimport { formalPackageDigest, importedModules } from \"../../src/domain/formal-package.ts\";\nimport { controlOf } from \"../helpers/execution-fixture.ts\";\n\nconst COMPTEUR =\n\t\"---- MODULE Compteur ----\\nEXTENDS Bornes\\nVARIABLE x\\nInit == x = 0\\nNext == x < Max /\\\\ x' = x + 1\\n====\\n\";\n/** A module the model reaches through `EXTENDS`, and which the package does not pin. */\nconst BORNES = \"---- MODULE Bornes ----\\nEXTENDS Naturals\\nMax == 3\\nBorne(x) == x <= Max\\n====\\n\";\nconst CONFIG = \"INIT Init\\nNEXT Next\\nINVARIANT Borne\\n\";\n\nconst JAVA = \"/opt/java/bin/java\";\nconst JAR = \"/opt/tlaplus/tla2tools.jar\";\n\nconst PACKAGE: FormalPackage = {\n\tmodel: \"spec/Compteur.tla\",\n\tconfig: \"spec/Compteur.cfg\",\n\tfiles: { \"spec/Compteur.tla\": digestBytes(COMPTEUR), \"spec/Compteur.cfg\": digestBytes(CONFIG) },\n\trequired_properties: [\"Borne\"],\n\texpected_violation: { mutant: \"spec/mutants/Compteur.tla\", replaces: \"spec/Compteur.tla\" },\n\ttool: { name: \"TLC\", version: \"2.19 of 08 August 2024 (rev: 5a47802)\", java: JAVA, jar: JAR },\n\tbudget: { timeout_ms: 600_000, workers: 1, heap_mb: 512 },\n\trequirement_ids: [\"R1\"],\n\tcorrespondence: [{ control_id: \"unit\", cases: [\"R1 replays the traces of Compteur\"] }],\n};\n\n/** The control exploring `pkg`, versioned by the package as the kernel freezes it. */\nfunction formalControl(pkg: FormalPackage): ControlDefinition {\n\treturn controlOf({\n\t\tcontrol_id: \"formal-model\",\n\t\tversion: formalPackageDigest(pkg),\n\t\tcommand: [pkg.tool.java, \"-cp\", pkg.tool.jar, \"tlc2.TLC\", \"-tool\", \"-config\", pkg.config, pkg.model],\n\t\tparser: \"tlc\",\n\t\tformal_package: pkg,\n\t});\n}\n\n/** What the exploration reads, by path: the closure of the model's modules, its configuration and the tool. */\nconst READ = {\n\t\"spec/Compteur.tla\": digestBytes(COMPTEUR),\n\t\"spec/Bornes.tla\": digestBytes(BORNES),\n\t\"spec/Compteur.cfg\": digestBytes(CONFIG),\n\t[JAVA]: digestBytes(\"java 21\"),\n\t[JAR]: digestBytes(\"tla2tools 2.19\"),\n};\n\nconst CANDIDATE_A = `sha256:${\"a\".repeat(64)}`;\nconst CANDIDATE_B = `sha256:${\"b\".repeat(64)}`;\n\ndescribe(\"a formal result is identified by everything it read, and a program result by its exact candidate\", () => {\n\tit(\"changer un import transitif ou une propriété change la clé, changer seulement le candidat ne conserve que le modèle\", () => {\n\t\tconst control = formalControl(PACKAGE);\n\t\tconst key = controlInputsDigest(control, CANDIDATE_A, READ);\n\n\t\tconst otherBound = { ...READ, \"spec/Bornes.tla\": digestBytes(BORNES.replace(\"Max == 3\", \"Max == 4\")) };\n\t\tassert.notEqual(\n\t\t\tcontrolInputsDigest(control, CANDIDATE_A, otherBound),\n\t\t\tkey,\n\t\t\t\"changing a module the model imports transitively, under the same name, changes the key\",\n\t\t);\n\t\tconst moreProperties = formalControl({ ...PACKAGE, required_properties: [\"Borne\", \"Progres\"] });\n\t\tassert.notEqual(\n\t\t\tcontrolInputsDigest(moreProperties, CANDIDATE_A, READ),\n\t\t\tkey,\n\t\t\t\"changing a required property changes the key\",\n\t\t);\n\t\tconst otherJar = { ...READ, [JAR]: digestBytes(\"tla2tools 1.8\") };\n\t\tassert.notEqual(\n\t\t\tcontrolInputsDigest(control, CANDIDATE_A, otherJar),\n\t\t\tkey,\n\t\t\t\"another jar at the same path changes the key\",\n\t\t);\n\n\t\tassert.equal(\n\t\t\tcontrolInputsDigest(control, CANDIDATE_B, READ),\n\t\t\tkey,\n\t\t\t\"another candidate holding the same model keeps the key of the model result\",\n\t\t);\n\t\tconst unit = controlOf({ control_id: \"unit\", command: [\"node\", \"--test\"] });\n\t\tassert.notEqual(\n\t\t\tcontrolInputsDigest(unit, CANDIDATE_B),\n\t\t\tcontrolInputsDigest(unit, CANDIDATE_A),\n\t\t\t\"a control of the program is identified by its exact candidate\",\n\t\t);\n\t});\n});\n\ndescribe(\"the modules a TLA+ module imports\", () => {\n\tit(\"are those named after EXTENDS and INSTANCE, a module named in a comment set aside\", () => {\n\t\tconst text = [\n\t\t\t\"---- MODULE Compteur ----\",\n\t\t\t\"EXTENDS Naturals ,  Bornes\",\n\t\t\t\"\\\\* EXTENDS Ligne\",\n\t\t\t\"(* INSTANCE Bloc\",\n\t\t\t\"   EXTENDS Bloc *)\",\n\t\t\t\"B == INSTANCE Bornes\",\n\t\t\t\"C == INSTANCE Cache WITH x <- 0\",\n\t\t\t\"====\",\n\t\t].join(\"\\n\");\n\t\tassert.deepEqual(importedModules(text), [\"Naturals\", \"Bornes\", \"Cache\"]);\n\t\tassert.deepEqual(importedModules(\"---- MODULE Seul ----\\nVARIABLE x\\n====\\n\"), [], \"a module importing nothing\");\n\t});\n});\n"},"test/v2-kernel/formal-result-reuse.test.ts":{"tests":[{"id":"1","name":"test/v2-kernel/formal-result-reuse.test.ts"}],"source":"/**\n * The exploration of a formal model is about the model, not the candidate: a second candidate holding the same model\n * cites the original proof instead of exploring it again, while the controls of the program run on it. What would make\n * that citation a lie — an altered proof, a changed import, another tool or environment, an input nobody can identify,\n * an exploration that proved nothing — has the model explored again.\n */\nimport { strict as assert } from \"node:assert\";\nimport { chmodSync, readFileSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { readersOf } from \"../../src/adapters/execution/common-readers.ts\";\nimport { GenericControlRunner } from \"../../src/adapters/execution/runner.ts\";\nimport { CasObjectStore } from \"../../src/adapters/object-store/cas.ts\";\nimport { UnconfinedSandbox } from \"../../src/adapters/sandbox/backends.ts\";\nimport { SqliteLedger } from \"../../src/adapters/storage-sqlite/ledger.ts\";\nimport { DEFAULT_WORKSPACE_POLICY, GitWorkspace } from \"../../src/adapters/workspace/git-workspace.ts\";\nimport { EXECUTOR_ACTOR } from \"../../src/application/actors.ts\";\nimport { establishedExploration, formalInputsOf, uncoveredModules } from \"../../src/application/formal-reuse.ts\";\nimport { VerificationCoordinator } from \"../../src/application/verification.ts\";\nimport { digestBytes, digestValue } from \"../../src/contracts/digest.ts\";\nimport type { EnvironmentRef } from \"../../src/contracts/v1/common.ts\";\nimport { type Evidence, evidenceDigest } from \"../../src/contracts/v1/evidence.ts\";\nimport type { ControlDefinition, FormalPackage, Protocol } from \"../../src/contracts/v1/protocol.ts\";\nimport type { EvidenceFact } from \"../../src/domain/change/commands.ts\";\nimport { DomainError } from \"../../src/domain/errors.ts\";\nimport { formalPackageDigest } from \"../../src/domain/formal-package.ts\";\nimport { DEFAULT_POLICY } from \"../../src/domain/policy.ts\";\nimport { STACKS_OF_495 } from \"../../src/extension/runtime.ts\";\nimport { controlOf } from \"../helpers/execution-fixture.ts\";\nimport { initRepo, outputDir, removedAfterEach, writeFiles } from \"../helpers/fixtures.ts\";\nimport { BOUNDED, COMPTEUR, CONFIG, DIVERGENT, counterPackage, tlcStandIn } from \"../helpers/formal-control.ts\";\n\nconst roots = removedAfterEach();\n\nconst AT = \"2026-10-10T12:00:00.000Z\";\nconst ENVIRONMENT: EnvironmentRef = {\n\tenvironment_id: \"env_formal\",\n\tdigest: digestValue({ formal: 1 }),\n\tprofile_id: \"u\",\n};\n\n/** The counter model reaching its bound through a module the package does not pin. */\nconst MODEL = COMPTEUR.replace(\"EXTENDS Naturals\", \"EXTENDS Naturals, Bornes\");\nconst BORNES = \"---- MODULE Bornes ----\\nEXTENDS Naturals\\nPlafond == 3\\n====\\n\";\n\nfunction formalControl(pkg: FormalPackage): ControlDefinition {\n\treturn controlOf({\n\t\tcontrol_id: \"formal-model\",\n\t\tversion: formalPackageDigest(pkg),\n\t\ttitle: `TLC on ${pkg.model}`,\n\t\tcommand: [pkg.tool.java, \"-cp\", pkg.tool.jar, \"tlc2.TLC\", \"-tool\", \"-config\", pkg.config, pkg.model],\n\t\ttimeout_ms: pkg.budget.timeout_ms,\n\t\tparser: \"tlc\",\n\t\twritable_paths: [\".495-tlc\"],\n\t\tenv_allowlist: [\"PATH\", \"HOME\", \"TMPDIR\", \"JAVA_HOME\"],\n\t\tprotected_paths: Object.keys(pkg.files),\n\t\tformal_package: pkg,\n\t});\n}\n\n/** A control of the program that records each run it makes, one line per run. */\nfunction unitControl(ran: string): ControlDefinition {\n\treturn controlOf({\n\t\tcontrol_id: \"unit\",\n\t\tcommand: [process.execPath, \"-e\", `require(\"node:fs\").appendFileSync(${JSON.stringify(ran)}, \"run\\\\n\")`],\n\t});\n}\n\nfunction lines(path: string): number {\n\ttry {\n\t\treturn readFileSync(path, \"utf8\")\n\t\t\t.split(\"\\n\")\n\t\t\t.filter((l) => l !== \"\").length;\n\t} catch {\n\t\treturn 0;\n\t}\n}\n\ninterface Bench {\n\tverify(candidate: Record<string, string>, environment?: EnvironmentRef): Promise<Evidence>;\n\tobjects: CasObjectStore;\n\t/** The jar the package names, outside the target. */\n\tjar: string;\n\texplorations(): number;\n\tprogramRuns(): number;\n\t/** The facts the last verification committed to the change for its candidate. */\n\tcommitted(): readonly EvidenceFact[];\n}\n\n/** A change whose protocol freezes the exploration of `model` and a program control, on a fresh ledger and store. */\nfunction bench(model: string = MODEL, imported: Record<string, string> = { \"spec/Bornes.tla\": BORNES }): Bench {\n\tconst root = outputDir(\"formal-reuse-\", roots);\n\tconst tool = tlcStandIn();\n\tconst pkg = counterPackage(tool, {\n\t\tfiles: { \"spec/Compteur.tla\": digestBytes(model), \"spec/Compteur.cfg\": digestBytes(CONFIG) },\n\t});\n\tconst unitRan = join(root, \"unit-ran.txt\");\n\tconst project = join(root, \"project\");\n\twriteFiles(project, {\n\t\t\"package.json\": JSON.stringify({ name: \"counter\", version: \"1.0.0\", type: \"module\" }),\n\t\t\"src/counter.js\": \"export function next(x, max) {\\n  return x + 1;\\n}\\n\",\n\t\t\"spec/Compteur.tla\": model,\n\t\t\"spec/Compteur.cfg\": CONFIG,\n\t\t...imported,\n\t});\n\tinitRepo(project);\n\tconst objects = new CasObjectStore(join(root, \"objects\"));\n\tconst ledger = new SqliteLedger(join(root, \"state.sqlite\"));\n\tconst workspace = new GitWorkspace(join(root, \"workspaces\"));\n\tconst runner = new GenericControlRunner(new UnconfinedSandbox(), objects, readersOf(STACKS_OF_495.technologies));\n\tconst formal = formalControl(pkg);\n\tconst protocol: Protocol = {\n\t\tprotocol_id: \"prt_1\",\n\t\tchange_id: \"chg_1\",\n\t\tcontrols: [formal, unitControl(unitRan)],\n\t\tqualifications: {},\n\t\tcapability_diagnosis: {\n\t\t\tstack: \"node\",\n\t\t\tlevel: \"discriminating\",\n\t\t\ttest_files: 1,\n\t\t\tdiscovered: 1,\n\t\t\texecuted: 1,\n\t\t\tundiscriminated_requirements: [],\n\t\t\tunobserved_requirements: [],\n\t\t\tnotes: [],\n\t\t},\n\t\tobligations: [],\n\t\trequired_reviews: [],\n\t\tarbitration: \"human_decision\",\n\t\tbaseline: { compare_to_reference: false, tolerance: \"block_any\", instability: \"none\", max_confirmations: 0 },\n\t\tenvironment_digest: ENVIRONMENT.digest,\n\t};\n\tlet next = 0;\n\tlet committed: readonly EvidenceFact[] = [];\n\treturn {\n\t\tobjects,\n\t\tcommitted: () => committed,\n\t\tjar: tool.jar,\n\t\texplorations: () => lines(tool.ran),\n\t\tprogramRuns: () => lines(unitRan),\n\t\tasync verify(files, environment = ENVIRONMENT) {\n\t\t\tconst reference = await workspace.captureReference(project, DEFAULT_WORKSPACE_POLICY);\n\t\t\tconst handle = await workspace.createWorkspace(reference, DEFAULT_WORKSPACE_POLICY);\n\t\t\twriteFiles(handle.path, files);\n\t\t\tconst manifest = await workspace.snapshotCandidate(handle, reference, DEFAULT_WORKSPACE_POLICY);\n\t\t\tconst coordinator = new VerificationCoordinator({\n\t\t\t\tcontrols: runner,\n\t\t\t\tworkspace,\n\t\t\t\tworkspacePolicy: DEFAULT_WORKSPACE_POLICY,\n\t\t\t\tobjects,\n\t\t\t\tledger,\n\t\t\t\tenvironment,\n\t\t\t\tpolicy: DEFAULT_POLICY,\n\t\t\t\tnow: () => AT,\n\t\t\t\tid: (prefix) => `${prefix}_${++next}`,\n\t\t\t\treadArtifact: async () => {\n\t\t\t\t\tthrow new DomainError(\"EVIDENCE_MISSING\", \"no artifact in this bench\");\n\t\t\t\t},\n\t\t\t\tstoredFiles: async () => async () => null,\n\t\t\t\tprogress: () => {},\n\t\t\t});\n\t\t\t({ facts: committed } = await coordinator.run({\n\t\t\t\tchange_id: \"chg_1\",\n\t\t\t\tprotocol,\n\t\t\t\tprotocol_ref: { protocol_id: \"prt_1\", revision: 1, content_digest: digestValue(protocol) },\n\t\t\t\tcandidate: {\n\t\t\t\t\tcandidate_id: manifest.candidate_id,\n\t\t\t\t\tmanifest_digest: manifest.manifest_digest,\n\t\t\t\t\tbase_digest: reference.tree_digest,\n\t\t\t\t\tworkspace_id: handle.workspace_id,\n\t\t\t\t},\n\t\t\t\tmanifest,\n\t\t\t\treference,\n\t\t\t\tworkspace_path: handle.path,\n\t\t\t}));\n\t\t\tconst explored = ledger\n\t\t\t\t.listEvidence(\"chg_1\")\n\t\t\t\t.find((e) => e.control_id === formal.control_id && e.subject.digest === manifest.manifest_digest);\n\t\t\tassert.ok(explored, \"the run records what it holds of the model for the candidate verified\");\n\t\t\treturn explored;\n\t\t},\n\t};\n}\n\ndescribe(\"a proof of the model is cited for another candidate only while it is intact and its inputs unchanged\", () => {\n\tit(\"la seconde demande cite la preuve originale et sa corruption interdit cette réutilisation\", async () => {\n\t\tconst b = bench();\n\t\tconst original = await b.verify({ \"src/counter.js\": BOUNDED });\n\t\tassert.equal(original.verdict, \"PASS\", `the model is explored: ${original.limits.notes.join(\" | \")}`);\n\t\tassert.equal(b.explorations(), 1);\n\n\t\tconst second = await b.verify({ \"src/counter.js\": DIVERGENT });\n\t\tassert.equal(b.explorations(), 1, \"the second request explores nothing\");\n\t\tassert.equal(second.facts.reused_from, original.evidence_id, \"the second request cites the original proof\");\n\t\tassert.equal(second.facts.run, \"reused\", \"the citation says it is a reuse\");\n\t\tassert.equal(second.facts.duration_ms, undefined, \"a reuse does not present itself as an execution\");\n\t\tassert.equal(second.verdict, \"PASS\");\n\t\tassert.equal(b.programRuns(), 2, \"the controls of the program run on the second candidate\");\n\t\tconst held = b.committed().find((f) => f.control_id === second.control_id);\n\t\tassert.equal(held?.evidence_id, second.evidence_id, \"the citation is what the verification holds of the model\");\n\t\tassert.equal(held?.subject_digest, second.subject.digest, \"for the second candidate\");\n\n\t\tconst stdout = original.artifacts.find((a) => a.name === \"stdout\");\n\t\tassert.ok(stdout, \"the original exploration kept its output\");\n\t\tconst path = b.objects.pathFor(stdout.ref.digest);\n\t\tchmodSync(path, 0o644);\n\t\twriteFileSync(path, \"an output nobody produced\\n\");\n\t\tconst third = await b.verify({ \"src/counter.js\": `${BOUNDED}// third\\n` });\n\t\tassert.equal(b.explorations(), 2, \"a corrupted proof forbids its reuse: the model is explored again\");\n\t\tassert.equal(third.facts.reused_from, undefined, \"nothing cites the corrupted proof\");\n\t\tassert.equal(third.facts.run, \"candidate\");\n\t\tassert.match(String(third.facts.rerun_because), /stdout of evd_\\d+ is lost or altered/, \"the evidence says why\");\n\t});\n\n\tit(\"a changed import, another tool or environment, an unidentified module or an inconclusive exploration is explored again\", async () => {\n\t\tconst b = bench();\n\t\tawait b.verify({ \"src/counter.js\": BOUNDED });\n\t\tconst imported = await b.verify({ \"spec/Bornes.tla\": BORNES.replace(\"Plafond == 3\", \"Plafond == 4\") });\n\t\tassert.equal(b.explorations(), 2, \"a module the model imports changed: explored again\");\n\t\tassert.match(String(imported.facts.rerun_because), /no earlier exploration read the same model/);\n\t\tawait b.verify({ \"src/counter.js\": DIVERGENT }, { ...ENVIRONMENT, digest: digestValue({ formal: 2 }) });\n\t\tassert.equal(b.explorations(), 3, \"another environment: explored again\");\n\t\twriteFileSync(b.jar, \"another tla2tools.jar at the same path\\n\");\n\t\tawait b.verify({ \"src/counter.js\": `${BOUNDED}// tool\\n` });\n\t\tassert.equal(b.explorations(), 4, \"another jar at the same path: explored again\");\n\t\tconst javaHome = process.env.JAVA_HOME;\n\t\ttry {\n\t\t\tprocess.env.JAVA_HOME = \"/opt/jdk-21\";\n\t\t\tawait b.verify({ \"src/counter.js\": `${BOUNDED}// jdk 21\\n` });\n\t\t\tawait b.verify({ \"src/counter.js\": `${BOUNDED}// jdk 21 again\\n` });\n\t\t\tassert.equal(b.explorations(), 5, \"the same variables: cited\");\n\t\t\tprocess.env.JAVA_HOME = \"/opt/jdk-17\";\n\t\t\tawait b.verify({ \"src/counter.js\": `${BOUNDED}// jdk 17\\n` });\n\t\t\tassert.equal(b.explorations(), 6, \"a variable the control passes to TLC changed: explored again\");\n\t\t} finally {\n\t\t\tif (javaHome === undefined) delete process.env.JAVA_HOME;\n\t\t\telse process.env.JAVA_HOME = javaHome;\n\t\t}\n\n\t\tconst unknown = bench(MODEL.replace(\"Bornes\", \"Inconnu\"), {});\n\t\tawait unknown.verify({ \"src/counter.js\": BOUNDED });\n\t\tconst again = await unknown.verify({ \"src/counter.js\": DIVERGENT });\n\t\tassert.equal(unknown.explorations(), 2, \"a module neither in the tree nor shipped by TLC forbids reuse\");\n\t\tassert.equal(again.facts.reused_from, undefined);\n\t\tassert.match(String(again.facts.rerun_because), /inputs not identified: spec\\/Inconnu\\.tla/);\n\n\t\tconst hanging = bench();\n\t\tconst interrupted = await hanging.verify({ \".495-hang\": \"\" });\n\t\tassert.equal(interrupted.verdict, \"INDETERMINATE\", \"the exploration is interrupted by its budget\");\n\t\tconst after = await hanging.verify({ \"src/counter.js\": BOUNDED });\n\t\tassert.equal(hanging.explorations(), 2, \"an interrupted exploration is not reused\");\n\t\tassert.equal(after.verdict, \"PASS\");\n\t\tassert.match(String(after.facts.rerun_because), /ended INDETERMINATE, which concludes nothing/);\n\t});\n\n\tit(\"a module at the root of the copy, where TLC looks before the model's directory, has the model explored again\", async () => {\n\t\tconst b = bench();\n\t\tawait b.verify({ \"src/counter.js\": BOUNDED });\n\t\tconst shadowed = await b.verify({ \"Bornes.tla\": BORNES.replace(\"Plafond == 3\", \"Plafond == 5\") });\n\t\tassert.equal(b.explorations(), 2, \"a Bornes.tla TLC reads in place of spec/Bornes.tla changes the key\");\n\t\tassert.equal(shadowed.facts.reused_from, undefined, \"nothing cites the exploration of spec/Bornes.tla\");\n\t\tawait b.verify({ \"Naturals.tla\": \"---- MODULE Naturals ----\\nNat == {0, 1}\\n====\\n\" });\n\t\tassert.equal(b.explorations(), 3, \"a file at the root named after a module TLC ships changes the key\");\n\t});\n});\n\n/** Sealed explorations of one key under one protocol revision, and the context a lookup runs in. */\nfunction sealedExplorations() {\n\tconst control = formalControl(counterPackage(tlcStandIn()));\n\tconst inputs = {\n\t\t\"spec/Compteur.cfg\": digestBytes(CONFIG),\n\t\t\"spec/Compteur.tla\": digestBytes(MODEL),\n\t\t\"spec/Bornes.tla\": digestBytes(BORNES),\n\t};\n\tconst key = digestValue({ read: inputs });\n\tconst protocol = { protocol_id: \"prt_1\", revision: 1, content_digest: digestValue(\"prt_1\") };\n\t/** A sealed, conclusive exploration of that key, in which TLC reports processing `modules`. */\n\tconst explored = (modules: string[], over: Partial<Evidence> = {}): Evidence => {\n\t\tconst evidence: Evidence = {\n\t\t\tevidence_id: \"evd_1\",\n\t\t\trequirement_refs: [],\n\t\t\tcontrol_id: control.control_id,\n\t\t\tcontrol_version: control.version,\n\t\t\tsubject: { kind: \"candidate\", id: \"cnd_1\", revision: 1, digest: digestValue(\"cnd_1\") },\n\t\t\tprotocol_revision: protocol,\n\t\t\tenvironment_digest: ENVIRONMENT.digest,\n\t\t\tinputs_digest: key,\n\t\t\tstarted_at: AT,\n\t\t\tended_at: AT,\n\t\t\tverdict: \"PASS\",\n\t\t\tfacts: { run: \"candidate\", tlc: { modules } },\n\t\t\tfindings: [],\n\t\t\tartifacts: [],\n\t\t\tlimits: { truncated: false, bytes_read: 0, bytes_total: 0, exclusions: [], unstable: false, notes: [] },\n\t\t\tbaseline: null,\n\t\t\tproducer: EXECUTOR_ACTOR,\n\t\t\tintegrity: { content_digest: \"\", chained_to: null },\n\t\t\t...over,\n\t\t};\n\t\tevidence.integrity.content_digest = evidenceDigest(evidence);\n\t\treturn evidence;\n\t};\n\tconst context = {\n\t\tenvironment_digest: ENVIRONMENT.digest,\n\t\tprotocol,\n\t\tobjects: new CasObjectStore(join(outputDir(\"formal-reuse-\", roots), \"objects\")),\n\t};\n\treturn { control, inputs, key, protocol, explored, context };\n}\n\ndescribe(\"an exploration that read a module its identity does not cover is never cited\", () => {\n\tit(\"a module TLC reports it processed outside the closure read has the model explored again\", async () => {\n\t\tconst { control, inputs, key, explored, context } = sealedExplorations();\n\n\t\tconst covered = await establishedExploration(\n\t\t\t[explored([\"Naturals\", \"Bornes\", \"Compteur\"])],\n\t\t\tcontrol,\n\t\t\tinputs,\n\t\t\tkey,\n\t\t\tcontext,\n\t\t);\n\t\tassert.ok(\"original\" in covered, \"an exploration whose every processed module was read is cited\");\n\t\tconst missed = await establishedExploration(\n\t\t\t[explored([\"Naturals\", \"Bornes\", \"Cache\", \"Compteur\"])],\n\t\t\tcontrol,\n\t\t\tinputs,\n\t\t\tkey,\n\t\t\tcontext,\n\t\t);\n\t\tassert.ok(\"rerun_because\" in missed, \"a module read outside the closure forbids the citation\");\n\t\tassert.match(missed.rerun_because, /Cache/, \"the reason names the module the identity missed\");\n\n\t\tconst tool = \"/opt/java/bin/java\";\n\t\tconst named = await establishedExploration(\n\t\t\t[explored([\"Naturals\", \"Bornes\", \"java\", \"Compteur\"])],\n\t\t\tcontrol,\n\t\t\t{ ...inputs, [tool]: digestBytes(\"java 21\") },\n\t\t\tkey,\n\t\t\tcontext,\n\t\t);\n\t\tassert.ok(\"rerun_because\" in named, \"a module named like a tool the exploration ran is no module it read\");\n\t\tassert.match(named.rerun_because, /java/);\n\t});\n\n\tit(\"only the sealed execution of the same protocol revision is cited, never a citation nor an altered record\", async () => {\n\t\tconst { control, inputs, key, protocol, explored, context } = sealedExplorations();\n\t\tconst modules = [\"Naturals\", \"Bornes\", \"Compteur\"];\n\t\tconst lookup = (evidence: Evidence[]) => establishedExploration(evidence, control, inputs, key, context);\n\n\t\tconst execution = explored(modules);\n\t\tconst citation = explored(modules, {\n\t\t\tevidence_id: \"evd_2\",\n\t\t\tfacts: { run: \"reused\", reused_from: \"evd_1\", tlc: { modules } },\n\t\t});\n\t\tconst found = await lookup([execution, citation]);\n\t\tassert.equal(\"original\" in found && found.original.evidence_id, \"evd_1\", \"the citation names the execution\");\n\t\tconst alone = await lookup([citation]);\n\t\tassert.ok(\"rerun_because\" in alone, \"a citation alone is no proof to cite\");\n\n\t\tconst otherProtocol = { ...protocol, protocol_id: \"prt_0\" };\n\t\tassert.ok(\"rerun_because\" in (await lookup([explored(modules, { protocol_revision: otherProtocol })])));\n\t\tconst otherRevision = { ...protocol, revision: 2 };\n\t\tassert.ok(\n\t\t\t\"rerun_because\" in (await lookup([explored(modules, { protocol_revision: otherRevision })])),\n\t\t\t\"an exploration a revision of the protocol invalidated is not cited\",\n\t\t);\n\n\t\tconst altered = { ...execution, verdict: \"FAIL\" as const };\n\t\tconst refused = await lookup([altered]);\n\t\tassert.ok(\"rerun_because\" in refused, \"a record altered after it was sealed is not cited\");\n\t\tassert.match(refused.rerun_because, /the record of evd_1 is altered/);\n\t});\n\n\tit(\"a module TLC processed is covered by a module file of the closure, never by a tool or a variable of its name\", () => {\n\t\tconst inputs = { \"spec/Compteur.tla\": \"d1\", \"Bornes.tla\": \"d2\", \"/opt/java/bin/java\": \"d3\", \"env:Cache\": \"d4\" };\n\t\tconst processed = [\"Naturals\", \"Bornes\", \"Compteur\", \"Cache\", \"java\"];\n\t\tassert.deepEqual(uncoveredModules(processed, inputs), [\"Cache\", \"java\"], \"a shipped module is covered by the jar\");\n\t});\n\n\tit(\"a file of the model's directory named after a module TLC ships enters the identity, imported or not\", async () => {\n\t\tconst root = outputDir(\"formal-reuse-\", roots);\n\t\twriteFiles(root, { \"spec/Compteur.tla\": COMPTEUR, \"spec/Compteur.cfg\": CONFIG, \"spec/TLC.tla\": BORNES });\n\t\tconst reads = { model: \"spec/Compteur.tla\", config: \"spec/Compteur.cfg\", cwd: \".\", tools: [], env_allowlist: [] };\n\t\tconst inputs = await formalInputsOf(reads, root);\n\t\tassert.equal(inputs[\"spec/TLC.tla\"], digestBytes(BORNES), \"TLC reads it before the module its jar ships\");\n\t});\n});\n"},"test/cycle/verification-reuse.test.ts":{"tests":[{"id":"2","name":"test/cycle/verification-reuse.test.ts"}],"source":"/**\n * The explorations of a preparation are costly and their models change rarely: a later preparation of the same model,\n * tool and checker cites the earlier exploration instead of running it again, and the journal says what ran, for how\n * long, what was cited and why anything ran. Reuse changes no verdict: the same corpus examined with and without it\n * blocks and passes the same stories on the same outcomes.\n */\nimport { strict as assert } from \"node:assert\";\nimport { chmodSync, mkdirSync, writeFileSync } from \"node:fs\";\nimport { delimiter, join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport type { Controle, Preuve } from \"../../cycle/src/controls.ts\";\nimport { identiteDExploration } from \"../../cycle/src/explorations.ts\";\nimport { Journal } from \"../../cycle/src/journal.ts\";\nimport { preparer } from \"../../cycle/src/preparation.ts\";\nimport { lireStory } from \"../../cycle/src/story.ts\";\nimport { gitCmd, removedAfterEach, tempDir } from \"../helpers/fixtures.ts\";\nimport { CONTRE_EXEMPLE, MANIFESTE, NODE, compagnon, depotAvecCompagnon, fichiersDuModele } from \"../helpers/cycle.ts\";\n\nconst cleanups = removedAfterEach();\n\n/** A second model of the test story, whose exploration ends on a counterexample. */\nconst BORNE = \"specs/formal/borne/manifest.json\";\nconst FICHIERS = {\n\t...fichiersDuModele(),\n\t\"specs/formal/borne/Borne.tla\": \"---- MODULE Borne ----\\nEXTENDS Naturals\\nVARIABLE x\\nInit == x = 0\\n====\\n\",\n\t\"specs/formal/borne/Borne.cfg\": \"INIT Init\\nINVARIANT Borne\\n\",\n\t[BORNE]: JSON.stringify({ model: \"Borne.tla\", config: \"Borne.cfg\", required_properties: [\"Borne\"] }),\n};\nconst COMPLETED = \"Greet.tla with Greet.cfg: completed — PASS for the model under its bounds\\n\";\n/**\n * What the stand-in for `scripts/check-formal.ts` answers for each manifest: its exit status, its output and the\n * duration its runner measured, 40 ms unless it says it measured none.\n */\ntype Issue = [number, string, (number | null)?];\nconst ISSUES: Record<string, Issue> = { [MANIFESTE]: [0, COMPLETED], [BORNE]: [1, CONTRE_EXEMPLE] };\n\nfunction modeles(manifestes: string[]): unknown[] {\n\treturn [\n\t\t{ moyen: \"exemples\", retenu: true, raison: \"one case shows the greeting\" },\n\t\t{ moyen: \"proprietes\", retenu: false, raison: \"one input is enough\" },\n\t\t{ moyen: \"modele-d-etats\", retenu: true, proprietes: [\"Shouted\"], manifestes },\n\t\t{ moyen: \"preuve-lean\", retenu: false, raison: \"no decision rule\" },\n\t];\n}\n\n/** The exploration of a manifest, by a stand-in whose Java is the running node, a tool identified by its path. */\nfunction exploration(manifeste: string): Controle {\n\treturn {\n\t\tid: `exploration-${manifeste}`,\n\t\tcommande: [NODE, \"check-formal.ts\", manifeste, \"--java\", NODE],\n\t\treseau: \"denied\",\n\t\ttimeout_ms: 60_000,\n\t};\n}\n\ninterface Resultat {\n\tmanifeste: string;\n\tissue: string;\n\ttrace: { digest: string } | null;\n\tduree_ms: number | null;\n\trecherche_ms: number;\n\treutilise: { story: string } | null;\n\tmotif: string | null;\n}\n\n/**\n * Examines the preparation of the same story under each of `stories`, one journal each beside the others, with reuse\n * on or off, through a stand-in that records every exploration it is asked to run.\n */\nasync function examinerCorpus(\n\troot: string,\n\tstories: string[],\n\treutiliser: boolean,\n\tissues: Record<string, Issue> = ISSUES,\n\tracine = tempDir(\"495-\", cleanups),\n) {\n\tconst lancements: string[] = [];\n\tconst verdicts: { verte: boolean; issues: string[][] }[] = [];\n\tconst resultats: Resultat[][] = [];\n\tconst comptes: string[] = [];\n\tfor (const id of stories) {\n\t\tconst journal = new Journal(id, racine);\n\t\tconst outillage = {\n\t\t\troot,\n\t\t\tstory: lireStory(\"e01s05\", root),\n\t\t\texploration,\n\t\t\treutiliser,\n\t\t\tlancer: async (c: Controle): Promise<Preuve> => {\n\t\t\t\tconst manifeste = c.commande[2] ?? \"\";\n\t\t\t\tlancements.push(manifeste);\n\t\t\t\tconst [code, sortie, duree = 40] = issues[manifeste] ?? [3, \"error\\n\"];\n\t\t\t\tconst ref = await journal.objets.putText(sortie);\n\t\t\t\tconst debut = Date.now();\n\t\t\t\treturn {\n\t\t\t\t\tcontrole: c.id,\n\t\t\t\t\tcommande: c.commande,\n\t\t\t\t\trevision: \"head\",\n\t\t\t\t\tverdict: code === 0 ? \"PASS\" : \"FAIL\",\n\t\t\t\t\tstarted_at: new Date(debut).toISOString(),\n\t\t\t\t\tended_at: new Date(debut + 25).toISOString(),\n\t\t\t\t\tfacts: { exit_code: code, duration_ms: duree },\n\t\t\t\t\techecs: [],\n\t\t\t\t\tartifacts: [{ name: \"stdout\", ref }],\n\t\t\t\t\tsandbox: \"unconfined\",\n\t\t\t\t};\n\t\t\t},\n\t\t\tlire: async (digest: string) => {\n\t\t\t\tconst octets = await journal.objets.get(digest);\n\t\t\t\treturn octets ? new TextDecoder().decode(octets) : null;\n\t\t\t},\n\t\t};\n\t\tconst preparation = await preparer(outillage, journal);\n\t\tconst e = journal.dernier(\"preparation\");\n\t\tconst r = (e?.resultats ?? []) as Resultat[];\n\t\tverdicts.push({ verte: preparation.verte, issues: r.map((x) => [x.manifeste, x.issue]) });\n\t\tresultats.push(r);\n\t\tcomptes.push(preparation.verte ? preparation.resume : preparation.motif);\n\t}\n\treturn { lancements, verdicts, resultats, comptes, racine };\n}\n\ndescribe(\"the explorations of a preparation are reused across stories without changing a verdict\", () => {\n\tit(\"activer la réutilisation ne change aucun verdict du corpus et réduit les appels effectivement observés\", async () => {\n\t\tconst root = depotAvecCompagnon(compagnon(modeles([MANIFESTE, BORNE])), FICHIERS);\n\t\tconst stories = [\"e01s05\", \"e01s06\", \"e01s07\"];\n\t\tconst sans = await examinerCorpus(root, stories, false);\n\t\tconst avec = await examinerCorpus(root, stories, true);\n\n\t\tassert.deepEqual(avec.verdicts, sans.verdicts, \"reuse changes no verdict of the corpus\");\n\t\tassert.equal(sans.lancements.length, 6, \"without reuse every preparation explores both models\");\n\t\tassert.equal(avec.lancements.length, 2, \"with reuse the models are explored once, by the first preparation\");\n\n\t\tconst [premier, ...suivants] = avec.resultats;\n\t\tfor (const r of premier ?? []) {\n\t\t\tassert.equal(r.reutilise, null, `${r.manifeste} ran`);\n\t\t\tassert.equal(r.duree_ms, 40, \"the journal keeps the duration the exploration really ran\");\n\t\t\tassert.match(r.motif ?? \"\", /aucune exploration antérieure/, \"the journal says why it ran\");\n\t\t}\n\t\tconst cites = suivants.flat();\n\t\tassert.equal(cites.length, 4);\n\t\tfor (const r of cites) {\n\t\t\tassert.equal(r.reutilise?.story, \"e01s05\", `${r.manifeste} cites the exploration of the first preparation`);\n\t\t\tassert.equal(r.duree_ms, null, \"a citation claims no execution\");\n\t\t\tassert.equal(r.motif, null);\n\t\t\tassert.equal(typeof r.recherche_ms, \"number\", \"the journal keeps the time the lookup took\");\n\t\t\tconst original = premier?.find((p) => p.manifeste === r.manifeste);\n\t\t\tassert.equal(r.trace?.digest, original?.trace?.digest, \"the citation points at the original output\");\n\t\t}\n\t\tfor (const r of sans.resultats.flat()) assert.equal(r.reutilise, null, \"reuse turned off cites nothing\");\n\t});\n\n\tit(\"an altered output, an inconclusive exploration or a changed model is explored again, with the reason\", async () => {\n\t\tconst root = depotAvecCompagnon(compagnon(modeles([MANIFESTE, BORNE])), FICHIERS);\n\t\tconst premier = await examinerCorpus(root, [\"e01s05\"], true);\n\t\tconst trace = premier.resultats[0]?.find((r) => r.manifeste === MANIFESTE)?.trace?.digest ?? \"\";\n\t\tconst objet = new Journal(\"e01s05\", premier.racine).objets.pathFor(trace);\n\t\tchmodSync(objet, 0o644);\n\t\twriteFileSync(objet, \"an output nobody produced\\n\");\n\t\tconst altere = await examinerCorpus(root, [\"e01s06\"], true, ISSUES, premier.racine);\n\t\tassert.deepEqual(altere.lancements, [MANIFESTE], \"the altered output is explored again, the intact one cited\");\n\t\tassert.match(altere.resultats[0]?.[0]?.motif ?? \"\", /altérée/);\n\n\t\tconst indetermine: Record<string, Issue> = { ...ISSUES, [MANIFESTE]: [2, \"inconclusive\\n\"] };\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\tawait examinerCorpus(root, [\"e01s05\"], true, indetermine, racine);\n\t\tconst ensuite = await examinerCorpus(root, [\"e01s06\"], true, indetermine, racine);\n\t\tassert.deepEqual(ensuite.lancements, [MANIFESTE], \"an inconclusive exploration is never cited\");\n\t\tassert.match(ensuite.resultats[0]?.[0]?.motif ?? \"\", /aucune exploration antérieure concluante/);\n\n\t\twriteFileSync(`${root}/specs/formal/borne/Borne.tla`, \"---- MODULE Borne ----\\nVARIABLE x\\n====\\n\");\n\t\tconst change = await examinerCorpus(root, [\"e01s07\"], true, ISSUES, premier.racine);\n\t\tassert.ok(change.lancements.includes(BORNE), \"a changed model is explored again\");\n\t\tconst borne = change.resultats[0]?.find((r) => r.manifeste === BORNE);\n\t\tassert.match(borne?.motif ?? \"\", /aucune exploration antérieure concluante/, \"the journal says why it ran\");\n\t});\n\n\tit(\"a module TLC reports it processed that the reading of the imports missed forbids citing its exploration\", async () => {\n\t\tconst masque = \"specs/formal/masque/manifest.json\";\n\t\tconst cache = \"specs/formal/masque/Cache.tla\";\n\t\tconst fichiers = {\n\t\t\t// The import sits between the delimiters of a comment inside strings: the reading of the imports drops it,\n\t\t\t// TLC reads it.\n\t\t\t\"specs/formal/masque/Masque.tla\":\n\t\t\t\t'---- MODULE Masque ----\\nS == \"(*\"\\nI == INSTANCE Cache\\nT == \"*)\"\\nVARIABLE x\\nInit == x = 0\\nInv == I!Ok\\n====\\n',\n\t\t\t\"specs/formal/masque/Masque.cfg\": \"INIT Init\\nINVARIANT Inv\\n\",\n\t\t\t[masque]: JSON.stringify({ model: \"Masque.tla\", config: \"Masque.cfg\", required_properties: [\"Inv\"] }),\n\t\t\t[cache]: \"---- MODULE Cache ----\\nOk == TRUE\\n====\\n\",\n\t\t};\n\t\tconst sortie =\n\t\t\t\"Masque.tla with Masque.cfg: completed — PASS for the model under its bounds\\nmodules: Cache, Masque\\n\";\n\t\tconst issues: Record<string, Issue> = { [masque]: [0, sortie] };\n\t\tconst root = depotAvecCompagnon(compagnon(modeles([masque])), fichiers);\n\t\tconst premier = await examinerCorpus(root, [\"e01s05\"], true, issues);\n\t\tassert.deepEqual(premier.lancements, [masque]);\n\n\t\twriteFileSync(join(root, cache), \"---- MODULE Cache ----\\nOk == FALSE\\n====\\n\");\n\t\tconst ensuite = await examinerCorpus(root, [\"e01s06\"], true, issues, premier.racine);\n\t\tassert.deepEqual(\n\t\t\tensuite.lancements,\n\t\t\t[masque],\n\t\t\t\"a module TLC read outside the identity has the model explored again\",\n\t\t);\n\t\tassert.equal(ensuite.resultats[0]?.[0]?.reutilise, null, \"nothing cites the exploration of the former Cache\");\n\t\tassert.match(ensuite.resultats[0]?.[0]?.motif ?? \"\", /Cache/, \"the journal names the module the identity missed\");\n\t});\n\n\tit(\"the account a green preparation gives the red-green names the story whose exploration it cites\", async () => {\n\t\tconst root = depotAvecCompagnon(compagnon(modeles([MANIFESTE])), FICHIERS);\n\t\tconst corpus = await examinerCorpus(root, [\"e01s05\", \"e01s06\"], true);\n\t\tassert.doesNotMatch(corpus.comptes[0] ?? \"\", /réutilisée/, \"the first preparation ran its exploration\");\n\t\tassert.match(corpus.comptes[1] ?? \"\", /: completed, sortie sha256:\\w+, exploration de e01s05 réutilisée/);\n\t});\n\n\tit(\"an exploration whose runner measured no duration keeps the span between its start and its end\", async () => {\n\t\tconst root = depotAvecCompagnon(compagnon(modeles([MANIFESTE])), FICHIERS);\n\t\tconst corpus = await examinerCorpus(root, [\"e01s05\"], true, { [MANIFESTE]: [0, COMPLETED, null] });\n\t\tassert.equal(corpus.resultats[0]?.[0]?.duree_ms, 25);\n\t});\n\n\tit(\"a checker that differs from HEAD forbids citing an exploration, and the journal says so\", async () => {\n\t\tconst root = depotAvecCompagnon(compagnon(modeles([MANIFESTE, BORNE])), FICHIERS);\n\t\tconst premier = await examinerCorpus(root, [\"e01s05\"], true);\n\t\tmkdirSync(join(root, \"scripts\"), { recursive: true });\n\t\twriteFileSync(join(root, \"scripts\", \"check-formal.ts\"), \"// a checker nobody committed\\n\");\n\t\tconst ensuite = await examinerCorpus(root, [\"e01s06\"], true, ISSUES, premier.racine);\n\t\tassert.deepEqual(ensuite.lancements, [MANIFESTE, BORNE], \"both models are explored again\");\n\t\tfor (const r of ensuite.resultats[0] ?? []) assert.match(r.motif ?? \"\", /différent de HEAD/);\n\t});\n});\n\n/** The identity of `controle` on the manifest of the test story, or the inputs that keep it from having one. */\nasync function identite(root: string, controle: Controle, env: NodeJS.ProcessEnv): Promise<string> {\n\tconst id = await identiteDExploration(root, MANIFESTE, controle, env);\n\tassert.ok(\"identite\" in id, `the exploration is identified: ${\"non_identifiees\" in id ? id.non_identifiees : \"\"}`);\n\treturn id.identite;\n}\n\n/** Runs `run` with the process reporting `property` as `value`: another Node or another platform. */\nasync function sous<T>(property: \"version\" | \"platform\", value: string, run: () => Promise<T>): Promise<T> {\n\tconst was = Object.getOwnPropertyDescriptor(process, property);\n\tObject.defineProperty(process, property, { ...was, value });\n\ttry {\n\t\treturn await run();\n\t} finally {\n\t\tif (was) Object.defineProperty(process, property, was);\n\t}\n}\n\ndescribe(\"the identity of an exploration changes with everything it reads, and is withheld for what nobody identifies\", () => {\n\tit(\"a property, the jar, the Java, a variable, the command, Node or the platform changing changes the identity\", async () => {\n\t\tconst root = depotAvecCompagnon(compagnon(modeles([MANIFESTE])), FICHIERS);\n\t\tconst outils = tempDir(\"495-tool-\", cleanups);\n\t\tconst java = join(outils, \"java\");\n\t\tconst jar = join(outils, \"tla2tools.jar\");\n\t\twriteFileSync(java, \"java 21\\n\");\n\t\twriteFileSync(jar, \"tla2tools 1.7.4\\n\");\n\t\tconst controle: Controle = {\n\t\t\tid: \"exploration\",\n\t\t\tcommande: [NODE, \"check-formal.ts\", MANIFESTE, \"--java\", java, \"--jar\", jar],\n\t\t\treseau: \"denied\",\n\t\t\ttimeout_ms: 60_000,\n\t\t};\n\t\tconst env = { PATH: outils, HOME: \"/home/owner\", TMPDIR: \"/tmp\", LANG: \"C\", JAVA_HOME: \"/opt/jdk-21\" };\n\t\tconst base = await identite(root, controle, env);\n\t\tassert.equal(await identite(root, controle, { ...env }), base, \"the same reads keep the identity\");\n\n\t\tconst differe = async (raison: string, autre: () => Promise<string>) =>\n\t\t\tassert.notEqual(await autre(), base, raison);\n\t\tawait differe(\"another JAVA_HOME\", () => identite(root, controle, { ...env, JAVA_HOME: \"/opt/jdk-17\" }));\n\t\tconst commande = { ...controle, commande: [...controle.commande, \"--store\", \"/tmp/store\"] };\n\t\tawait differe(\"another command\", () => identite(root, commande, env));\n\t\tawait differe(\"another Node\", () => sous(\"version\", \"v0.0.0\", () => identite(root, controle, env)));\n\t\tawait differe(\"another platform\", () => sous(\"platform\", \"plan9\", () => identite(root, controle, env)));\n\t\twriteFileSync(jar, \"tla2tools 1.8.0\\n\");\n\t\tawait differe(\"another jar at the same path\", () => identite(root, controle, env));\n\t\twriteFileSync(jar, \"tla2tools 1.7.4\\n\");\n\t\twriteFileSync(java, \"java 17\\n\");\n\t\tawait differe(\"another Java at the same path\", () => identite(root, controle, env));\n\t\twriteFileSync(java, \"java 21\\n\");\n\t\tassert.equal(await identite(root, controle, env), base, \"the tools as they were give the identity back\");\n\t\tconst manifeste = JSON.stringify({ model: \"Greet.tla\", config: \"Greet.cfg\", required_properties: [\"Loud\"] });\n\t\twriteFileSync(join(root, MANIFESTE), manifeste);\n\t\tawait differe(\"another required property\", () => identite(root, controle, env));\n\t});\n\n\tit(\"a change committed to the checker, the script or the code of 495 it loads, changes the identity\", async () => {\n\t\tconst root = depotAvecCompagnon(compagnon(modeles([MANIFESTE])), FICHIERS);\n\t\tconst controle = exploration(MANIFESTE);\n\t\tconst env = { PATH: \"\" };\n\t\tconst commettre = (fichier: string, contenu: string) => {\n\t\t\tmkdirSync(join(root, fichier, \"..\"), { recursive: true });\n\t\t\twriteFileSync(join(root, fichier), contenu);\n\t\t\tgitCmd(root, [\"add\", \"-A\"]);\n\t\t\tgitCmd(root, [\"commit\", \"-q\", \"-m\", `chore: ${fichier}`]);\n\t\t};\n\t\tconst base = await identite