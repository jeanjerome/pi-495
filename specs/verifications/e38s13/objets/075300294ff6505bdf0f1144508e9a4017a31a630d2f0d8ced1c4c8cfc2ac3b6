s command is the owner's, run\n * as declared rather than qualified on witnesses. The profile also names the test files that suite runs and the\n * paths it may write, the only other things it sets of the controls a target is judged by.\n */\nimport type { ControlDefinition } from \"../contracts/v1/protocol.ts\";\nimport type { ActivePolicy } from \"../domain/policy.ts\";\nimport { baseControl, type DetectedTechnology } from \"./stacks/stack.ts\";\n\n/** The declared controls, in the order the profile declares them. */\nexport function projectControlsOf(policy: ActivePolicy): ControlDefinition[] {\n\treturn policy.project_controls.map((declared) => ({\n\t\t...baseControl([]),\n\t\tcontrol_id: declared.control_id,\n\t\ttitle: declared.title,\n\t\tcommand: declared.command,\n\t\ttimeout_ms: declared.timeout_ms,\n\t\tparser: \"exit-code\",\n\t\treport_path: null,\n\t\tprovides: declared.provides ?? [],\n\t\trequires: declared.requires ?? [],\n\t\tnetwork: declared.network ?? \"denied\",\n\t\twritable_paths: declared.writable_paths ?? [],\n\t\tprotected_paths: declared.protected_paths,\n\t}));\n}\n\n/**\n * The detection with its suite — the first control, which the common layer puts before the others — run on the test\n * files the profile names, appended to its command, and allowed to write the paths the profile adds to those its\n * technology grants. Both are the owner's, read from the policy and never from a file of the target, so a producer\n * that rewrites the target's test script neither narrows what judges the requirements nor lengthens it nor widens\n * where it writes: the whole tree of a project whose tests launch a sandbox of their own fails or outlasts its delay\n * inside the platform's sandbox, and the profile keeps the suite to the tests that run there; tests that create their\n * files under a directory of the project fail there without an assertion unless the profile lets the suite write it.\n */\nexport function withSuitePaths(detection: DetectedTechnology, policy: ActivePolicy): DetectedTechnology {\n\tconst [suite, ...others] = detection.controls;\n\tif (!suite || (policy.suite_paths.length === 0 && policy.suite_writable_paths.length === 0)) return detection;\n\treturn {\n\t\t...detection,\n\t\tcontrols: [\n\t\t\t{\n\t\t\t\t...suite,\n\t\t\t\tcommand: [...suite.command, ...policy.suite_paths],\n\t\t\t\twritable_paths: [...new Set([...suite.writable_paths, ...policy.suite_writable_paths])],\n\t\t\t},\n\t\t\t...others,\n\t\t],\n\t};\n}\n"},"src/contracts/v1/config.ts":{"language":"typescript","mutants":[{"id":"16","mutatorName":"ObjectLiteral","replacement":"{}","status":"Timeout","static":false,"coveredBy":["1","2","3"],"location":{"end":{"column":78,"line":110},"start":{"column":62,"line":110}}}],"source":"/**\n * Contract v1 — the harness configuration file, `<data dir>/config.json`.\n *\n * Closed at every level: a key the schema does not name is refused rather than ignored, so a\n * misspelt setting is never mistaken for one that was applied. Every key is optional, since an\n * absent one takes its default; `baseline` is therefore partial, merged over the default policy.\n */\nimport { Type, type Static } from \"typebox\";\nimport { Closed, contractId, Identifier, NonNegativeInt, Revision } from \"./common.ts\";\nimport { AcceptanceRecipe, BaselinePolicy, FormalPackage } from \"./protocol.ts\";\n\n/** A bound that allows nothing at 0. */\nconst PositiveInt = Type.Integer({ minimum: 1 });\nconst AdoptionRule = Closed([\"kernel\", \"human\"] as const);\n\nconst Budgets = Type.Object(\n\t{\n\t\tmax_attempts: Type.Optional(PositiveInt),\n\t\tmax_technical_retries: Type.Optional(NonNegativeInt),\n\t\tmax_continuations: Type.Optional(NonNegativeInt),\n\t\tintervention_ms: Type.Optional(PositiveInt),\n\t\tincrement_ms: Type.Optional(PositiveInt),\n\t\ttool_calls_per_intervention: Type.Optional(PositiveInt),\n\t\tfeedback_bytes: Type.Optional(NonNegativeInt),\n\t},\n\t{ additionalProperties: false },\n);\n\nconst Adoption = Type.Object(\n\t{\n\t\tmandate: Type.Optional(AdoptionRule),\n\t\trequirements: Type.Optional(AdoptionRule),\n\t\t/** The kernel always adopts the protocol; `human` is refused rather than silently replaced. */\n\t\tprotocol: Type.Optional(Closed([\"kernel\"] as const)),\n\t\tdesign: Type.Optional(AdoptionRule),\n\t},\n\t{ additionalProperties: false },\n);\n\n/**\n * The acceptance run the profile asks of every candidate: the recipe, and the command that drives it from the copy\n * of the candidate, `{candidate}` replaced by the identity of the candidate it runs on, writing its report at\n * `report_path`. `network` defaults to `denied`; a recipe that reads outside data says so in `external_data`.\n */\nexport const AcceptanceRecipeDeclaration = Type.Object(\n\t{\n\t\t...AcceptanceRecipe.properties,\n\t\tcommand: Type.Array(Type.String(), { minItems: 1 }),\n\t\treport_path: Type.String({ minLength: 1 }),\n\t\ttimeout_ms: PositiveInt,\n\t\tnetwork: Type.Optional(Closed([\"denied\", \"loopback\", \"allowed\"] as const)),\n\t\t/** The files of the target the recipe runs, which a producer may not modify. */\n\t\tprotected_paths: Type.Optional(Type.Array(Type.String())),\n\t},\n\t{ additionalProperties: false },\n);\nexport type AcceptanceRecipeDeclaration = Static<typeof AcceptanceRecipeDeclaration>;\n\n/**\n * A control the profile declares for the target beside those its technology detects — its type check, its import\n * rules, its own lints — run on the reference and on each candidate and judged by its exit code. G5 requires it to\n * pass on the candidate. `protected_paths` names the files it reads to judge, which a producer may not modify;\n * `provides` and `requires` order it after the control that writes what it reads, such as a build.\n */\nexport const ProjectControlDeclaration = Type.Object(\n\t{\n\t\tcontrol_id: Identifier,\n\t\ttitle: Type.String({ minLength: 1 }),\n\t\tcommand: Type.Array(Type.String(), { minItems: 1 }),\n\t\ttimeout_ms: PositiveInt,\n\t\tprotected_paths: Type.Array(Type.String()),\n\t\tnetwork: Type.Optional(Closed([\"denied\", \"loopback\", \"allowed\"] as const)),\n\t\twritable_paths: Type.Optional(Type.Array(Type.String())),\n\t\tprovides: Type.Optional(Type.Array(Type.String())),\n\t\trequires: Type.Optional(Type.Array(Type.String())),\n\t},\n\t{ additionalProperties: false },\n);\nexport type ProjectControlDeclaration = Static<typeof ProjectControlDeclaration>;\n\nconst Policy = Type.Object(\n\t{\n\t\tpolicy_id: Type.Optional(Identifier),\n\t\trevision: Type.Optional(Revision),\n\t\tbudgets: Type.Optional(Budgets),\n\t\tadoption: Type.Optional(Adoption),\n\t\tg5_human_acceptance: Type.Optional(Type.Boolean()),\n\t\tintegration_enabled: Type.Optional(Type.Boolean()),\n\t\tbaseline: Type.Optional(Type.Partial(BaselinePolicy, { additionalProperties: false })),\n\t\t/** 0 turns stagnation detection off. */\n\t\tstagnation_identical_candidates: Type.Optional(NonNegativeInt),\n\t\trequired_reviews: Type.Optional(Type.Array(Type.String())),\n\t\t/** What each required review is asked to judge, by role. */\n\t\treview_missions: Type.Optional(Type.Record(Type.String(), Type.String({ minLength: 1 }))),\n\t\t/** null asks no acceptance run, as the default policy does. */\n\t\tacceptance_recipe: Type.Optional(Type.Union([AcceptanceRecipeDeclaration, Type.Null()])),\n\t\t/** null adopts no formal model, as the default policy does: no formal tool is then looked for nor run. */\n\t\tformal_control: Type.Optional(Type.Union([FormalPackage, Type.Null()])),\n\t\t/** Empty declares none, as the default policy does: the controls the technology detects are then all there is. */\n\t\tproject_controls: Type.Optional(Type.Array(ProjectControlDeclaration)),\n\t\t/**\n\t\t * The test files the suite its technology detects runs, as patterns appended to the command of that suite.\n\t\t * Empty runs the suite as its technology runs it, as the default policy does.\n\t\t */\n\t\tsuite_paths: Type.Optional(Type.Array(Type.String({ minLength: 1 }))),\n\t\t/**\n\t\t * The paths the suite its technology detects may write beside those its technology grants it, such as the\n\t\t * directory where the project's tests create their files. Empty grants none, as the default policy does.\n\t\t */\n\t\tsuite_writable_paths: Type.Optional(Type.Array(Type.String({ minLength: 1 }))),\n\t},\n\t{ additionalProperties: false },\n);\n\nexport const HarnessConfigFile = Type.Object(\n\t{\n\t\t/** Lets an editor point at the published schema. */\n\t\t$schema: Type.Optional(Type.String()),\n\t\tpolicy: Type.Optional(Policy),\n\t\tisolation: Type.Optional(\n\t\t\tType.Object({ allow_unconfined: Type.Optional(Type.Boolean()) }, { additionalProperties: false }),\n\t\t),\n\t\thuman_origin: Type.Optional(\n\t\t\tType.Object({ rpc_actor_env: Type.Optional(Type.String({ minLength: 1 })) }, { additionalProperties: false }),\n\t\t),\n\t\tworkspace_exclusions: Type.Optional(Type.Array(Type.String())),\n\t\tlanguage: Type.Optional(Closed([\"fr\", \"en\"] as const)),\n\t},\n\t{ $id: contractId(\"harness-config\"), additionalProperties: false },\n);\nexport type HarnessConfigFile = Static<typeof HarnessConfigFile>;\n"},"src/domain/policy.ts":{"language":"typescript","mutants":[{"id":"17","mutatorName":"ArrayDeclaration","replacement":"[\"Stryker was here\"]","status":"Timeout","static":false,"coveredBy":["1","2","3"],"location":{"end":{"column":26,"line":109},"start":{"column":24,"line":109}}}],"source":"/** Active policy: configured before execution, versioned, never modified by a producer. */\nimport type { AcceptanceRecipeDeclaration, ProjectControlDeclaration } from \"../contracts/v1/config.ts\";\nimport type { BaselinePolicy, FormalPackage } from \"../contracts/v1/protocol.ts\";\n\n/** Bounds applied by the controller, never by a producer (DEC-03). */\nexport interface Budgets {\n\tmax_attempts: number;\n\tmax_technical_retries: number;\n\t/**\n\t * How many times a producer cut short by `intervention_ms` may resume on its own workspace\n\t * before the candidate is frozen as it stands. A continuation is not a new attempt: nothing is\n\t * rebuilt from the reference and no attempt budget is consumed.\n\t */\n\tmax_continuations: number;\n\tintervention_ms: number;\n\tincrement_ms: number;\n\ttool_calls_per_intervention: number;\n\tfeedback_bytes: number;\n}\n\nexport type AdoptionRule = \"kernel\" | \"human\";\n\n/** Where a model sits relative to the machine 495 runs on (SEC-05), read from its address. */\nexport type ModelLocation = \"on_machine\" | \"off_machine\";\n\n/**\n * Reads the host of the address Pi holds for a model, without resolving it. Only `localhost`,\n * `127.0.0.0/8` and `::1` are on this machine; an address that is absent or unreadable, or a name\n * that merely looks like loopback, is off it, so a doubt is announced rather than kept silent. The\n * URL parser normalizes IPv4 shorthands such as `127.1` before the host is read.\n */\nexport function locateModel(baseUrl: string | undefined): ModelLocation {\n\tlet host: string;\n\ttry {\n\t\thost = new URL(baseUrl ?? \"\").hostname;\n\t} catch {\n\t\treturn \"off_machine\";\n\t}\n\treturn host === \"localhost\" || host === \"[::1]\" || /^127(?:\\.\\d{1,3}){3}$/.test(host) ? \"on_machine\" : \"off_machine\";\n}\n\nexport interface ActivePolicy {\n\tpolicy_id: string;\n\trevision: number;\n\tbudgets: Budgets;\n\tadoption: {\n\t\tmandate: AdoptionRule;\n\t\trequirements: AdoptionRule;\n\t\tprotocol: \"kernel\";\n\t\tdesign: AdoptionRule;\n\t};\n\tg5_human_acceptance: boolean;\n\tintegration_enabled: boolean;\n\t/** Frozen with the protocol at G2: how the candidate is compared to the reference (VER-08). */\n\tbaseline: BaselinePolicy;\n\tstagnation_identical_candidates: number;\n\trequired_reviews: string[];\n\t/** What each required review is asked to judge, by role; frozen with the protocol at G2. */\n\treview_missions: Record<string, string>;\n\t/** The acceptance run every candidate must pass through its real entry before G5 accepts it; null asks none. */\n\tacceptance_recipe: AcceptanceRecipeDeclaration | null;\n\t/** The TLA+ model the owner adopted as a means of verification; null adopts none, and no formal tool is run. */\n\tformal_control: FormalPackage | null;\n\t/** The controls the profile declares beside those the technology detects, each required at G5. */\n\tproject_controls: ProjectControlDeclaration[];\n\t/** The test files the suite the technology detects runs, appended to its command; empty runs it as detected. */\n\tsuite_paths: string[];\n\t/** The paths the suite the technology detects may write beside those the technology grants; empty grants none. */\n\tsuite_writable_paths: string[];\n}\n\nexport const DEFAULT_POLICY: ActivePolicy = {\n\tpolicy_id: \"default\",\n\trevision: 1,\n\tbudgets: {\n\t\tmax_attempts: 3,\n\t\tmax_technical_retries: 2,\n\t\tmax_continuations: 3,\n\t\t// Which of the two per-intervention bounds falls first depends on the tool-call rate, and the rate\n\t\t// depends on the model and on the target: the two coincide at 5 calls a minute.\n\t\t//\n\t\t// Reached, the duration suspends the intervention, and the producer resumes on its own workspace\n\t\t// up to `max_continuations` times without the owner.\n\t\tintervention_ms: 20 * 60_000,\n\t\t// Reached, the kernel starts no further intervention on the change; it cuts none that is running.\n\t\tincrement_ms: 120 * 60_000,\n\t\t// Reached, whatever the role, the change stops under `budget_exhausted` until its owner resumes\n\t\t// it. On a provider billed per token each resume is new spending, so this bound waits for the\n\t\t// owner instead of resuming on its own the way the duration does.\n\t\ttool_calls_per_intervention: 100,\n\t\tfeedback_bytes: 64 * 1024,\n\t},\n\tadoption: { mandate: \"kernel\", requirements: \"kernel\", protocol: \"kernel\", design: \"kernel\" },\n\tg5_human_acceptance: false,\n\tintegration_enabled: false,\n\tbaseline: {\n\t\tcompare_to_reference: true,\n\t\ttolerance: \"no_aggravation\",\n\t\tinstability: \"confirm_then_indeterminate\",\n\t\tmax_confirmations: 1,\n\t},\n\tstagnation_identical_candidates: 2,\n\trequired_reviews: [],\n\treview_missions: {},\n\tacceptance_recipe: null,\n\tformal_control: null,\n\tproject_controls: [],\n\tsuite_paths: [],\n\tsuite_writable_paths: [],\n};\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/cycle/process-measurements.test.ts":{"tests":[{"id":"0","name":"test/cycle/process-measurements.test.ts"}],"source":"import { describe, it } from \"node:test\";\nimport { strict as assert } from \"node:assert\";\nimport { spawnSync } from \"node:child_process\";\nimport { mkdirSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { stripVTControlCharacters } from \"node:util\";\nimport { gitCmd, tempDir, removedAfterEach } from \"../helpers/fixtures.ts\";\nimport { NODE, PASSING_TEST, SHOUT_CODE, SHOUT_TEST, STORY, depot } from \"../helpers/cycle.ts\";\n\nconst MAIN = join(import.meta.dirname, \"..\", \"..\", \"cycle\", \"src\", \"main.ts\");\nconst cleanups = removedAfterEach();\n\nfunction commit(root: string, files: Record<string, string>, message: string): string {\n\tfor (const [rel, content] of Object.entries(files)) {\n\t\tmkdirSync(join(root, rel, \"..\"), { recursive: true });\n\t\twriteFileSync(join(root, rel), content);\n\t}\n\tgitCmd(root, [\"add\", \"-A\"]);\n\tgitCmd(root, [\"commit\", \"-q\", \"-m\", message]);\n\treturn gitCmd(root, [\"rev-parse\", \"HEAD\"]).trim();\n}\n\nfunction journal(racine: string, story: string, evenements: Record<string, unknown>[]): void {\n\tmkdirSync(join(racine, story), { recursive: true });\n\twriteFileSync(join(racine, story, \"journal.jsonl\"), evenements.map((e) => `${JSON.stringify(e)}\\n`).join(\"\"));\n}\n\n/** A story that landed `heures` after it started, its session reporting `cout`, after `ecarts` acceptance gaps. */\nfunction storyVersee(racine: string, id: string, heures: number, cout: number, ecarts: number): void {\n\tjournal(racine, id, [\n\t\t{ at: \"2026-10-01T10:00:00.000Z\", pas: \"story\", genre: \"debute\" },\n\t\t{ at: \"2026-10-01T10:30:00.000Z\", pas: \"rouge-vert\", genre: \"session\", ok: true, cout_usd: cout },\n\t\t...Array.from({ length: ecarts }, () => ({\n\t\t\tat: \"2026-10-01T10:40:00.000Z\",\n\t\t\tpas: \"recette\",\n\t\t\tgenre: \"rouvert\",\n\t\t\tmotif: \"gap\",\n\t\t})),\n\t\t{\n\t\t\tat: new Date(Date.parse(\"2026-10-01T10:00:00.000Z\") + heures * 3_600_000).toISOString(),\n\t\t\tpas: \"versement\",\n\t\t\tgenre: \"verse\",\n\t\t},\n\t]);\n}\n\n/** A promise held by examples alone. */\nconst EXEMPLES = [{ moyen: \"exemples\", retenu: true, raison: null }];\n/** A promise held by examples and by a state model TLC explores, named by its manifest. */\nconst MODELE_D_ETATS = [\n\t...EXEMPLES,\n\t{\n\t\tmoyen: \"modele-d-etats\",\n\t\tretenu: true,\n\t\traison: null,\n\t\tproprietes: [\"Shouted\"],\n\t\tmanifestes: [\"specs/formal/greet.json\"],\n\t},\n];\n\n/** Writes the story `id` in `root`, its companion keeping `moyens` for its one promise. */\nfunction storyAvecCompagnon(root: string, id: string, moyens: Record<string, unknown>[]): void {\n\tconst dir = join(root, \"specs\", \"stories\", \"e01\");\n\tmkdirSync(dir, { recursive: true });\n\twriteFileSync(join(dir, `${id}-greet-shouts.md`), STORY.replace(\"Story : e01s05\", `Story : ${id}`));\n\tconst promesse = {\n\t\tid: \"P1\",\n\t\tscenario: \"greet shouts\",\n\t\tcategorie: \"nouveau-comportement\",\n\t\tobservation: \"the greeting is upper case\",\n\t\toracles: [{ tache: 1, cas: \"test/shout.test.js\", assertion: \"the greeting is upper case\" }],\n\t\tmoyens,\n\t};\n\twriteFileSync(\n\t\tjoin(dir, `${id}-greet-shouts.verification.json`),\n\t\tJSON.stringify({ version: 1, story: id, promesses: [promesse] }),\n\t);\n}\n\n/** What `cycle mesures` prints, as far as these tests read it. */\ninterface Bilan {\n\tstories: Record<string, unknown>[];\n\tmediane_duree_ms: number | null;\n\tprofils: Record<string, { stories: string[]; mediane_duree_ms: number | null; mediane_cout_usd: number | null }>;\n\trecommandations: {\n\t\tprofil: string;\n\t\trecommandation: string;\n\t\tobligations_maintenues: string[];\n\t\tobligations_retirees: string[];\n\t}[];\n}\n\n/** `cycle mesures` run on `designations`, read in `racine` from the repository `root`. */\nfunction lancerMesures(root: string, racine: string, designations: string[]) {\n\treturn spawnSync(NODE, [MAIN, \"mesures\", ...designations], {\n\t\tcwd: root,\n\t\tenv: { ...process.env, CYCLE_495_DIR: racine, NO_COLOR: \"1\" },\n\t\tencoding: \"utf8\",\n\t\ttimeout: 60_000,\n\t});\n}\n\n/** What `cycle mesures` prints for `designations`, read in `racine` from the repository `root`. */\nfunction mesures(root: string, racine: string, designations: string[]): Bilan {\n\tconst r = lancerMesures(root, racine, designations);\n\tassert.equal(r.status, 0, `the cycle prints the measurements of the stories: ${stripVTControlCharacters(r.stderr)}`);\n\treturn JSON.parse(r.stdout) as Bilan;\n}\n\ndescribe(\"the measurements of the cycle\", () => {\n\tit(\"les valeurs manquantes restent manquantes et les révisions de test sont séparées des corrections de code\", () => {\n\t\tconst root = depot();\n\t\tconst base = gitCmd(root, [\"rev-parse\", \"HEAD\"]).trim();\n\t\tgitCmd(root, [\"checkout\", \"-q\", \"-b\", \"e01s05\"]);\n\t\tcommit(root, { \"test/shout.test.js\": SHOUT_TEST }, \"test: greet shouts\");\n\t\tconst rougeVert = commit(root, { \"src/greet.js\": SHOUT_CODE }, \"feat: greet shouts\");\n\t\t// After the red-green: a review answer that rewrites an existing assertion, one that corrects the code, and new\n\t\t// tests written for a gap, in a file of their own or after the existing ones, which revise no test.\n\t\tcommit(root, { \"test/shout.test.js\": SHOUT_TEST.replace('\"HELLO, X\"', '\"HELLO, X!\"') }, \"test: shout revised\");\n\t\tcommit(root, { \"src/greet.js\": `${SHOUT_CODE}// trims nothing\\n` }, \"fix: shout corrected\");\n\t\tcommit(root, { \"test/greet-again.test.js\": PASSING_TEST }, \"test: greet still greets\");\n\t\tcommit(\n\t\t\troot,\n\t\t\t{ \"test/greet-again.test.js\": `${PASSING_TEST}${PASSING_TEST.replace(\"greet greets\", \"greet greets twice\")}` },\n\t\t\t\"test: greet greets twice\",\n\t\t);\n\t\tgitCmd(root, [\"checkout\", \"-q\", \"main\"]);\n\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\t// An older journal: its sessions carry no cost, and the story has not landed.\n\t\tjournal(racine, \"e01s05\", [\n\t\t\t{ at: \"2026-10-01T10:00:00.000Z\", pas: \"story\", genre: \"debute\", revision: base },\n\t\t\t{ at: \"2026-10-01T10:01:00.000Z\", pas: \"story\", genre: \"branche\", nom: \"e01s05\", base },\n\t\t\t{ at: \"2026-10-01T10:01:00.000Z\", pas: \"story\", genre: \"fini\" },\n\t\t\t{ at: \"2026-10-01T10:01:00.000Z\", pas: \"rouge-vert\", genre: \"debute\", revision: base },\n\t\t\t{ at: \"2026-10-01T10:20:00.000Z\", pas: \"rouge-vert\", genre: \"session\", nom: \"rouge-vert\", ok: true },\n\t\t\t{ at: \"2026-10-01T10:21:00.000Z\", pas: \"rouge-vert\", genre: \"fini\" },\n\t\t\t{ at: \"2026-10-01T10:21:00.000Z\", pas: \"autocontrole\", genre: \"debute\", revision: rougeVert },\n\t\t\t{ at: \"2026-10-01T10:30:00.000Z\", pas: \"autocontrole\", genre: \"fini\" },\n\t\t\t{ at: \"2026-10-01T10:30:00.000Z\", pas: \"relecture\", genre: \"debute\", revision: rougeVert },\n\t\t\t{ at: \"2026-10-01T10:40:00.000Z\", pas: \"relecture\", genre: \"tour\", tour: 1, porte: \"fail\", constats: 3 },\n\t\t\t{ at: \"2026-10-01T10:50:00.000Z\", pas: \"relecture\", genre: \"fini\" },\n\t\t\t{ at: \"2026-10-01T10:50:00.000Z\", pas: \"recette\", genre: \"debute\", revision: rougeVert },\n\t\t\t{ at: \"2026-10-01T11:00:00.000Z\", pas: \"recette\", genre: \"rouvert\", motif: \"the name is not upper-cased\" },\n\t\t]);\n\t\t// A journal that names no branch: what its commits would say is not known.\n\t\tjournal(racine, \"e01s06\", [\n\t\t\t{ at: \"2026-10-02T10:00:00.000Z\", pas: \"story\", genre: \"debute\", revision: base },\n\t\t\t{ at: \"2026-10-02T10:30:00.000Z\", pas: \"rouge-vert\", genre: \"session\", nom: \"rouge-vert\", ok: true, cout_usd: 0 },\n\t\t\t{ at: \"2026-10-02T11:00:00.000Z\", pas: \"versement\", genre: \"verse\", commit: base },\n\t\t]);\n\n\t\tconst bilan = mesures(root, racine, [\"e01s05\", \"e01s06\"]);\n\t\tconst [ouverte, sansBranche] = bilan.stories;\n\n\t\tassert.equal(ouverte?.cout_usd, null, \"a cost no session observed stays missing, never zero\");\n\t\tassert.equal(ouverte?.duree_totale_ms, null, \"a story that has not landed has no time to landing\");\n\t\tassert.equal(ouverte?.revisions_de_tests, 1, \"the rewritten assertion is a test revision, the new test is not\");\n\t\tassert.equal(ouverte?.reprises_de_code, 1, \"the code correction is counted apart from the test revision\");\n\t\tassert.equal(ouverte?.tours_de_relecture, 1);\n\t\tassert.equal(ouverte?.constats_de_relecture, 3);\n\t\tassert.equal(ouverte?.ecarts_de_recette, 1, \"the gap the acceptance run found is a defect found at acceptance\");\n\n\t\tassert.equal(sansBranche?.cout_usd, 0, \"a cost observed at zero stays zero\");\n\t\tassert.equal(sansBranche?.duree_totale_ms, 60 * 60_000);\n\t\tassert.equal(sansBranche?.revisions_de_tests, null, \"without its branch, the revisions of a story are not known\");\n\t\tassert.equal(sansBranche?.reprises_de_code, null);\n\t\tassert.equal(bilan.mediane_duree_ms, 60 * 60_000, \"the median counts only the stories that landed\");\n\t});\n\n\tit(\"une attente que l'automate tranche n'est pas une intervention, et incidents et écarts de recette sont comptés à part\", () => {\n\t\tconst root = depot();\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\tconst at = (minute: number) => new Date(Date.parse(\"2026-10-01T10:00:00.000Z\") + minute * 60_000).toISOString();\n\t\tjournal(racine, \"e01s07\", [\n\t\t\t{ at: at(0), pas: \"story\", genre: \"debute\" },\n\t\t\t// A session that returns no output, then a step that blocks: two incidents.\n\t\t\t{ at: at(1), pas: \"rouge-vert\", genre: \"session\", nom: \"rouge-vert\", ok: false },\n\t\t\t{ at: at(2), pas: \"rouge-vert\", genre: \"bloque\", detail: \"no output\" },\n\t\t\t// The review leaves a promise unkept: unattended, the tool reopens the review itself, without the owner.\n\t\t\t{ at: at(3), pas: \"relecture\", genre: \"tour\", tour: 2, porte: \"fail\", constats: 1 },\n\t\t\t{ at: at(4), pas: \"relecture\", genre: \"proprietaire\", detail: \"a promise is not kept\" },\n\t\t\t{ at: at(4), pas: \"relecture\", genre: \"rouvert\", motif: \"a promise is not kept\" },\n\t\t\t// The acceptance run waits for the owner, and an independent session agrees in their place.\n\t\t\t{ at: at(5), pas: \"recette\", genre: \"proprietaire\", detail: \"acceptance run report\" },\n\t\t\t{ at: at(6), pas: \"recette\", genre: \"session\", nom: \"arbitrage\", ok: true },\n\t\t\t{ at: at(6), pas: \"recette\", genre: \"arbitrage\", decision: \"ecart\", origine: \"automate\" },\n\t\t\t{ at: at(6), pas: \"recette\", genre: \"rouvert\", motif: \"the name is not upper-cased\" },\n\t\t\t// The next acceptance run waits for the owner, who answers in a later run.\n\t\t\t{ at: at(7), pas: \"recette\", genre: \"proprietaire\", detail: \"acceptance run report\" },\n\t\t\t{ at: at(60), pas: \"recette\", genre: \"acceptee\", note: \"\" },\n\t\t]);\n\n\t\tconst [story] = mesures(root, racine, [\"e01s07\"]).stories;\n\t\tassert.equal(story?.interventions, 1, \"only the wait the owner answered is an intervention\");\n\t\tassert.equal(story?.arbitrages_automate, 1, \"the agreement the automaton gave is counted apart\");\n\t\tassert.equal(story?.tours_de_relecture, 1, \"the review the tool reopened is counted as review\");\n\t\tassert.equal(story?.ecarts_de_recette, 1, \"a review reopened is not a defect found at the acceptance run\");\n\t\tassert.equal(story?.incidents, 2, \"a session without output and a blocked step are two incidents\");\n\t});\n\n\tit(\"a formal profile that costs more without finding fewer defects late is reserved to the risks that justify it, and no obligation is removed\", () => {\n\t\tconst root = depot();\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\tstoryVersee(racine, \"e01s05\", 1, 10, 1);\n\t\tstoryVersee(racine, \"e01s06\", 2, 30, 1);\n\t\t// As long as the simple story, dearer in dollars alone.\n\t\tstoryVersee(racine, \"e01s08\", 1, 30, 1);\n\t\tstoryAvecCompagnon(root, \"e01s06\", MODELE_D_ETATS);\n\t\t// A refactoring lands through the short path: its journal says `versement` under `reprise`.\n\t\tjournal(racine, \"R900\", [\n\t\t\t{ at: \"2026-10-01T10:00:00.000Z\", pas: \"reprise\", genre: \"debute\" },\n\t\t\t{ at: \"2026-10-01T10:20:00.000Z\", pas: \"reprise\", genre: \"versement\" },\n\t\t]);\n\n\t\tconst bilan = mesures(root, racine, [\"simple=e01s05\", \"tla=e01s06\", \"lean=e01s08\", \"refactoring=R900\"]);\n\t\tassert.deepEqual(bilan.profils.tla, {\n\t\t\tstories: [\"e01s06\"],\n\t\t\tmediane_duree_ms: 2 * 3_600_000,\n\t\t\tmediane_cout_usd: 30,\n\t\t});\n\t\tassert.equal(bilan.profils.refactoring?.mediane_duree_ms, 20 * 60_000, \"a refactoring is measured to its landing\");\n\t\tconst tla = bilan.recommandations.find((x) => x.profil === \"tla\");\n\t\tassert.match(\n\t\t\ttla?.recommandation ?? \"\",\n\t\t\t/réserver .*risque/,\n\t\t\t\"a formal means that costs more without fewer late defects is reserved to the risks that justify it\",\n\t\t);\n\t\tassert.match(\n\t\t\tbilan.recommandations.find((x) => x.profil === \"lean\")?.recommandation ?? \"\",\n\t\t\t/réserver .*risque/,\n\t\t\t\"a means that costs more in dollars alone costs more\",\n\t\t);\n\t\tfor (const x of bilan.recommandations)\n\t\t\tassert.deepEqual(x.obligations_retirees, [], `${x.profil}: no obligation is removed to gain time`);\n\t\t// What a story's path requires stays required of a formal profile; a refactoring keeps the short path's own.\n\t\tconst obligations = (profil: string) =>\n\t\t\tbilan.recommandations.find((x) => x.profil === profil)?.obligations_maintenues.join(\" | \") ?? \"\";\n\t\tfor (const exigee of [/rouge vu/, /deux relecteurs/, /recette réelle/, /Preflight verte/])\n\t\t\tassert.match(obligations(\"tla\"), exigee, \"the formal profile keeps every obligation of a story\");\n\t\tassert.match(obligations(\"refactoring\"), /relecture indépendante du diff/);\n\t\tassert.doesNotMatch(\n\t\t\tobligations(\"refactoring\"),\n\t\t\t/deux relecteurs/,\n\t\t\t\"a refactoring keeps the obligations of its path\",\n\t\t);\n\t});\n\n\tit(\"sums the time of a step over each of its runs, a step left and resumed included\", () => {\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\tconst at = (minute: number) => new Date(Date.parse(\"2026-10-01T10:00:00.000Z\") + minute * 60_000).toISOString();\n\t\tjournal(racine, \"e01s09\", [\n\t\t\t{ at: at(0), pas: \"story\", genre: \"debute\" },\n\t\t\t{ at: at(5), pas: \"story\", genre: \"fini\" },\n\t\t\t{ at: at(5), pas: \"rouge-vert\", genre: \"debute\" },\n\t\t\t{ at: at(25), pas: \"rouge-vert\", genre: \"fini\" },\n\t\t\t{ at: at(25), pas: \"recette\", genre: \"debute\" },\n\t\t\t{ at: at(35), pas: \"recette\", genre: \"rouvert\", motif: \"gap\" },\n\t\t\t{ at: at(35), pas: \"rouge-vert\", genre: \"debute\" },\n\t\t\t{ at: at(45), pas: \"rouge-vert\", genre: \"fini\" },\n\t\t\t{ at: at(45), pas: \"recette\", genre: \"debute\" },\n\t\t\t{ at: at(50), pas: \"recette\", genre: \"acceptee\" },\n\t\t\t{ at: at(50), pas: \"versement\", genre: \"verse\" },\n\t\t]);\n\n\t\tconst [story] = mesures(depot(), racine, [\"e01s09\"]).stories;\n\t\tassert.deepEqual(story?.duree_par_pas_ms, {\n\t\t\tstory: 5 * 60_000,\n\t\t\t\"rouge-vert\": 30 * 60_000,\n\t\t\trecette: 15 * 60_000,\n\t\t\tversement: 0,\n\t\t});\n\t});\n\n\tit(\"extends a profile that costs no more than the simple one, keeps a dearer one that finds fewer defects late, and adapts nothing without a simple profile\", () => {\n\t\tconst root = depot();\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\tstoryVersee(racine, \"e01s05\", 1, 10, 1);\n\t\tstoryVersee(racine, \"e01s06\", 1, 10, 1);\n\t\tstoryVersee(racine, \"e01s08\", 2, 30, 0);\n\t\tstoryAvecCompagnon(root, \"e01s06\", MODELE_D_ETATS);\n\n\t\tconst recommandation = (bilan: ReturnType<typeof mesures>, profil: string) =>\n\t\t\tbilan.recommandations.find((x) => x.profil === profil)?.recommandation ?? \"\";\n\t\tconst compare = mesures(root, racine, [\"simple=e01s05\", \"tla=e01s06\", \"lean=e01s08\"]);\n\t\tassert.match(recommandation(compare, \"simple\"), /profil de référence/);\n\t\tassert.match(recommandation(compare, \"tla\"), /rien ne s'oppose à l'étendre/, \"no dearer than the simple profile\");\n\t\tassert.match(\n\t\t\trecommandation(compare, \"lean\"),\n\t\t\t/garder .*risque/,\n\t\t\t\"dearer, with fewer defects at the acceptance run\",\n\t\t);\n\n\t\tconst seul = mesures(root, racine, [\"tla=e01s06\"]);\n\t\tassert.match(recommandation(seul, \"tla\"), /aucune adaptation proposée/, \"nothing to compare with\");\n\t});\n\tit(\"une story dont le compagnon ne retient pas de modèle d'états, donnée sous le profil à états, est refusée en nommant la story et le moyen modele-d-etats, sans recommandation pour ce profil\", () => {\n\t\tconst root = depot();\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\tstoryVersee(racine, \"e01s05\", 1, 10, 1);\n\t\tstoryVersee(racine, \"e01s06\", 2, 30, 1);\n\t\tstoryAvecCompagnon(root, \"e01s05\", EXEMPLES);\n\t\tstoryAvecCompagnon(root, \"e01s06\", MODELE_D_ETATS);\n\n\t\tconst refus = lancerMesures(root, racine, [\"simple=e01s06\", \"tla=e01s05\"]);\n\t\tassert.notEqual(refus.status, 0, \"a story whose companion keeps no state model is not measured as one\");\n\t\tconst motif = stripVTControlCharacters(refus.stderr);\n\t\tassert.match(motif, /e01s05/, \"the refusal names the story\");\n\t\tassert.match(motif, /modele-d-etats/, \"the refusal names the means its companion does not keep\");\n\t\tassert.doesNotMatch(refus.stdout, /recommandation/, \"no recommendation is written for the profile\");\n\n\t\tconst bilan = mesures(root, racine, [\"simple=e01s05\", \"tla=e01s06\"]);\n\t\tassert.deepEqual(bilan.profils.tla?.stories, [\"e01s06\"], \"a story whose companion keeps a state model is measured\");\n\t});\n});\n"},"test/v4-platform/dogfood-controls.test.ts":{"tests":[{"id":"1","name":"test/v4-platform/dogfood-controls.test.ts"}],"source":"/**\n * pi-495 driving a change of pi-495 judges the candidate by every control `npm run check` chains, not only by the\n * suite its technology detects: the controls the stable controller declares run on the candidate under the sandbox\n * of the platform, and G5 requires each of them.\n */\nimport { strict as assert } from \"node:assert\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { loadConfig } from \"../../src/extension/config.ts\";\nimport { DOMAIN_IMPORTING_AN_ADAPTER, runOnPi495Shape } from \"../helpers/dogfood.ts\";\nimport { NO_QUALIFIED_SANDBOX, removedAfterEach } from \"../helpers/fixtures.ts\";\n\nremovedAfterEach();\n\nconst REPOSITORY = join(import.meta.dirname, \"..\", \"..\");\n/** The data directory of the stable controller: its `config.json` declares the controls of this repository. */\nconst CONTROLLER = join(REPOSITORY, \"specs\", \"experiments\", \"e38\", \"dogfood\");\n\n/** The layer control of this repository, as the stable controller declares it. */\nconst LAYERS = {\n\tcontrol_id: \"lint-layers\",\n\ttitle: \"npm run lint:layers\",\n\tcommand: [\"node\", \"scripts/check-layers.ts\"],\n\ttimeout_ms: 60_000,\n\tprotected_paths: [\"scripts/\"],\n};\n\ndescribe(\"the stable controller judges a change of pi-495 by the controls of npm run check\", {\n\tskip: NO_QUALIFIED_SANDBOX && \"no sandbox backend qualifies on this machine\",\n}, () => {\n\tit(\"un échec du contrôle de couches bloque la story même si les tests unitaires passent\", async () => {\n\t\tconst { state } = await runOnPi495Shape(\n\t\t\t{ \"src/domain/rule.ts\": DOMAIN_IMPORTING_AN_ADAPTER },\n\t\t\t{ project_controls: [LAYERS], budgets: { max_attempts: 1 } },\n\t\t);\n\t\tconst candidate = state.candidate!.manifest_digest;\n\t\tconst onCandidate = state.evidence.filter((e) => e.valid && e.subject_digest === candidate);\n\t\tassert.equal(onCandidate.findLast((e) => e.control_id === \"unit\")?.verdict, \"PASS\", \"the unit tests pass\");\n\t\tassert.notEqual(state.outcome, \"accepted\", \"a layer violation blocks the story even though the unit tests pass\");\n\t\tassert.equal(state.gates.G5?.verdict, \"FAIL\", JSON.stringify(state.gates.G5));\n\t\tassert.equal(onCandidate.findLast((e) => e.control_id === LAYERS.control_id)?.verdict, \"FAIL\");\n\t\tassert.match(state.gates.G5?.reasons.join(\" | \") ?? \"\", /lint-layers/);\n\t});\n\n\tit(\"a producer that rewrites the layer script beside a layer violation is refused, the script being protected\", async () => {\n\t\tconst declared = loadConfig(CONTROLLER, {}).config.policy.project_controls ?? [];\n\t\tconst layers = declared.find((c) => c.control_id === LAYERS.control_id);\n\t\tassert.ok(layers, \"the stable controller declares the layer control\");\n\t\tconst { state } = await runOnPi495Shape(\n\t\t\t{ \"src/domain/rule.ts\": DOMAIN_IMPORTING_AN_ADAPTER, \"scripts/check-layers.ts\": \"process.exit(0);\\n\" },\n\t\t\t{ project_controls: [layers], budgets: { max_attempts: 1 } },\n\t\t);\n\t\tassert.equal(state.gates.G4?.verdict, \"FAIL\", \"the rewritten layer script does not stand as the control\");\n\t\tassert.match(state.gates.G4?.reasons.join(\" | \") ?? \"\", /protected path altered by the producer: scripts\\//);\n\t\tassert.notEqual(state.outcome, \"accepted\");\n\t});\n\n\tit(\"the stable controller declares every control npm run check chains, the suite included\", () => {\n\t\tconst { scripts } = JSON.parse(readFileSync(join(REPOSITORY, \"package.json\"), \"utf8\"));\n\t\tconst chained = String(scripts.check)\n\t\t\t.split(\"&&\")\n\t\t\t.map((s) => s.trim().replace(/^npm run /, \"\"));\n\t\tconst declared = loadConfig(CONTROLLER, {}).config.policy.project_controls ?? [];\n\t\tfor (const name of chained) {\n\t\t\tconst control = declared.find((c) => c.control_id === name.replace(\":\", \"-\"));\n\t\t\tassert.ok(control, `npm run ${name} is declared to the stable controller`);\n\t\t\tassert.match(control.title, new RegExp(`npm run ${name}\\\\b`), `${control.control_id} says which script it runs`);\n\t\t}\n\t\tassert.deepEqual(\n\t\t\tdeclared.find((c) => c.control_id === \"lint-layers\")?.command,\n\t\t\tLAYERS.command,\n\t\t\t\"the layer control is the script npm run lint:layers runs\",\n\t\t);\n\t});\n});\n"},"test/v4-platform/dogfood-process.test.ts":{"tests":[{"id":"2","name":"test/v4-platform/dogfood-process.test.ts"}],"source":"/**\n * The dogfooding campaign of pi-495 at the scale of its witnesses: the stable controller, configured as\n * `specs/experiments/e38/dogfood/config.json` declares it, drives changes of a pi-495-shaped target under the sandbox\n * of the platform. Each witness carries one fault the new process must stop — a test tied to no requirement, a stale\n * proof, a missing acceptance run, a layer violation — and must stop it where it is announced; the conformant\n * candidate is integrated under the controller and the controls identified when the campaign started.\n */\nimport { strict as assert } from \"node:assert\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport type { ProjectControlDeclaration } from \"../../src/contracts/v1/config.ts\";\nimport { evaluateG5 } from \"../../src/domain/gates/g5.ts\";\nimport { DEFAULT_POLICY } from \"../../src/domain/policy.ts\";\nimport { recipe } from \"../helpers/acceptance-recipe.ts\";\nimport { tuiOrigin } from \"../helpers/change-fixture.ts\";\nimport { DOMAIN_IMPORTING_AN_ADAPTER, runOnPi495Shape } from \"../helpers/dogfood.ts\";\nimport { NO_QUALIFIED_SANDBOX, removedAfterEach, SHOUT_TEST } from \"../helpers/fixtures.ts\";\nimport type { PolicyOverride } from \"../helpers/harness-fixture.ts\";\n\nremovedAfterEach();\n\nconst CONTROLLER = join(import.meta.dirname, \"..\", \"..\", \"specs\", \"experiments\", \"e38\", \"dogfood\", \"config.json\");\nconst declared = JSON.parse(readFileSync(CONTROLLER, \"utf8\")).policy.project_controls as ProjectControlDeclaration[];\nconst LAYERS = declared.find((c) => c.control_id === \"lint-layers\")!;\nconst RECIPE = recipe([\"node\", \"recipe.js\", \"{candidate}\"]);\n\n/** The campaign's policy: the controller's layer control, the acceptance run, one attempt per change. */\nconst campaign = (over: PolicyOverride = {}): PolicyOverride => ({\n\tproject_controls: [LAYERS],\n\tacceptance_recipe: RECIPE,\n\tbudgets: { max_attempts: 1 },\n\t...over,\n});\n\nconst CONFORMANT = {};\n\ndescribe(\"the dogfooding campaign of pi-495 under its stable controller\", {\n\tskip: NO_QUALIFIED_SANDBOX && \"no sandbox backend qualifies on this machine\",\n}, () => {\n\tit(\"les quatre témoins bloquent au point attendu et le candidat conforme est intégré sous le contrôleur initial\", async () => {\n\t\t// A test tied to no requirement: its cases name none, so no prepared test can judge R1, the owner is asked what\n\t\t// to do at the qualification, and the protocol is never frozen — the change stops before any code is written.\n\t\tconst untied = await runOnPi495Shape(CONFORMANT, campaign(), {\n\t\t\tpreparedTest: SHOUT_TEST.replace(\"R1 shout\", \"shout\").replace(\"R2 greet\", \"greet\"),\n\t\t});\n\t\tconst asked = untied.t.requested.at(-1);\n\t\tassert.equal(asked?.interaction, \"IH-04\", untied.steps.join(\" | \"));\n\t\tassert.match(asked?.question ?? \"\", /R1/, \"the owner is told which requirement no test can judge\");\n\t\tassert.equal(untied.state.gates.G2, undefined, \"a test tied to no requirement does not freeze the protocol\");\n\t\tassert.equal(untied.state.candidate, null, \"it stops before any candidate is produced\");\n\n\t\t// A layer violation: the unit tests pass, the declared layer control refuses the candidate at G5.\n\t\tconst layered = await runOnPi495Shape({ \"src/domain/rule.ts\": DOMAIN_IMPORTING_AN_ADAPTER }, campaign());\n\t\tassert.equal(layered.state.gates.G4?.verdict, \"PASS\", layered.steps.join(\" | \"));\n\t\tassert.equal(layered.state.gates.G5?.verdict, \"FAIL\", \"the layer violation stops the candidate at G5\");\n\t\tassert.notEqual(layered.state.outcome, \"accepted\");\n\n\t\t// A missing acceptance run: the recipe writes no report, so nothing stands for it at G5.\n\t\tconst unrun = await runOnPi495Shape(\n\t\t\tCONFORMANT,\n\t\t\tcampaign({ acceptance_recipe: { ...RECIPE, command: [\"node\", \"-e\", \"\"] } }),\n\t\t);\n\t\tassert.equal(unrun.state.gates.G4?.verdict, \"PASS\", unrun.steps.join(\" | \"));\n\t\tassert.notEqual(unrun.state.gates.G5?.verdict, \"PASS\", \"a missing acceptance run stops the candidate at G5\");\n\t\tassert.match(unrun.state.gates.G5?.reasons.join(\" | \") ?? \"\", /acceptance recipe/);\n\t\tassert.notEqual(unrun.state.outcome, \"accepted\");\n\n\t\t// The conformant candidate: accepted at G5, integrated once the owner authorizes it.\n\t\tconst conformant = await runOnPi495Shape(CONFORMANT, campaign({ integration_enabled: true }), {\n\t\t\tintegration: true,\n\t\t});\n\t\tconst { t, change_id, state } = conformant;\n\t\tassert.equal(state.gates.G5?.verdict, \"PASS\", conformant.steps.join(\" | \"));\n\t\tconst question = t.requested.at(-1)!;\n\t\tassert.equal(question.interaction, \"IH-11\", \"integration waits for the owner\");\n\t\tt.harness.answerDecision(\n\t\t\tchange_id,\n\t\t\t{\n\t\t\t\tdecision_id: question.decision_id,\n\t\t\t\toption_id: \"integrate\",\n\t\t\t\tfree_text: null,\n\t\t\t\treason: null,\n\t\t\t\tsubject_revision: question.subject.revision,\n\t\t\t\tscope: null,\n\t\t\t\texpires_at: null,\n\t\t\t},\n\t\t\ttuiOrigin(),\n\t\t);\n\t\tconst done = await t.harness.advance(change_id, { max_steps: 10 });\n\t\tconst integrated = t.ledger.loadChange(change_id)!.state;\n\t\tassert.equal(integrated.outcome, \"integrated\", done.steps.join(\" | \"));\n\n\t\t// Under the initial controller: the protocol froze the controller's environment and its declared control as\n\t\t// identified when the campaign started, and every proof G5 retained ran under both.\n\t\tconst protocol = integrated.protocol!;\n\t\tassert.equal(protocol.environment_digest, integrated.environment_digest);\n\t\tassert.deepEqual(protocol.project_control_ids, [\"lint-layers\"]);\n\t\tconst candidate = integrated.candidate!;\n\t\tconst policy = { ...DEFAULT_POLICY, project_controls: [LAYERS], acceptance_recipe: RECIPE };\n\t\tassert.equal(evaluateG5(integrated, protocol, candidate, policy).verdict, \"PASS\");\n\t\t// The controls frozen with the protocol stay those G5 requires, whatever the policy declares afterwards: one\n\t\t// declared after the freeze is not required, one dropped after it still is.\n\t\tconst LINT = declared.find((c) => c.control_id === \"lint-code\")!;\n\t\tconst added = { ...policy, project_controls: [LAYERS, LINT] };\n\t\tassert.equal(evaluateG5(integrated, protocol, candidate, added).verdict, \"PASS\", \"a control added later\");\n\t\tconst unrunLayers = integrated.evidence.filter((e) => e.control_id !== \"lint-layers\");\n\t\tconst dropped = evaluateG5({ ...integrated, evidence: unrunLayers }, protocol, candidate, {\n\t\t\t...policy,\n\t\t\tproject_controls: [],\n\t\t});\n\t\tassert.ok(dropped.missing.includes(\"project:lint-layers\"), \"a control dropped after the freeze is still required\");\n\n\t\t// A stale proof: the layer control's run on another candidate, or under another controller, stands for nothing.\n\t\tfor (const [why, stale] of [\n\t\t\t[\"other candidate\", { subject_digest: `sha256:${\"1\".repeat(64)}` }],\n\t\t\t[\"other environment\", { environment_digest: `sha256:${\"2\".repeat(64)}` }],\n\t\t] as const) {\n\t\t\tconst evidence = integrated.evidence.map((e) => (e.control_id === \"lint-layers\" ? { ...e, ...stale } : e));\n\t\t\tconst g5 = evaluateG5({ ...integrated, evidence }, protocol, candidate, policy);\n\t\t\tassert.notEqual(g5.verdict, \"PASS\", `a proof of the layer control from an ${why} is stale`);\n\t\t\tassert.ok(g5.missing.includes(\"project:lint-layers\"), g5.missing.join(\", \"));\n\t\t}\n\t});\n});\n"},"test/v4-platform/dogfood-preparation.test.ts":{"tests":[{"id":"3","name":"test/v4-platform/dogfood-preparation.test.ts"}],"source":"/**\n * The prepared suite of a pi-495-shaped target under the stable controller: the suite its technology detects runs the\n * whole tree, where some tests launch a sandbox of their own and the whole run outlasts the delay of the control.\n * Confined, without a nested sandbox, the prepared suite is judged on the reference within that delay because the\n * controller's profile names the test files the suite runs — a profile the candidate never writes.\n */\nimport { strict as assert } from \"node:assert\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport type { ProjectControlDeclaration } from \"../../src/contracts/v1/config.ts\";\nimport type { Protocol } from \"../../src/contracts/v1/protocol.ts\";\nimport { recipe } from \"../helpers/acceptance-recipe.ts\";\nimport { runOnPi495Shape, ShortensTheSuiteDelay } from \"../helpers/dogfood.ts\";\nimport { NO_QUALIFIED_SANDBOX, removedAfterEach } from \"../helpers/fixtures.ts\";\n\nremovedAfterEach();\n\nconst CONTROLLER = join(import.meta.dirname, \"..\", \"..\", \"specs\", \"experiments\", \"e38\", \"dogfood\", \"config.json\");\nconst { policy } = JSON.parse(readFileSync(CONTROLLER, \"utf8\")) as {\n\tpolicy: { project_controls: ProjectControlDeclaration[]; suite_paths: string[]; suite_writable_paths: string[] };\n};\nconst LAYERS = policy.project_controls.find((c) => c.control_id === \"lint-layers\")!;\n/** The build control of the stable controller, run by a script of the target in place of its compiler. */\nconst BUILD = { ...policy.project_controls.find((c) => c.control_id === \"build\")!, command: [\"node\", \"build.js\"] };\n\n/** The delay the bench grants the suite: the ten minutes of the control, cut so the bench runs in seconds. */\nconst SUITE_DELAY_MS = 20_000;\n\n/**\n * The generations of pi-495 in miniature: a pure one that passes confined, and a kernel one whose tests launch a\n * sandbox of their own and run past any delay.\n */\nconst GENERATIONS = {\n\t\"test/v0-pure/greet.test.ts\":\n\t\t'import { test } from \"node:test\";\\nimport { strict as assert } from \"node:assert\";\\nimport { greet } from \"../../src/greet.js\";\\ntest(\"greet greets\", () => { assert.equal(greet(\"x\"), \"Hello, x\"); });\\n',\n\t\"test/v2-kernel/sandbox.test.js\":\n\t\t'import { test } from \"node:test\";\\nimport { strict as assert } from \"node:assert\";\\nimport { spawnSync } from \"node:child_process\";\\nconst nested = process.platform === \"darwin\" ? [\"sandbox-exec\", [\"-p\", \"(version 1)(allow default)\", \"/usr/bin/true\"]] : [\"bwrap\", [\"--ro-bind\", \"/\", \"/\", \"true\"]];\\ntest(\"a sandbox of its own runs\", () => { assert.equal(spawnSync(...nested).status, 0); });\\n',\n\t\"test/v2-kernel/campaign.test.js\":\n\t\t'import { test } from \"node:test\";\\ntest(\"a campaign that outlasts the delay\", () => new Promise(() => { setInterval(() => {}, 1000); }));\\n',\n};\n\n/**\n * The helper of pi-495's tests that creates their directory under `test-output/`, as `outputDir` of\n * `test/helpers/fixtures.ts` does, a prepared test that calls it, and an existing test of the reference that does too.\n */\nconst WRITES_UNDER_TEST_OUTPUT = {\n\t\"test/helpers/fixtures.js\":\n\t\t'import { mkdirSync, mkdtempSync } from \"node:fs\";\\nimport { join } from \"node:path\";\\nexport function outputDir(prefix) {\\n  mkdirSync(join(process.cwd(), \"test-output\"), { recursive: true });\\n  return mkdtempSync(join(process.cwd(), \"test-output\", prefix));\\n}\\n',\n\t\"test/v0-pure/output.test.ts\":\n\t\t'import { test } from \"node:test\";\\nimport { strict as assert } from \"node:assert\";\\nimport { existsSync } from \"node:fs\";\\nimport { outputDir } from \"../helpers/fixtures.js\";\\ntest(\"an output directory is created\", () => { assert.ok(existsSync(outputDir(\"lcov-\"))); });\\n',\n\t\"build.js\":\n\t\t'import { mkdirSync, copyFileSync } from \"node:fs\";\\nmkdirSync(\"dist\", { recursive: true });\\ncopyFileSync(\"src/greet.js\", \"dist/greet.js\");\\n',\n};\nconst SHOUT_TEST_WRITING_OUTPUT =\n\t'import { test } from \"node:test\";\\nimport { strict as assert } from \"node:assert\";\\nimport * as greeting from \"../src/greet.js\";\\nimport { outputDir } from \"./helpers/fixtures.js\";\\n\\ntest(\"R1 shout upper-cases the greeting\", () => {\\n  outputDir(\"shout-\");\\n  assert.equal(typeof greeting.shout, \"function\");\\n  assert.equal(greeting.shout(\"x\"), \"HELLO, X\");\\n});\\ntest(\"R2 greet unchanged\", () => {\\n  outputDir(\"greet-\");\\n  assert.equal(greeting.greet(\"x\"), \"Hello, x\");\\n});\\n';\n\ndescribe(\"the prepared suite of pi-495 under its stable controller\", {\n\tskip: NO_QUALIFIED_SANDBOX && \"no sandbox backend qualifies on this machine\",\n}, () => {\n\tit(\"sur une cible façonnée comme pi-495, dont des tests lancent eux-mêmes un bac à sable et dont la suite entière dépasse le délai du contrôle, la suite préparée est jugée PASS ou FAIL sur la référence, jamais INDETERMINATE par un dépassement de délai, et G2 fige le protocole\", async () => {\n\t\tconst { t, change_id, state, steps } = await runOnPi495Shape(\n\t\t\t{},\n\t\t\t{\n\t\t\t\tproject_controls: [LAYERS],\n\t\t\t\tacceptance_recipe: recipe([\"node\", \"recipe.js\", \"{candidate}\"]),\n\t\t\t\tbudgets: { max_