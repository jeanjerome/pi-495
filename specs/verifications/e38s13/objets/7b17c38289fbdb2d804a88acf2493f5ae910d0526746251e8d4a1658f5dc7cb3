"coveredBy":[],"location":{"end":{"column":44,"line":86},"start":{"column":39,"line":86}}},{"id":"32","mutatorName":"StringLiteral","replacement":"\"\"","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":57,"line":86},"start":{"column":46,"line":86}}},{"id":"33","mutatorName":"StringLiteral","replacement":"``","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":109,"line":86},"start":{"column":59,"line":86}}},{"id":"34","mutatorName":"StringLiteral","replacement":"\"\"","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":89,"line":86},"start":{"column":75,"line":86}}},{"id":"35","mutatorName":"StringLiteral","replacement":"\"\"","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":97,"line":86},"start":{"column":91,"line":86}}},{"id":"36","mutatorName":"BooleanLiteral","replacement":"lanceurDuControleur(depot, revisionControleur)","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":53,"line":87},"start":{"column":6,"line":87}}},{"id":"37","mutatorName":"ConditionalExpression","replacement":"true","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":53,"line":87},"start":{"column":6,"line":87}}},{"id":"38","mutatorName":"ConditionalExpression","replacement":"false","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":53,"line":87},"start":{"column":6,"line":87}}},{"id":"39","mutatorName":"BlockStatement","replacement":"{}","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":3,"line":92},"start":{"column":55,"line":87}}},{"id":"41","mutatorName":"StringLiteral","replacement":"``","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":169,"line":89},"start":{"column":4,"line":89}}},{"id":"43","mutatorName":"StringLiteral","replacement":"``","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":36,"line":93},"start":{"column":14,"line":93}}},{"id":"44","mutatorName":"CallExpression","replacement":";","status":"NoCoverage","static":false,"coveredBy":[],"location":{"end":{"column":50,"line":94},"start":{"column":2,"line":94}}}],"source":"/**\n * The dogfooding campaign: a stable, identified build of pi-495 — the controller — drives a change of another copy\n * of pi-495 — the candidate — in a real Pi with a real model. This launcher only extracts the two revisions from the\n * repository it runs in: the controller at its revision, with its dependencies, and the candidate as a repository of\n * one commit. It then hands the campaign to the controller's own `cycle/src/dogfood-controleur.ts`, run from the\n * controller's tree, so that the declaration of the controls, the driver of Pi and the record are those of the\n * controller's revision even when the launcher runs from the candidate's working tree. The launcher itself runs only\n * when it is the one the controller's revision carries: a candidate that rewrites it runs no campaign from its own\n * tree. A controller whose revision carries no such campaign cannot drive one.\n *\n * Usage: `npm run dogfood -- --objectif \"<the change>\" [--controleur <revision>] [--candidat <revision>]\n * [--model <provider/id>] [--thinking <level>]`; the controller defaults to `main`, the candidate to `HEAD`.\n *\n * The campaign lives under `~/.495/campagnes/dogfood-<timestamp>/`: `controleur/` is the controller's tree and build,\n * `cible/` the copy the change is made in, `dossier/` the controller's data directory, and `releve.json` its record.\n */\nimport { execFileSync, spawnSync } from \"node:child_process\";\nimport { existsSync, mkdirSync, rmSync } from \"node:fs\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport type { Lancement } from \"./dogfood-controleur.ts\";\n\nconst CAMPAGNE_DU_CONTROLEUR = join(\"cycle\", \"src\", \"dogfood-controleur.ts\");\nconst LANCEUR = \"cycle/src/dogfood.ts\";\nconst MODELE_PAR_DEFAUT = \"anthropic/claude-sonnet-5-5\";\n\nfunction option(args: string[], nom: string, parDefaut: string): string {\n\tconst i = args.indexOf(nom);\n\treturn i === -1 ? parDefaut : (args[i + 1] ?? parDefaut);\n}\n\nfunction executer(commande: string[], cwd: string): string {\n\tconst [programme, ...arguments_] = commande;\n\treturn execFileSync(programme!, arguments_, { cwd, encoding: \"utf8\", stdio: [\"ignore\", \"pipe\", \"inherit\"] }).trim();\n}\n\n/**\n * Whether the launcher that runs is the one the controller's revision `sha` carries, byte for byte: a launcher the\n * candidate rewrote could change the controller's tree after extracting it and before handing over to it.\n */\nfunction lanceurDuControleur(depot: string, sha: string): boolean {\n\tconst attendu = spawnSync(\"git\", [\"rev-parse\", \"-q\", \"--verify\", `${sha}:${LANCEUR}`], {\n\t\tcwd: depot,\n\t\tencoding: \"utf8\",\n\t});\n\tconst lance = executer([\"git\", \"hash-object\", fileURLToPath(import.meta.url)], depot);\n\treturn attendu.status === 0 && attendu.stdout.trim() === lance;\n}\n\n/**\n * The tree of `depot` at `revision`, extracted into `dossier` with its dependencies installed and no install script\n * run: the candidate's would run unconfined beside the controller's tree before the controller identifies itself.\n */\nfunction extraire(depot: string, revision: string, dossier: string): string {\n\tmkdirSync(dossier, { recursive: true });\n\tconst sha = executer([\"git\", \"rev-parse\", `${revision}^{commit}`], depot);\n\tconst archive = `${dossier}.tar`;\n\texecuter([\"git\", \"archive\", \"--format=tar\", \"-o\", archive, sha], depot);\n\texecuter([\"tar\", \"-xf\", archive, \"-C\", dossier], depot);\n\trmSync(archive);\n\texecFileSync(\"npm\", [\"ci\", \"--no-audit\", \"--no-fund\", \"--ignore-scripts\"], { cwd: dossier, stdio: \"inherit\" });\n\treturn sha;\n}\n\nfunction horodatage(): string {\n\treturn new Date()\n\t\t.toISOString()\n\t\t.replace(/\\.\\d+Z$/, \"\")\n\t\t.replace(/[-:]/g, \"\");\n}\n\nfunction main(): number {\n\tconst args = process.argv.slice(2);\n\tconst objectif = option(args, \"--objectif\", \"\");\n\tif (!objectif) {\n\t\tconsole.error(\n\t\t\t'usage: npm run dogfood -- --objectif \"<the change>\" [--controleur <revision>] [--candidat <revision>] [--model <id>] [--thinking <level>]',\n\t\t);\n\t\treturn 2;\n\t}\n\tconst depot = process.cwd();\n\tconst campagne = join(homedir(), \".495\", \"campagnes\", `dogfood-${horodatage()}`);\n\tconst [controleur, cible] = [join(campagne, \"controleur\"), join(campagne, \"cible\")];\n\n\tconst revisionControleur = executer([\"git\", \"rev-parse\", `${option(args, \"--controleur\", \"main\")}^{commit}`], depot);\n\tif (!lanceurDuControleur(depot, revisionControleur)) {\n\t\tconsole.error(\n\t\t\t`the launcher that runs is not the one the controller at ${revisionControleur} carries (${LANCEUR}): run the campaign from a tree whose launcher is the controller's`,\n\t\t);\n\t\treturn 2;\n\t}\n\tconsole.log(`campaign ${campagne}`);\n\textraire(depot, revisionControleur, controleur);\n\tconst script = join(controleur, CAMPAGNE_DU_CONTROLEUR);\n\tif (!existsSync(script)) {\n\t\tconsole.error(\n\t\t\t`the controller at ${revisionControleur} carries no dogfooding campaign (${CAMPAGNE_DU_CONTROLEUR}): name a controller revision that does`,\n\t\t);\n\t\treturn 2;\n\t}\n\n\tconst revisionCandidat = extraire(depot, option(args, \"--candidat\", \"HEAD\"), cible);\n\tconst git = (...a: string[]) =>\n\t\texecuter([\"git\", \"-c\", \"user.name=dogfood\", \"-c\", \"user.email=dogfood@localhost\", ...a], cible);\n\tgit(\"init\", \"-q\", \"-b\", \"main\");\n\tgit(\"add\", \"-A\");\n\tgit(\"commit\", \"-q\", \"-m\", `pi-495 at ${revisionCandidat}`);\n\n\tconst lancement: Lancement = {\n\t\tcampagne,\n\t\trevision_controleur: revisionControleur,\n\t\trevision_candidat: revisionCandidat,\n\t\tcible,\n\t\tdepart: git(\"rev-parse\", \"HEAD\"),\n\t\tobjectif,\n\t\tmodele: option(args, \"--model\", MODELE_PAR_DEFAUT),\n\t\treflexion: option(args, \"--thinking\", \"high\"),\n\t};\n\treturn (\n\t\tspawnSync(process.execPath, [script, JSON.stringify(lancement)], { cwd: controleur, stdio: \"inherit\" }).status ?? 1\n\t);\n}\n\nprocess.exitCode = main();\n"}},"schemaVersion":"1.0","thresholds":{"high":80,"low":60,"break":null},"testFiles":{"test/cycle/process-measurements.test.ts":{"tests":[{"id":"0","name":"test/cycle/process-measurements.test.ts"}],"source":"import { describe, it } from \"node:test\";\nimport { strict as assert } from \"node:assert\";\nimport { spawnSync } from \"node:child_process\";\nimport { mkdirSync, writeFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { stripVTControlCharacters } from \"node:util\";\nimport { gitCmd, tempDir, removedAfterEach } from \"../helpers/fixtures.ts\";\nimport { NODE, PASSING_TEST, SHOUT_CODE, SHOUT_TEST, depot } from \"../helpers/cycle.ts\";\n\nconst MAIN = join(import.meta.dirname, \"..\", \"..\", \"cycle\", \"src\", \"main.ts\");\nconst cleanups = removedAfterEach();\n\nfunction commit(root: string, files: Record<string, string>, message: string): string {\n\tfor (const [rel, content] of Object.entries(files)) {\n\t\tmkdirSync(join(root, rel, \"..\"), { recursive: true });\n\t\twriteFileSync(join(root, rel), content);\n\t}\n\tgitCmd(root, [\"add\", \"-A\"]);\n\tgitCmd(root, [\"commit\", \"-q\", \"-m\", message]);\n\treturn gitCmd(root, [\"rev-parse\", \"HEAD\"]).trim();\n}\n\nfunction journal(racine: string, story: string, evenements: Record<string, unknown>[]): void {\n\tmkdirSync(join(racine, story), { recursive: true });\n\twriteFileSync(join(racine, story, \"journal.jsonl\"), evenements.map((e) => `${JSON.stringify(e)}\\n`).join(\"\"));\n}\n\n/** A story that landed `heures` after it started, its session reporting `cout`, after `ecarts` acceptance gaps. */\nfunction storyVersee(racine: string, id: string, heures: number, cout: number, ecarts: number): void {\n\tjournal(racine, id, [\n\t\t{ at: \"2026-10-01T10:00:00.000Z\", pas: \"story\", genre: \"debute\" },\n\t\t{ at: \"2026-10-01T10:30:00.000Z\", pas: \"rouge-vert\", genre: \"session\", ok: true, cout_usd: cout },\n\t\t...Array.from({ length: ecarts }, () => ({\n\t\t\tat: \"2026-10-01T10:40:00.000Z\",\n\t\t\tpas: \"recette\",\n\t\t\tgenre: \"rouvert\",\n\t\t\tmotif: \"gap\",\n\t\t})),\n\t\t{\n\t\t\tat: new Date(Date.parse(\"2026-10-01T10:00:00.000Z\") + heures * 3_600_000).toISOString(),\n\t\t\tpas: \"versement\",\n\t\t\tgenre: \"verse\",\n\t\t},\n\t]);\n}\n\n/** What `cycle mesures` prints for `designations`, read in `racine` from the repository `root`. */\nfunction mesures(root: string, racine: string, designations: string[]) {\n\tconst r = spawnSync(NODE, [MAIN, \"mesures\", ...designations], {\n\t\tcwd: root,\n\t\tenv: { ...process.env, CYCLE_495_DIR: racine, NO_COLOR: \"1\" },\n\t\tencoding: \"utf8\",\n\t\ttimeout: 60_000,\n\t});\n\tassert.equal(r.status, 0, stripVTControlCharacters(r.stderr));\n\treturn JSON.parse(r.stdout) as {\n\t\tstories: { duree_par_pas_ms: Record<string, number> }[];\n\t\trecommandations: { profil: string; recommandation: string }[];\n\t};\n}\n\ndescribe(\"the measurements of the cycle\", () => {\n\tit(\"les valeurs manquantes restent manquantes et les révisions de test sont séparées des corrections de code\", () => {\n\t\tconst root = depot();\n\t\tconst base = gitCmd(root, [\"rev-parse\", \"HEAD\"]).trim();\n\t\tgitCmd(root, [\"checkout\", \"-q\", \"-b\", \"e01s05\"]);\n\t\tcommit(root, { \"test/shout.test.js\": SHOUT_TEST }, \"test: greet shouts\");\n\t\tconst rougeVert = commit(root, { \"src/greet.js\": SHOUT_CODE }, \"feat: greet shouts\");\n\t\t// After the red-green: a review answer that rewrites an existing assertion, one that corrects the code, and new\n\t\t// tests written for a gap, in a file of their own or after the existing ones, which revise no test.\n\t\tcommit(root, { \"test/shout.test.js\": SHOUT_TEST.replace('\"HELLO, X\"', '\"HELLO, X!\"') }, \"test: shout revised\");\n\t\tcommit(root, { \"src/greet.js\": `${SHOUT_CODE}// trims nothing\\n` }, \"fix: shout corrected\");\n\t\tcommit(root, { \"test/greet-again.test.js\": PASSING_TEST }, \"test: greet still greets\");\n\t\tcommit(\n\t\t\troot,\n\t\t\t{ \"test/greet-again.test.js\": `${PASSING_TEST}${PASSING_TEST.replace(\"greet greets\", \"greet greets twice\")}` },\n\t\t\t\"test: greet greets twice\",\n\t\t);\n\t\tgitCmd(root, [\"checkout\", \"-q\", \"main\"]);\n\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\t// An older journal: its sessions carry no cost, and the story has not landed.\n\t\tjournal(racine, \"e01s05\", [\n\t\t\t{ at: \"2026-10-01T10:00:00.000Z\", pas: \"story\", genre: \"debute\", revision: base },\n\t\t\t{ at: \"2026-10-01T10:01:00.000Z\", pas: \"story\", genre: \"branche\", nom: \"e01s05\", base },\n\t\t\t{ at: \"2026-10-01T10:01:00.000Z\", pas: \"story\", genre: \"fini\" },\n\t\t\t{ at: \"2026-10-01T10:01:00.000Z\", pas: \"rouge-vert\", genre: \"debute\", revision: base },\n\t\t\t{ at: \"2026-10-01T10:20:00.000Z\", pas: \"rouge-vert\", genre: \"session\", nom: \"rouge-vert\", ok: true },\n\t\t\t{ at: \"2026-10-01T10:21:00.000Z\", pas: \"rouge-vert\", genre: \"fini\" },\n\t\t\t{ at: \"2026-10-01T10:21:00.000Z\", pas: \"autocontrole\", genre: \"debute\", revision: rougeVert },\n\t\t\t{ at: \"2026-10-01T10:30:00.000Z\", pas: \"autocontrole\", genre: \"fini\" },\n\t\t\t{ at: \"2026-10-01T10:30:00.000Z\", pas: \"relecture\", genre: \"debute\", revision: rougeVert },\n\t\t\t{ at: \"2026-10-01T10:40:00.000Z\", pas: \"relecture\", genre: \"tour\", tour: 1, porte: \"fail\", constats: 3 },\n\t\t\t{ at: \"2026-10-01T10:50:00.000Z\", pas: \"relecture\", genre: \"fini\" },\n\t\t\t{ at: \"2026-10-01T10:50:00.000Z\", pas: \"recette\", genre: \"debute\", revision: rougeVert },\n\t\t\t{ at: \"2026-10-01T11:00:00.000Z\", pas: \"recette\", genre: \"rouvert\", motif: \"the name is not upper-cased\" },\n\t\t]);\n\t\t// A journal that names no branch: what its commits would say is not known.\n\t\tjournal(racine, \"e01s06\", [\n\t\t\t{ at: \"2026-10-02T10:00:00.000Z\", pas: \"story\", genre: \"debute\", revision: base },\n\t\t\t{ at: \"2026-10-02T10:30:00.000Z\", pas: \"rouge-vert\", genre: \"session\", nom: \"rouge-vert\", ok: true, cout_usd: 0 },\n\t\t\t{ at: \"2026-10-02T11:00:00.000Z\", pas: \"versement\", genre: \"verse\", commit: base },\n\t\t]);\n\n\t\tconst r = spawnSync(NODE, [MAIN, \"mesures\", \"e01s05\", \"e01s06\"], {\n\t\t\tcwd: root,\n\t\t\tenv: { ...process.env, CYCLE_495_DIR: racine, NO_COLOR: \"1\" },\n\t\t\tencoding: \"utf8\",\n\t\t\ttimeout: 60_000,\n\t\t});\n\t\tlet bilan: { stories: Record<string, unknown>[]; mediane_duree_ms: unknown } | null = null;\n\t\ttry {\n\t\t\tbilan = JSON.parse(r.stdout);\n\t\t} catch {}\n\t\tassert.ok(bilan, `the cycle prints the measurements of the stories: ${stripVTControlCharacters(r.stderr)}`);\n\t\tconst [ouverte, sansBranche] = bilan.stories;\n\n\t\tassert.equal(ouverte?.cout_usd, null, \"a cost no session observed stays missing, never zero\");\n\t\tassert.equal(ouverte?.duree_totale_ms, null, \"a story that has not landed has no time to landing\");\n\t\tassert.equal(ouverte?.revisions_de_tests, 1, \"the rewritten assertion is a test revision, the new test is not\");\n\t\tassert.equal(ouverte?.reprises_de_code, 1, \"the code correction is counted apart from the test revision\");\n\t\tassert.equal(ouverte?.tours_de_relecture, 1);\n\t\tassert.equal(ouverte?.constats_de_relecture, 3);\n\t\tassert.equal(ouverte?.ecarts_de_recette, 1, \"the gap the acceptance run found is a defect found at acceptance\");\n\n\t\tassert.equal(sansBranche?.cout_usd, 0, \"a cost observed at zero stays zero\");\n\t\tassert.equal(sansBranche?.duree_totale_ms, 60 * 60_000);\n\t\tassert.equal(sansBranche?.revisions_de_tests, null, \"without its branch, the revisions of a story are not known\");\n\t\tassert.equal(sansBranche?.reprises_de_code, null);\n\t\tassert.equal(bilan.mediane_duree_ms, 60 * 60_000, \"the median counts only the stories that landed\");\n\t});\n\n\tit(\"une attente que l'automate tranche n'est pas une intervention, et incidents et écarts de recette sont comptés à part\", () => {\n\t\tconst root = depot();\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\tconst at = (minute: number) => new Date(Date.parse(\"2026-10-01T10:00:00.000Z\") + minute * 60_000).toISOString();\n\t\tjournal(racine, \"e01s07\", [\n\t\t\t{ at: at(0), pas: \"story\", genre: \"debute\" },\n\t\t\t// A session that returns no output, then a step that blocks: two incidents.\n\t\t\t{ at: at(1), pas: \"rouge-vert\", genre: \"session\", nom: \"rouge-vert\", ok: false },\n\t\t\t{ at: at(2), pas: \"rouge-vert\", genre: \"bloque\", detail: \"no output\" },\n\t\t\t// The review leaves a promise unkept: unattended, the tool reopens the review itself, without the owner.\n\t\t\t{ at: at(3), pas: \"relecture\", genre: \"tour\", tour: 2, porte: \"fail\", constats: 1 },\n\t\t\t{ at: at(4), pas: \"relecture\", genre: \"proprietaire\", detail: \"a promise is not kept\" },\n\t\t\t{ at: at(4), pas: \"relecture\", genre: \"rouvert\", motif: \"a promise is not kept\" },\n\t\t\t// The acceptance run waits for the owner, and an independent session agrees in their place.\n\t\t\t{ at: at(5), pas: \"recette\", genre: \"proprietaire\", detail: \"acceptance run report\" },\n\t\t\t{ at: at(6), pas: \"recette\", genre: \"session\", nom: \"arbitrage\", ok: true },\n\t\t\t{ at: at(6), pas: \"recette\", genre: \"arbitrage\", decision: \"ecart\", origine: \"automate\" },\n\t\t\t{ at: at(6), pas: \"recette\", genre: \"rouvert\", motif: \"the name is not upper-cased\" },\n\t\t\t// The next acceptance run waits for the owner, who answers in a later run.\n\t\t\t{ at: at(7), pas: \"recette\", genre: \"proprietaire\", detail: \"acceptance run report\" },\n\t\t\t{ at: at(60), pas: \"recette\", genre: \"acceptee\", note: \"\" },\n\t\t]);\n\n\t\tconst r = spawnSync(NODE, [MAIN, \"mesures\", \"e01s07\"], {\n\t\t\tcwd: root,\n\t\t\tenv: { ...process.env, CYCLE_495_DIR: racine, NO_COLOR: \"1\" },\n\t\t\tencoding: \"utf8\",\n\t\t\ttimeout: 60_000,\n\t\t});\n\t\tlet bilan: { stories: Record<string, unknown>[] } | null = null;\n\t\ttry {\n\t\t\tbilan = JSON.parse(r.stdout);\n\t\t} catch {}\n\t\tassert.ok(bilan, `the cycle prints the measurements of the stories: ${stripVTControlCharacters(r.stderr)}`);\n\t\tconst [story] = bilan.stories;\n\t\tassert.equal(story?.interventions, 1, \"only the wait the owner answered is an intervention\");\n\t\tassert.equal(story?.arbitrages_automate, 1, \"the agreement the automaton gave is counted apart\");\n\t\tassert.equal(story?.tours_de_relecture, 1, \"the review the tool reopened is counted as review\");\n\t\tassert.equal(story?.ecarts_de_recette, 1, \"a review reopened is not a defect found at the acceptance run\");\n\t\tassert.equal(story?.incidents, 2, \"a session without output and a blocked step are two incidents\");\n\t});\n\n\tit(\"a formal profile that costs more without finding fewer defects late is reserved to the risks that justify it, and no obligation is removed\", () => {\n\t\tconst root = depot();\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\tstoryVersee(racine, \"e01s05\", 1, 10, 1);\n\t\tstoryVersee(racine, \"e01s06\", 2, 30, 1);\n\t\t// As long as the simple story, dearer in dollars alone.\n\t\tstoryVersee(racine, \"e01s08\", 1, 30, 1);\n\t\t// A refactoring lands through the short path: its journal says `versement` under `reprise`.\n\t\tjournal(racine, \"R900\", [\n\t\t\t{ at: \"2026-10-01T10:00:00.000Z\", pas: \"reprise\", genre: \"debute\" },\n\t\t\t{ at: \"2026-10-01T10:20:00.000Z\", pas: \"reprise\", genre: \"versement\" },\n\t\t]);\n\n\t\tconst r = spawnSync(NODE, [MAIN, \"mesures\", \"simple=e01s05\", \"tla=e01s06\", \"lean=e01s08\", \"refactoring=R900\"], {\n\t\t\tcwd: root,\n\t\t\tenv: { ...process.env, CYCLE_495_DIR: racine, NO_COLOR: \"1\" },\n\t\t\tencoding: \"utf8\",\n\t\t\ttimeout: 60_000,\n\t\t});\n\t\tlet bilan: {\n\t\t\tprofils?: Record<string, { stories: string[]; mediane_duree_ms: number | null; mediane_cout_usd: number | null }>;\n\t\t\trecommandations?: {\n\t\t\t\tprofil: string;\n\t\t\t\trecommandation: string;\n\t\t\t\tobligations_maintenues: string[];\n\t\t\t\tobligations_retirees: string[];\n\t\t\t}[];\n\t\t} | null = null;\n\t\ttry {\n\t\t\tbilan = JSON.parse(r.stdout);\n\t\t} catch {}\n\t\tassert.ok(bilan?.recommandations, `the bilan recommends by profile: ${stripVTControlCharacters(r.stderr)}`);\n\t\tassert.deepEqual(bilan.profils?.tla, {\n\t\t\tstories: [\"e01s06\"],\n\t\t\tmediane_duree_ms: 2 * 3_600_000,\n\t\t\tmediane_cout_usd: 30,\n\t\t});\n\t\tassert.equal(bilan.profils?.refactoring?.mediane_duree_ms, 20 * 60_000, \"a refactoring is measured to its landing\");\n\t\tconst tla = bilan.recommandations.find((x) => x.profil === \"tla\");\n\t\tassert.match(\n\t\t\ttla?.recommandation ?? \"\",\n\t\t\t/réserver .*risque/,\n\t\t\t\"a formal means that costs more without fewer late defects is reserved to the risks that justify it\",\n\t\t);\n\t\tassert.match(\n\t\t\tbilan.recommandations.find((x) => x.profil === \"lean\")?.recommandation ?? \"\",\n\t\t\t/réserver .*risque/,\n\t\t\t\"a means that costs more in dollars alone costs more\",\n\t\t);\n\t\tfor (const x of bilan.recommandations)\n\t\t\tassert.deepEqual(x.obligations_retirees, [], `${x.profil}: no obligation is removed to gain time`);\n\t\t// What a story's path requires stays required of a formal profile; a refactoring keeps the short path's own.\n\t\tconst obligations = (profil: string) =>\n\t\t\tbilan?.recommandations?.find((x) => x.profil === profil)?.obligations_maintenues.join(\" | \") ?? \"\";\n\t\tfor (const exigee of [/rouge vu/, /deux relecteurs/, /recette réelle/, /Preflight verte/])\n\t\t\tassert.match(obligations(\"tla\"), exigee, \"the formal profile keeps every obligation of a story\");\n\t\tassert.match(obligations(\"refactoring\"), /relecture indépendante du diff/);\n\t\tassert.doesNotMatch(\n\t\t\tobligations(\"refactoring\"),\n\t\t\t/deux relecteurs/,\n\t\t\t\"a refactoring keeps the obligations of its path\",\n\t\t);\n\t});\n\tit(\"sums the time of a step over each of its runs, a step left and resumed included\", () => {\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\tconst at = (minute: number) => new Date(Date.parse(\"2026-10-01T10:00:00.000Z\") + minute * 60_000).toISOString();\n\t\tjournal(racine, \"e01s09\", [\n\t\t\t{ at: at(0), pas: \"story\", genre: \"debute\" },\n\t\t\t{ at: at(5), pas: \"story\", genre: \"fini\" },\n\t\t\t{ at: at(5), pas: \"rouge-vert\", genre: \"debute\" },\n\t\t\t{ at: at(25), pas: \"rouge-vert\", genre: \"fini\" },\n\t\t\t{ at: at(25), pas: \"recette\", genre: \"debute\" },\n\t\t\t{ at: at(35), pas: \"recette\", genre: \"rouvert\", motif: \"gap\" },\n\t\t\t{ at: at(35), pas: \"rouge-vert\", genre: \"debute\" },\n\t\t\t{ at: at(45), pas: \"rouge-vert\", genre: \"fini\" },\n\t\t\t{ at: at(45), pas: \"recette\", genre: \"debute\" },\n\t\t\t{ at: at(50), pas: \"recette\", genre: \"acceptee\" },\n\t\t\t{ at: at(50), pas: \"versement\", genre: \"verse\" },\n\t\t]);\n\n\t\tconst [story] = mesures(depot(), racine, [\"e01s09\"]).stories;\n\t\tassert.deepEqual(story?.duree_par_pas_ms, {\n\t\t\tstory: 5 * 60_000,\n\t\t\t\"rouge-vert\": 30 * 60_000,\n\t\t\trecette: 15 * 60_000,\n\t\t\tversement: 0,\n\t\t});\n\t});\n\n\tit(\"extends a profile that costs no more than the simple one, keeps a dearer one that finds fewer defects late, and adapts nothing without a simple profile\", () => {\n\t\tconst root = depot();\n\t\tconst racine = tempDir(\"495-\", cleanups);\n\t\tstoryVersee(racine, \"e01s05\", 1, 10, 1);\n\t\tstoryVersee(racine, \"e01s06\", 1, 10, 1);\n\t\tstoryVersee(racine, \"e01s08\", 2, 30, 0);\n\n\t\tconst recommandation = (bilan: ReturnType<typeof mesures>, profil: string) =>\n\t\t\tbilan.recommandations.find((x) => x.profil === profil)?.recommandation ?? \"\";\n\t\tconst compare = mesures(root, racine, [\"simple=e01s05\", \"tla=e01s06\", \"lean=e01s08\"]);\n\t\tassert.match(recommandation(compare, \"simple\"), /profil de référence/);\n\t\tassert.match(recommandation(compare, \"tla\"), /rien ne s'oppose à l'étendre/, \"no dearer than the simple profile\");\n\t\tassert.match(\n\t\t\trecommandation(compare, \"lean\"),\n\t\t\t/garder .*risque/,\n\t\t\t\"dearer, with fewer defects at the acceptance run\",\n\t\t);\n\n\t\tconst seul = mesures(root, racine, [\"tla=e01s06\"]);\n\t\tassert.match(recommandation(seul, \"tla\"), /aucune adaptation proposée/, \"nothing to compare with\");\n\t});\n});\n"},"test/v4-platform/dogfood-controls.test.ts":{"tests":[{"id":"1","name":"test/v4-platform/dogfood-controls.test.ts"}],"source":"/**\n * pi-495 driving a change of pi-495 judges the candidate by every control `npm run check` chains, not only by the\n * suite its technology detects: the controls the stable controller declares run on the candidate under the sandbox\n * of the platform, and G5 requires each of them.\n */\nimport { strict as assert } from \"node:assert\";\nimport { existsSync, readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { loadConfig } from \"../../src/extension/config.ts\";\nimport { DOMAIN_IMPORTING_AN_ADAPTER, runOnPi495Shape } from \"../helpers/dogfood.ts\";\nimport { NO_QUALIFIED_SANDBOX, removedAfterEach } from \"../helpers/fixtures.ts\";\n\nremovedAfterEach();\n\nconst REPOSITORY = join(import.meta.dirname, \"..\", \"..\");\n/** The data directory of the stable controller: its `config.json` declares the controls of this repository. */\nconst CONTROLLER = join(REPOSITORY, \"specs\", \"experiments\", \"e38\", \"dogfood\");\n\n/** The layer control of this repository, as the stable controller declares it. */\nconst LAYERS = {\n\tcontrol_id: \"lint-layers\",\n\ttitle: \"npm run lint:layers\",\n\tcommand: [\"node\", \"scripts/check-layers.ts\"],\n\ttimeout_ms: 60_000,\n\tprotected_paths: [\"scripts/\"],\n};\n\ndescribe(\"the stable controller judges a change of pi-495 by the controls of npm run check\", {\n\tskip: NO_QUALIFIED_SANDBOX && \"no sandbox backend qualifies on this machine\",\n}, () => {\n\tit(\"un échec du contrôle de couches bloque la story même si les tests unitaires passent\", async () => {\n\t\tconst { state } = await runOnPi495Shape(\n\t\t\t{ \"src/domain/rule.ts\": DOMAIN_IMPORTING_AN_ADAPTER },\n\t\t\t{ project_controls: [LAYERS], budgets: { max_attempts: 1 } },\n\t\t);\n\t\tconst candidate = state.candidate!.manifest_digest;\n\t\tconst onCandidate = state.evidence.filter((e) => e.valid && e.subject_digest === candidate);\n\t\tassert.equal(onCandidate.findLast((e) => e.control_id === \"unit\")?.verdict, \"PASS\", \"the unit tests pass\");\n\t\tassert.notEqual(state.outcome, \"accepted\", \"a layer violation blocks the story even though the unit tests pass\");\n\t\tassert.equal(state.gates.G5?.verdict, \"FAIL\", JSON.stringify(state.gates.G5));\n\t\tassert.equal(onCandidate.findLast((e) => e.control_id === LAYERS.control_id)?.verdict, \"FAIL\");\n\t\tassert.match(state.gates.G5?.reasons.join(\" | \") ?? \"\", /lint-layers/);\n\t});\n\n\tit(\"a producer that rewrites the layer script beside a layer violation is refused, the script being protected\", async () => {\n\t\tconst declared = loadConfig(CONTROLLER, {}).config.policy.project_controls ?? [];\n\t\tconst layers = declared.find((c) => c.control_id === LAYERS.control_id);\n\t\tassert.ok(layers, \"the stable controller declares the layer control\");\n\t\tconst { state } = await runOnPi495Shape(\n\t\t\t{ \"src/domain/rule.ts\": DOMAIN_IMPORTING_AN_ADAPTER, \"scripts/check-layers.ts\": \"process.exit(0);\\n\" },\n\t\t\t{ project_controls: [layers], budgets: { max_attempts: 1 } },\n\t\t);\n\t\tassert.equal(state.gates.G4?.verdict, \"FAIL\", \"the rewritten layer script does not stand as the control\");\n\t\tassert.match(state.gates.G4?.reasons.join(\" | \") ?? \"\", /protected path altered by the producer: scripts\\//);\n\t\tassert.notEqual(state.outcome, \"accepted\");\n\t});\n\n\tit(\"the stable controller declares every control npm run check chains, the suite included\", () => {\n\t\tconst { scripts } = JSON.parse(readFileSync(join(REPOSITORY, \"package.json\"), \"utf8\"));\n\t\tconst chained = String(scripts.check)\n\t\t\t.split(\"&&\")\n\t\t\t.map((s) => s.trim().replace(/^npm run /, \"\"));\n\t\tconst declared = existsSync(join(CONTROLLER, \"config.json\"))\n\t\t\t? (loadConfig(CONTROLLER, {}).config.policy.project_controls ?? [])\n\t\t\t: [];\n\t\tfor (const name of chained) {\n\t\t\tconst control = declared.find((c) => c.control_id === name.replace(\":\", \"-\"));\n\t\t\tassert.ok(control, `npm run ${name} is declared to the stable controller`);\n\t\t\tassert.match(control.title, new RegExp(`npm run ${name}\\\\b`), `${control.control_id} says which script it runs`);\n\t\t}\n\t\tassert.deepEqual(\n\t\t\tdeclared.find((c) => c.control_id === \"lint-layers\")?.command,\n\t\t\tLAYERS.command,\n\t\t\t\"the layer control is the script npm run lint:layers runs\",\n\t\t);\n\t});\n});\n"},"test/v4-platform/dogfood-process.test.ts":{"tests":[{"id":"2","name":"test/v4-platform/dogfood-process.test.ts"}],"source":"/**\n * The dogfooding campaign of pi-495 at the scale of its witnesses: the stable controller, configured as\n * `specs/experiments/e38/dogfood/config.json` declares it, drives changes of a pi-495-shaped target under the sandbox\n * of the platform. Each witness carries one fault the new process must stop — a test tied to no requirement, a stale\n * proof, a missing acceptance run, a layer violation — and must stop it where it is announced; the conformant\n * candidate is integrated under the controller and the controls identified when the campaign started.\n */\nimport { strict as assert } from \"node:assert\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport type { ProjectControlDeclaration } from \"../../src/contracts/v1/config.ts\";\nimport { evaluateG5 } from \"../../src/domain/gates/g5.ts\";\nimport { DEFAULT_POLICY } from \"../../src/domain/policy.ts\";\nimport { recipe } from \"../helpers/acceptance-recipe.ts\";\nimport { tuiOrigin } from \"../helpers/change-fixture.ts\";\nimport { DOMAIN_IMPORTING_AN_ADAPTER, runOnPi495Shape } from \"../helpers/dogfood.ts\";\nimport { NO_QUALIFIED_SANDBOX, removedAfterEach, SHOUT_TEST } from \"../helpers/fixtures.ts\";\nimport type { PolicyOverride } from \"../helpers/harness-fixture.ts\";\n\nremovedAfterEach();\n\nconst CONTROLLER = join(import.meta.dirname, \"..\", \"..\", \"specs\", \"experiments\", \"e38\", \"dogfood\", \"config.json\");\nconst declared = JSON.parse(readFileSync(CONTROLLER, \"utf8\")).policy.project_controls as ProjectControlDeclaration[];\nconst LAYERS = declared.find((c) => c.control_id === \"lint-layers\")!;\nconst RECIPE = recipe([\"node\", \"recipe.js\", \"{candidate}\"]);\n\n/** The campaign's policy: the controller's layer control, the acceptance run, one attempt per change. */\nconst campaign = (over: PolicyOverride = {}): PolicyOverride => ({\n\tproject_controls: [LAYERS],\n\tacceptance_recipe: RECIPE,\n\tbudgets: { max_attempts: 1 },\n\t...over,\n});\n\nconst CONFORMANT = {};\n\ndescribe(\"the dogfooding campaign of pi-495 under its stable controller\", {\n\tskip: NO_QUALIFIED_SANDBOX && \"no sandbox backend qualifies on this machine\",\n}, () => {\n\tit(\"les quatre témoins bloquent au point attendu et le candidat conforme est intégré sous le contrôleur initial\", async () => {\n\t\t// A test tied to no requirement: its cases name none, so no prepared test can judge R1, the owner is asked what\n\t\t// to do at the qualification, and the protocol is never frozen — the change stops before any code is written.\n\t\tconst untied = await runOnPi495Shape(CONFORMANT, campaign(), {\n\t\t\tpreparedTest: SHOUT_TEST.replace(\"R1 shout\", \"shout\").replace(\"R2 greet\", \"greet\"),\n\t\t});\n\t\tconst asked = untied.t.requested.at(-1);\n\t\tassert.equal(asked?.interaction, \"IH-04\", untied.steps.join(\" | \"));\n\t\tassert.match(asked?.question ?? \"\", /R1/, \"the owner is told which requirement no test can judge\");\n\t\tassert.equal(untied.state.gates.G2, undefined, \"a test tied to no requirement does not freeze the protocol\");\n\t\tassert.equal(untied.state.candidate, null, \"it stops before any candidate is produced\");\n\n\t\t// A layer violation: the unit tests pass, the declared layer control refuses the candidate at G5.\n\t\tconst layered = await runOnPi495Shape({ \"src/domain/rule.ts\": DOMAIN_IMPORTING_AN_ADAPTER }, campaign());\n\t\tassert.equal(layered.state.gates.G4?.verdict, \"PASS\", layered.steps.join(\" | \"));\n\t\tassert.equal(layered.state.gates.G5?.verdict, \"FAIL\", \"the layer violation stops the candidate at G5\");\n\t\tassert.notEqual(layered.state.outcome, \"accepted\");\n\n\t\t// A missing acceptance run: the recipe writes no report, so nothing stands for it at G5.\n\t\tconst unrun = await runOnPi495Shape(\n\t\t\tCONFORMANT,\n\t\t\tcampaign({ acceptance_recipe: { ...RECIPE, command: [\"node\", \"-e\", \"\"] } }),\n\t\t);\n\t\tassert.equal(unrun.state.gates.G4?.verdict, \"PASS\", unrun.steps.join(\" | \"));\n\t\tassert.notEqual(unrun.state.gates.G5?.verdict, \"PASS\", \"a missing acceptance run stops the candidate at G5\");\n\t\tassert.match(unrun.state.gates.G5?.reasons.join(\" | \") ?? \"\", /acceptance recipe/);\n\t\tassert.notEqual(unrun.state.outcome, \"accepted\");\n\n\t\t// The conformant candidate: accepted at G5, integrated once the owner authorizes it.\n\t\tconst conformant = await runOnPi495Shape(CONFORMANT, campaign({ integration_enabled: true }), {\n\t\t\tintegration: true,\n\t\t});\n\t\tconst { t, change_id, state } = conformant;\n\t\tassert.equal(state.gates.G5?.verdict, \"PASS\", conformant.steps.join(\" | \"));\n\t\tconst question = t.requested.at(-1)!;\n\t\tassert.equal(question.interaction, \"IH-11\", \"integration waits for the owner\");\n\t\tt.harness.answerDecision(\n\t\t\tchange_id,\n\t\t\t{\n\t\t\t\tdecision_id: question.decision_id,\n\t\t\t\toption_id: \"integrate\",\n\t\t\t\tfree_text: null,\n\t\t\t\treason: null,\n\t\t\t\tsubject_revision: question.subject.revision,\n\t\t\t\tscope: null,\n\t\t\t\texpires_at: null,\n\t\t\t},\n\t\t\ttuiOrigin(),\n\t\t);\n\t\tconst done = await t.harness.advance(change_id, { max_steps: 10 });\n\t\tconst integrated = t.ledger.loadChange(change_id)!.state;\n\t\tassert.equal(integrated.outcome, \"integrated\", done.steps.join(\" | \"));\n\n\t\t// Under the initial controller: the protocol froze the controller's environment and its declared control as\n\t\t// identified when the campaign started, and every proof G5 retained ran under both.\n\t\tconst protocol = integrated.protocol!;\n\t\tassert.equal(protocol.environment_digest, integrated.environment_digest);\n\t\tassert.deepEqual(protocol.project_control_ids, [\"lint-layers\"]);\n\t\tconst candidate = integrated.candidate!;\n\t\tconst policy = { ...DEFAULT_POLICY, project_controls: [LAYERS], acceptance_recipe: RECIPE };\n\t\tassert.equal(evaluateG5(integrated, protocol, candidate, policy).verdict, \"PASS\");\n\t\t// The controls frozen with the protocol stay those G5 requires, whatever the policy declares afterwards: one\n\t\t// declared after the freeze is not required, one dropped after it still is.\n\t\tconst LINT = declared.find((c) => c.control_id === \"lint-code\")!;\n\t\tconst added = { ...policy, project_controls: [LAYERS, LINT] };\n\t\tassert.equal(evaluateG5(integrated, protocol, candidate, added).verdict, \"PASS\", \"a control added later\");\n\t\tconst unrunLayers = integrated.evidence.filter((e) => e.control_id !== \"lint-layers\");\n\t\tconst dropped = evaluateG5({ ...integrated, evidence: unrunLayers }, protocol, candidate, {\n\t\t\t...policy,\n\t\t\tproject_controls: [],\n\t\t});\n\t\tassert.ok(dropped.missing.includes(\"project:lint-layers\"), \"a control dropped after the freeze is still required\");\n\n\t\t// A stale proof: the layer control's run on another candidate, or under another controller, stands for nothing.\n\t\tfor (const [why, stale] of [\n\t\t\t[\"other candidate\", { subject_digest: `sha256:${\"1\".repeat(64)}` }],\n\t\t\t[\"other environment\", { environment_digest: `sha256:${\"2\".repeat(64)}` }],\n\t\t] as const) {\n\t\t\tconst evidence = integrated.evidence.map((e) => (e.control_id === \"lint-layers\" ? { ...e, ...stale } : e));\n\t\t\tconst g5 = evaluateG5({ ...integrated, evidence }, protocol, candidate, policy);\n\t\t\tassert.notEqual(g5.verdict, \"PASS\", `a proof of the layer control from an ${why} is stale`);\n\t\t\tassert.ok(g5.missing.includes(\"project:lint-layers\"), g5.missing.join(\", \"));\n\t\t}\n\t});\n});\n"}},"projectRoot":"/private/var/folders/j9/bnfyqnns4tzccm9jnvrxzx100000gn/T/cycle-arbre-AzwQu0","config":{"mutate":["cycle/src/dogfood.ts:7-9","cycle/src/dogfood.ts:21-21","cycle/src/dogfood.ts:25-25","cycle/src/dogfood.ts:38-54","cycle/src/dogfood.ts:62-62","cycle/src/dogfood.ts:86-94","cycle/src/mesures.ts:203-204","cycle/src/pilote-pi.ts:27-27"],"testRunner":"tap","tap":{"testFiles":["test/cycle/process-measurements.test.ts","test/v4-platform/dogfood-controls.test.ts","test/v4-platform/dogfood-process.test.ts"],"nodeArgs":["--test-reporter=tap","-r","{{hookFile}}","{{testFile}}"],"forceBail":true},"coverageAnalysis":"perTest","reporters":["json"],"jsonReporter":{"fileName":"/var/folders/j9/bnfyqnns4tzccm9jnvrxzx100000gn/T/cycle-mutation-OC9xsW/mutation.json"},"inPlace":true,"disableTypeChecks":false,"tempDirName":"/var/folders/j9/bnfyqnns4tzccm9jnvrxzx100000gn/T/cycle-mutation-OC9xsW/stryker-tmp","configFile":"/var/folders/j9/bnfyqnns4tzccm9jnvrxzx100000gn/T/cycle-mutation-OC9xsW/stryker.config.json","allowConsoleColors":true,"checkers":[],"checkerNodeArgs":[],"commandRunner"