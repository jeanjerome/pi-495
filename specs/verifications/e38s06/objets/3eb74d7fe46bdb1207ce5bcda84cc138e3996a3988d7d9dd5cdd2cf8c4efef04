e, r.requirement_id));\n\t\treturn {\n\t\t\trequirement_id: r.requirement_id,\n\t\t\tcategory,\n\t\t\tcontrol_id: controlId,\n\t\t\texpected: r.satisfied_by_reference ? \"passed\" : \"failed_assertion\",\n\t\t\tcases: own,\n\t\t\tqualification: cases === null ? \"unlocatable\" : qualificationOf(category, own),\n\t\t};\n\t});\n}\n\nexport function samePreparationPaths(left: string[], right: string[]): boolean {\n\tconst normal = (paths: string[]) => [...new Set(paths)].sort();\n\treturn JSON.stringify(normal(left)) === JSON.stringify(normal(right));\n}\n","structuredPatch":[{"oldStart":188,"oldLines":8,"newStart":188,"newLines":9,"lines":["   for (const r of requirements) {","     if (!r.mandatory) continue;","     const oracle = oracleOf.get(r.requirement_id);","-    if (oracle?.qualification === \"proved\") continue;","-    const failed = oracle && oracle.qualification !== \"no_case\" ? oracle : refutedOf.get(r.requirement_id);","+    const refutation = refutedOf.get(r.requirement_id);","+    if (oracle?.qualification === \"proved\" && !refutation) continue;","+    const failed = oracle && oracle.qualification !== \"no_case\" && oracle.qualification !== \"proved\" ? oracle : refutation;","     if (failed) {","       undiscriminated.push(r.requirement_id);","       notes.push(oracleNote(failed));"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_01Dp7C9t8dh7qsvUoyktQNkG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
