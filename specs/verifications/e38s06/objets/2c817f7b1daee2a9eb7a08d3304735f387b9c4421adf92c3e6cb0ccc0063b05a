rement: such a record stays readable and proves no requirement.\n    42\t\t */\n    43\t\trequirements?: RequirementOracle[];\n    44\t}\n    45\t\n    46\t/**\n    47\t * What a preparation retains: the files written under its roots, with those among them that existed\n    48\t * on the reference named apart. What it wrote elsewhere — a work log, a script, the feature itself —\n    49\t * is named and left out, never refused: the mandate bounds what is retained, not what a producer\n    50\t * may write to check itself. A deletion or a non-file entry under a root is refused, since nothing\n    51\t * of it can be retained.\n    52\t */\n    53\texport function preparedFilesFrom(\n    54\t\tmanifest: CandidateManifest,\n    55\t\tallowed: string[],\n    56\t): { files: PreparedFile[]; modified_existing: string[]; out_of_scope: string[]; refused: string[] } {\n    57\t\tconst files: PreparedFile[] = [];\n    58\t\tconst modifiedExisting: string[] = [];\n    59\t\tconst out: string[] = [];\n    60\t\tconst refused: string[] = [];\n    61\t\tfor (const e of manifest.entries) {\n    62\t\t\tif (e.baseline_state === \"unchanged\") continue;\n    63\t\t\tconst inScope = allowed.some((a) => e.path.startsWith(a));\n    64\t\t\tif (!inScope) {\n    65\t\t\t\tout.push(e.path);\n    66\t\t\t\tcontinue;\n    67\t\t\t}\n    68\t\t\tif (e.baseline_state === \"deleted\" || e.kind !== \"file\" || !e.content_digest) {\n    69\t\t\t\trefused.push(`${e.path} (${e.baseline_state})`);\n    70\t\t\t\tcontinue;\n    71\t\t\t}\n    72\t\t\tfiles.push({ path: e.path, digest: e.content_digest, size_bytes: e.size });\n    73\t\t\tif (e.baseline_state !== \"added\") modifiedExisting.push(e.path);\n    74\t\t}\n    75\t\treturn { files, modified_existing: modifiedExisting, out_of_scope: out, refused };\n    76\t}\n    77\t\n    78\t/**\n    79\t * Level 1 of the PRE-01 scale: the files of the reference under `testPaths` that its technology names as tests,\n    80\t * which says nothing about them ever running.\n    81\t */\n    82\texport function referenceTestFiles(\n    83\t\treference: ReferenceSnapshot,\n    84\t\ttestPaths: string[],\n    85\t\tisTestFile: (path: string) => boolean,\n    86\t): string[] {\n    87\t\treturn reference.entries\n    88\t\t\t.filter((e) => e.kind === \"file\" && testPaths.some((d) => e.path.startsWith(d)) && isTestFile(e.path))\n    89\t\t\t.map((e) => e.path);\n    90\t}\n    91\t\n    92\t/** What the target's own test command reported when it ran on a copy of the reference. */\n    93\texport interface ReferenceSuiteObservation {\n    94\t\t/** Test cases reported, qualification witnesses included. */\n    95\t\treported: number;\n    96\t\t/** Of those, the ones skipped or left todo: discovered, never executed. */\n    97\t\tskipped: number;\n    98\t\t/** Cases contributed by the witnesses, which exercise the runner and not the project. */\n    99\t\twitnesses: number;\n   100\t}\n   101\t\n   102\texport interface CapabilityInput {\n   103\t\tstack: string;\n   104\t\ttest_files: string[];\n   105\t\trequirements: readonly { requirement_id: string; mandatory: boolean; satisfied_by_reference: boolean }[];\n   106\t\t/** Null until the suite has been run on the reference; the levels above `file_present` stay unknown. */\n   107\t\tsuite: ReferenceSuiteObservation | null;\n   108\t\tprepared: PreparationRecord | null;\n   109\t\t/**\n   110\t\t * The characterizations an earlier preparation for these requirements saw contradicted on the\n   111\t\t * reference: a later preparation that drops the case, or rewrites it to pass, does not give the\n   112\t\t * declaration back its weight.\n   113\t\t */\n   114\t\trefuted?: readonly RequirementOracle[];\n   115\t}\n   116\t\n   117\t/** Some requirement the reference lacks is proved by a case of its own failing there by assertion. */\n   118\texport function provesNewBehaviour(oracles: readonly RequirementOracle[]): boolean {\n   119\t\treturn oracles.some((o) => o.category === \"new_behaviour\" && o.qualification === \"proved\");\n   120\t}\n   121\t\n   122\t/**\n   123\t * PRE-01 — what the controls already on the target can decide, on the four-level scale, and which\n   124\t * mandatory requirements they leave undecided.\n   125\t *\n   126\t * The scale is not cosmetic: every control the protocol may freeze is green on the reference, since\n   127\t * G2 refuses it unless its positive witness passes there. Such a control answers the same whether a\n   128\t * behaviour the reference does not have appears or not, so it can never decide a requirement asking\n   129\t * for that behaviour — only a case of its own that fails on the reference can. A requirement the\n   130\t * reference already honours is the opposite case: a characterization of its own that passes there\n   131\t * decides it, and without one, non-regression does, provided the existing suite actually executes\n   132\t * something, which is what levels 2 and 3 measure. A characterization that fails on the reference\n   133\t * refutes the declaration, which then decides nothing.\n   134\t */\n   135\texport function diagnoseControlCapability(input: CapabilityInput): ControlCapabilityDiagnosis {\n   136\t\tconst discovered = input.suite ? Math.max(0, input.suite.reported - input.suite.witnesses) : null;\n   137\t\tconst executed = discovered === null || input.suite === null ? null : Math.max(0, discovered - input.suite.skipped);\n   138\t\tconst oracles = input.prepared?.requirements ?? null;\n   139\t\tconst discriminant = provesNewBehaviour(oracles ?? []);\n   140\t\tconst level: CapabilityLevel = discriminant\n   141\t\t\t? \"discriminating\"\n   142\t\t\t: (executed ?? 0) > 0\n   143\t\t\t\t? \"executed\"\n   144\t\t\t\t: (discovered ?? 0) > 0\n   145\t\t\t\t\t? \"discoverable\"\n   146\t\t\t\t\t: input.test_files.length > 0\n   147\t\t\t\t\t\t? \"file_present\"\n   148\t\t\t\t\t\t: \"none\";\n   149\t\tconst notes: string[] = [];\n   150\t\tif (input.test_files.length === 0) notes.push(`no test file under the test roots of this ${input.stack} target`);\n   151\t\tif (input.test_files.length > 0 && discovered === 0)\n   152\t\t\tnotes.push(\n   153\t\t\t\t`${input.test_files.length} test file(s) are present but the target's own test command reports no case of its own: ${input.test_files.slice(0, 5).join(\", \")}`,\n   154\t\t\t);\n   155\t\tif ((discovered ?? 0) > 0 && executed === 0)\n   156\t\t\tnotes.push(`${discovered} case(s) are discovered and every one is skipped: the suite executes nothing`);\n   157\t\tif (input.prepared && oracles === null)\n   158\t\t\tnotes.push(\n   159\t\t\t\t`preparation ${input.prepared.preparation_id} was recorded before observations were kept per requirement: it proves no requirement`,\n   160\t\t\t);\n   161\t\tif (discriminant) notes.push(`prepared suite adopted: ${input.prepared!.files.length} file(s)`);\n   162\t\tconst undecided = undecidedRequirements(input.requirements, oracles ?? [], input.refuted ?? [], executed);\n   163\t\treturn {\n   164\t\t\tstack: input.stack,\n   165\t\t\tlevel,\n   166\t\t\ttest_files: input.test_files.length,\n   167\t\t\tdiscovered,\n   168\t\t\texecuted,\n   169\t\t\tundiscriminated_requirements: undecided.undiscriminated,\n   170\t\t\tunobserved_requirements: undecided.unobserved,\n   171\t\t\tnotes: [...notes, ...undecided.notes],\n   172\t\t\t...(oracles ? { oracles } : {}),\n   173\t\t};\n   174\t}\n   175\t\n   176\t/**\n   177\t * The mandatory requirements no control decides, and why. Its own proved oracle decides a requirement,\n   178\t * unless a preparation for these requirements saw its characterization contradicted, which leaves it\n   179\t * without one however a later preparation rewrites the case; so does a failed oracle.\n   180\t * Otherwise a requirement the reference lacks has nothing to detect its absence, and one the reference\n   181\t * honours rests on non-regression, unobserved until the suite has run and undecided when it executes\n   182\t * nothing.\n   183\t */\n   184\tfunction undecidedRequirements(\n   185\t\trequirements: CapabilityInput[\"requirements\"],\n   186\t\toracles: readonly RequirementOracle[],\n   187\t\trefuted: readonly RequirementOracle[],\n   188\t\texecuted: number | null,\n   189\t): { undiscriminated: string[]; unobserved: string[]; notes: string[] } {\n   190\t\tconst oracleOf = new Map(oracles.map((o) => [o.requirement_id, o] as const));\n   191\t\tconst refutedOf = new Map(refuted.map((o) => [o.requirement_id, o] as const));\n   192\t\tconst undiscriminated: string[] = [];\n   193\t\tconst unobserved: string[] = [];\n   194\t\tconst notes: string[] = [];\n   195\t\tfor (const r of requirements) {\n   196\t\t\tif (!r.mandatory) continue;\n   197\t\t\tconst oracle = oracleOf.get(r.requirement_id);\n   198\t\t\tconst failed = failedOracles(oracle, refutedOf.get(r.requirement_id));\n   199\t\t\tif (failed.length > 0) {\n   200\t\t\t\tundiscriminated.push(r.requirement_id);\n   201\t\t\t\tnotes.push(...failed.map(oracleNote));\n   202\t\t\t\tcontinue;\n   203\t\t\t}\n   204\t\t\tif (oracle?.qualification === \"proved\") continue;\n   205\t\t\tif (!r.satisfied_by_reference) {\n   206\t\t\t\tundiscriminated.push(r.requirement_id);\n   207\t\t\t\tnotes.push(\n   208\t\t\t\t\t`${r.requirement_id} asks for behaviour the reference does not have: no control that passes on the reference can detect its absence`,\n   209\t\t\t\t);\n   210\t\t\t\tcontinue;\n   211\t\t\t}\n   212\t\t\tif (executed === null) unobserved.push(r.requirement_id);\n   213\t\t\telse if (executed === 0) {\n   214\t\t\t\tundiscriminated.push(r.requirement_id);\n   215\t\t\t\tnotes.push(`${r.requirement_id} is proved by non-regression, and the reference executes no test of its own`);\n   216\t\t\t}\n   217\t\t}\n   218\t\treturn { undiscriminated, unobserved, notes };\n   219\t}\n   220\t\n   221\t/**\n   222\t * The observations that leave a requirement without an oracle of its own: its latest oracle when that\n   223\t * one found a case and failed, and the contradiction an earlier preparation saw, which no later oracle\n   224\t * erases nor stands in for unless it is a contradiction itself.\n   225\t */\n   226\tfunction failedOracles(\n   227\t\toracle: RequirementOracle | undefined,\n   228\t\trefutation: RequirementOracle | undefined,\n   229\t): RequirementOracle[] {\n   230\t\tconst latest = oracle && oracle.qualification !== \"no_case\" && oracle.qualification !== \"proved\" ? oracle : undefined;\n   231\t\tif (!refutation || latest?.qualification === \"contradicted\") return latest ? [latest] : [];\n   232\t\treturn latest ? [latest, refutation] : [refutation];\n   233\t}\n   234\t\n   235\t/** Why the cases bound to a requirement prove nothing about it, naming them. */\n   236\texport function oracleNote(oracle: RequirementOracle): string {\n   237\t\tconst cases = oracle.cases.map((c) => `\"${c.name}\" ${c.outcome.replace(\"_\", \" \")}`).join(\", \");\n   238\t\tswitch (oracle.qualification) {\n   239\t\t\tcase \"contradicted\":\n   240\t\t\t\treturn oracle.category === \"characterization\"\n   241\t\t\t\t\t? `${oracle.requirement_id} is declared satisfied by the reference, and its characterization contradicts it there: ${cases}`\n   242\t\t\t\t\t: `${oracle.requirement_id} asks for behaviour the reference does not have, and its cases pass there: ${cases}`;\n   243\t\t\tcase \"incident\":\n   244\t\t\t\treturn `${oracle.requirement_id}: its cases fail on the reference without an assertion, which proves nothing about it: ${cases}`;\n   245\t\t\tcase \"unlocatable\":\n   246\t\t\t\treturn `${oracle.requirement_id}: the reader of ${oracle.control_id} names no case, so no case of its own can be told apart from the global count`;\n   247\t\t\tdefault:\n   248\t\t\t\treturn `${oracle.requirement_id}: no case of its own was observed`;\n   249\t\t}\n   250\t}\n   251\t\n   252\t/**\n   253\t * Whether a case names the requirement: its id as a whole word of the case name, whatever its case. A\n   254\t * case is bound by what it says it verifies, never by the file it sits in or by the count it adds to.\n   255\t * A hyphen of the id may be written as an underscore, since a Java method name cannot carry one and\n   256\t * Surefire reports the method name alone.\n   257\t */\n   258\tfunction namesRequirement(caseName: string, requirementId: string): boolean {\n   259\t\tconst id = requirementId.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\").replaceAll(\"-\", \"[-_]\");\n   260\t\treturn new RegExp(`(^|[^A-Za-z0-9])${id}($|[^A-Za-z0-9])`, \"i\").test(caseName);\n   261\t}\n   262\t\n   263\t/**\n   264\t * What the cases of one requirement prove on the reference. A requirement the reference lacks is\n   265\t * proved by a case that fails there by assertion, provided none of its cases fails otherwise; one the\n   266\t * reference is declared to honour is proved when every case of it passes there, and contradicted by a\n   267\t * case that fails by assertion.\n   268\t */\n   269\tfunction qualificationOf(category: RequirementOracle[\"category\"], cases: readonly ObservedCase[]): OracleQualification {\n   270\t\tif (cases.length === 0) return \"no_case\";\n   271\t\tconst failedOtherwise = cases.some((c) => c.outcome === \"failed_otherwise\");\n   272\t\tconst failedAssertion = cases.some((c) => c.outcome === \"failed_assertion\");\n   273\t\tif (category === \"characterization\")\n   274\t\t\treturn failedAssertion ? \"contradicted\" : failedOtherwise ? \"incident\" : \"proved\";\n   275\t\treturn failedOtherwise ? \"incident\" : failedAssertion ? \"proved\" : \"contradicted\";\n   276\t}\n   277\t\n   278\t/**\n   279\t * The oracle of each requirement, from the cases `controlId` reported on the reference. A reader that\n   280\t * names no case (`cases` null) leaves every requirement unlocatable rather than covered by a count.\n   281\t */\n   282\texport function requirementOracles(\n   283\t\trequirements: readonly { requirement_id: string; satisfied_by_reference: boolean }[],\n   284\t\tcontrolId: string,\n   285\t\tcases: readonly ObservedCase[] | null,\n   286\t): RequirementOracle[] {\n   287\t\treturn requirements.map((r) => {\n   288\t\t\tconst category = r.satisfied_by_reference ? \"characterization\" : \"new_behaviour\";\n   289\t\t\tconst own = (cases ?? []).filter((c) => namesRequirement(c.name, r.requirement_id));\n   290\t\t\treturn {\n   291\t\t\t\trequirement_id: r.requirement_id,\n   292\t\t\t\tcategory,\n   293\t\t\t\tcontrol_id: controlId,\n   294\t\t\t\texpected: r.satisfied_by_reference ? \"passed\" : \"failed_assertion\",\n   295\t\t\t\tcases: own,\n   296\t\t\t\tqualification: cases === null ? \"unlocatable\" : qualificationOf(category, own),\n   297\t\t\t};\n   298\t\t});\n   299\t}\n   300\t\n   301\texport function samePreparationPaths(left: string[], right: string[]): boolean {\n   302\t\tconst normal = (paths: string[]) => [...new Set(paths)].sort();\n   303\t\treturn JSON.stringify(normal(left)) === JSON.stringify(normal(right));\n   304\t}","is_error":false}]},"parent_tool_use_id":null,"session_id":"d074524e-8fa1-496a-84b3-73d253c39cd4","uuid":"f3df1e07-2af7-4e68-b4a5-0bbf0653d7a9","timestamp":"2026-10-09T21:16:24.102Z","tool_use_result":{"stdout":"     1\t/**\n     2\t * Preparation of verification means (PF-06 steps 3-5, PRE-01 to PRE-03, SA-008, SA-009):\n     3\t * a `prepare` intervention proposes tests in the target technology; the kernel checks scope,\n     4\t * loadability and discriminance, then adopts (or not) the prepared files. The producer never\n     5\t * adopts its own proposal.\n     6\t */\n     7\timport type { CandidateManifest, ReferenceSnapshot } from \"../contracts/v1/candidate.ts\";\n     8\timport type {\n     9\t\tCapabilityLevel,\n    10\t\tControlCapabilityDiagnosis,\n    11\t\tObservedCase,\n    12\t\tOracleQualification,\n    13\t\tRequirementOracle,\n    14\t} from \"../contracts/v1/protocol.ts\";\n    15\t\n    16