lt: CampaignResult, defect: string): ReducedCase {\n\tif (!result.failed || !result.path || !result.failure)\n\t\tthrow new Error(`the campaign of seed ${result.seed} found no failure to keep`);\n\treturn {\n\t\tformat: TRACE_FORMAT,\n\t\tdefect,\n\t\tseed: result.seed,\n\t\tpath: result.path,\n\t\treplay_path: result.replay_path,\n\t\tversions: versions(),\n\t\tsequence: result.sequence,\n\t\tfailure: result.failure,\n\t};\n}\n\nexport function persistReducedCase(path: string, reduced: ReducedCase): void {\n\twriteFileSync(path, `${JSON.stringify(reduced, null, \"\\t\")}\\n`);\n}\n\nexport function readReducedCase(path: string): ReducedCase {\n\tconst kept = JSON.parse(readFileSync(path, \"utf8\")) as Partial<ReducedCase>;\n\tif (kept.format !== TRACE_FORMAT || typeof kept.seed !== \"number\" || typeof kept.path !== \"string\")\n\t\tthrow new Error(`${path} is not a reduced case of format ${TRACE_FORMAT} with a seed and a path`);\n\treturn kept as ReducedCase;\n}\n{\n\t\"format\": 1,\n\t\"defect\": \"the kernel records a result of an earlier protocol revision\",\n\t\"seed\": 495,\n\t\"path\": \"193:13\",\n\t\"replay_path\": \"ABBFACACA/SF:Vl\",\n\t\"versions\": {\n\t\t\"fast-check\": \"4.10.2\",\n\t\t\"node\": \"v24.21.0\",\n\t\t\"model\": \"sha256:1d9b5cd10424625a1dfdd9fe3dcea05c1527d313a49976ee415d2781d308827d\",\n\t\t\"trace_format\": 1\n\t},\n\t\"sequence\": [\n\t\t\"Launch(k1)\",\n\t\t\"ReviseProtocol\",\n\t\t\"Requalify\",\n\t\t\"StartAttempt\",\n\t\t\"Freeze(same)\",\n\t\t\"Deliver(#0 PASS)\"\n\t],\n\t\"failure\": \"step 7 Deliver(#0 PASS): the kernel observes {\\\"phase\\\":\\\"verifying\\\",\\\"status\\\":\\\"ready\\\",\\\"outcome\\\":\\\"pending\\\",\\\"attempt\\\":2,\\\"evidence\\\":[\\\"k1:PASS\\\"]}, the model {\\\"phase\\\":\\\"verifying\\\",\\\"status\\\":\\\"ready\\\",\\\"outcome\\\":\\\"pending\\\",\\\"attempt\\\":2,\\\"evidence\\\":[]}\"\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_