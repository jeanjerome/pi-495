of SequenceFailure ? error.sequence : [],\n\t\tfailure: error instanceof Error ? error.message : String(error),\n\t};\n}\n\n// --- the reduced cases kept ---------------------------------------------------------------------------------\n\nexport interface ReducedCase {\n\tformat: typeof TRACE_FORMAT;\n\tdefect: string;\n\tseed: number;\n\tpath: string;\n\treplay_path: string | null;\n\tversions: { \"fast-check\": string; node: string; model: string; trace_format: typeof TRACE_FORMAT };\n\tsequence: string[];\n\tfailure: string;\n}\n\nconst MODEL_MANIFEST = \"specs/formal/change-lifecycle/manifest.json\";\n\nfunction versions(): ReducedCase[\"versions\"] {\n\tconst fastCheck = JSON.parse(readFileSync(\"node_modules/fast-check/package.json\", \"utf8\")) as { version: string };\n\tconst manifest = JSON.parse(readFileSync(MODEL_MANIFEST, \"utf8\")) as { files: Record<string, string> };\n\treturn {\n\t\t\"fast-check\": fastCheck.version,\n\t\tnode: process.version,\n\t\tmodel: manifest.files[\"ChangeLifecycle.tla\"] ?? \"unknown\",\n\t\ttrace_format: TRACE_FORMAT,\n\t};\n}\n\n/** What a failure found by a campaign leaves to replay it: seed, reduction path, versions, minimal sequence. */\nexport function reducedCase(result: CampaignResult, defect: string): ReducedCase {\n\tif (!result.failed || !result.path || !result.failure)\n\t\tthrow new Error(`the campaign of seed ${result.seed} found no failure to keep`);\n\treturn {\n\t\tformat: TRACE_FORMAT,\n\t\tdefect,\n\t\tseed: result.seed,\n\t\tpath: result.path,\n\t\treplay_path: result.replay_path,\n\t\tversions: versions(),\n\t\tsequence: result.sequence,\n\t\tfailure: result.failure,\n\t};\n}\n\nexport function persistReducedCase(path: string, reduced: ReducedCase): void {\n\twriteFileSync(path, `${JSON.stringify(reduced, null, \"\\t\")}\\n`);\n}\n\nexport function readReducedCase(path: string): ReducedCase {\n\tconst kept = JSON.parse(readFileSync(path, \"utf8\")) as Partial<ReducedCase>;\n\tif (kept.format !== TRACE_FORMAT || typeof kept.seed !== \"number\" || typeof kept.path !== \"string\")\n\t\tthrow new Error(`${path} is not a reduced case of format ${TRACE_FORMAT} with a seed and a path`);\n\treturn kept as ReducedCase;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"ada6fb1c-7f84-4ebb-b262-35a47390fd3d","uuid":"4aebb210-5e28-4f10-9fea-e4c8edc8a74e","timestamp":"2026-10-09T16:17:03.057Z","tool_use_result":{"stdout":"/**\n * Bounded sequences of the change-lifecycle model's actions, generated by fast-check under the model's own\n * preconditions and replayed on the kernel, which must follow the model and keep its properties after each\n * step. A random campaign samples the sequences; it claims no exhaustivity, which is TLC's.\n */\nimport { strict as assert } from \"node:assert\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { decide } from \"../../src/domain/change/decide.ts\";\nimport {\n\tpersistReducedCase,\n\treadReducedCase,\n\treducedCase,\n\trunCampaign,\n\tsampleActions,\n} from \"../support/change-commands.ts\";\nimport type { Decider } from \"../support/kernel-replay.ts\";\nimport { removedAfterEach, tempDir } from \"../helpers/fixtures.ts\";\n\nconst cleanups = removedAfterEach();\n\n/** The injected defect: the kernel records a result whatever protocol revision it ran under. */\nconst revisionGuardDropped: Decider = (state, command, policy) => {\n\tconst frozen = state?.protocol?.ref.revision;\n\tif (command.type !== \"verification.record\" || frozen === undefined) return decide(state, command, policy);\n\tconst evidence = command.evidence.map((e) => ({ ...e, protocol_revision: frozen }));\n\treturn decide(state, { ...command, evidence }, policy);\n};\n\nconst installedFastCheck = (\n\tJSON.parse(readFileSync(\"node_modules/fast-check/package.json\", \"utf8\")) as { version: string }\n).version;\nconst modelDigest = (\n\tJSON.parse(readFileSync(\"specs/formal/c