{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J6HP2FQ1pYLVT61Heshvpp","type":"tool_result","content":"/**\n * Bounded sequences of the change-lifecycle model's actions, generated by fast-check under the model's own\n * preconditions and replayed on the kernel, which must follow the model and keep its properties after each\n * step. A random campaign samples the sequences; it claims no exhaustivity, which is TLC's.\n */\nimport { strict as assert } from \"node:assert\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { describe, it } from \"node:test\";\nimport { decide } from \"../../src/domain/change/decide.ts\";\nimport {\n\tpersistReducedCase,\n\treadReducedCase,\n\treducedCase,\n\trunCampaign,\n\tsampleActions,\n} from \"../support/change-commands.ts\";\nimport type { Decider } from \"../support/kernel-replay.ts\";\nimport { removedAfterEach, tempDir } from \"../helpers/fixtures.ts\";\n\nconst cleanups = removedAfterEach();\n\n/** The injected defect: the kernel records a result whatever protocol revision it ran under. */\nconst revisionGuardDropped: Decider = (state, command, policy) => {\n\tconst frozen = state?.protocol?.ref.revision;\n\tif (command.type !== \"verification.record\" || frozen === undefined) return decide(state, command, policy);\n\tconst evidence = command.evidence.map((e) => ({ ...e, protocol_revision: frozen }));\n\treturn decide(state, { ...command, evidence }, policy);\n};\n\nconst installedFastCheck = (\n\tJSON.parse(readFileSync(\"node_modules/fast-check/package.json\", \"utf8\")) as { version: string }\n).version;\nconst modelDigest = (\n\tJSON.parse(readFileSync(\"specs/formal/change-lifecycle/manifest.json\", \"utf8\")) as { files: Record<string, string> }\n).files[\"ChangeLifecycle.tla\"];\n\ndescribe(\"generated change-lifecycle sequences on the kernel\", () => {\n\tit(\"une graine rejouée produit les mêmes actions et un défaut injecté est réduit en séquence conservée\", () => {\n\t\tconst first = sampleActions(495, 20);\n\t\tassert.ok(\n\t\t\tfirst.some((actions) => actions.length > 0),\n\t\t\t\"a seed yields generated actions\",\n\t\t);\n\t\tassert.deepEqual(sampleActions(495, 20), first, \"a seed replayed yields the same actions\");\n\n\t\tconst found = runCampaign({ seed: 495, numRuns: 300, decide: revisionGuardDropped });\n\t\tassert.equal(found.failed, true, \"the injected defect is found\");\n\t\tconst path = join(tempDir(\"495-reduced-\", cleanups), \"reduced.json\");\n\t\tpersistReducedCase(path, reducedCase(found, \"the kernel records a result of an earlier protocol revision\"));\n\t\tconst kept = readReducedCase(path);\n\t\tassert.equal(kept.seed, 495);\n\t\tassert.match(kept.path, /^\\d+(:\\d+)+$/, \"the path kept runs from the failing run through its reductions\");\n\t\tassert.deepEqual(kept.versions, {\n\t\t\t\"fast-check\": installedFastCheck,\n\t\t\tnode: process.version,\n\t\t\tmodel: modelDigest,\n\t\t\ttrace_format: 1,\n\t\t});\n\t\tassert.ok(kept.sequence.length > 0 && kept.sequence.length <= 8, `a minimal sequence: ${kept.sequence.join(\", \")}`);\n\t\tassert.match(kept.sequence.at(-1) ?? \"\", /^Deliver/, \"the sequence ends on the result the defect records\");\n\t\tassert.match(kept.failure, /step \\d+ Deliver/);\n\n\t\tconst replay = { seed: kept.seed, path: kept.path, replayPath: kept.replay_path, decide: revisionGuardDropped };\n\t\tconst replayed = runCampaign({ ...replay, reduce: false });\n\t\tassert.deepEqual(\n\t\t\treplayed.sequence,\n\t\t\tkept.sequence,\n\t\t\t\"the kept seed and path replay the reduced sequence as it stands\",\n\t\t);\n\t\tassert.equal(runCampaign(replay).path, kept.path, \"fast-check reduces the kept sequence no further: it is minimal\");\n\t});\n\n\tit(\"the archived reduced case replays to its kept sequence with the defect, and passes on the kernel\", () => {\n\t\tconst kept = readReducedCase(\"test/fixtures/formal-traces/reduced/revision-guard-dropped.json\");\n\t\tconst replay = { seed: kept.seed, path: kept.path, replayPath: kept.replay_path, reduce: false };\n\t\tconst replayed = runCampaign({ ...replay, decide: revisionGuardDropped });\n\t\tassert.deepEqual(\n\t\t\treplayed.sequence,\n\t\t\tkept.sequence,\n\t\t\t`fast-check ${installedFastCheck} replays the case kept under fast-check ${kept.versions[\"fast-check\"]}`,\n\t\t);\n\t\tassert.equal(replayed.failure, kept.failure);\n\t\tassert.equal(runCampaign(replay).failed, false, \"the kernel itself keeps the guard the defect drops\");\n\t});\n\n\tit(\"the kernel follows the model and keeps its properties along 3000 generated sequences\", () => {\n\t\tconst result = runCampaign({ seed: 4950, numRuns: 3000 });\n\t\tconst kept = result.failed ? reducedCase(result, \"the kernel departs from the model\") : null;\n\t\tassert.equal(result.failed, false, `the reduced case to keep: ${JSON.stringify(kept, null, \"\\t\")}`);\n\t});\n});\n\tfc.constant(new Resume()),\n];\n\nfunction lifecycleSequences(replayPath: string | null) {\n\treturn fc.tuple(\n\t\tfc.boolean(),\n\t\tfc.commands(ARBITRARY_COMMANDS, {\n\t\t\tmaxCommands: MAX_COMMANDS,\n\t\t\tsize: \"max\",\n\t\t\t...(replayPath ? { replayPath } : {}),\n\t\t}),\n\t);\n}\n\n// --- the campaign ------------------------------------------------------------------------------------------\n\n/** The failure of one generated sequence, carrying the actions it executed up to the failing one. */\nclass SequenceFailure extends Error {\n\treadonly sequence: string[];\n\tconstructor(cause: unknown, sequence: string[]) {\n\t\tsuper(cause instanceof Error ? cause.message : String(cause), { cause });\n\t\tthis.sequence = sequence;\n\t}\n}\n\nexport interface CampaignOptions {\n\tseed: number;\n\tnumRuns?: number;\n\t/** The reduction path of a failure, which replays it with `seed`. */\n\tpath?: string;\n\t/** The commands' own replay path, which fast-check's command shrinker needs beside `path`. */\n\treplayPath?: string | null;\n\t/** Whether a failure