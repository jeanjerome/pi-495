ctive(c, statement, (await keptBy(ctx, unit, c)) !== null);\n   144\t\tconst workspacePath = ctx.workspace.workspacePath(unit.state.candidate!.workspace_id);\n   145\t\tfor (;;) {\n   146\t\t\tconst r = await ctx.runIntervention(unit, cor, \"review\", objective, workspacePath, {\n   147\t\t\t\tadopted: [\"mandate\", \"requirements\", \"protocol\"],\n   148\t\t\t\toutput_schema: \"contestation-finding\",\n   149\t\t\t});\n   150\t\t\tunit = r.unit;\n   151\t\t\tif (unit.state.status === \"blocked\") return unit;\n   152\t\t\tif (r.result === \"completed\" && r.output_valid && Value.Check(OUTPUT_SCHEMAS[\"contestation-finding\"], r.output)) {\n   153\t\t\t\tconst report = r.output as ContestationFindingReport;\n   154\t\t\t\treturn ctx.commit(\n   155\t\t\t\t\tunit,\n   156\t\t\t\t\t{\n   157\t\t\t\t\t\ttype: \"contestation.conclude\",\n   158\t\t\t\t\t\tat: ctx.now(),\n   159\t\t\t\t\t\tactor: KERNEL_ACTOR,\n   160\t\t\t\t\t\tcontestation_id: c.contestation_id,\n   161\t\t\t\t\t\tfinding: report.finding,\n   162\t\t\t\t\t\texaminer_id: r.intervention_id,\n   163\t\t\t\t\t\treasons: report.reasons,\n   164\t\t\t\t\t},\n   165\t\t\t\t\tcor,\n   166\t\t\t\t);\n   167\t\t\t}\n   168\t\t\tunit = ctx.commit(\n   169\t\t\t\tunit,\n   170\t\t\t\t{\n   171\t\t\t\t\ttype: \"operation.fail\",\n   172\t\t\t\t\tat: ctx.now(),\n   173\t\t\t\t\tactor: KERNEL_ACTOR,\n   174\t\t\t\t\toperation_key: `examination of contestation ${c.contestation_id}`,\n   175\t\t\t\t},\n   176\t\t\t\tcor,\n   177\t\t\t);\n   178\t\t\tif (unit.state.status === \"blocked\") return unit;\n   179\t\t}\n   180\t}\n   181\t\n   182\t/** Files what the producer contested of the frozen tests and examines what is still open on the frozen candidate. */\n   183\texport async function examineContestations(ctx: PhaseContext, unit: Unit, cor: string): Promise<ContestationOutcome> {\n   184\t\tunit = await fileReported(ctx, unit, cor);\n   185\t\tfor (const c of onCandidate(unit.state).filter((x) => x.finding === nul