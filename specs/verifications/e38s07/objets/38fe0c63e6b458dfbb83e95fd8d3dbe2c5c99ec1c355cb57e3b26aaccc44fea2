{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PGMxHPUwuEhEzrUsPMxEBn","type":"tool_result","content":"     1\t/**\n     2\t * Examining a contested frozen case: once G5 refused a candidate, what the producer contested of the\n     3\t * frozen tests is filed by the kernel and examined by an intervention distinct from the producer, which\n     4\t * reads and writes nothing it could change. The examiner says what it found; the kernel takes the step\n     5\t * that follows. An examination that never concludes is bounded by the retry budget, and the change then\n     6\t * stops naming the contestation it could not settle. A case found wrong has the preparation written again,\n     7\t * qualified and frozen anew; a case that holds the requirement as adopted puts the requirement to the owner,\n     8\t * who alone says whether the need changes; a contestation found unfounded leaves the code to correct. A case\n     9\t * the owner kept is never rewritten on the examiner's word: its examiner is told the owner's answer, and a\n    10\t * finding that the case is wrong goes back to the owner.\n    11\t */\n    12\timport { Value } from \"typebox/value\";\n    13\timport { digestValue } from \"../../contracts/digest.ts\";\n    14\timport type { SubjectRef } from \"../../contracts/v1/common.ts\";\n    15\timport type { RequirementsDocument } from \"../../contracts/v1/protocol.ts\";\n    16\timport { type ContestationFindingReport, OUTPUT_SCHEMAS, type ProducerReport } from \"../../contracts/v1/reports.ts\";\n    17\timport {\n    18\t\tcurrentAttempt,\n    19\t\tranUnderProtocol,\n    20\t\ttype ChangeState,\n    21\t\ttype ContestationEntry,\n    22\t\ttype ContestationFacts,\n    23\t\ttype HumanDecisionEntry,\n    24\t} from \"../../domain/change/state.ts\";\n    25\timport { DomainError } from \"../../domain/errors.ts\";\n    26\timport { KERNEL_ACTOR } from \"../actors.ts\";\n    27\timport { contestationObjective } from \"../context.ts\";\n    28\timport type { PhaseContext, Unit } from \"./phase.ts\";\n    29\timport { reviseRequirements } from \"./requirements-revision.ts\";\n    30\t\n    31\t/** What the producer contested, kept beside the candidate its intervention left. */\n    32\tinterface ProducerContestations {\n    33\t\tintervention_id: string;\n    34\t\tcontestations: NonNullable<ProducerReport[\"contestations\"]>;\n    35\t}\n    36\t\n    37\t/** The name under which the contestations a producer intervention reported are kept. */\n    38\tfunction producerContestationsId(interventionId: string): string {\n    39\t\treturn `contested_${interventionId}`;\n    40\t}\n    41\t\n    42\t/** Keeps what the producer contested of the frozen tests, to be filed once G5 has judged its candidate. */\n    43\texport async function keepProducerContestations(\n    44\t\tctx: PhaseContext,\n    45\t\tchangeId: string,\n    46\t\tinterventionId: string,\n    47\t\treport: ProducerReport | null,\n    48\t): Promise<void> {\n    49\t\tif (!report?.contestations?.length) return;\n    50\t\tawait ctx.artifacts.store(\n    51\t\t\t\"candidate\",\n    52\t\t\tchangeId,\n    53\t\t\tproducerContestationsId(interventionId),\n    54\t\t\t{ intervention_id: interventionId, contestations: report.contestations },\n    55\t\t\tinterventionId,\n    56\t\t);\n    57\t}\n    58\t\n    59\t/** What the examination of the contestations on the frozen candidate came to. */\n    60\ttype ContestationOutcome =\n    61\t\t| { kind: \"examined\"; unit: Unit; concluded: ContestationEntry[] }\n    62\t\t| { kind: \"stopped\"; unit: Unit };\n    63\t\n    64\t/**\n    65\t * The contestations filed on the frozen candidate under the frozen protocol. A revised preparation can yield the\n    66\t * same candidate again: what was found under the protocol it replaced no longer steers the change.\n    67\t */\n    68\tfunction onCandidate(state: ChangeState): ContestationEntry[] {\n    69\t\tconst digest = state.candidate?.manifest_