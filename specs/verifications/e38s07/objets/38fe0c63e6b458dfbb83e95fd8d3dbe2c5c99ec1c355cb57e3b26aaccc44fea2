ntestations: NonNullable<ProducerReport[\"contestations\"]>;\n    35\t}\n    36\t\n    37\t/** The name under which the contestations a producer intervention reported are kept. */\n    38\tfunction producerContestationsId(interventionId: string): string {\n    39\t\treturn `contested_${interventionId}`;\n    40\t}\n    41\t\n    42\t/** Keeps what the producer contested of the frozen tests, to be filed once G5 has judged its candidate. */\n    43\texport async function keepProducerContestations(\n    44\t\tctx: PhaseContext,\n    45\t\tchangeId: string,\n    46\t\tinterventionId: string,\n    47\t\treport: ProducerReport | null,\n    48\t): Promise<void> {\n    49\t\tif (!report?.contestations?.length) return;\n    50\t\tawait ctx.artifacts.store(\n    51\t\t\t\"candidate\",\n    52\t\t\tchangeId,\n    53\t\t\tproducerContestationsId(interventionId),\n    54\t\t\t{ intervention_id: interventionId, contestations: report.contestations },\n    55\t\t\tinterventionId,\n    56\t\t);\n    57\t}\n    58\t\n    59\t/** What the examination of the contestations on the frozen candidate came to. */\n    60\ttype ContestationOutcome =\n    61\t\t| { kind: \"examined\"; unit: Unit; concluded: ContestationEntry[] }\n    62\t\t| { kind: \"stopped\"; unit: Unit };\n    63\t\n    64\t/**\n    65\t * The contestations filed on the frozen candidate under the frozen protocol. A revised preparation can yield the\n    66\t * same candidate again: what was found under the protocol it replaced no longer steers the change.\n    67\t */\n    68\tfunction onCandidate(state: ChangeState): ContestationEntry[] {\n    69\t\tconst digest = state.candidate?.manifest_digest;\n    70\t\tconst frozen = state.protocol?.ref;\n    71\t\treturn (state.contestations ?? []).filter(\n    72\t\t\t(c) =>\n    73\t\t\t\tc.candidate_digest === digest &&\n    74\t\t\t\tc.protocol.protocol_id === frozen?.protocol_id &&\n    75\t\t\t\tc.protocol.revision === frozen.revision,\n    76\t\t);\n    77\t}\n    78\t\n    79\t/** The run of the frozen control judging the requirement in which the contested case failed on the candidate. */\n    80\tfunction reproductionOf(\n    81\t\tstate: ChangeState,\n    82\t\trequirementId: string,\n    83\t\tcaseName: string,\n    84\t): ContestationFacts[\"reproduction\"] {\n    85\t\tconst obligation = state.protocol?.obligations.find((o) => o.requirement.requirement_id === requirementId);\n    86\t\tconst run = state.evidence.findLast(\n    87\t\t\t(e) =>\n    88\t\t\t\te.valid &&\n    89\t\t\t\te.verdict === \"FAIL\" &&\n    90\t\t\t\te.subject_digest === state.candidate?.manifest_digest &&\n    91\t\t\t\tstate.protocol !== null &&\n    92\t\t\t\tranUnderProtocol(e, state.protocol.ref) &&\n    93\t\t\t\t(obligation?.control_ids.includes(e.control_id) ?? false) &&\n    94\t\t\t\t!(e.passed_cases ?? []).includes(caseName),\n    95\t\t);\n    96\t\treturn { control_id: run?.control_id ?? \"\", evidence_id: run?.evidence_id ?? \"\" };\n    97\t}\n    98\t\n    99\t/**\n   100\t * Files what the producer of the attempt contested, once per candidate. The kernel refuses a\n   101\t * contestation that names a wrong identity or no failing run; it is reported and examined no further.\n   102\t */\n   103\tasync function fileReported(ctx: PhaseContext, unit: Unit, cor: string): Promise<Unit> {\n   104\t\tconst state = unit.state;\n   105\t\tconst attempt = currentAttempt(state);\n   106\t\tconst producer = state.interventions.findLast((i) => i.role === \"implement\" && i.attempt_id === attempt?.attempt_id);\n   107\t\tif (!producer || !state.protocol || !state.candidate || onCandidate(state).length > 0) return unit;\n   108\t\tconst reported = await ctx.artifacts\n   109\t\t\t.read<ProducerContestations>({ artifact_id: producerContestationsId(producer.intervention_id), revision: 1 })\n   110\t\t\t// A producer that contested nothing left nothing to read.\n   111\t\t\t.catch(() => null);\n   112\t\tfor (const item of reported?.contestations ?? []) {\n  