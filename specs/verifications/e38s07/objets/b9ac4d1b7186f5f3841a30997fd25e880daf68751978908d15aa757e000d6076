nit, cor);\n   186\t\tfor (const c of onCandidate(unit.state).filter((x) => x.finding === null)) {\n   187\t\t\tunit = await examine(ctx, unit, cor, c);\n   188\t\t\tif (unit.state.status === \"blocked\") return { kind: \"stopped\", unit };\n   189\t\t}\n   190\t\treturn { kind: \"examined\", unit, concluded: onCandidate(unit.state) };\n   191\t}\n   192\t\n   193\t/** What the producer is told of a contestation the examination rejected: the case stands, the code is to change. */\n   194\tfunction unfoundedNote(c: ContestationEntry): string {\n   195\t\treturn `contestation ${c.contestation_id} of \"${c.case_name}\" found unfounded: ${c.reasons}; the frozen protocol stands and the code must be corrected`;\n   196\t}\n   197\t\n   198\t/** What the producer is told once the owner kept the requirement the contested case asserts. */\n   199\tfunction keptNote(c: ContestationEntry): string {\n   200\t\treturn `the owner kept ${c.requirement_id} as adopted: the frozen case \"${c.case_name}\" stands and the code must be corrected`;\n   201\t}\n   202\t\n   203\t/**\n   204\t * What a preparation written again is told of a case the examination found wrong, while that case is still frozen.\n   205\t * A case the owner kept is not among them: the owner kept it against that finding.\n   206\t */\n   207\texport async function foundWrongNotes(ctx: PhaseContext, unit: Unit): Promise<string[]> {\n   208\t\tconst notes: string[] = [];\n   209\t\tfor (const c of unit.state.contestations ?? []) {\n   210\t\t\tif (c.finding !== \"test_correction\" || c.protocol.protocol_id !== unit.state.protocol?.ref.protocol_id) continue;\n   211\t\t\tif ((await keptBy(ctx, unit, c)) !== null) continue;\n   212\t\t\tnotes.push(\n   213\t\t\t\t`The frozen case \"${c.case_name}\" of ${c.requirement_id} was examined and found wrong: ${c.reasons}. Write it again so that it asserts what ${c.requirement_id} says.`,\n   214\t\t\t);\n   215\t\t}\n   216\t\treturn notes;\n   217\t}\n   218\t\n   219\t/** T