{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019iKcxj5PJZtqwf2yg1jEj8","type":"tool_result","content":"     1\t/**\n     2\t * Examining a contested frozen case: once G5 refused a candidate, what the producer contested of the\n     3\t * frozen tests is filed by the kernel and examined by an intervention distinct from the producer, which\n     4\t * reads and writes nothing it could change. The examiner says what it found; the kernel takes the step\n     5\t * that follows. An examination that never concludes is bounded by the retry budget, and the change then\n     6\t * stops naming the contestation it could not settle. A case found wrong has the preparation written again,\n     7\t * qualified and frozen anew; a case that holds the requirement as adopted puts the requirement to the owner,\n     8\t * who alone says whether the need changes; a contestation found unfounded leaves the code to correct. A case\n     9\t * the owner kept is never rewritten on the examiner's word, whatever protocol froze it since: its examiner is\n    10\t * told the owner's answer, a finding that the case is wrong goes back to the owner before the preparation is\n    11\t * revised for any other case, and a preparation written again is not told to rewrite it.\n    12\t */\n    13\timport { Value } from \"typebox/value\";\n    14\timport { digestValue } from \"../../contracts/digest.ts\";\n    15\timport type { SubjectRef } from \"../../contracts/v1/common.ts\";\n    16\timport type { RequirementsDocument } from \"../../contracts/v1/protocol.ts\";\n    17\timport { OUTPUT_SCHEMAS, type ProducerReport } from \"../../contracts/v1/reports.ts\";\n    18\timport {\n    19\t\tcurrentAttempt,\n    20\t\tranUnderProtocol,\n    21\t\ttype ChangeState,\n    22\t\ttype ContestationEntry,\n    23\t\ttype ContestationFacts,\n    24\t\ttype HumanDecisionEntry,\n    25\t} from \"../../domain/change/state.ts\";\n    26\timport { DomainError } from \"../../domain/errors.ts\";\n    27\timport { KERNEL_ACTOR } from \"../actors.ts\";\n    28\timport { contestationObjective } from \"../context.ts\";\n    29\timport type { PhaseContext, Unit } from \"./phase.ts\";\n    30\timport { reviseRequirements } from \"./requirements-revision.ts\";\n    31\t\n    32\t/** What the producer contested, kept beside the candidate its intervention left. */\n    33\tinterface ProducerContestations {\n    34\t\tintervention_id: string;\n    35\t\tcontestations: NonNullable<ProducerReport[\"contestations\"]>;\n    36\t}\n    37\t\n    38\t/** The name under which the contestations a producer intervention reported are kept. */\n    39\tfunction producerContestationsId(interventionId: string): string {\n    40\t\treturn `contested_${interventionId}`;\n    41\t}\n    42\t\n    43\t/** Keeps what the producer contested of the frozen tests, to be filed once G5 has judged its candidate. */\n    44\texport async function keepProducerContestations(\n    45\t\tctx: PhaseContext,\n    46\t\tchangeId: string,\n    47\t\tinterventionId: string,\n    48\t\treport: ProducerReport | null,\n    49\t): Promise<void> {\n    50\t\tif (!report?.contestations?.length) return;\n    51\t\tawait ctx.artifacts.store(\n    52\t\t\t\"candidate\",\n    53\t\t\tchangeId,\n    54\t\t\tproducerContestationsId(interventionId),\n    55\t\t\t{ intervention_id: interventionId, contestations: report.contestations },\n    56\t\t\tinterventionId,\n    57\t\t);\n    58\t}\n    59\t\n    60\t/** What the examination of the contestations on the frozen candidate came to. */\n    61\ttype ContestationOutcome =\n    62\t\t| { kind: \"examined\"; unit: Unit; concluded: ContestationEntry[] }\n    63\t\t| { kind: \"stopped\"; unit: Unit };\n    64\t\n    65\t/**\n    66\t * The contestations filed on the frozen candidate under the frozen protocol. A revised preparation can yield the\n    67\t * same candidate again: what was found under the protocol it replaced no longer steers the change.\n    68\t */\n    69\tfunction onCandidate(state: ChangeState): ContestationEntry[] {\n    70\t\tconst digest = state.candidate?.manifest_digest;\n    71\t\tconst frozen = state.protocol?.ref;\n    72\t\treturn (state.contestations ?? []).filter(\n    73\t\t\t(c) =>\n    74\t\t\t\tc.candidate_digest === digest &&\n    75\t\t\t\tc.protocol.protocol_id === frozen?.protocol_id &&\n    76\t\t\t\tc.protocol.revision === frozen.revision,\n    77\t\t);\n    78\t}\n    79\t\n    80\t/** The run of the frozen control judging the requirement in which the contested case failed on the candidate. */\n    81\tfunction reproductionOf(\n    82\t\tstate: ChangeState,\n    83\t\trequirementId: string,\n    84\t\tcaseName: string,\n    85\t): ContestationFacts[\"reproduction\"] {\n    86\t\tconst obligation = state.protocol?.obligations.find((o) => o.requirement.requirement_id === requirementId);\n    87\t\tconst run = state.evidence.findLast(\n    88\t\t\t(e) =>\n    89\t\t\t\te.valid &&\n    90\t\t\t\te.verdict === \"FAIL\" &&\n    91\t\t\t\te.subject_digest === state.candidate?.manifest_digest &&\n    92\t\t\t\tstate.protocol !== null &&\n    93\t\t\t\tranUnderProtocol(e, state.protocol.ref) &&\n    94\t\t\t\t(obligation?.control_ids.includes(e.control_id) ?? false) &&\n    95\t\t\t\t!(e.passed_cases ?? []).includes(caseName),\n    96\t\t);\n    97\t\treturn { control_id: run?.control_id ?? \"\", evidence_id: run?.evidence_id ?? \"\" };\n    98\t}\n    99\t\n   100\t/**\n   101\t * Files what the producer of the attempt contested, once per candidate. The kernel refuses a\n   102\t * contestation that names a wrong identity or no failing run; it is reported and examined no further.\n   103\t */\n   104\tasync function fileReported(ctx: PhaseContext, unit: Unit, cor: string): Promise<Unit> {\n   105\t\tconst state = unit.state;\n   106\t\tconst attempt = currentAttempt(state);\n   107\t\tconst producer = state.interventions.findLast((i) => i.role === \"implement\" && i.attempt_id === attempt?.attemp