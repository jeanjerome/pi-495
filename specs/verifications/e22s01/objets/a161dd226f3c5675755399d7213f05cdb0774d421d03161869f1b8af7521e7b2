{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FRFrdbPaH2JF6MojfeUkDS","type":"tool_result","content":"1:/**\n2: * Engineering report (IMP-05): the three natures of what a change produced, kept apart because\n3: * they do not have the same authority. A mechanical observation is what an executed control\n4: * measured on an identified subject. A judgment is what someone or something concluded from it —\n5: * the kernel at a gate, a model in a review, a human in a decision. A residual risk is what\n6: * nothing here establishes: a control that passed observed what it knows how to observe, and that\n7: * is not the absence of a defect.\n8: *\n9: * The report is derived from the ledger alone, so it reads without a model and without Pi.\n10: */\n11:import type { Outcome, Verdict } from \"../contracts/v1/common.ts\";\n12:import type { Evidence } from \"../contracts/v1/evidence.ts\";\n13:import type { Protocol, RequirementsDocument } from \"../contracts/v1/protocol.ts\";\n14:import type { ChangeState, EvidenceEntry } from \"../domain/change/state.ts\";\n15:\n16:/** Measured: a control ran on a subject and answered. No interpretation is carried here. */\n17:export interface MechanicalObservation {\n18:\tevidence_id: string;\n19:\tcontrol_id: string;\n20:\tcontrol_version: string;\n21:\t/** `candidate`, `reference` or `fixture` — what the control was pointed at. */\n22:\tsubject_kind: string;\n23:\tsubject_digest: string;\n24:\tverdict: Verdict;\n25:\tblocking_findings: number;\n26:\t/** The control answered, but its answer is no longer usable for this change. */\n27:\tvalid: boolean;\n28:}\n29:\n30:/** Concluded: by whom, with what authority, and whether the outcome depended on it. */\n31:export interface Judgment {\n32:\tkind: \"gate\" | \"review\" | \"human_decision\";\n33:\tid: string;\n34:\tby: string;\n35:\tauthority: \"kernel\" | \"model\" | \"human\";\n36:\tstatement: string;\n37:\t/** A judgment the outcome rests on, as opposed to one recorded for the reader. */\n38:\tbinding: boolean;\n39:}\n40:\n41:/** Not established: named so a green report is not read as a proof. */\n42:export interface ResidualRisk {\n43:\tcode: string;\n44:\tstatement: string;\n45:}\n46:\n47:/** Asked: an adopted requirement, and what the controls covering it answered on the candidate. */\n48:export interface RequirementLine {\n49:\trequirement_id: string;\n50:\tstatement: string;\n51:\tmandatory: boolean;\n52:\tcontrols: { control_id: string; verdict: EvidenceEntry[\"verdict\"] }[];\n53:}\n54:\n55:export interface EngineeringReport {\n56:\tschema_version: 1;\n57:\tchange_id: string;\n58:\toutcome: Outcome;\n59:\tcandidate: { candidate_id: string; manifest_digest: string } | null;\n60:\trequirements: RequirementLine[];\n61:\tobservations: MechanicalObservation[];\n62:\tjudgments: Judgment[];\n63:\tresidual_risks: ResidualRisk[];\n64:}\n65:\n66:function reviewStatement(conclusion: string, blocking: number, valid: boolean): string {\n67:\tconst base = `review concluded ${conclusion}${blocking > 0 ? ` with ${blocking} blocking finding(s)` : \"\"}`;\n68:\treturn valid ? base : `${base} (invalidated)`;\n69:}\n70:\n71:export function engineeringReport(\n72:\tstate: ChangeState,\n73:\tevidence: readonly Evidence[],\n74:\tprotocol: Protocol | null,\n75:\trequirements: RequirementsDocument | null = null,\n76:): EngineeringReport {\n77:\tconst entryOf = new Map(state.evidence.map((e) => [e.evidence_id, e]));\n78:\tconst onCandidateEntries = state.evidence.filter(\n79:\t\t(e) => e.valid && state.candidate !== null && e.subject_digest === state.candidate.manifest_digest,\n80:\t);\n81:\tconst asked: RequirementLine[] = (requirements?.requirements ?? []).map((q) => ({\n82:\t\trequirement_id: q.requirement_id,\n83:\t\tstatement: q.statement,\n84:\t\tmandatory: q.mandatory,\n85:\t\tcontrols: onCandidateEntries\n86:\t\t\t.filter((e) => e.requirement_ids.includes(q.requirement_id))\n87:\t\t\t.map((e) => ({ control_id: e.control_id, verdict: e.verdict })),\n88:\t}));\n89:\tconst observations: MechanicalObservation[] = evidence.map((e) => ({\n90:\t\tevidence_id: e.evidence_id,\n91:\t\tcontrol_id: e.control_id,\n92:\t\tcontrol_version: e.control_version,\n93:\t\tsubject_kind: e.subject.kind,\n94:\t\tsubject_digest: e.subject.digest,\n95:\t\tverdict: e.verdict,\n96:\t\tblocking_findings: e.baseline?.blocking_findings ?? e.findings.filter((f) => f.severity === \"blocker\").length,\n97:\t\tvalid: entryOf.get(e.evidence_id)?.valid ?? true,\n98:\t}));\n99:\n100:\tconst judgments: Judgment[] = [];\n101:\tfor (const gate of Object.values(state.gates)) {\n102:\t\tjudgments.push({\n103:\t\t\tkind: \"gate\",\n104:\t\t\tid: gate.gate,\n105:\t\t\tby: \"495 kernel\",\n106:\t\t\tauthority: \"kernel\",\n107:\t\t\tstatement: `${gate.gate} ${gate.verdict}${gate.reasons.length ? `: ${gate.reasons.join(\"; \")}` : \"\"}`,\n108:\t\t\tbinding: true,\n109:\t\t});\n110:\t}\n111:\tfor (const review of state.reviews) {\n112:\t\t// A review is produced by a model reading the candidate. Required or not, it is an opinion on\n113:\t\t// a text, never a measurement; only its blocking findings bear on the outcome.\n114:\t\tjudgments.push({\n115:\t\t\tkind: \"review\",\n116:\t\t\tid: review.review_id,\n117:\t\t\tby: review.reviewer_role,\n118:\t\t\tauthority: \"model\",\n119:\t\t\tstatement: reviewStatement(review.conclusion, review.blocking_findings, review.valid),\n120:\t\t\tbinding: review.valid && review.blocking_findings > 0,\n121:\t\t});\n122:\t}\n123:\tfor (const decision of state.human_decisions) {\n124:\t\tjudgments.push({\n125:\t\t\tkind: \"human_decision\",\n126:\t\t\tid: decision.human_decision_id,\n127:\t\t\tby: decision.actor_id,\n128:\t\t\tauthority: \"human\",\n129:\t\t\tstatement: `${decision.interaction} ${decision.option_id ?? \"answered\"} on ${decision.subject.kind} ${decision.subject.id}${decision.valid ? \"\" : \" (revoked)\"}`,\n130:\t\t\tbinding: decision.valid,\n131:\t\t});\n132:\t}\n133:\n134:\tconst risks: ResidualRisk[] = [];\n135:\tconst add = (code: string, statement: string) => {\n136:\t\tif (!risks.some((r) => r.code === code && r.statement === statement)) risks.push({ code, statement });\n137:\t};\n138:\n139:\tconst onCandidate = observations.filter((o) => o.subject_kind === \"candidate\");\n140:\tif (onCandidate.length > 0) {\n141:\t\tadd(\n142:\t\t\t\"controls_are_not_a_proof\",\n143:\t\t\t`${onCandidate.length} control run(s) observed the candidate under the frozen protocol; they establish what those controls detect, not the absence of defects.`,\n144:\t\t);\n145:\t}\n146:\tif (state.reviews.some((r) => r.valid && r.conclusion === \"approve\")) {\n147:\t\tadd(\n148:\t\t\t\"review_is_not_a_demonstration\",\n149:\t\t\t\"a review concluded approve: it is a model reading the candidate, and it demonstrates nothing by itself.\",\n150:\t\t);\n151:\t}\n152:\tfor (const obligation of protocol?.obligations ?? []) {\n153:\t\tif (obligation.control_ids.length === 0 && !obligation.not_applicable_reason) {\n154:\t\t\tadd(\n155:\t\t\t\t\"requirement_without_control\",\n156:\t\t\t\t`requirement ${obligation.requirement.requirement_id} is carried by no control.`,\n157:\t\t\t);\n158:\t\t}\n159:\t\tif (obligation.not_applicable_reason) {\n160:\t\t\tadd(\n161:\t\t\t\t\"requirement_declared_not_applicable\",\n162:\t\t\t\t`requirement ${obligation.requirement.requirement_id} was set aside: ${obligation.not_applicable_reason}.`,\n163:\t\t\t);\n164:\t\t}\n165:\t\tif (obligation.human_interaction) {\n166:\t\t\tadd(\n167:\t\t\t\t\"requirement_decided_by_a_human\",\n168:\t\t\t\t`requirement ${obligation.requirement.requirement_id} is settled by ${obligation.human_interaction}, not by a measurement.`,\n169:\t\t\t);\n170:\t\t}\n171:\t}\n172:\tfor (const [controlId, qualification] of Object.entries(protocol?.qualifications ?? {})) {\n173:\t\tif (!qualification.qualified)\n174:\t\t\tadd(\n175:\t\t\t\t\"control_not_qualified\",\n176:\t\t\t\t`control ${controlId} is not qualified: ${qualification.notes.join(\"; \") || \"witnesses did not answer as required\"}.`,\n177:\t\t\t);\n178:\t}\n179:\tfor (const e of evidence) {\n180:\t\tif (e.verdict === \"INDETERMINATE\")\n181:\t\t\tadd(\n182:\t\t\t\t\"indeterminate_control\",\n183:\t\t\t\t`control ${e.control_id} answered INDETERMINATE on ${e.subject.kind} ${e.subject.id}; nothing is concluded from it.`,\n184:\t\t\t);\n185:\t\tif (e.limits.unstable)\n186:\t\t\tadd(\"unstable_control\", `control ${e.control_id} answered differently on two passes of the same subject.`);\n187:\t\tif (e.limits.truncated)\n188:\t\t\tadd(\n189:\t\t\t\t\"truncated_output\",\n190:\t\t\t\t`the output of control ${e.control_id} was truncated at ${e.limits.bytes_read} bytes; what it did not say was not read.`,\n191:\t\t\t);\n192:\t\tfor (const exclusion of e.limits.exclusions)\n193:\t\t\tadd(\"excluded_from_measure\", `control ${e.control_id} excluded ${exclusion} from what it measured.`);\n194:\t\tfor (const note of e.limits.notes) add(\"control_limit\", `control ${e.control_id}: ${note}`);\n195:\t\tif ((e.baseline?.preexisting_findings ?? 0) > 0)\n196:\t\t\tadd(\n197:\t\t\t\t\"preexisting_findings_tolerated\",\n198:\t\t\t\t`control ${e.control_id} reports ${e.baseline!.preexisting_findings} finding(s) the reference already carried; the tolerance let them stand.`,\n199:\t\t\t);\n200:\t}\n201:\tfor (const entry of state.evidence) {\n202:\t\tif (!entry.valid)\n203:\t\t\tadd(\n204:\t\t\t\t\"invalidated_evidence\",\n205:\t\t\t\t`evidence ${entry.evidence_id} (${entry.control_id}) no longer applies: ${entry.invalid_reason ?? \"invalidated\"}.`,\n206:\t\t\t);\n207:\t}\n208:\tif (state.stop_reason)\n209:\t\tadd(\n210:\t\t\t\"stopped_before_the_end\",\n211:\t\t\t`the change stopped on ${state.stop_reason}${state.stop_detail ? `: ${state.stop_detail}` : \"\"}.`,\n212:\t\t);\n213:\n214:\treturn {\n215:\t\tschema_version: 1,\n216:\t\tchange_id: state.change_id,\n217:\t\toutcome: state.outcome,\n218:\t\tcandidate: state.candidate\n219:\t\t\t? { candidate_id: state.candidate.candidate_id, manifest_digest: state.candidate.manifest_digest }\n220:\t\t\t: null,\n221:\t\trequirements: asked,\n222:\t\tobservations,\n223:\t\tjudgments,\n224:\t\tresidual_risks: risks,\n225:\t};\n226:}","is_error":false}]},"parent_tool_use_id":null,"session_id":"6599c808-d3d6-475b-8484-f7869ab824d8","uuid":"73acc7ec-bfb4-4306-8742-322d85a80410","timestamp":"2026-09-29T19:17:16.192Z","tool_use_result":{"stdout":"1:/**\n2: * Engineering report (IMP-05): the three natures of what a change produced, kept apart because\n3: * they do not have the same authority. A mechanical observation is what an executed control\n4: * measured on an identified subject. A judgment is what someone or something concluded from it —\n5: * the kernel at a gate, a model in a review, a human in a decision. A residual risk is what\n6: * nothing here establishes: a control that passed observed what it knows how to observe, and that\n7: * is not the absence of a defect.\n8: *\n9: * The report is derived from the ledger alone, so it reads without a model and without Pi.\n10: */\n11:import type { Outcome, Verdict } from \"../contracts/v1/common.ts\";\n12:import type { Evidence } from \"../contracts/v1/evidence.ts\";\n13:import type { Protocol, RequirementsDocument } from \"../contracts/v1/protocol.ts\";\n14:import type { ChangeState, EvidenceEntry } from \"../domain/change/state.ts\";\n15:\n16:/** Measured: a control ran on a subject and answered. No interpretation is carried here. */\n17:export interface MechanicalObservation {\n18:\tevidence_id: string;\n19:\tcontrol_id: string;\n20:\tcontrol_version: string;\n21:\t/** `candidate`, `reference` or `fixture` — what the control was pointed at. */\n22:\tsubject_kind: string;\n23:\tsubject_digest: string;\n24:\tverdict: Verdict;\n25:\tblocking_findings: number;\n26:\t/** The control answered, but its answer is no longer usable for this change. */\n27:\tvalid: boolean;\n28:}\n29:\n30:/** Concluded: by whom, with what authorit