ks it landed, and the epic\n206-becomes `versé` when a session finds that its stories deliver its purpose. The run starts from `main`\n207-with a clean tree and stops at the first block, saying why; it never pushes.\n208-`npm run cycle -- <story> auto` does the same for a single story.\n209-\n210-Three of the owner's answers are delegated, each an act recorded in the record:\n    60\t\t\treturn `acceptance report at ${where} is unreadable: ${messageOf(error)}`;\n    61\t\t}\n    62\t\tlet parsed: unknown;\n    63\t\ttry {\n    64\t\t\tparsed = JSON.parse(text);\n    65\t\t} catch (error) {\n    66\t\t\treturn `acceptance report at ${where} is not JSON: ${messageOf(error)}`;\n    67\t\t}\n    68\t\treturn check(AcceptanceReport, parsed)\n    69\t\t\t? parsed\n    70\t\t\t: `acceptance report at ${where} does not follow the contract acceptance-report`;\n    71\t}\n    72\t\n    73\t/** What keeps the report from standing for the declared recipe on this candidate. */\n    74\tfunction gapsOf(report: AcceptanceReport, recipe: AcceptanceRecipe, subject: string): string[] {\n    75\t\tconst gaps: string[] = [];\n    76\t\tif (report.candidate !== subject)\n    77\t\t\tgaps.push(`acceptance report names candidate ${report.candidate}, not ${subject} this run judged`);\n    78\t\tif (report.observations.length === 0)\n    79\t\t\tgaps.push(\"acceptance report observes nothing: a summary without observations is not an acceptance run\");\n    80\t\tif (report.entry !== recipe.entry)\n    81\t\t\tgaps.push(`acceptance report drove the entry ${report.entry}, the recipe declares ${recipe.entry}`);\n    82\t\tfor (const simulation of report.simulations)\n    83\t\t\tif (!recipe.simulations.includes(simulation))\n    84\t\t\t\tgaps.push(`acceptance report simulates ${simulation}, which the recipe does not allow`);\n    85\t\tfor (const declared of recipe.observations)\n    86\t\t\tif (!report.observations.some((o) => same(o, declared)))\n    87\t\t\t\tgaps.push(`observation ${decla